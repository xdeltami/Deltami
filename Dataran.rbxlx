	Text = "M",
	Size = UDim2.new(1, 0, 1, 0),
	BackgroundTransparency = 1,
	TextColor3 = Color3.fromRGB(126, 86, 10),
	TextScaled = true,
	Font = Enum.Font.GothamBlack,
}, ikon)

