        <Item class="Script" referent="RBX886">
          <Properties>
            <string name="Name">AnimasiKincir</string>
            <ProtectedString name="Source">local pusat = script.Parent:WaitForChild("PusatBaling")
local sudut = 0
while true do
	task.wait(0.06)
	sudut += 0.04
	for i = 1, 4 do
		local baling = script.Parent:FindFirstChild("Baling" .. i)
		if baling then
			baling.CFrame = pusat.CFrame * CFrame.Angles(0, 0, sudut + (i - 1) * math.pi / 2) * CFrame.new(0, 6, 0)
		end
	end
end
</ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
