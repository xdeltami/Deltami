	Size = UDim2.new(0, 64, 0, 12),
	BackgroundTransparency = 1,
	TextColor3 = Color3.fromRGB(214, 178, 92),
	TextScaled = true,
	Font = Enum.Font.GothamBold,
	TextXAlignment = Enum.TextXAlignment.Left,
}, pil)

local labelPil = buat("TextLabel", {
	Name = "JumlahMicda",
