    <Item class="ModuleScript" referent="RBX979">
      <Properties>
        <string name="Name">GameConfig</string>
        <ProtectedString name="Source">local GameConfig = {}

GameConfig.TempatIni = "Dataran"
GameConfig.Places = {
	Dataran = 77626159664192,
	Kampung = 104140882721739,
	Sabana = 114149183491762,
	Stepa = 121892136503729,
	Perladangan = 74900687715969,
}
GameConfig.PesanKawasan = "Selamat datang di Dataran! Toko Benih di barat, kebun demonstrasi di timur, empat gerbang di utara, timur, selatan, dan barat."
GameConfig.NPCTeks = {}

GameConfig.NamaPlace = "Dataran"
GameConfig.MataUang = "Micda"
GameConfig.MicdaAwal = 999990000000000
GameConfig.MicdaMaks = 1000000000000000
GameConfig.HadiahBicaraMaks = 999
GameConfig.HargaBawaan = 1
GameConfig.WaktuTumbuhBawaan = 1
GameConfig.TasSlotMaks = 50
GameConfig.IsiPerSlotMaks = 250
GameConfig.RadiusInteraksi = 16
GameConfig.RadiusPetak = 12
GameConfig.BatasPermintaanPerDetik = 5

GameConfig.Kategori = {"Serealia", "Legum", "Sayuran", "Buah-buahan", "Tanaman Lainnya"}

GameConfig.Benih = {
	{Id = 1, Nama = "Gandum", Kategori = "Serealia", Warna = Color3.fromRGB(198, 168, 88)},
	{Id = 2, Nama = "Jelai", Kategori = "Serealia", Warna = Color3.fromRGB(176, 150, 80)},
	{Id = 3, Nama = "Oat", Kategori = "Serealia", Warna = Color3.fromRGB(210, 186, 120)},
	{Id = 4, Nama = "Rye", Kategori = "Serealia", Warna = Color3.fromRGB(146, 124, 88)},
	{Id = 5, Nama = "Sorgum", Kategori = "Serealia", Warna = Color3.fromRGB(168, 96, 60)},
	{Id = 6, Nama = "Jewawut", Kategori = "Serealia", Warna = Color3.fromRGB(204, 178, 98)},
	{Id = 7, Nama = "Buckwheat", Kategori = "Serealia", Warna = Color3.fromRGB(120, 96, 72)},
	{Id = 8, Nama = "Kacang polong", Kategori = "Legum", Warna = Color3.fromRGB(108, 180, 78)},
	{Id = 9, Nama = "Kacang lentil", Kategori = "Legum", Warna = Color3.fromRGB(198, 132, 64)},
	{Id = 10, Nama = "Kacang arab", Kategori = "Legum", Warna = Color3.fromRGB(214, 190, 140)},
	{Id = 11, Nama = "Kacang hitam", Kategori = "Legum", Warna = Color3.fromRGB(70, 62, 56)},
	{Id = 12, Nama = "Kacang merah", Kategori = "Legum", Warna = Color3.fromRGB(168, 64, 52)},
	{Id = 13, Nama = "Bit", Kategori = "Sayuran", Warna = Color3.fromRGB(164, 44, 96)},
	{Id = 14, Nama = "Asparagus", Kategori = "Sayuran", Warna = Color3.fromRGB(96, 150, 70)},
	{Id = 15, Nama = "Seledri", Kategori = "Sayuran", Warna = Color3.fromRGB(140, 190, 96)},
	{Id = 16, Nama = "Selada", Kategori = "Sayuran", Warna = Color3.fromRGB(116, 178, 84)},
	{Id = 17, Nama = "Brokoli", Kategori = "Sayuran", Warna = Color3.fromRGB(72, 124, 58)},
	{Id = 18, Nama = "Kembang kol", Kategori = "Sayuran", Warna = Color3.fromRGB(238, 232, 214)},
	{Id = 19, Nama = "Kubis", Kategori = "Sayuran", Warna = Color3.fromRGB(128, 168, 96)},
	{Id = 20, Nama = "Paprika", Kategori = "Sayuran", Warna = Color3.fromRGB(196, 44, 44)},
	{Id = 21, Nama = "Mentimun", Kategori = "Sayuran", Warna = Color3.fromRGB(78, 148, 72)},
	{Id = 22, Nama = "Apel", Kategori = "Buah-buahan", Warna = Color3.fromRGB(196, 52, 48)},
	{Id = 23, Nama = "Pir", Kategori = "Buah-buahan", Warna = Color3.fromRGB(188, 196, 96)},
	{Id = 24, Nama = "Anggur (buah saja)", Kategori = "Buah-buahan", Warna = Color3.fromRGB(124, 64, 152)},
	{Id = 25, Nama = "Plum", Kategori = "Buah-buahan", Warna = Color3.fromRGB(110, 54, 128)},
	{Id = 26, Nama = "Aprikot", Kategori = "Buah-buahan", Warna = Color3.fromRGB(232, 140, 72)},
	{Id = 27, Nama = "Persik", Kategori = "Buah-buahan", Warna = Color3.fromRGB(238, 150, 130)},
	{Id = 28, Nama = "Nektarin", Kategori = "Buah-buahan", Warna = Color3.fromRGB(212, 88, 56)},
	{Id = 29, Nama = "Ceri", Kategori = "Buah-buahan", Warna = Color3.fromRGB(140, 28, 36)},
	{Id = 30, Nama = "Zaitun", Kategori = "Tanaman Lainnya", Warna = Color3.fromRGB(118, 132, 66)},
}

GameConfig.BenihPerId = {}
for _, benih in ipairs(GameConfig.Benih) do
	benih.Harga = GameConfig.HargaBawaan
	benih.WaktuTumbuh = GameConfig.WaktuTumbuhBawaan
	GameConfig.BenihPerId[benih.Id] = benih
end

function GameConfig.SlotTasTerpakai(tas)
	local isi = 0
	for _ in pairs(tas) do
		isi += 1
	end
	return isi
end

function GameConfig.FormatAngkaPenuh(nilai)
	local n = math.floor(tonumber(nilai) or 0)
	local negatif = n &lt; 0
	if negatif then
		n = -n
	end
	local s = tostring(n)
	while true do
		local ganti
		s, ganti = s:gsub("^(%d+)(%d%d%d)", "%1.%2")
		if ganti == 0 then
			break
		end
	end
	if negatif then
		s = "-" .. s
	end
	return s
end

function GameConfig.FormatMicda(nilai)
	local n = tonumber(nilai) or 0
	local tanda = ""
	if n &lt; 0 then
		tanda = "-"
		n = -n
	end
	local satuan = {
		{1000000000000, "T"},
		{1000000000, "M"},
		{1000000, "Jt"},
		{1000, "Rb"},
	}
	for _, s in ipairs(satuan) do
		if n &gt;= s[1] then
			local kecil = n / s[1]
			local teks
			if kecil == math.floor(kecil) then
				teks = tostring(math.floor(kecil))
			else
				teks = (string.format("%.2f", kecil):gsub("%.", ","))
			end
			return tanda .. teks .. " " .. s[2]
		end
	end
	return tanda .. tostring(math.floor(n))
end

return GameConfig
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX980">
      <Properties>
        <string name="Name">Remotes</string>
        <ProtectedString name="Source">local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = {}
local namaFolder = "RemoteDataran"
local daftarRemote = {
	{Nama = "PermintaanToko", Kelas = "RemoteEvent"},
	{Nama = "AksiKebun", Kelas = "RemoteEvent"},
	{Nama = "InfoDataran", Kelas = "RemoteEvent"},
	{Nama = "AmbilData", Kelas = "RemoteFunction"},
}

local folder
if RunService:IsServer() then
	folder = ReplicatedStorage:FindFirstChild(namaFolder)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = namaFolder
		folder.Parent = ReplicatedStorage
	end
	for _, info in ipairs(daftarRemote) do
		if not folder:FindFirstChild(info.Nama) then
			local remote = Instance.new(info.Kelas)
			remote.Name = info.Nama
			remote.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild(namaFolder, 20)
end

for _, info in ipairs(daftarRemote) do
	if folder then
		if RunService:IsServer() then
			Remotes[info.Nama] = folder:FindFirstChild(info.Nama)
		else
			Remotes[info.Nama] = folder:WaitForChild(info.Nama, 20)
		end
	end
end

return Remotes
</ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX981">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="ModuleScript" referent="RBX982">
      <Properties>
        <string name="Name">RateLimit</string>
        <ProtectedString name="Source">local RateLimit = {}
local data = {}

function RateLimit.Izinkan(player, kunci, maksPerDetik)
	local id = player.UserId .. ":" .. kunci
	local sekarang = os.clock()
	local entri = data[id]
	if not entri or sekarang - entri.Awal &gt;= 1 then
		data[id] = {Awal = sekarang, Hitung = 1}
		return true
	end
	entri.Hitung += 1
	return entri.Hitung &lt;= maksPerDetik
end

function RateLimit.Bersihkan(player)
	local awalan = tostring(player.UserId) .. ":"
	for id in pairs(data) do
		if string.sub(id, 1, #awalan) == awalan then
			data[id] = nil
		end
	end
end

return RateLimit
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX983">
      <Properties>
        <string name="Name">DataService</string>
        <ProtectedString name="Source">local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("GameConfig"))
local Remotes = require(ReplicatedStorage:WaitForChild("Remotes"))
local RateLimit = require(script.Parent:WaitForChild("RateLimit"))

local DataService = {}
local store = nil
local dataPemain = {}

pcall(function()
	store = DataStoreService:GetDataStore("DataranData_v1")
end)

local function dataBaru()
	return {Micda = GameConfig.MicdaAwal, Tas = {}}
end

local function kunciItem(jenis, id)
	return jenis .. "_" .. id
end

local function muatData(player)
	if dataPemain[player.UserId] then
		return
	end
	local data = dataBaru()
	if store then
		local ok, hasil = pcall(function()
			return store:GetAsync("P_" .. player.UserId)
		end)
		if ok and type(hasil) == "table" then
			data.Micda = tonumber(hasil.Micda) or data.Micda
			if type(hasil.Tas) == "table" then
				data.Tas = hasil.Tas
			end
		end
	end
	if data.Micda &gt; GameConfig.MicdaMaks then
		data.Micda = GameConfig.MicdaMaks
	end
	dataPemain[player.UserId] = data
	Remotes.InfoDataran:FireClient(player, {Jenis = "Pesan", Teks = "Selamat datang di " .. GameConfig.TempatIni .. "! " .. GameConfig.FormatMicda(data.Micda) .. " Micda sudah terisi di akunmu."})
	DataService.KirimData(player)
end

local function simpanData(player)
	local data = dataPemain[player.UserId]
	if not store or not data then
		return
	end
	pcall(function()
		store:UpdateAsync("P_" .. player.UserId, function()
			return data
		end)
	end)
end

function DataService.Ambil(player)
	return dataPemain[player.UserId]
end

function DataService.KirimData(player)
	local data = dataPemain[player.UserId]
	if data then
		Remotes.InfoDataran:FireClient(player, {Jenis = "Data", Micda = data.Micda, Tas = data.Tas})
	end
end

function DataService.UbahMicda(player, delta)
	local data = dataPemain[player.UserId]
	if not data then
		return false
	end
	local hasil = data.Micda + delta
	if hasil &lt; 0 then
		return false
	end
	if hasil &gt; GameConfig.MicdaMaks then
		hasil = GameConfig.MicdaMaks
	end
	data.Micda = hasil
	return true
end

function DataService.HadiahBicara(player, jumlah)
	if not jumlah or jumlah &lt;= 0 then
		return 0
	end
	if jumlah &gt; GameConfig.HadiahBicaraMaks then
		jumlah = GameConfig.HadiahBicaraMaks
	end
	DataService.UbahMicda(player, jumlah)
	DataService.KirimData(player)
	return jumlah
end

function DataService.TambahItem(player, jenis, id, jumlah)
	local data = dataPemain[player.UserId]
	if not data or jumlah &lt;= 0 then
		return false
	end
	local kunci = kunciItem(jenis, id)
	local slot = data.Tas[kunci]
	if slot then
		if slot.Jumlah + jumlah &gt; GameConfig.IsiPerSlotMaks then
			return false
		end
		slot.Jumlah += jumlah
	else
		if GameConfig.SlotTasTerpakai(data.Tas) &gt;= GameConfig.TasSlotMaks then
			return false
		end
		data.Tas[kunci] = {Jenis = jenis, Id = id, Jumlah = jumlah}
	end
	return true
end

function DataService.KurangiItem(player, jenis, id, jumlah)
	local data = dataPemain[player.UserId]
	if not data or jumlah &lt;= 0 then
		return false
	end
	local kunci = kunciItem(jenis, id)
	local slot = data.Tas[kunci]
	if not slot or slot.Jumlah &lt; jumlah then
		return false
	end
	slot.Jumlah -= jumlah
	if slot.Jumlah &lt;= 0 then
		data.Tas[kunci] = nil
	end
	return true
end

Remotes.AmbilData.OnServerInvoke = function(player)
	if not RateLimit.Izinkan(player, "Data", 3) then
		return nil
	end
	local data = dataPemain[player.UserId]
	if not data then
		return nil
	end
	return {Micda = data.Micda, Tas = data.Tas}
end

Players.PlayerAdded:Connect(muatData)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(muatData, player)
end

Players.PlayerRemoving:Connect(function(player)
	simpanData(player)
	dataPemain[player.UserId] = nil
	RateLimit.Bersihkan(player)
end)

task.spawn(function()
	while true do
		task.wait(120)
		for _, player in ipairs(Players:GetPlayers()) do
			simpanData(player)
		end
	end
end)

game:BindToClose(function()
	for _, player in ipairs(Players:GetPlayers()) do
		simpanData(player)
	end
end)

return DataService
</ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX984">
      <Properties>
        <string name="Name">GerbangTeleport</string>
        <ProtectedString name="Source">local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("GameConfig"))
local Remotes = require(ReplicatedStorage:WaitForChild("Remotes"))
local RateLimit = require(script.Parent:WaitForChild("RateLimit"))

local cooldown = {}

local function tujuanDari(namaGerbang)
	local target = string.gsub(namaGerbang, "^Gerbang", "")
	if target == GameConfig.TempatIni then
		return nil
	end
	local id = GameConfig.Places[target]
	if id and id ~= GameConfig.Places[GameConfig.TempatIni] then
		return id, target
	end
	return nil
end

task.spawn(function()
	local folderGerbang = workspace:WaitForChild("Gerbang", 60)
	if not folderGerbang then
		return
	end
	for _, gerbang in ipairs(folderGerbang:GetChildren()) do
		local id, nama = tujuanDari(gerbang.Name)
		local papan = gerbang:FindFirstChild("PapanGerbang", true)
		if id and papan then
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "PromptTeleport"
			prompt.ActionText = "Masuk Gerbang"
			prompt.ObjectText = "Menuju " .. nama
			prompt.HoldDuration = 0.5
			prompt.MaxActivationDistance = 18
			prompt.RequiresLineOfSight = false
			prompt.Parent = papan
			prompt.Triggered:Connect(function(player)
				if not RateLimit.Izinkan(player, "Teleport", 2) then
					return
				end
				local sekarang = os.clock()
				if cooldown[player.UserId] and sekarang - cooldown[player.UserId] &lt; 4 then
					return
				end
				cooldown[player.UserId] = sekarang
				Remotes.InfoDataran:FireClient(player, {Jenis = "Pesan", Teks = "Gerbang terbuka... menuju " .. nama .. "!"})
				local ok, err = pcall(function()
					TeleportService:TeleportAsync(id, {player})
				end)
				if not ok then
					Remotes.InfoDataran:FireClient(player, {Jenis = "Pesan", Teks = "Gerbang gagal membuka, coba lagi. (" .. tostring(err) .. ")"})
				end
			end)
		end
	end
end)

TeleportService.TeleportInitFailed:Connect(function(player, _, hasil)
	if player.Parent then
		Remotes.InfoDataran:FireClient(player, {Jenis = "Pesan", Teks = "Teleport gagal (" .. tostring(hasil) .. "), coba masuk gerbang lagi."})
	end
end)

Players.PlayerRemoving:Connect(function(player)
	cooldown[player.UserId] = nil
end)
</ProtectedString>
        <bool name="Disabled">false</bool>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX985">
      <Properties>
        <string name="Name">TerrainDunia</string>
        <ProtectedString name="Source">local Terrain = workspace:WaitForChild("Terrain")

local DASAR_M = "Grass"
local BUKIT = {{x=-320,z=-180,r=85,t=16,m="Grass"}, {x=280,z=-220,r=80,t=15,m="Grass"}, {x=-220,z=-60,r=60,t=12,m="Grass"}, {x=320,z=100,r=75,t=14,m="Grass"}, {x=-340,z=60,r=70,t=13,m="Grass"}, {x=200,z=330,r=80,t=16,m="Grass"}, {x=-100,z=350,r=75,t=15,m="Grass"}, {x=-380,z=260,r=70,t=14,m="Grass"}, {x=60,z=-350,r=70,t=14,m="Grass"}, {x=-240,z=400,r=80,t=16,m="Grass"}, {x=400,z=-80,r=65,t=12,m="Grass"}, {x=100,z=230,r=50,t=10,m="Grass"}}
local TUMPUK = {}
local SUNGAI = {{x=-470,z=150}, {x=-330,z=122}, {x=-180,z=168}, {x=-20,z=196}, {x=130,z=150}, {x=280,z=186}, {x=470,z=150}}
local GIGI = {{x=-428.5,z=-517.6,y=92,d=17.7}, {x=-268.9,z=-519.9,y=92,d=16.8}, {x=-139.5,z=-518.5,y=92,d=15.3}, {x=-75.1,z=-506.9,y=92,d=9.1}, {x=27.6,z=-518.8,y=92,d=9.6}, {x=155.4,z=-504.3,y=92,d=16.7}, {x=286.8,z=-518.9,y=92,d=13.6}, {x=422.6,z=-511,y=92,d=16.1}, {x=-374.6,z=509.3,y=92,d=16.8}, {x=-294.3,z=508.7,y=92,d=12.4}, {x=-167.8,z=512,y=92,d=14.5}, {x=-51.9,z=521.1,y=92,d=16.9}, {x=29,z=517.5,y=92,d=10.8}, {x=163,z=508.1,y=92,d=14.5}, {x=282.2,z=516.6,y=92,d=12.4}, {x=388.5,z=520.7,y=92,d=14.8}, {x=-514.8,z=-401.3,y=92,d=11.9}, {x=-507.8,z=-300.9,y=92,d=13}, {x=-518.6,z=-180.4,y=92,d=14.6}, {x=-514.3,z=-29.6,y=92,d=14.7}, {x=-507.6,z=60.7,y=92,d=17.6}, {x=-513.7,z=202.4,y=92,d=12.7}, {x=-511.7,z=291.2,y=92,d=16.1}, {x=-521.8,z=432.4,y=92,d=14.2}, {x=502.7,z=-367.4,y=92,d=18}, {x=514.7,z=-290.5,y=92,d=11.3}, {x=514.2,z=-165,y=92,d=12}, {x=506.9,z=-67.3,y=92,d=17.7}, {x=517.8,z=65.1,y=92,d=12.4}, {x=504.4,z=173.1,y=92,d=13.8}, {x=516.7,z=265.5,y=92,d=17.6}, {x=513.5,z=365.1,y=92,d=9.5}}
local TEPI = {jrk = 496, tbl = 48, tng = 90}
local RIVER = {lbr = 18, pahat = 8}

local function bahan(nama)
	return Enum.Material[nama]
end

local dasar = Region3.new(Vector3.new(-512, -12, -512), Vector3.new(512, -0.001, 512))
Terrain:FillRegion(dasar, 4, bahan(DASAR_M))

for _, b in ipairs(BUKIT) do
	Terrain:FillBall(Vector3.new(b.x, b.t - b.r, b.z), b.r, bahan(b.m))
end

for _, p in ipairs(TUMPUK) do
	Terrain:FillBlock(CFrame.new(Vector3.new(p.x, -2, p.z)), Vector3.new(p.sx, 4, p.sz), bahan(p.m))
end

for i = 1, #SUNGAI - 1 do
	local a = SUNGAI[i]
	local b = SUNGAI[i + 1]
	local ax, az, bx, bz = a.x, a.z, b.x, b.z
	local panj = math.sqrt((bx - ax) ^ 2 + (bz - az) ^ 2)
	if panj &gt; 1 then
		local mid = Vector3.new((ax + bx) / 2, -4, (az + bz) / 2)
		local cf = CFrame.lookAt(mid, Vector3.new(bx, -4, bz))
		Terrain:FillBlock(cf, Vector3.new(RIVER.lbr, 12, panj + 10), bahan("Air"))
		Terrain:FillBlock(cf, Vector3.new(RIVER.lbr, 4, panj + 10), bahan("Ground"))
		Terrain:FillBlock(cf, Vector3.new(RIVER.lbr - 2, 4, panj + 10), bahan("Water"))
	end
end

local j, tb, tg = TEPI.jrk, TEPI.tbl, TEPI.tng
local q = 2 * j + 2 * tb
Terrain:FillBlock(CFrame.new(Vector3.new(0, tg / 2 - 12, -j - tb / 2)), Vector3.new(q, tg + 12, tb), bahan("Rock"))
Terrain:FillBlock(CFrame.new(Vector3.new(0, tg / 2 - 12, j + tb / 2)), Vector3.new(q, tg + 12, tb), bahan("Rock"))
Terrain:FillBlock(CFrame.new(Vector3.new(-j - tb / 2, tg / 2 - 12, 0)), Vector3.new(tb, tg + 12, q), bahan("Rock"))
Terrain:FillBlock(CFrame.new(Vector3.new(j + tb / 2, tg / 2 - 12, 0)), Vector3.new(tb, tg + 12, q), bahan("Rock"))

for _, g in ipairs(GIGI) do
	Terrain:FillBall(Vector3.new(g.x, g.y, g.z), g.d, bahan("Rock"))
end
</ProtectedString>
        <bool name="Disabled">false</bool>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX986">
      <Properties>
        <string name="Name">TokoBenihService</string>
        <ProtectedString name="Source">local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("GameConfig"))
local Remotes = require(ReplicatedStorage:WaitForChild("Remotes"))
local RateLimit = require(script.Parent:WaitForChild("RateLimit"))
local DataService = require(script.Parent:WaitForChild("DataService"))

task.spawn(function()
	local zonaToko = workspace:WaitForChild("ZonaToko")
	local counter = zonaToko:WaitForChild("CounterToko")

	Remotes.PermintaanToko.OnServerEvent:Connect(function(player, paket)
		if type(paket) ~= "table" then
			return
		end
		if paket.Aksi ~= "Beli" then
			return
		end
		if not RateLimit.Izinkan(player, "Toko", GameConfig.BatasPermintaanPerDetik) then
			return
		end
		local karakter = player.Character
		local akar = karakter and karakter:FindFirstChild("HumanoidRootPart")
		if not akar then
			return
		end
		if (akar.Position - counter.Position).Magnitude &gt; GameConfig.RadiusInteraksi + 10 then
			return
		end
		local benih = GameConfig.BenihPerId[tonumber(paket.BenihId)]
		if not benih then
			return
		end
		local data = DataService.Ambil(player)
		if not data then
			return
		end
		if data.Micda &lt; benih.Harga then
			Remotes.InfoDataran:FireClient(player, {Jenis = "Pesan", Teks = "Micda tidak cukup"})
			return
		end
		if not DataService.TambahItem(player, "Benih", benih.Id, 1) then
			Remotes.InfoDataran:FireClient(player, {Jenis = "Pesan", Teks = "Tas penuh"})
			return
		end
		DataService.UbahMicda(player, -benih.Harga)
		DataService.KirimData(player)
		Remotes.InfoDataran:FireClient(player, {Jenis = "BeliSukses", Nama = benih.Nama})
	end)
end)
</ProtectedString>
        <bool name="Disabled">false</bool>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX987">
      <Properties>
        <string name="Name">KebunDemoService</string>
        <ProtectedString name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("GameConfig"))
local Remotes = require(ReplicatedStorage:WaitForChild("Remotes"))
local RateLimit = require(script.Parent:WaitForChild("RateLimit"))
local DataService = require(script.Parent:WaitForChild("DataService"))

local kebun = workspace:WaitForChild("KebunDemo")
local statusPetak = {}

local function aturPrompt(petak, teks, aktif)
	local prompt = petak:FindFirstChildOfClass("ProximityPrompt")
	if not prompt then
		prompt = Instance.new("ProximityPrompt")
		prompt.Name = "PromptPetak"
		prompt.ObjectText = "Petak Semai"
		prompt.HoldDuration = 0.4
		prompt.MaxActivationDistance = GameConfig.RadiusPetak
		prompt.RequiresLineOfSight = false
		prompt.Parent = petak
	end
	prompt.ActionText = teks
	prompt.Enabled = aktif
	return prompt
end

local function hapusVisual(petak)
	local visual = petak:FindFirstChild("VisualTanaman")
	if visual then
		visual:Destroy()
	end
end

local function buatBagian(induk, nama, ukuran, cframe, warna, bentuk)
	local bagian = Instance.new("Part")
	bagian.Name = nama
	bagian.Size = ukuran
	bagian.CFrame = cframe
	bagian.Anchored = true
	bagian.CanCollide = false
	bagian.Color = warna
	bagian.Material = Enum.Material.SmoothPlastic
	if bentuk then
		bagian.Shape = bentuk
	end
	bagian.Parent = induk
	return bagian
end

local function buatVisual(petak, benih, siap)
	hapusVisual(petak)
	local model = Instance.new("Model")
	model.Name = "VisualTanaman"
	local puncak = petak.CFrame * CFrame.new(0, petak.Size.Y / 2, 0)
	buatBagian(model, "Batang", Vector3.new(0.6, 2.4, 0.6), puncak * CFrame.new(0, 1.2, 0), Color3.fromRGB(96, 128, 56), nil)
	local daun = buatBagian(model, "Daun", Vector3.new(1.1, 1.1, 1.1), puncak * CFrame.new(0, 2.6, 0), Color3.fromRGB(104, 152, 66), Enum.PartType.Ball)
	daun.Transparency = 0.1
	local ukuranBuah = siap and Vector3.new(1.8, 1.8, 1.8) or Vector3.new(0.9, 0.9, 0.9)
	buatBagian(model, "Buah", ukuranBuah, puncak * CFrame.new(0, 3.4, 0), benih.Warna, Enum.PartType.Ball)
	model.Parent = petak
end

local function jarakAman(player, petak)
	local karakter = player.Character
	local akar = karakter and karakter:FindFirstChild("HumanoidRootPart")
	if not akar then
		return false
	end
	return (akar.Position - petak.Position).Magnitude &lt;= GameConfig.RadiusPetak + 6
end

local function tanam(player, petak, benihId)
	local benih = GameConfig.BenihPerId[benihId]
	if not benih then
		return
	end
	if not jarakAman(player, petak) then
		return
	end
	if statusPetak[petak] then
		Remotes.InfoDataran:FireClient(player, {Jenis = "Pesan", Teks = "Petak sedang dipakai"})
		return
	end
	if not DataService.KurangiItem(player, "Benih", benih.Id, 1) then
		Remotes.InfoDataran:FireClient(player, {Jenis = "Pesan", Teks = "Benih tidak ada di tas"})
		return
	end
	statusPetak[petak] = {Pemilik = player.UserId, Benih = benih, Siap = false}
	aturPrompt(petak, "Menumbuhkan", false)
	buatVisual(petak, benih, false)
	DataService.KirimData(player)
	task.delay(benih.WaktuTumbuh, function()
		local status = statusPetak[petak]
		if not status or status.Benih.Id ~= benih.Id then
			return
		end
		status.Siap = true
		buatVisual(petak, benih, true)
		aturPrompt(petak, "Panen", true)
		local pemilik = Players:GetPlayerByUserId(status.Pemilik)
		if pemilik then
			Remotes.InfoDataran:FireClient(pemilik, {Jenis = "Pesan", Teks = benih.Nama .. " siap dipanen"})
		else
			statusPetak[petak] = nil
			hapusVisual(petak)
			aturPrompt(petak, "Tanam", true)
		end
	end)
end

local function panen(player, petak)
	local status = statusPetak[petak]
	if not status or not status.Siap then
		return
	end
	if status.Pemilik ~= player.UserId then
		Remotes.InfoDataran:FireClient(player, {Jenis = "Pesan", Teks = "Ini petak pemain lain"})
		return
	end
	if not jarakAman(player, petak) then
		return
	end
	local jumlah = math.random(1, 3)
	if not DataService.TambahItem(player, "Hasil", status.Benih.Id, jumlah) then
		Remotes.InfoDataran:FireClient(player, {Jenis = "Pesan", Teks = "Tas penuh"})
		return
	end
	local nama = status.Benih.Nama
	statusPetak[petak] = nil
	hapusVisual(petak)
	aturPrompt(petak, "Tanam", true)
	DataService.KirimData(player)
	Remotes.InfoDataran:FireClient(player, {Jenis = "Pesan", Teks = "Panen: " .. jumlah .. "x " .. nama})
end

local function benihPemain(player)
	local data = DataService.Ambil(player)
	local pilihan = {}
	if data then
		for _, slot in pairs(data.Tas) do
			if slot.Jenis == "Benih" and slot.Jumlah &gt; 0 then
				table.insert(pilihan, slot.Id)
			end
		end
	end
	table.sort(pilihan)
	return pilihan
end

for i = 1, 6 do
	local petak = kebun:WaitForChild("PetakSemai" .. i)
	aturPrompt(petak, "Tanam", true).Triggered:Connect(function(player)
		if not RateLimit.Izinkan(player, "Kebun", GameConfig.BatasPermintaanPerDetik) then
			return
		end
		local status = statusPetak[petak]
		if status and status.Siap and status.Pemilik == player.UserId then
			panen(player, petak)
		elseif not status then
			local pilihan = benihPemain(player)
			if #pilihan == 0 then
				Remotes.InfoDataran:FireClient(player, {Jenis = "Pesan", Teks = "Belum punya benih, beli di Toko Benih"})
				return
			end
			if #pilihan == 1 then
				tanam(player, petak, pilihan[1])
			else
				Remotes.InfoDataran:FireClient(player, {Jenis = "MintaPilihBenih", Petak = petak.Name})
			end
		end
	end)
end

Remotes.AksiKebun.OnServerEvent:Connect(function(player, paket)
	if type(paket) ~= "table" or paket.Aksi ~= "Tanam" then
		return
	end
	if not RateLimit.Izinkan(player, "Kebun", GameConfig.BatasPermintaanPerDetik) then
		return
	end
	local namaPetak = tostring(paket.Petak)
	if string.sub(namaPetak, 1, 11) ~= "PetakSemai" then
		return
	end
	local petak = kebun:FindFirstChild(namaPetak)
	if not petak or statusPetak[petak] then
		return
	end
	tanam(player, petak, tonumber(paket.BenihId))
end)

Players.PlayerRemoving:Connect(function(player)
	for petak, status in pairs(statusPetak) do
		if status.Pemilik == player.UserId then
			statusPetak[petak] = nil
			hapusVisual(petak)
			aturPrompt(petak, "Tanam", true)
		end
	end
end)
</ProtectedString>
        <bool name="Disabled">false</bool>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX988">
      <Properties>
        <string name="Name">InteraksiDunia</string>
        <ProtectedString name="Source">local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Remotes"))

local sapaan = {
	NPC_BuSari = {
		"Selamat datang di Toko Benih Dataran!",
		"Ada 30 jenis benih, semuanya 1 Micda.",
		"Setelah beli, tanam benihmu di petak semai kebun demonstrasi.",
	},
	NPC_PakDarsa = {
		"Dataran damai sekali hari ini.",
		"Empat gerbang menghubungkan Dataran dengan kawasan lain.",
		"Alun-alun adalah tempat terbaik untuk bertemu pendatang baru.",
	},
	NPC_Mira = {
		"Kebun demonstrasi menampilkan contoh semua 30 jenis benih.",
		"Kenali bentuk tanamannya dulu sebelum membeli.",
		"Petak semai ada di sini, coba tanam satu benih!",
	},
}

local infoGerbang = {
	GerbangKampung = "Gerbang Barat menuju Kampung. Pilih 'Masuk Gerbang' pada papan untuk teleport ke kawasan itu.",
	GerbangSabana = "Gerbang Utara menuju Sabana. Pilih 'Masuk Gerbang' pada papan untuk teleport ke kawasan itu.",
	GerbangStepa = "Gerbang Timur menuju Stepa. Pilih 'Masuk Gerbang' pada papan untuk teleport ke kawasan itu.",
	GerbangPerladangan = "Gerbang Selatan menuju Perladangan. Pilih 'Masuk Gerbang' pada papan untuk teleport ke kawasan itu.",
}

local function tambahPrompt(induk, aksi, objek)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = aksi
	prompt.ObjectText = objek
	prompt.HoldDuration = 0.3
	prompt.MaxActivationDistance = 16
	prompt.RequiresLineOfSight = false
	prompt.Parent = induk
	return prompt
end

task.spawn(function()
	local zonaToko = workspace:WaitForChild("ZonaToko")
	local counter = zonaToko:WaitForChild("CounterToko")
	tambahPrompt(counter, "Buka Toko", "Toko Benih Dataran").Triggered:Connect(function(player)
		Remotes.InfoDataran:FireClient(player, {Jenis = "BukaToko"})
	end)
end)

task.spawn(function()
	local folderNPC = workspace:WaitForChild("NPC")
	for _, npc in ipairs(folderNPC:GetChildren()) do
		local torso = npc:FindFirstChild("Torso")
		if torso and sapaan[npc.Name] then
			local prompt = tambahPrompt(torso, "Bicara", string.gsub(npc.Name, "NPC_", ""))
			prompt.Triggered:Connect(function(player)
				local daftar = sapaan[npc.Name]
				Remotes.InfoDataran:FireClient(player, {Jenis = "NPCBicara", NPC = npc.Name, Teks = daftar[math.random(1, #daftar)]})
			end)
		end
	end
end)

task.spawn(function()
	local folderGerbang = workspace:WaitForChild("Gerbang")
	for _, gerbang in ipairs(folderGerbang:GetChildren()) do
		local papan = gerbang:FindFirstChild("PapanGerbang", true)
		if papan and infoGerbang[gerbang.Name] then
			local prompt = tambahPrompt(papan, "Info Gerbang", string.gsub(gerbang.Name, "Gerbang", "Gerbang "))
			prompt.Triggered:Connect(function(player)
				Remotes.InfoDataran:FireClient(player, {Jenis = "Pesan", Teks = infoGerbang[gerbang.Name]})
			end)
		end
	end
end)

task.spawn(function()
	local alunAlun = workspace:WaitForChild("AlunAlun")
	local papan = alunAlun:WaitForChild("PapanInfo")
	local prompt = tambahPrompt(papan, "Baca", "Papan Informasi")
	prompt.Triggered:Connect(function(player)
		Remotes.InfoDataran:FireClient(player, {Jenis = "Pesan", Teks = "Selamat datang di Dataran! Toko Benih di barat, kebun demonstrasi di timur, empat gerbang di utara, timur, selatan, dan barat."})
	end)
end)
</ProtectedString>
