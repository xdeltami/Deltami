    <Item class="ModuleScript" referent="RBX1059">
      <Properties>
        <string name="Name">GameConfig</string>
        <ProtectedString name="Source">local GameConfig = {}

GameConfig.TempatIni = "Stepa"
GameConfig.Places = {
	Dataran = 77626159664192,
	Kampung = 104140882721739,
	Sabana = 114149183491762,
	Stepa = 121892136503729,
	Perladangan = 74900687715969,
}
GameConfig.PesanKawasan = "STEPA AKIOMIDA - hamparan awal kawasan; detailnya belum ditentukan. Gerbang di utara kembali ke Dataran."
GameConfig.NPCTeks = {}

GameConfig.NamaPlace = "Stepa"
GameConfig.MataUang = "Micda"
GameConfig.MicdaAwal = 999990000000000
GameConfig.MicdaMaks = 1000000000000000
GameConfig.HadiahBicaraMaks = 999
GameConfig.HargaBawaan = 1
GameConfig.WaktuTumbuhBawaan = 1
GameConfig.TasSlotMaks = 50
GameConfig.IsiPerSlotMaks = 250
GameConfig.RadiusInteraksi = 16
GameConfig.RadiusPetak = 12
GameConfig.BatasPermintaanPerDetik = 5

GameConfig.Kategori = {"Serealia", "Legum", "Sayuran", "Buah-buahan", "Tanaman Lainnya"}

GameConfig.Benih = {
	{Id = 1, Nama = "Gandum", Kategori = "Serealia", Warna = Color3.fromRGB(198, 168, 88)},
	{Id = 2, Nama = "Jelai", Kategori = "Serealia", Warna = Color3.fromRGB(176, 150, 80)},
	{Id = 3, Nama = "Oat", Kategori = "Serealia", Warna = Color3.fromRGB(210, 186, 120)},
	{Id = 4, Nama = "Rye", Kategori = "Serealia", Warna = Color3.fromRGB(146, 124, 88)},
	{Id = 5, Nama = "Sorgum", Kategori = "Serealia", Warna = Color3.fromRGB(168, 96, 60)},
	{Id = 6, Nama = "Jewawut", Kategori = "Serealia", Warna = Color3.fromRGB(204, 178, 98)},
	{Id = 7, Nama = "Buckwheat", Kategori = "Serealia", Warna = Color3.fromRGB(120, 96, 72)},
	{Id = 8, Nama = "Kacang polong", Kategori = "Legum", Warna = Color3.fromRGB(108, 180, 78)},
	{Id = 9, Nama = "Kacang lentil", Kategori = "Legum", Warna = Color3.fromRGB(198, 132, 64)},
	{Id = 10, Nama = "Kacang arab", Kategori = "Legum", Warna = Color3.fromRGB(214, 190, 140)},
	{Id = 11, Nama = "Kacang hitam", Kategori = "Legum", Warna = Color3.fromRGB(70, 62, 56)},
	{Id = 12, Nama = "Kacang merah", Kategori = "Legum", Warna = Color3.fromRGB(168, 64, 52)},
	{Id = 13, Nama = "Bit", Kategori = "Sayuran", Warna = Color3.fromRGB(164, 44, 96)},
	{Id = 14, Nama = "Asparagus", Kategori = "Sayuran", Warna = Color3.fromRGB(96, 150, 70)},
	{Id = 15, Nama = "Seledri", Kategori = "Sayuran", Warna = Color3.fromRGB(140, 190, 96)},
	{Id = 16, Nama = "Selada", Kategori = "Sayuran", Warna = Color3.fromRGB(116, 178, 84)},
	{Id = 17, Nama = "Brokoli", Kategori = "Sayuran", Warna = Color3.fromRGB(72, 124, 58)},
	{Id = 18, Nama = "Kembang kol", Kategori = "Sayuran", Warna = Color3.fromRGB(238, 232, 214)},
	{Id = 19, Nama = "Kubis", Kategori = "Sayuran", Warna = Color3.fromRGB(128, 168, 96)},
	{Id = 20, Nama = "Paprika", Kategori = "Sayuran", Warna = Color3.fromRGB(196, 44, 44)},
	{Id = 21, Nama = "Mentimun", Kategori = "Sayuran", Warna = Color3.fromRGB(78, 148, 72)},
	{Id = 22, Nama = "Apel", Kategori = "Buah-buahan", Warna = Color3.fromRGB(196, 52, 48)},
	{Id = 23, Nama = "Pir", Kategori = "Buah-buahan", Warna = Color3.fromRGB(188, 196, 96)},
	{Id = 24, Nama = "Anggur (buah saja)", Kategori = "Buah-buahan", Warna = Color3.fromRGB(124, 64, 152)},
	{Id = 25, Nama = "Plum", Kategori = "Buah-buahan", Warna = Color3.fromRGB(110, 54, 128)},
	{Id = 26, Nama = "Aprikot", Kategori = "Buah-buahan", Warna = Color3.fromRGB(232, 140, 72)},
	{Id = 27, Nama = "Persik", Kategori = "Buah-buahan", Warna = Color3.fromRGB(238, 150, 130)},
	{Id = 28, Nama = "Nektarin", Kategori = "Buah-buahan", Warna = Color3.fromRGB(212, 88, 56)},
	{Id = 29, Nama = "Ceri", Kategori = "Buah-buahan", Warna = Color3.fromRGB(140, 28, 36)},
	{Id = 30, Nama = "Zaitun", Kategori = "Tanaman Lainnya", Warna = Color3.fromRGB(118, 132, 66)},
}

GameConfig.BenihPerId = {}
for _, benih in ipairs(GameConfig.Benih) do
	benih.Harga = GameConfig.HargaBawaan
	benih.WaktuTumbuh = GameConfig.WaktuTumbuhBawaan
	GameConfig.BenihPerId[benih.Id] = benih
end

function GameConfig.SlotTasTerpakai(tas)
	local isi = 0
	for _ in pairs(tas) do
		isi += 1
	end
	return isi
end

function GameConfig.FormatAngkaPenuh(nilai)
	local n = math.floor(tonumber(nilai) or 0)
	local negatif = n &lt; 0
	if negatif then
		n = -n
	end
	local s = tostring(n)
	while true do
		local ganti
		s, ganti = s:gsub("^(%d+)(%d%d%d)", "%1.%2")
		if ganti == 0 then
			break
		end
	end
	if negatif then
		s = "-" .. s
	end
	return s
end

function GameConfig.FormatMicda(nilai)
	local n = tonumber(nilai) or 0
	local tanda = ""
	if n &lt; 0 then
		tanda = "-"
		n = -n
	end
	local satuan = {
		{1000000000000, "T"},
		{1000000000, "M"},
		{1000000, "Jt"},
		{1000, "Rb"},
	}
	for _, s in ipairs(satuan) do
		if n &gt;= s[1] then
			local kecil = n / s[1]
			local teks
			if kecil == math.floor(kecil) then
				teks = tostring(math.floor(kecil))
			else
				teks = (string.format("%.2f", kecil):gsub("%.", ","))
			end
			return tanda .. teks .. " " .. s[2]
		end
	end
	return tanda .. tostring(math.floor(n))
end

return GameConfig
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX1060">
      <Properties>
        <string name="Name">Remotes</string>
        <ProtectedString name="Source">local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = {}
local namaFolder = "RemoteDataran"
local daftarRemote = {
	{Nama = "PermintaanToko", Kelas = "RemoteEvent"},
	{Nama = "AksiKebun", Kelas = "RemoteEvent"},
	{Nama = "InfoDataran", Kelas = "RemoteEvent"},
	{Nama = "AmbilData", Kelas = "RemoteFunction"},
}

local folder
if RunService:IsServer() then
	folder = ReplicatedStorage:FindFirstChild(namaFolder)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = namaFolder
		folder.Parent = ReplicatedStorage
	end
	for _, info in ipairs(daftarRemote) do
		if not folder:FindFirstChild(info.Nama) then
			local remote = Instance.new(info.Kelas)
			remote.Name = info.Nama
			remote.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild(namaFolder, 20)
end

for _, info in ipairs(daftarRemote) do
	if folder then
		if RunService:IsServer() then
			Remotes[info.Nama] = folder:FindFirstChild(info.Nama)
		else
			Remotes[info.Nama] = folder:WaitForChild(info.Nama, 20)
		end
	end
end

return Remotes
</ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX1061">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="ModuleScript" referent="RBX1062">
      <Properties>
        <string name="Name">RateLimit</string>
        <ProtectedString name="Source">local RateLimit = {}
local data = {}

function RateLimit.Izinkan(player, kunci, maksPerDetik)
	local id = player.UserId .. ":" .. kunci
	local sekarang = os.clock()
	local entri = data[id]
	if not entri or sekarang - entri.Awal &gt;= 1 then
		data[id] = {Awal = sekarang, Hitung = 1}
		return true
	end
	entri.Hitung += 1
	return entri.Hitung &lt;= maksPerDetik
end

function RateLimit.Bersihkan(player)
	local awalan = tostring(player.UserId) .. ":"
	for id in pairs(data) do
		if string.sub(id, 1, #awalan) == awalan then
			data[id] = nil
		end
	end
end

return RateLimit
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX1063">
      <Properties>
        <string name="Name">DataService</string>
        <ProtectedString name="Source">local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("GameConfig"))
local Remotes = require(ReplicatedStorage:WaitForChild("Remotes"))
local RateLimit = require(script.Parent:WaitForChild("RateLimit"))

local DataService = {}
local store = nil
local dataPemain = {}

pcall(function()
	store = DataStoreService:GetDataStore("DataranData_v1")
end)

local function dataBaru()
	return {Micda = GameConfig.MicdaAwal, Tas = {}}
end

local function kunciItem(jenis, id)
	return jenis .. "_" .. id
end

local function muatData(player)
	if dataPemain[player.UserId] then
		return
	end
	local data = dataBaru()
	if store then
		local ok, hasil = pcall(function()
			return store:GetAsync("P_" .. player.UserId)
		end)
		if ok and type(hasil) == "table" then
			data.Micda = tonumber(hasil.Micda) or data.Micda
			if type(hasil.Tas) == "table" then
				data.Tas = hasil.Tas
			end
		end
	end
	if data.Micda &gt; GameConfig.MicdaMaks then
		data.Micda = GameConfig.MicdaMaks
	end
	dataPemain[player.UserId] = data
	Remotes.InfoDataran:FireClient(player, {Jenis = "Pesan", Teks = "Selamat datang di " .. GameConfig.TempatIni .. "! " .. GameConfig.FormatMicda(data.Micda) .. " Micda sudah terisi di akunmu."})
	DataService.KirimData(player)
end

local function simpanData(player)
	local data = dataPemain[player.UserId]
	if not store or not data then
		return
	end
	pcall(function()
		store:UpdateAsync("P_" .. player.UserId, function()
			return data
		end)
	end)
end

function DataService.Ambil(player)
	return dataPemain[player.UserId]
end

function DataService.KirimData(player)
	local data = dataPemain[player.UserId]
	if data then
		Remotes.InfoDataran:FireClient(player, {Jenis = "Data", Micda = data.Micda, Tas = data.Tas})
	end
end

function DataService.UbahMicda(player, delta)
	local data = dataPemain[player.UserId]
	if not data then
		return false
	end
	local hasil = data.Micda + delta
	if hasil &lt; 0 then
		return false
	end
	if hasil &gt; GameConfig.MicdaMaks then
		hasil = GameConfig.MicdaMaks
	end
	data.Micda = hasil
	return true
end

function DataService.HadiahBicara(player, jumlah)
	if not jumlah or jumlah &lt;= 0 then
		return 0
	end
	if jumlah &gt; GameConfig.HadiahBicaraMaks then
		jumlah = GameConfig.HadiahBicaraMaks
	end
	DataService.UbahMicda(player, jumlah)
	DataService.KirimData(player)
	return jumlah
end

function DataService.TambahItem(player, jenis, id, jumlah)
	local data = dataPemain[player.UserId]
	if not data or jumlah &lt;= 0 then
		return false
	end
	local kunci = kunciItem(jenis, id)
	local slot = data.Tas[kunci]
	if slot then
		if slot.Jumlah + jumlah &gt; GameConfig.IsiPerSlotMaks then
			return false
		end
		slot.Jumlah += jumlah
	else
		if GameConfig.SlotTasTerpakai(data.Tas) &gt;= GameConfig.TasSlotMaks then
			return false
		end
		data.Tas[kunci] = {Jenis = jenis, Id = id, Jumlah = jumlah}
	end
	return true
end

function DataService.KurangiItem(player, jenis, id, jumlah)
	local data = dataPemain[player.UserId]
	if not data or jumlah &lt;= 0 then
		return false
	end
	local kunci = kunciItem(jenis, id)
	local slot = data.Tas[kunci]
	if not slot or slot.Jumlah &lt; jumlah then
		return false
	end
	slot.Jumlah -= jumlah
	if slot.Jumlah &lt;= 0 then
		data.Tas[kunci] = nil
	end
	return true
end

Remotes.AmbilData.OnServerInvoke = function(player)
	if not RateLimit.Izinkan(player, "Data", 3) then
		return nil
	end
	local data = dataPemain[player.UserId]
	if not data then
		return nil
	end
	return {Micda = data.Micda, Tas = data.Tas}
end

Players.PlayerAdded:Connect(muatData)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(muatData, player)
end

Players.PlayerRemoving:Connect(function(player)
	simpanData(player)
	dataPemain[player.UserId] = nil
	RateLimit.Bersihkan(player)
end)

task.spawn(function()
	while true do
		task.wait(120)
		for _, player in ipairs(Players:GetPlayers()) do
			simpanData(player)
		end
	end
end)

game:BindToClose(function()
	for _, player in ipairs(Players:GetPlayers()) do
		simpanData(player)
	end
end)

return DataService
</ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX1064">
      <Properties>
        <string name="Name">GerbangTeleport</string>
        <ProtectedString name="Source">local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("GameConfig"))
local Remotes = require(ReplicatedStorage:WaitForChild("Remotes"))
local RateLimit = require(script.Parent:WaitForChild("RateLimit"))

local cooldown = {}

local function tujuanDari(namaGerbang)
	local target = string.gsub(namaGerbang, "^Gerbang", "")
	if target == GameConfig.TempatIni then
		return nil
	end
	local id = GameConfig.Places[target]
	if id and id ~= GameConfig.Places[GameConfig.TempatIni] then
		return id, target
	end
	return nil
end

task.spawn(function()
	local folderGerbang = workspace:WaitForChild("Gerbang", 60)
	if not folderGerbang then
		return
	end
	for _, gerbang in ipairs(folderGerbang:GetChildren()) do
		local id, nama = tujuanDari(gerbang.Name)
		local papan = gerbang:FindFirstChild("PapanGerbang", true)
		if id and papan then
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "PromptTeleport"
			prompt.ActionText = "Masuk Gerbang"
			prompt.ObjectText = "Menuju " .. nama
			prompt.HoldDuration = 0.5
			prompt.MaxActivationDistance = 18
			prompt.RequiresLineOfSight = false
			prompt.Parent = papan
			prompt.Triggered:Connect(function(player)
				if not RateLimit.Izinkan(player, "Teleport", 2) then
					return
				end
				local sekarang = os.clock()
				if cooldown[player.UserId] and sekarang - cooldown[player.UserId] &lt; 4 then
					return
				end
				cooldown[player.UserId] = sekarang
				Remotes.InfoDataran:FireClient(player, {Jenis = "Pesan", Teks = "Gerbang terbuka... menuju " .. nama .. "!"})
				local ok, err = pcall(function()
					TeleportService:TeleportAsync(id, {player})
				end)
				if not ok then
					Remotes.InfoDataran:FireClient(player, {Jenis = "Pesan", Teks = "Gerbang gagal membuka, coba lagi. (" .. tostring(err) .. ")"})
				end
			end)
		end
	end
end)

TeleportService.TeleportInitFailed:Connect(function(player, _, hasil)
	if player.Parent then
		Remotes.InfoDataran:FireClient(player, {Jenis = "Pesan", Teks = "Teleport gagal (" .. tostring(hasil) .. "), coba masuk gerbang lagi."})
	end
end)

Players.PlayerRemoving:Connect(function(player)
	cooldown[player.UserId] = nil
end)
</ProtectedString>
        <bool name="Disabled">false</bool>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX1065">
      <Properties>
        <string name="Name">TerrainDunia</string>
        <ProtectedString name="Source">local Terrain = workspace:WaitForChild("Terrain")

local DASAR_M = "Ground"
local BUKIT = {{x=-336.7,z=-325.2,r=101,t=5.2,m="Grass"}, {x=-317.8,z=51.9,r=126.5,t=3.9,m="Grass"}, {x=-75.4,z=-343.9,r=91.6,t=5.6,m="Grass"}, {x=234.3,z=420.3,r=117.7,t=5.4,m="Grass"}, {x=84.5,z=-102.6,r=93.9,t=3.2,m="Grass"}, {x=-125.4,z=318.5,r=95.1,t=3,m="Grass"}, {x=239.9,z=-117.7,r=93.2,t=3.2,m="Grass"}, {x=394.1,z=140.7,r=97.5,t=5.9,m="Grass"}}
local TUMPUK = {{x=368.8,z=272.9,sx=44.8,sz=34.2,m="Rock"}, {x=-204.3,z=244,sx=59.8,sz=53,m="Rock"}, {x=251.2,z=259.9,sx=24.7,sz=41.8,m="Rock"}, {x=375.2,z=-128.2,sx=29.5,sz=31.5,m="Rock"}, {x=31.2,z=-51.5,sx=54.2,sz=49.4,m="Rock"}, {x=399.7,z=-311.8,sx=31.7,sz=43,m="Rock"}, {x=-285.2,z=180.9,sx=58.7,sz=28.7,m="Rock"}, {x=367.5,z=-278.9,sx=39.8,sz=45.8,m="Rock"}}
local SUNGAI = {}
local GIGI = {{x=-384.6,z=-520,y=92,d=9.2}, {x=-254.8,z=-518.4,y=92,d=9.5}, {x=-150,z=-518.1,y=92,d=10.7}, {x=-24.8,z=-509.3,y=92,d=13.1}, {x=67.5,z=-515.8,y=92,d=15.7}, {x=155.8,z=-511.7,y=92,d=10.2}, {x=269.6,z=-511.8,y=92,d=9.7}, {x=388.7,z=-518.3,y=92,d=10.6}, {x=-403.6,z=502.7,y=92,d=15.6}, {x=-312.3,z=505.6,y=92,d=15.7}, {x=-174.9,z=513.1,y=92,d=14.5}, {x=-57.2,z=510.5,y=92,d=10.4}, {x=32.5,z=506.1,y=92,d=11.2}, {x=158.8,z=519.8,y=92,d=10.9}, {x=259.8,z=507.4,y=92,d=10.2}, {x=421.5,z=521.1,y=92,d=15.9}, {x=-513,z=-368,y=92,d=13.1}, {x=-515.1,z=-292.9,y=92,d=11.2}, {x=-509.8,z=-169.4,y=92,d=15}, {x=-515.2,z=-31.6,y=92,d=10.3}, {x=-516.6,z=63.4,y=92,d=13.8}, {x=-503.9,z=141.3,y=92,d=13.8}, {x=-511.9,z=299.9,y=92,d=15.6}, {x=-518.5,z=402.4,y=92,d=10.9}, {x=517,z=-376.3,y=92,d=10}, {x=507.9,z=-303.8,y=92,d=16.1}, {x=503.4,z=-161.5,y=92,d=15.6}, {x=519.3,z=-70.2,y=92,d=11.5}, {x=508.6,z=29.8,y=92,d=13.2}, {x=512.7,z=166.2,y=92,d=10}, {x=502.8,z=269.5,y=92,d=17.9}, {x=507.7,z=398.1,y=92,d=10.5}}
local TEPI = {jrk = 496, tbl = 48, tng = 90}
local RIVER = {lbr = 18, pahat = 8}

local function bahan(nama)
	return Enum.Material[nama]
end

local dasar = Region3.new(Vector3.new(-512, -12, -512), Vector3.new(512, -0.001, 512))
Terrain:FillRegion(dasar, 4, bahan(DASAR_M))

for _, b in ipairs(BUKIT) do
	Terrain:FillBall(Vector3.new(b.x, b.t - b.r, b.z), b.r, bahan(b.m))
end

for _, p in ipairs(TUMPUK) do
	Terrain:FillBlock(CFrame.new(Vector3.new(p.x, -2, p.z)), Vector3.new(p.sx, 4, p.sz), bahan(p.m))
end

for i = 1, #SUNGAI - 1 do
	local a = SUNGAI[i]
	local b = SUNGAI[i + 1]
	local ax, az, bx, bz = a.x, a.z, b.x, b.z
	local panj = math.sqrt((bx - ax) ^ 2 + (bz - az) ^ 2)
	if panj &gt; 1 then
		local mid = Vector3.new((ax + bx) / 2, -4, (az + bz) / 2)
		local cf = CFrame.lookAt(mid, Vector3.new(bx, -4, bz))
		Terrain:FillBlock(cf, Vector3.new(RIVER.lbr, 12, panj + 10), bahan("Air"))
		Terrain:FillBlock(cf, Vector3.new(RIVER.lbr, 4, panj + 10), bahan("Ground"))
		Terrain:FillBlock(cf, Vector3.new(RIVER.lbr - 2, 4, panj + 10), bahan("Water"))
	end
end

local j, tb, tg = TEPI.jrk, TEPI.tbl, TEPI.tng
local q = 2 * j + 2 * tb
Terrain:FillBlock(CFrame.new(Vector3.new(0, tg / 2 - 12, -j - tb / 2)), Vector3.new(q, tg + 12, tb), bahan("Rock"))
Terrain:FillBlock(CFrame.new(Vector3.new(0, tg / 2 - 12, j + tb / 2)), Vector3.new(q, tg + 12, tb), bahan("Rock"))
Terrain:FillBlock(CFrame.new(Vector3.new(-j - tb / 2, tg / 2 - 12, 0)), Vector3.new(tb, tg + 12, q), bahan("Rock"))
Terrain:FillBlock(CFrame.new(Vector3.new(j + tb / 2, tg / 2 - 12, 0)), Vector3.new(tb, tg + 12, q), bahan("Rock"))

for _, g in ipairs(GIGI) do
	Terrain:FillBall(Vector3.new(g.x, g.y, g.z), g.d, bahan("Rock"))
end
</ProtectedString>
        <bool name="Disabled">false</bool>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX1066">
      <Properties>
        <string name="Name">InteraksiTempat</string>
        <ProtectedString name="Source">local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("GameConfig"))
local Remotes = require(ReplicatedStorage:WaitForChild("Remotes"))

local function tambahPrompt(induk, aksi, objek)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = aksi
	prompt.ObjectText = objek
	prompt.HoldDuration = 0.3
	prompt.MaxActivationDistance = 16
	prompt.RequiresLineOfSight = false
	prompt.Parent = induk
	return prompt
end

task.spawn(function()
	local folderNPC = workspace:WaitForChild("NPC", 60)
	if not folderNPC then
		return
	end
	for _, npc in ipairs(folderNPC:GetChildren()) do
		local torso = npc:FindFirstChild("Torso")
		local daftar = GameConfig.NPCTeks and GameConfig.NPCTeks[npc.Name]
		if torso and daftar then
			local prompt = tambahPrompt(torso, "Bicara", string.gsub(npc.Name, "NPC_", ""))
			prompt.Triggered:Connect(function(player)
				local teks = daftar[math.random(1, #daftar)]
				Remotes.InfoDataran:FireClient(player, {Jenis = "NPCBicara", NPC = npc.Name, Teks = teks})
			end)
		end
	end
end)

task.spawn(function()
	local folderGerbang = workspace:WaitForChild("Gerbang", 60)
	if not folderGerbang then
		return
	end
	for _, gerbang in ipairs(folderGerbang:GetChildren()) do
		local papan = gerbang:FindFirstChild("PapanGerbang", true)
		if papan then
			local tujuan = string.gsub(gerbang.Name, "^Gerbang", "")
			local prompt = tambahPrompt(papan, "Info Gerbang", "Gerbang " .. tujuan)
			prompt.Triggered:Connect(function(player)
				local teks = "Gerbang menuju " .. tujuan .. ". Dekati papan dan pilih 'Masuk Gerbang' untuk teleport ke kawasan itu."
				if tujuan == GameConfig.TempatIni then
					teks = "Gerbang kembali ke Dataran, pusat seluruh kawasan. Pilih 'Masuk Gerbang' untuk teleport."
				end
				Remotes.InfoDataran:FireClient(player, {Jenis = "Pesan", Teks = teks})
			end)
		end
	end
end)

task.spawn(function()
	local alun = workspace:FindFirstChild("PapanKawasan", true)
	if alun then
		local prompt = tambahPrompt(alun, "Baca", "Papan Informasi")
		prompt.Triggered:Connect(function(player)
			Remotes.InfoDataran:FireClient(player, {Jenis = "Pesan", Teks = GameConfig.PesanKawasan})
		end)
	end
end)
</ProtectedString>
        <bool name="Disabled">false</bool>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterGui" referent="RBX1067">
    <Properties>
      <string name="Name">StarterGui</string>
    </Properties>
    <Item class="LocalScript" referent="RBX1068">
      <Properties>
        <string name="Name">TempatClient</string>
        <ProtectedString name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GuiService = game:GetService("GuiService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

if playerGui:FindFirstChild("MicdaHud") then
	return
end

local GameConfig = require(ReplicatedStorage:WaitForChild("GameConfig"))
local Remotes = require(ReplicatedStorage:WaitForChild("Remotes"))

local keadaan = {Micda = GameConfig.MicdaAwal}

local function buat(kelas, sifat, induk)
	local objek = Instance.new(kelas)
	for kunci, nilai in pairs(sifat) do
		objek[kunci] = nilai
	end
	objek.Parent = induk
	return objek
end

local hud = buat("ScreenGui", {Name = "MicdaHud", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 20}, playerGui)

local pil = buat("TextButton", {
	Name = "PilMicda",
	AnchorPoint = Vector2.new(0, 0),
	Position = UDim2.new(0, 12, 0, 70),
	Size = UDim2.new(0, 220, 0, 44),
	BackgroundColor3 = Color3.fromRGB(24, 26, 22),
	BackgroundTransparency = 0.12,
	BorderSizePixel = 0,
	Text = "",
	AutoButtonColor = false,
}, hud)
buat("UICorner", {CornerRadius = UDim.new(1, 0)}, pil)
buat("UIStroke", {Color = Color3.fromRGB(212, 175, 55), Thickness = 2, Transparency = 0.25}, pil)

local ikon = buat("Frame", {
	Name = "IkonMicda",
	Position = UDim2.new(0, 9, 0.5, -13),
	Size = UDim2.new(0, 26, 0, 26),
	BackgroundColor3 = Color3.fromRGB(246, 198, 62),
	BorderSizePixel = 0,
}, pil)
buat("UICorner", {CornerRadius = UDim.new(1, 0)}, ikon)
buat("UIStroke", {Color = Color3.fromRGB(150, 104, 18), Thickness = 2}, ikon)
buat("TextLabel", {
	Text = "M",
	Size = UDim2.new(1, 0, 1, 0),
	BackgroundTransparency = 1,
	TextColor3 = Color3.fromRGB(126, 86, 10),
	TextScaled = true,
	Font = Enum.Font.GothamBlack,
}, ikon)

buat("TextLabel", {
	Text = "MICDA",
	Position = UDim2.new(0, 44, 0, 6),
	Size = UDim2.new(0, 64, 0, 12),
	BackgroundTransparency = 1,
	TextColor3 = Color3.fromRGB(214, 178, 92),
	TextScaled = true,
	Font = Enum.Font.GothamBold,
	TextXAlignment = Enum.TextXAlignment.Left,
}, pil)

local labelPil = buat("TextLabel", {
	Name = "JumlahMicda",
	Text = "0",
	Position = UDim2.new(0, 44, 0, 18),
	Size = UDim2.new(1, -98, 0, 22),
	BackgroundTransparency = 1,
	TextColor3 = Color3.fromRGB(255, 222, 130),
	TextScaled = true,
	Font = Enum.Font.GothamBlack,
	TextXAlignment = Enum.TextXAlignment.Left,
}, pil)

local labelPenuh = buat("TextLabel", {
	Name = "MicdaPenuh",
	AnchorPoint = Vector2.new(0, 0),
	Position = UDim2.new(0, 0, 1, 6),
	Size = UDim2.new(0, 260, 0, 24),
	BackgroundColor3 = Color3.fromRGB(18, 20, 16),
	BackgroundTransparency = 0.1,
	TextColor3 = Color3.fromRGB(255, 222, 130),
	TextScaled = true,
	Font = Enum.Font.GothamBold,
	BorderSizePixel = 0,
	Visible = false,
}, pil)
buat("UICorner", {CornerRadius = UDim.new(0, 8)}, labelPenuh)
buat("UIStroke", {Color = Color3.fromRGB(212, 175, 55), Thickness = 1}, labelPenuh)

local function aturPosisiHud()
	local inset = GuiService:GetTopbarInsets()
	pil.Position = UDim2.new(0, 12, 0, inset.Top + 8)
end
aturPosisiHud()
GuiService:GetPropertyChangedSignal("TopbarInset"):Connect(aturPosisiHud)

local function perbaruiMicda()
	labelPil.Text = GameConfig.FormatMicda(keadaan.Micda)
end

local tokenPenuh = 0
pil.Activated:Connect(function()
	tokenPenuh += 1
	local token = tokenPenuh
	labelPenuh.Text = GameConfig.FormatAngkaPenuh(keadaan.Micda) .. " Micda"
	labelPenuh.Visible = true
	task.delay(3, function()
		if tokenPenuh == token then
			labelPenuh.Visible = false
		end
	end)
end)

local kotak = buat("Frame", {
	Name = "KotakCerita",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -12),
	Size = UDim2.new(0.72, 0, 0, 86),
	BackgroundColor3 = Color3.fromRGB(20, 23, 18),
	BackgroundTransparency = 0.06,
	BorderSizePixel = 0,
	Visible = false,
}, playerGui)
buat("UICorner", {CornerRadius = UDim.new(0, 12)}, kotak)
buat("UIStroke", {Color = Color3.fromRGB(212, 175, 55), Thickness = 1.5, Transparency = 0.3}, kotak)

local labelSiapa = buat("TextLabel", {
	Name = "Siapa",
	Text = "",
	Position = UDim2.new(0, 14, 0, 8),
	Size = UDim2.new(0.6, 0, 0, 18),
	BackgroundTransparency = 1,
	TextColor3 = Color3.fromRGB(214, 178, 92),
	TextScaled = true,
	Font = Enum.Font.GothamBold,
	TextXAlignment = Enum.TextXAlignment.Left,
}, kotak)

local labelTeks = buat("TextLabel", {
	Name = "Teks",
	Text = "",
	Position = UDim2.new(0, 14, 0, 28),
	Size = UDim2.new(1, -28, 0, 52),
	BackgroundTransparency = 1,
	TextColor3 = Color3.fromRGB(240, 236, 220),
	TextScaled = true,
	Font = Enum.Font.Gotham,
	TextWrapped = true,
	TextXAlignment = Enum.TextXAlignment.Left,
	TextYAlignment = Enum.TextYAlignment.Top,
}, kotak)

local tokenKotak = 0
local function tampilKotak(siapa, teks, lama)
	tokenKotak += 1
	local token = tokenKotak
	labelSiapa.Text = siapa
	labelTeks.Text = teks
	kotak.Visible = true
	task.delay(lama or 6, function()
		if tokenKotak == token then
			kotak.Visible = false
		end
	end)
end

Remotes.InfoDataran.OnClientEvent:Connect(function(paket)
	if type(paket) ~= "table" then
		return
	end
	local jenis = paket.Jenis
	if jenis == "Data" then
		keadaan.Micda = tonumber(paket.Micda) or keadaan.Micda
		perbaruiMicda()
	elseif jenis == "Pesan" then
		tampilKotak(GameConfig.TempatIni, tostring(paket.Teks))
	elseif jenis == "NPCBicara" then
		tampilKotak(string.gsub(tostring(paket.NPC), "NPC_", ""), tostring(paket.Teks), 7)
	end
end)

task.spawn(function()
	local ok, data = pcall(function()
		return Remotes.AmbilData:InvokeServer()
	end)
	if ok and type(data) == "table" then
		keadaan.Micda = tonumber(data.Micda) or keadaan.Micda
		perbaruiMicda()
	end
end)

perbaruiMicda()
</ProtectedString>
        <bool name="Disabled">false</bool>
      </Properties>
    </Item>
  </Item>
</roblox>
