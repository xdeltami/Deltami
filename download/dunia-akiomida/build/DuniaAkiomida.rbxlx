      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">CropConfig</string>
          <string name="Source"><![CDATA[local CropConfig = {}

CropConfig.Rarities = {
	{ id = "common", name = "Common", order = 1, color = { 178, 182, 190 } },
	{ id = "rare", name = "Rare", order = 2, color = { 104, 172, 242 } },
	{ id = "epic", name = "Epic", order = 3, color = { 188, 124, 246 } },
}

CropConfig.Crops = {
	{ id = "wortel", name = "Wortel", rarity = "common", sell = 5, color = { 255, 140, 60 } },
	{ id = "pisang", name = "Pisang", rarity = "common", sell = 5, color = { 255, 216, 80 } },
	{ id = "bayam", name = "Bayam", rarity = "common", sell = 8, color = { 74, 170, 92 } },
	{ id = "kentang", name = "Kentang", rarity = "common", sell = 9, color = { 222, 190, 122 } },
	{ id = "ubi_jalar", name = "Ubi Jalar", rarity = "common", sell = 11, color = { 202, 112, 70 } },
	{ id = "jambu_biji", name = "Jambu Biji", rarity = "common", sell = 13, color = { 152, 202, 112 } },
	{ id = "singkong", name = "Singkong", rarity = "common", sell = 13, color = { 190, 172, 122 } },
	{ id = "tebu", name = "Tebu", rarity = "common", sell = 25, color = { 152, 220, 140 } },
	{ id = "kedelai", name = "Kedelai", rarity = "common", sell = 30, color = { 222, 202, 132 } },
	{ id = "jamur", name = "Jamur", rarity = "common", sell = 30, color = { 212, 192, 172 } },
	{ id = "brokoli", name = "Brokoli", rarity = "common", sell = 38, color = { 72, 152, 82 } },
	{ id = "sorgum", name = "Sorgum", rarity = "common", sell = 88, color = { 192, 142, 82 } },
	{ id = "jeruk_mandarin", name = "Jeruk Mandarin", rarity = "rare", sell = 11, color = { 255, 172, 62 } },
	{ id = "plum", name = "Plum", rarity = "rare", sell = 19, color = { 152, 82, 182 } },
	{ id = "aprikot", name = "Aprikot", rarity = "rare", sell = 20, color = { 250, 152, 92 } },
	{ id = "nektarin", name = "Nektarin", rarity = "rare", sell = 25, color = { 242, 112, 112 } },
	{ id = "brassica_rapa", name = "Brassica Rapa", rarity = "rare", sell = 38, color = { 242, 212, 92 } },
	{ id = "brassica_oleracea", name = "Brassica Oleracea", rarity = "rare", sell = 38, color = { 122, 152, 232 } },
	{ id = "grapefruit", name = "Grapefruit", rarity = "rare", sell = 50, color = { 255, 122, 112 } },
	{ id = "labu_moschata", name = "Labu Cucurbita Moschata", rarity = "rare", sell = 75, color = { 232, 152, 62 } },
	{ id = "labu_maxima", name = "Labu Cucurbita Maxima", rarity = "rare", sell = 88, color = { 212, 102, 52 } },
	{ id = "gandum", name = "Gandum", rarity = "rare", sell = 95, color = { 232, 202, 112 } },
	{ id = "arachis_duranensis", name = "Arachis Duranensis", rarity = "rare", sell = 100, color = { 172, 192, 112 } },
	{ id = "arachis_ipaensis", name = "Arachis Ipaensis", rarity = "rare", sell = 100, color = { 152, 182, 102 } },
	{ id = "rye", name = "Rye", rarity = "rare", sell = 200, color = { 182, 162, 122 } },
	{ id = "ceri", name = "Ceri", rarity = "rare", sell = 438, color = { 222, 52, 72 } },
	{ id = "tangelo", name = "Tangelo", rarity = "epic", sell = 88, color = { 255, 152, 52 } },
	{ id = "plumcot", name = "Plumcot", rarity = "epic", sell = 113, color = { 192, 92, 202 } },
	{ id = "nectaplum", name = "Nectaplum", rarity = "epic", sell = 125, color = { 242, 102, 142 } },
	{ id = "kacang_tanah", name = "Kacang Tanah", rarity = "epic", sell = 150, color = { 202, 172, 112 } },
	{ id = "pluerry", name = "Pluerry", rarity = "epic", sell = 175, color = { 212, 72, 112 } },
	{ id = "canola", name = "Canola", rarity = "epic", sell = 300, color = { 250, 212, 72 } },
	{ id = "triticale", name = "Triticale", rarity = "epic", sell = 338, color = { 222, 192, 132 } },
	{ id = "tetsukabuto", name = "Tetsukabuto", rarity = "epic", sell = 375, color = { 92, 142, 72 } },
}

CropConfig.Recipes = {
	{ out = "tangelo", inputs = { "jeruk_mandarin", "grapefruit" } },
	{ out = "plumcot", inputs = { "plum", "aprikot" } },
	{ out = "nectaplum", inputs = { "nektarin", "plum" } },
	{ out = "kacang_tanah", inputs = { "arachis_duranensis", "arachis_ipaensis" } },
	{ out = "pluerry", inputs = { "ceri", "plum" } },
	{ out = "canola", inputs = { "brassica_rapa", "brassica_oleracea" } },
	{ out = "triticale", inputs = { "gandum", "rye" } },
	{ out = "tetsukabuto", inputs = { "labu_maxima", "labu_moschata" } },
}

CropConfig.Packs = {
	{ id = "common", name = "Pack Common", price = 400, count = 3, rarity = "common" },
	{ id = "rare", name = "Pack Rare", price = 1500, count = 3, rarity = "rare" },
	{ id = "epic", name = "Pack Epic", price = 3500, count = 3, rarity = "epic" },
}

CropConfig.GrowTime = 3
CropConfig.YieldMin = 1
CropConfig.YieldMax = 4

local byId: { [string]: any } = {}
for _, crop in ipairs(CropConfig.Crops) do
	byId[crop.id] = crop
end

function CropConfig.byId(id: string): any?
	return byId[id]
end

function CropConfig.nameOf(id: string): string
	local c = byId[id]
	return c and c.name or id
end

function CropConfig.sellOf(id: string): number
	local c = byId[id]
	return c and c.sell or 0
end

function CropConfig.rarityOf(id: string): string
	local c = byId[id]
	return c and c.rarity or "common"
end

function CropConfig.rarityColor(id: string): { number }
	local r = byId[id] and byId[id].rarity or "common"
	for _, rr in ipairs(CropConfig.Rarities) do
		if rr.id == r then
			return rr.color
		end
	end
	return { 178, 182, 190 }
end

function CropConfig.byRarity(rarity: string): { any }
	local out = {}
	for _, crop in ipairs(CropConfig.Crops) do
		if crop.rarity == rarity then
			table.insert(out, crop)
		end
	end
	return out
end

function CropConfig.packById(id: string): any?
	for _, p in ipairs(CropConfig.Packs) do
		if p.id == id then
			return p
		end
	end
	return nil
end

function CropConfig.findRecipe(idA: string, idB: string): any?
	for _, recipe in ipairs(CropConfig.Recipes) do
		local a, b = recipe.inputs[1], recipe.inputs[2]
		if (a == idA and b == idB) or (a == idB and b == idA) then
			return recipe
		end
	end
	return nil
end

function CropConfig.recipesUsing(id: string): { any }
	local out = {}
	for _, recipe in ipairs(CropConfig.Recipes) do
		if recipe.inputs[1] == id or recipe.inputs[2] == id then
			table.insert(out, recipe)
		end
	end
	return out
end

return CropConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">MathGen</string>
          <string name="Source"><![CDATA[local MathGen = {}

local function shuffledOptions(correct: number, decoys: { number }): ({ string }, number)
        local opts = { tostring(correct) }
        for _, d in decoys do
                if #opts >= 3 then
                        break
                end
                if d ~= correct then
                        table.insert(opts, tostring(d))
                end
        end

        local filler = correct + 1
        while #opts < 3 do
                if filler ~= correct and table.find(opts, tostring(filler)) == nil then
                        table.insert(opts, tostring(filler))
                end
                filler += 1
        end

        for i = #opts, 2, -1 do
                local j = math.random(1, i)
                opts[i], opts[j] = opts[j], opts[i]
        end
        local correctIndex = table.find(opts, tostring(correct)) or 1
        return opts, correctIndex
end

local function question(t: string, correct: number, decoys: { number }, betul: string, salah: string)
        local opsi, benar = shuffledOptions(correct, decoys)
        return { t = t, opsi = opsi, benar = benar, betul = betul, salah = salah }
end

local function near(n: number): { number }

        local out = {}
        local candidates = { n + 1, n - 1, n + 2, n - 2, n + 10, n - 10, n * 2 }
        for _, c in candidates do
                if c >= 0 and c ~= n and table.find(out, c) == nil then
                        table.insert(out, c)
                end
        end
        return out
end

local function kamp(): any
        local pick = math.random(1, 4)
        if pick == 1 then
                local a, b = math.random(2, 9), math.random(2, 9)
                return question(
                        ("Tenda butuh %d tiang. Sudah berdiri %d. Berapa tiang lagi yang harus dipasang?"):format(a + b, a),
                        b,
                        near(b),
                        ("Tepat! Dari %d menuju %d: %d langkah. Satu tiang berdiri!"):format(a, a + b, b),
                        "Hitung maju pelan-pelan dari " .. a .. " sampai " .. (a + b) .. ". Berapa langkah itu?"
                )
        elseif pick == 2 then
                local a, b = math.random(2, 6), math.random(2, 6)
                return question(
                        ("Kayu unggun disusun %d tumpukan, tiap tumpukan berisi %d kayu. Semuanya berapa kayu?"):format(a, b),
                        a * b,
                        near(a * b),
                        ("Benar! %d x %d = %d. Menjumlah berulang seperti ini adalah bibit perkalian!"):format(a, b, a * b),
                        "Coba hitung tumpuk demi tumpuk, tambahkan terus jumlahnya."
                )
        elseif pick == 3 then
                local total = math.random(5, 12)
                local ambil = math.random(1, total - 2)
                return question(
                        (("%d batu dikumpulkan, lalu %d dipakai bikin tungku. Sisa berapa batu?"):format(total, ambil)),
                        total - ambil,
                        near(total - ambil),
                        "Benar! Mengambil dari jumlah itu artinya berkurang.",
                        "Mulai dari " .. total .. ", lalu hitung mundur sebanyak " .. ambil .. "."
                )
        else
                local domba, kandang = math.random(6, 15), math.random(2, 5)
                return question(
                        (("%d domba dibagi rata ke %d kandang. Tiap kandang berisi berapa domba?"):format(domba, kandang)),
                        math.floor(domba / kandang),
                        near(math.floor(domba / kandang)),
                        "Benar! Membagi rata = membagi sama besar ke tiap kelompok.",
                        ("Bayangkan membagikan domba satu per satu bergiliran ke %d kandang."):format(kandang)
                )
        end
end

local function hutan(): any
        local pick = math.random(1, 4)
        if pick == 1 then
                local a, b, c = math.random(2, 6), math.random(2, 6), math.random(2, 6)
                local correct = a + b * c
                return question(
                        ("Berapa hasil dari %d + %d x %d?"):format(a, b, c),
                        correct,
                        { a * b + c, correct + b, correct - a },
                        "Benar! Kali dulu, baru tambah - urutan operasi menyelamatkanmu.",
                        "Ingat aturan hutan: kali dibahas lebih dulu daripada tambah."
                )
        elseif pick == 2 then
                local a = math.random(3, 12)
                local b = math.random(1, a + 4)
                local correct = a - b
                return question(
                        ("Suhu di hutan %d derajat, malamnya turun %d derajat. Suhu sekarang?"):format(a, b),
                        correct,
                        { a + b, math.abs(correct) + 1, correct + 1 },
                        "Benar! Turun dari angka positif bisa mendarat di wilayah negatif.",
                        "Melangkah mundur dari " .. a .. " sebanyak " .. b .. " kali - bisa lewat nol!"
                )
        elseif pick == 3 then
                local a, b = math.random(-9, 9), math.random(-9, 9)
                if a == b then
                        b = b + 1
                end
                local larger = math.max(a, b)
                return question(
                        ("Mana yang LEBIH BESAR: %d atau %d?"):format(a, b),
                        larger,
                        { math.min(a, b), math.abs(a), math.abs(b) },
                        "Benar! Garis bilangan: makin ke kanan makin besar, minus itu di kiri nol.",
                        "Bayangkan garis bilangan: -5 -4 -3 -2 -1 0 1 2 3 ..."
                )
        else
                local a, b = math.random(2, 9), math.random(2, 9)
                local correct = a * b
                return question(
                        ("Simbol misteri: %d ? %d = %d. Simbol ? seharusnya..."):format(a, b, correct),
                        correct,
                        { a + b, correct + a, math.abs(a - b) },
                        "Benar! Tanda itu tanda kali - simbol punya makna, bukan hiasan.",
                        "Periksa: apakah hasilnya jauh lebih besar dari kedua bilangan? Itu petunjuk perkalian."
                )
        end
end

local function gunung(): any
        local pick = math.random(1, 3)
        if pick == 1 then
                local start, step = math.random(1, 9), math.random(2, 7)
                local seq = { start, start + step, start + 2 * step, start + 3 * step }
                local nxt = start + 4 * step
                return question(
                        ("Barisan gunung: %d, %d, %d, %d, ... Berapa angka berikutnya?"):format(seq[1], seq[2], seq[3], seq[4]),
                        nxt,
                        { nxt + step, nxt - 1, seq[4] + 1 },
                        ("Benar! Beda tetap +%d. Pola itu tangganya."):format(step),
                        "Cari selisih dua angka yang berdekatan - selisihnya selalu sama."
                )
        elseif pick == 2 then
                local start = math.random(1, 4)
                local seq = { start, start * 2, start * 4, start * 8 }
                local nxt = start * 16
                return question(
                        ("Jejak di gunung: %d, %d, %d, %d, ... angka berikutnya?"):format(seq[1], seq[2], seq[3], seq[4]),
                        nxt,
                        { start * 12, nxt + 2, seq[4] + 8 },
                        "Benar! Tiap langkah dikali 2 - pola perkalian meledak tingginya!",
                        "Bandingkan tiap angka dengan sebelumnya: berapa kali lipat?"
                )
        else
                local rows = math.random(3, 8)
                local correct = rows * (rows + 1) / 2
                return question(
                        ("Susunan kaki gunung: baris 1 ada 1 batu, baris 2 ada 2 batu, sampai baris %d. Total batu?"):format(rows),
                        correct,
                        near(correct),
                        "Benar! 1+2+...+n = n(n+1)/2 - pola segitiga legendaris.",
                        "Jumlahkan bertahap: 1+2=3, 3+3=6, 6+4=10 ... terus sampai baris " .. rows .. "."
                )
        end
end

local function kota(): any
        local pick = math.random(1, 3)
        if pick == 1 then
                local a = math.random(2, 9)
                local x = math.random(2, 9)
                local b = math.random(1, 9)
                return question(
                        ("Selesaikan: %dx + %d = %d. Berapa x?"):format(a, b, a * x + b),
                        x,
                        { x + 1, x - 1, a + x },
                        "Benar! Pindahkan konstanta, lalu bagi - kasus hukum di Kota Bukti selesai.",
                        "Kurangi kedua ruas dengan " .. b .. " dulu, baru bagi dengan " .. a .. "."
                )
        elseif pick == 2 then
                local a, b = math.random(2, 12), math.random(2, 12)
                local correct = a * a + b
                return question(
                        ("Klaim warga: %d x %d + %d = %d. Benar atau tidak? (pilih nilai yang benar)"):format(a, a, b, correct + 2),
                        correct,
                        { correct + 2, a * a - b, a * 2 + b },
                        "Benar! Hitung sendiri = membuktikan. Itu jiwa Kota Bukti.",
                        "Kuadratkan dulu, lalu tambahkan. Jangan percaya klaim tanpa perhitungan!"
                )
        else
                local n = math.random(4, 12)
                local correct = n * n
                return question(
                        ("Luas pelataran kota berbentuk persegi dengan sisi %d. Berapa luasnya?"):format(n),
                        correct,
                        { 4 * n, n * 2, correct + n },
                        "Benar! Luas persegi = sisi x sisi. Bukti geometris selesai.",
                        "Luas bukan keliling - keliling yang 4 x sisi."
                )
        end
end

local function lembah(): any
        local pick = math.random(1, 3)
        if pick == 1 then
                local base = math.random(2, 6)
                local exp = math.random(2, 3)
                local correct = base ^ exp
                return question(
                        ("Teropong riset memperbesar %d kali tiap lapis. Setelah %d lapis: berapa %d^%d?"):format(base, exp, base, exp),
                        correct,
                        { base * exp, correct + base, correct - base },
                        "Benar! Pangkat = perkalian berulang. Semakin dalam, semakin terpahami.",
                        ("%d dipangkatkan %d artinya %d dikalikan dirinya sendiri %d kali."):format(base, exp, base, exp)
                )
        elseif pick == 2 then
                local x = math.random(1, 8)
                local a, b = math.random(2, 5), math.random(1, 6)
                local correct = a * x + b
                return question(
                        ("Fungsi f(x) = %dx + %d. Berapa f(%d)?"):format(a, b, x),
                        correct,
                        near(correct),
                        ("Benar! Masukkan %d ke x: %d(%d) + %d = %d."):format(x, a, x, b, correct),
                        ("Ganti setiap x dengan %d, lalu hitung sesuai urutan operasi."):format(x)
                )
        else
                local root = math.random(2, 12)
                local square = root * root
                return question(
                        ("Akar dari %d?"):format(square),
                        root,
                        { root + 1, root - 1, root * 2 },
                        ("Benar! %d x %d kembali ke %d. Akar adalah kebalikan kuadrat."):format(root, root, square),
                        "Coba kuadratkan pilihan-pilihannya - mana yang kembali ke " .. square .. "?"
                )
        end
end

local function salju(): any
        local pick = math.random(1, 3)
        if pick == 1 then
                local primes = { 7, 11, 13, 17, 19, 23 }
                local p = primes[math.random(1, #primes)]
                local composites = { 9, 15, 21, 25, 27, 33 }
                local c = composites[math.random(1, #composites)]
                local correct = math.random() < 0.5 and p or c
                local askPrima = correct == p
                return question(
                        "Manakah bilangan PRIMA di antara pilihan berikut?",
                        correct,
                        { askPrima and c or p },
                        "Benar! Prima hanya habis dibagi 1 dan dirinya sendiri.",
                        ("Uji bagi: apakah %d bisa dibagi bilangan lain selain 1 dan dirinya?"):format(askPrima and c or p)
                )
        elseif pick == 2 then
                local a = math.random(10, 40)
                local n = math.random(3, 6)
                local correct = a % n
                return question(
                        ("Sisa pembagian %d mod %d?"):format(a, n),
                        correct,
                        near(correct),
                        "Benar! Modulo = sisa setelah dibagi rata. Jam bergulir juga begitu.",
                        ("%d dibagi %d: kali berapa supaya mendekati, sisanya berapa?"):format(a, n)
                )
        else
                local a = math.random(3, 9)
                local correct = a * (a + 1) / 2 * 2
                return question(
                        ("Jumlah 1 + 2 + ... + %d, lalu dikali 2. Hasilnya?"):format(a),
                        correct,
                        near(correct),
                        "Benar! Rumus Gauss n(n+1)/2 lalu dilipatgandakan - riset dimulai dari tools yang tepat.",
                        ("Hitung 1+2+...+%d = %d(%d+1)/2 dulu, baru kali 2."):format(a, a, a)
                )
        end
end

local GENERATORS = { kamp, hutan, gunung, kota, lembah, salju }

function MathGen.generate(zoneIndex: number): any
        local gen = GENERATORS[math.clamp(zoneIndex, 1, #GENERATORS)]
        return gen()
end

return MathGen
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">TasLogic</string>
          <string name="Source"><![CDATA[local TasLogic = {}

TasLogic.MAX_SLOTS = 50
TasLogic.MAX_STACK = 250

function TasLogic.usedSlots(seeds: { [string]: number }, crops: { [string]: number }): number
	local used = 0
	for _ in pairs(seeds) do
		used += 1
	end
	for _ in pairs(crops) do
		used += 1
	end
	return used
end

function TasLogic.roomFor(seeds: { [string]: number }, crops: { [string]: number }, kind: string, id: string, count: number): number
	if count <= 0 then
		return 0
	end
	local own = 0
	if kind == "seed" then
		own = seeds[id] or 0
	elseif kind == "crop" then
		own = crops[id] or 0
	else
		return 0
	end
	local cap = TasLogic.MAX_STACK - own
	if cap <= 0 then
		return 0
	end
	if own > 0 then
		return math.min(count, cap)
	end
	if TasLogic.usedSlots(seeds, crops) >= TasLogic.MAX_SLOTS then
		return 0
	end
	return math.min(count, cap)
end

function TasLogic.slotView(seeds: { [string]: number }, crops: { [string]: number }): { { kind: string, id: string, n: number } }
	local out = {}
	for id, n in pairs(seeds) do
		table.insert(out, { kind = "seed", id = id, n = n })
	end
	for id, n in pairs(crops) do
		table.insert(out, { kind = "crop", id = id, n = n })
	end
	table.sort(out, function(a, b)
		if a.kind ~= b.kind then
			return a.kind < b.kind
		end
		return a.id < b.id
	end)
	return out
end

function TasLogic.canFitBatch(seeds: { [string]: number }, crops: { [string]: number }, items: { { kind: string, id: string, n: number } }): boolean
	local simS, simC = {}, {}
	for id, n in pairs(seeds) do
		simS[id] = n
	end
	for id, n in pairs(crops) do
		simC[id] = n
	end
	for _, item in ipairs(items) do
		local room = TasLogic.roomFor(simS, simC, item.kind, item.id, item.n)
		if room < item.n then
			return false
		end
		if item.kind == "seed" then
			simS[item.id] = (simS[item.id] or 0) + item.n
		else
			simC[item.id] = (simC[item.id] or 0) + item.n
		end
	end
	return true
end

return TasLogic
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[local Util = {}

local SUFFIXES = { "", "K", "M", "B", "T" }

function Util.formatNumber(n: number): string
        n = math.floor(n)
        if n < 1000 then
                return tostring(n)
        end
        local idx = math.floor(math.log10(n) / 3)
        if idx >= #SUFFIXES then
                idx = #SUFFIXES - 1
        end
        local m = n / (1000 ^ idx)
        local text
        if m >= 100 then
                text = string.format("%.0f", m)
        elseif m >= 10 then
                text = string.format("%.1f", m)
        else
                text = string.format("%.2f", m)
        end
        text = text:gsub("%.?0+$", "")
        return text .. SUFFIXES[idx + 1]
end

function Util.deepCopy<T>(t: T): T
        if type(t) ~= "table" then
                return t
        end
        local out = {}
        for k, v in pairs(t :: any) do
                out[k] = Util.deepCopy(v)
        end
        return out :: any
end

function Util.retry<T>(attempts: number, fn: () -> ...any): (boolean, ...any)
        local ok, a, b, c = false, nil, nil, nil
        for i = 1, attempts do
                ok, a, b, c = pcall(fn)
                if ok then
                        return true, a, b, c
                end
                task.wait(i * 2)
        end
        return false, a
end

function Util.create(className: string, props: { [string]: any }?, parent: Instance?): Instance
        local inst = Instance.new(className)
        if props then
                for k, v in pairs(props) do
                        (inst :: any)[k] = v
                end
        end
        if parent then
                inst.Parent = parent
        end
        return inst
end

function Util.zoneColor(rgb): Color3
        return Color3.fromRGB(rgb[1], rgb[2], rgb[3])
end

function Util.burst(parent: Instance?, color: Color3, count: number, speed: number?, size: number?)
        if not parent or not parent.Parent then
                return
        end
        local e = Instance.new("ParticleEmitter")
        e.Rate = 0
        e.Speed = NumberRange.new((speed or 6) * 0.6, speed or 6)
        e.Lifetime = NumberRange.new(0.3, 0.7)
        e.SpreadAngle = Vector2.new(180, 180)
        e.Color = ColorSequence.new(color)
        e.Size = NumberSequence.new(size or 0.35)
        e.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.2),
                NumberSequenceKeypoint.new(1, 1),
        })
        e.Parent = parent
        e:Emit(math.clamp(math.floor(count or 8), 1, 40))
        task.delay(2, function()
                if e.Parent then
                        e:Destroy()
                end
        end)
end

return Util
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="10">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="11">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Remotes)
local Config = require(ReplicatedStorage.Shared.Config)

Remotes.init()

local Modules = script.Modules
local DataService = require(Modules.DataService)
local FarmService = require(Modules.FarmService)
local GatherService = require(Modules.GatherService)
local KoperasiService = require(Modules.KoperasiService)
local SeedShopService = require(Modules.SeedShopService)
local LeaderboardService = require(Modules.LeaderboardService)
local EquipService = require(Modules.EquipService)
local CraftService = require(Modules.CraftService)
local CombatService = require(Modules.CombatService)
local RegionService = require(Modules.RegionService)
local MapService = require(Modules.MapService)

MapService.init({
	Farm = FarmService,
	Gather = GatherService,
	Craft = CraftService,
})

RegionService.init({
	Data = DataService,
	Farm = FarmService,
	Koperasi = KoperasiService,
})

FarmService.init()
FarmService.startLoop()
GatherService.init()
KoperasiService.init()
SeedShopService.init()
LeaderboardService.init()
EquipService.init()
CraftService.init()
CombatService.init()
CombatService.spawnMonsters()
DataService.startLoops()

local DevCodeVault = require(Modules.DevCodeVault)
Remotes.get("RedeemDevCode").OnServerInvoke = function(player, code)
        if not DataService.has(player) then
                return false, "Data belum siap."
        end
        if type(code) ~= "string" or code ~= DevCodeVault.CODE then
                return false, "Kode salah."
        end
        local data = DataService.get(player)
        if data.Dev then
                return false, "Kode sudah pernah dipakai."
        end
        data.Dev = true
        DataService.markDirty(player)
        DataService.push(player)
        return true, "Status dev aktif. Terima kasih, pemilik dunia!"
end

local function applySpeed(player: Player)
	EquipService.apply(player)
end

local function onPlayerAdded(player: Player)
	local ok = DataService.load(player)
	if not ok then
		DataService.startSession(player)
		warn("[AKIOMIDA] DataStore gagal, sesi memori dipakai untuk " .. player.Name)
		task.delay(5, function()
			if player.Parent then
				Remotes.get("Notify"):FireClient(player, "Mode Sesi",
					"Progres sementara hanya tersimpan di sesi ini. Keluar-masuk lagi nanti untuk simpan permanen.")
			end
		end)
	end

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local Micda = Instance.new("IntValue")
	Micda.Name = "Micda"
	Micda.Value = math.floor(DataService.get(player).Coins)
	Micda.Parent = leaderstats
	local xp = Instance.new("IntValue")
	xp.Name = "XP"
	xp.Value = math.floor(DataService.get(player).XP)
	xp.Parent = leaderstats
	leaderstats.Parent = player

	RegionService.onPlayerAdded(player)

	local today = tonumber(os.date("!%Y%m%d")) or 0
	local data = DataService.get(player)
	if data.LastLoginDay ~= today then
		local yesterday = tonumber(os.date("!%Y%m%d", os.time() - 86400)) or 0
		data.Streak = (data.LastLoginDay == yesterday) and (data.Streak + 1) or 1
		data.LastLoginDay = today
		DataService.markDirty(player)
		local bonus = Config.Economy.DailyBonus + 25 * math.min(data.Streak - 1, 6)
		DataService.addCoins(player, bonus, false)
		Remotes.get("Notify"):FireClient(player, "Bonus Hari " .. data.Streak,
			"+" .. bonus .. " Micda hadiah login! Datang lagi besok.")
	end

	applySpeed(player)
	DataService.push(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

print("[AKIOMIDA] Server v7 siap: ekonomi tani baru, 10 lahan, toko benih, koperasi.")
]]></string>
      </Properties>
      <Item class="Folder" referent="12">
        <Properties>
          <string name="Name">Modules</string>
        </Properties>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = require(ReplicatedStorage.Remotes)
local Balance = require(ReplicatedStorage.Shared.Balance)
local Util = require(ReplicatedStorage.Shared.Util)

local DataService = require(script.Parent.DataService)
local EquipService = require(script.Parent.EquipService)

local CombatService = {}

local monsterFolder: Folder? = nil
local monsters: { [string]: any } = {}
local monsterSeq = 0
local lastAttack: { [Player]: number } = {}
local rng = Random.new(tick() * 1000)

local boss: any = nil
local bossCredits: { [Player]: number } = {}
local bossNextSpawn = 0

local function notify(player: Player, title: string, text: string)
        Remotes.get("Notify"):FireClient(player, title, text)
end

local function statsOf(player: Player)
        return EquipService.statsOf(player)
end

local function isAliveCharacter(player: Player): boolean
        local character = player.Character
        if not character or not character.Parent then
                return false
        end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        return humanoid ~= nil and humanoid.Health > 0 and character.PrimaryPart ~= nil
end

local function part(props): Part
        local p = Instance.new("Part")
        p.Anchored = true
        p.TopSurface = Enum.SurfaceType.Smooth
        p.BottomSurface = Enum.SurfaceType.Smooth
        for k, v in props do
                (p :: any)[k] = v
        end
        p.Parent = monsterFolder
        return p
end

local SEG = {
        a = { horiz = true, x = 0, y = 0.5 },
        g = { horiz = true, x = 0, y = 0 },
        d = { horiz = true, x = 0, y = -0.5 },
        f = { horiz = false, x = -0.5, y = 0.25 },
        b = { horiz = false, x = 0.5, y = 0.25 },
        e = { horiz = false, x = -0.5, y = -0.25 },
        c = { horiz = false, x = 0.5, y = -0.25 },
}

local DIGIT_SEGMENTS: { [string]: string } = {
        ["1"] = "bc", ["2"] = "abged", ["3"] = "abgcd", ["4"] = "fgbc",
        ["5"] = "afgcd", ["6"] = "afgecd", ["7"] = "abc", ["9"] = "abcdfg",
}

local function buildMonsterModel(def: any, position: Vector3, isBoss: boolean): (Model, Part)
        local model = Instance.new("Model")
        model.Name = isBoss and "AngkaRaja" or ("Angka_" .. tostring(def.body.digit or "1"))

        local bodyColor = Color3.fromRGB(def.body.color[1], def.body.color[2], def.body.color[3])
        local auraColor = Color3.fromRGB(def.body.aura[1], def.body.aura[2], def.body.aura[3])
        local size = def.body.size
        local digit = tostring(def.body.digit or "1")

        local H = size
        local W = H * 0.62
        local t = math.max(0.5, H * 0.18)
        local depth = math.max(0.6, t * 0.9)

        local root = part({
                Name = "Badan",
                Size = Vector3.new(W + 2, H + 2, depth + 2),
                CFrame = CFrame.new(position + Vector3.new(0, H / 2, 0)),
                Transparency = 1,
                CanCollide = true,
        })
        root.Parent = model
        model.PrimaryPart = root

        local segs = DIGIT_SEGMENTS[digit] or "bc"
        for i = 1, #segs do
                local s = SEG[string.sub(segs, i, i)]
                local barSize = s.horiz and Vector3.new(W, t, depth) or Vector3.new(t, H / 2, depth)
                local offset = Vector3.new(s.x * W, s.y * H, 0)
                part({
                        Name = "Angka" .. i,
                        Size = barSize,
                        CFrame = root.CFrame * CFrame.new(offset),
                        Color = bodyColor,
                        Material = isBoss and Enum.Material.Neon or Enum.Material.SmoothPlastic,
                        CanCollide = false,
                }).Parent = model
                part({
                        Name = "Aura" .. i,
                        Size = s.horiz and Vector3.new(W + t * 1.2, t * 2.1, depth * 0.8) or Vector3.new(t * 2.1, H / 2 + t * 1.2, depth * 0.8),
                        CFrame = root.CFrame * CFrame.new(offset),
                        Color = auraColor,
                        Material = Enum.Material.Neon,
                        Transparency = 0.68,
                        CanCollide = false,
                }).Parent = model
        end

        local eyeZ = -(depth / 2 + 0.05)
        local eyeSize = math.max(0.35, t * 0.5)
        for side = -1, 1, 2 do
                part({
                        Name = "Mata" .. side,
                        Shape = Enum.PartType.Ball,
                        Size = Vector3.new(1, 1, 1) * eyeSize,
                        CFrame = root.CFrame * CFrame.new(Vector3.new(side * W * 0.18, H * 0.36, eyeZ)),
                        Color = isBoss and Color3.fromRGB(255, 80, 60) or Color3.fromRGB(26, 26, 32),
                        Material = Enum.Material.Neon,
                        CanCollide = false,
                }).Parent = model
        end

        part({
                Name = "CincinAura",
                Shape = Enum.PartType.Cylinder,
                Size = Vector3.new(0.18, W * 2.6, W * 2.6),
                CFrame = CFrame.new(position + Vector3.new(0, 0.12, 0)) * CFrame.Angles(0, 0, math.rad(90)),
                Color = auraColor,
                Material = Enum.Material.Neon,
                Transparency = 0.55,
                CanCollide = false,
        }).Parent = model

        local spark = Instance.new("ParticleEmitter")
        spark.Rate = isBoss and 8 or 3
        spark.Lifetime = NumberRange.new(0.5, 0.9)
        spark.Speed = NumberRange.new(0.6, 1.6)
        spark.Size = NumberSequence.new(0.28)
        spark.Color = ColorSequence.new(auraColor)
        spark.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 1) })
        spark.Enabled = true
        spark.Parent = root

        if isBoss then
                local light = Instance.new("PointLight")
                light.Color = auraColor
                light.Range = 30
                light.Brightness = 1.4
                light.Parent = root
        end

        local prompt = Instance.new("ProximityPrompt")
        prompt.ActionText = "Serang"
        prompt.ObjectText = def.name
        prompt.MaxActivationDistance = 9
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
        prompt.Parent = root

        return model, root
end

local function playSound(root: BasePart, soundName: string, pitch: number?, volume: number?)
        local s = Instance.new("Sound")
        s.SoundId = "rbxasset://sounds/" .. soundName
        s.Volume = volume or 0.5
        s.PlaybackSpeed = pitch or 1
        s.Parent = root
        s:Play()
        task.delay(3, function()
                if s.Parent then
                        s:Destroy()
                end
        end)
end

local function maybeEnrage(entity: any)
        if not entity.isBoss or entity.enraged or not entity.alive then
                return
        end
        if entity.hp > entity.maxHp * (Balance.Boss.enrageAt or 0.5) then
                return
        end
        entity.enraged = true
        local aura = Balance.Boss.enrageAura or { 255, 60, 50 }
        local c = Color3.fromRGB(aura[1], aura[2], aura[3])
        for _, p in entity.model:GetDescendants() do
                if p:IsA("BasePart") and (string.sub(p.Name, 1, 4) == "Aura" or p.Name == "CincinAura") then
                        p.Color = c
                elseif p:IsA("ParticleEmitter") then
                        p.Color = ColorSequence.new(c)
                elseif p:IsA("PointLight") then
                        p.Color = c
                end
        end
        Util.burst(entity.body, c, 24, 12)
        playSound(entity.body, "impact_water.mp3", 0.55, 0.8)
        Remotes.get("BossState"):FireAllClients({
                active = true, name = Balance.Boss.name,
                hp = math.max(1, entity.hp), maxHp = entity.maxHp,
                zone = "Arena", enraged = true,
        })
        for _, player in Players:GetPlayers() do
                notify(player, "MURKA!", Balance.Boss.name .. " mengamuk! Gerak & serangannya menguat - berhati-hatilah!")
        end
end

local function hpBillboard(body: Part, name: string, hp: number, maxHp: number, isBoss: boolean)
        local gui = Instance.new("BillboardGui")
        gui.Name = "HPBar"
        gui.Size = isBoss and UDim2.new(0, 260, 0, 54) or UDim2.new(0, 150, 0, 40)
        gui.StudsOffset = Vector3.new(0, (isBoss and 12 or 7), 0)
        gui.AlwaysOnTop = true
        gui.MaxDistance = 140
        gui.Parent = body

        local nameLabel = Util.create("TextLabel", {
                Size = UDim2.new(1, 0, 0, isBoss and 26 or 18),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBlack,
                TextScaled = true,
                TextColor3 = isBoss and Color3.fromRGB(255, 90, 90) or Color3.fromRGB(255, 230, 160),
                TextStrokeTransparency = 0.4,
                Text = name,
        }, gui)

        local barBg = Util.create("Frame", {
                Position = UDim2.new(0, 8, 0, isBoss and 28 or 20),
                Size = UDim2.new(1, -16, 0, isBoss and 16 or 12),
                BackgroundColor3 = Color3.fromRGB(40, 20, 20),
                BorderSizePixel = 0,
        }, gui)
        Util.create("UICorner", { CornerRadius = UDim.new(0, 6) }, barBg)
        local bar = Util.create("Frame", {
                Size = UDim2.fromScale(1, 1),
                BackgroundColor3 = isBoss and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(90, 220, 120),
                BorderSizePixel = 0,
        }, barBg)
        Util.create("UICorner", { CornerRadius = UDim.new(0, 6) }, bar)

        local hpLabel = Util.create("TextLabel", {
                Position = UDim2.new(0, 0, 0, isBoss and 44 or 32),
                Size = UDim2.new(1, 0, 0, 10),
                BackgroundTransparency = 1,
                Font = Enum.Font.Gotham,
                TextScaled = true,
                TextColor3 = Color3.fromRGB(230, 230, 235),
                Text = hp .. " / " .. maxHp,
        }, gui)

        return { gui = gui, bar = bar, label = hpLabel, name = nameLabel }
end

local function zoneCenter(zoneId: string): Vector3
        for _, zone in ipairs(Balance.Zones) do
                if zone.id == zoneId then
                        return Vector3.new(zone.center[1], zone.center[2], zone.center[3])
                end
        end
        return Vector3.new(0, 0, 0)
end

local function spawnMonster(def: any, zoneId: string, isBoss: boolean?)
        local center = zoneCenter(zoneId)
        local offset = Vector3.new(rng:NextNumber(-1, 1) * 12, 0, rng:NextNumber(-1, 1) * 12)
        local position = center + offset
        local model, body = buildMonsterModel(def, position, isBoss == true)

        local maxHp = def.hp
        local bb = hpBillboard(body, def.name, maxHp, maxHp, isBoss == true)

        local entity = {
                def = def,
                zone = zoneId,
                model = model,
                body = body,
                bb = bb,
                hp = maxHp,
                maxHp = maxHp,
                alive = true,
                home = position,
                target = nil :: Player?,
                lastHit = 0,
                lastMove = 0,
                wanderTo = position,
                isBoss = isBoss == true,
                unique = 0,
        }
        monsterSeq += 1
        entity.unique = monsterSeq

        local prompt = body:FindFirstChildOfClass("ProximityPrompt")
        if prompt then
                prompt.Triggered:Connect(function(player)
                        if entity.alive then
                                task.spawn(CombatService.playerAttack, player, entity)
                        end
                end)
        end

        monsters["m" .. entity.unique] = entity
        return entity
end

local function disablePrompt(p: Part)
        local pr = p:FindFirstChildOfClass("ProximityPrompt")
        if pr then
                pr.Enabled = false
        end
end

local function monsterDie(entity: any, byPlayer: Player?)
        entity.alive = false
        local def = entity.def

        for _, p in entity.model:GetChildren() do
                if p:IsA("BasePart") then
                        p.CanCollide = false
                        disablePrompt(p)
                end
        end
        local model = entity.model
        do

                local root = entity.body
                if root and root.Parent then
                        local burst = Instance.new("ParticleEmitter")
                        burst.Rate = 0
                        burst.Speed = NumberRange.new(8, 14)
                        burst.Lifetime = NumberRange.new(0.4, 0.8)
                        burst.SpreadAngle = Vector2.new(180, 180)
                        local c = Color3.fromRGB(def.body.aura[1], def.body.aura[2], def.body.aura[3])
                        burst.Color = ColorSequence.new(c)
                        burst.Size = NumberSequence.new(0.4)
                        burst.Parent = root
                        burst:Emit(20)
                end
        end
        task.spawn(function()
                for t = 1, 10 do
                        if model.Parent then
                                model:PivotTo(model:GetPivot() - Vector3.new(0, 0.25, 0))
                                for _, p in model:GetDescendants() do
                                        if p:IsA("BasePart") and p.Transparency < 1 then
                                                p.Transparency = math.min(1, t / 8)
                                        end
                                end
                        end
                        task.wait(0.05)
                end
                if entity.model.Parent then
                        entity.model:Destroy()
                end
        end)

        monsters["m" .. entity.unique] = nil

        if entity.isBoss then
                boss = nil
                return
        end

        task.delay(def.respawn, function()
                if monsterFolder and monsterFolder.Parent then
                        spawnMonster(def, entity.zone)
                end
        end)
end

local function damageTag(entity: any, dmg: number, crit: boolean, killed: boolean)
        local root = entity.body
        if not root or not root.Parent then
                return
        end
        local gui = Instance.new("BillboardGui")
        gui.Size = UDim2.new(0, 130, 0, 46)
        gui.StudsOffset = Vector3.new(rng:NextNumber(-1.4, 1.4), rng:NextNumber(3.4, 5.4), 0)
        gui.AlwaysOnTop = true
        gui.MaxDistance = 130
        gui.Parent = root
        local label = Util.create("TextLabel", {
                Size = UDim2.fromScale(1, 1),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBlack,
                TextScaled = true,
                TextColor3 = killed and Color3.fromRGB(255, 120, 90)
                        or (crit and Color3.fromRGB(255, 214, 90) or Color3.fromRGB(255, 255, 255)),
                TextStrokeTransparency = 0.35,
                Text = (crit and "KRITIS -" or "-") .. dmg,
        }, gui)
        playSound(root, "swordslash.wav", crit and 1.15 or 1, 0.45)
        if killed then
                playSound(root, "impact_water.mp3", 0.8, 0.6)
        end
        task.spawn(function()
                for i = 1, 14 do
                        if gui.Parent then
                                gui.StudsOffset += Vector3.new(0, 0.16, 0)
                                label.TextTransparency = i / 14
                                label.TextStrokeTransparency = math.min(1, 0.35 + i / 14)
                        end
                        task.wait(0.05)
                end
                gui:Destroy()
        end)
end

local lastSkill: { [Player]: { [string]: number } } = {}

local function findNearestMonster(player: Player, maxDist: number)
        local root = player.Character and player.Character.PrimaryPart
        if not root then
                return nil
        end
        local best, bestDist = nil, maxDist
        for _, e in monsters do
                if e.alive and e.body.Parent then
                        local d = (e.body.Position - root.Position).Magnitude
                        if d < bestDist then
                                best, bestDist = e, d
                        end
                end
        end
        return best
end

local function hitEntity(player: Player, entity: any, mult: number, stats: any, level: number): number
        local atk = Balance.playerAttack({
                weaponAtk = EquipService.weaponAtk(player),
                str = stats.str,
                dex = stats.dex,
                int = stats.int,
                level = level,
        })
        atk = math.floor(atk * mult)
        if rng:NextNumber() < Balance.critChance(stats.dex) then
                atk = math.floor(atk * Balance.CritMult + 0.5)
        end
        local def = entity.def.def or 0
        local dmg = math.max(1, math.floor(atk * (1 - def / (def + 60)) + 0.5))
        entity.hp -= dmg

        if mult > 1.6 and entity.body.Parent then
                local aura = entity.def.body and entity.def.body.aura
                Util.burst(entity.body, aura and Color3.fromRGB(aura[1], aura[2], aura[3]) or Color3.fromRGB(255, 230, 120), 8, 8)
        end
        maybeEnrage(entity)
        local bb = entity.bb
        bb.bar.Size = UDim2.fromScale(math.clamp(entity.hp / entity.maxHp, 0, 1), 1)
        bb.label.Text = math.max(0, entity.hp) .. " / " .. entity.maxHp
        if entity.isBoss then
                bossCredits[player] = (bossCredits[player] or 0) + dmg
        end
        local killed = entity.hp <= 0
        damageTag(entity, dmg, mult > 1.6, killed)
        if killed then
                CombatService.onKill(player, entity)
                if entity.isBoss then
                        CombatService.finishBoss()
                end
                monsterDie(entity, player)
        else
                entity.target = player
        end
        return dmg
end

function CombatService.useSkill(player: Player, payload: any)
        if not DataService.has(player) or type(payload) ~= "table" then
                return { ok = false, msg = "Tidak valid." }
        end
        if not isAliveCharacter(player) then
                return { ok = false, msg = "Kamu tidak bisa bertarung sekarang." }
        end
        local skill = nil
        for _, s in ipairs(Balance.Skills) do
                if s.id == payload.skillId then
                        skill = s
                        break
                end
        end
        if not skill then
                return { ok = false, msg = "Skill tidak dikenal." }
        end
        if DataService.levelOf(player) < skill.level then
                return { ok = false, msg = "Skill terbuka di level " .. skill.level .. "." }
        end
        if EquipService.weaponAtk(player) <= 0 then
                return { ok = false, msg = skill.name .. " butuh PEDANG - tempa dulu di Pak Tempa!" }
        end
        local now = os.clock()
        lastSkill[player] = lastSkill[player] or {}
        local readyAt = lastSkill[player][skill.id] or 0
        if now < readyAt then
                return { ok = false, msg = skill.name .. " belum siap (" .. math.ceil(readyAt - now) .. "s).", cd = math.ceil(readyAt - now) }
        end
        local stats = statsOf(player)
        local level = DataService.levelOf(player)
        local char = player.Character
        if not char or not char.PrimaryPart then
                return { ok = false, msg = "Karakter belum siap." }
        end

        if skill.aoe then
                local root = char.PrimaryPart
                local hits = 0
                local total = 0
                for _, e in monsters do
                        if e.alive and e.body.Parent and (e.body.Position - root.Position).Magnitude <= 16 then
                                total += hitEntity(player, e, skill.mult, stats, level)
                                hits += 1
                        end
                end
                if hits == 0 then
                        return { ok = false, msg = "Tidak ada angka di sekitarmu." }
                end
                lastSkill[player][skill.id] = now + skill.cooldown
                playSound(char.PrimaryPart, "swordlunge.wav", 1, 0.6)
                DataService.push(player)
                return { ok = true, msg = skill.name .. " menghantam " .. hits .. " angka! Total " .. total .. " damage." }
        end

        local target = findNearestMonster(player, 16)
        if not target then
                return { ok = false, msg = "Tidak ada angka di dekatmu." }
        end
        local dmg = hitEntity(player, target, skill.mult, stats, level)
        lastSkill[player][skill.id] = now + skill.cooldown
        playSound(char.PrimaryPart, "swordlunge.wav", 1.1, 0.55)
        DataService.push(player)
        return { ok = true, msg = skill.name .. "! " .. dmg .. " damage ke " .. target.def.name .. "." }
end

Players.PlayerRemoving:Connect(function(player)
        lastSkill[player] = nil
end)

function CombatService.playerAttack(player: Player, entity: any)
        if not entity or not entity.alive or not DataService.has(player) then
                return { ok = false, msg = "Target tidak valid." }
        end
        if not isAliveCharacter(player) then
                return { ok = false, msg = "Kamu tidak bisa menyerang sekarang." }
        end

        local root = player.Character and player.Character.PrimaryPart
        if not root or (root.Position - entity.body.Position).Magnitude > 14 then
                return { ok = false, msg = "Terlalu jauh!" }
        end

        local now = os.clock()
        local cd = Balance.attackCooldown(statsOf(player).agi)
        if lastAttack[player] and now - lastAttack[player] < cd then
                return { ok = false, msg = "Serangan belum siap." }
        end
        lastAttack[player] = now

        local stats = statsOf(player)
        local level = DataService.levelOf(player)
        local atk = Balance.playerAttack({
                weaponAtk = EquipService.weaponAtk(player),
                str = stats.str,
                dex = stats.dex,
                int = stats.int,
                level = level,
        })
        local crit = rng:NextNumber() < Balance.critChance(stats.dex)
        if crit then
                atk = math.floor(atk * Balance.CritMult + 0.5)
        end

        local def = entity.def.def or 0
        local dmg = math.max(1, math.floor(atk * (1 - def / (def + 60)) + 0.5))

        entity.hp -= dmg
        maybeEnrage(entity)
        local bb = entity.bb
        bb.bar.Size = UDim2.fromScale(math.clamp(entity.hp / entity.maxHp, 0, 1), 1)
        bb.label.Text = math.max(0, entity.hp) .. " / " .. entity.maxHp

        if entity.isBoss then
                bossCredits[player] = (bossCredits[player] or 0) + dmg
        end

        local killed = entity.hp <= 0
        damageTag(entity, dmg, crit, killed)

        do
                local rootPart = entity.body
                if rootPart and rootPart.Parent and not killed then
                        local dir = (rootPart.Position - root.Position)
                        dir = Vector3.new(dir.X, 0, dir.Z)
                        if dir.Magnitude > 0.1 then
                                dir = dir.Unit
                        else
                                dir = root.CFrame.LookVector * -1
                        end
                        local base = rootPart.Position
                        entity.model:PivotTo(CFrame.new(base + dir * 1.1))
                        task.delay(0.12, function()
                                if entity.alive and entity.model.Parent and entity.body.Parent then
                                        entity.model:PivotTo(CFrame.new(base))
                                end
                        end)
                end
        end

        if killed then
                CombatService.onKill(player, entity)
                if entity.isBoss then

                        CombatService.finishBoss()
                end
                monsterDie(entity, player)
        else

                entity.target = player
        end

        DataService.push(player)
        return { ok = true, dmg = dmg, crit = crit, killed = killed, name = entity.def.name }
end

function CombatService.onKill(player: Player, entity: any)
        local def = entity.def

        local xpGain, coinGain = def.xp, rng:NextInteger(def.coin[1], def.coin[2])
        local before = DataService.levelOf(player)
        DataService.addXP(player, xpGain)
        DataService.addCoins(player, coinGain, true)
        if DataService.levelOf(player) > before then
                Remotes.get("Notify"):FireClient(player, "LEVEL NAIK!",
                        "Level " .. DataService.levelOf(player) .. "! Dapat 2 poin stat - bagikan di panel Kar.")
        end

        local dropTexts = {}
        for _, drop in ipairs(def.drops) do
                if rng:NextNumber() <= drop.chance then
                        local n = rng:NextInteger(drop.min, drop.max)
                        DataService.giveItem(player, "bag", drop.id, n)
                        table.insert(dropTexts, "+" .. n .. " " .. drop.id)
                end
        end

        local msg = def.name .. " dikalahkan! +" .. xpGain .. " XP, +" .. coinGain .. " Micda"
        if #dropTexts > 0 then
                msg = msg .. " (" .. table.concat(dropTexts, ", ") .. ")"
        end
        notify(player, "KOMBAT!", msg)

        if entity.isBoss then
                Remotes.get("BossState"):FireAllClients({ active = false, killed = true, name = def.name })
        end
end

local function stepMonster(entity: any, dt: number)
        if not entity.alive or not entity.body.Parent then
                return
        end
        local def = entity.def

        local targetPlayer = entity.target
        if targetPlayer then
                local valid = targetPlayer.Parent ~= nil and isAliveCharacter(targetPlayer)
                if valid then
                        local root = targetPlayer.Character.PrimaryPart
                        local dist = (root.Position - entity.home).Magnitude
                        if dist > def.aggro * 2.2 then
                                valid = false
                        end
                end
                if not valid then
                        entity.target = nil
                end
        end

        if not entity.target then
                for _, player in Players:GetPlayers() do
                        if isAliveCharacter(player) and DataService.has(player) then
                                local root = player.Character.PrimaryPart
                                if (root.Position - entity.body.Position).Magnitude <= def.aggro then
                                        entity.target = player
                                        break
                                end
                        end
                end
        end

        local bodyPos = entity.body.Position
        local goal: Vector3

        local speed = def.speed * (entity.enraged and (Balance.Boss.enrageSpeed or 1) or 1)

        if entity.target then
                local root = entity.target.Character.PrimaryPart
                local dist = (root.Position - bodyPos).Magnitude
                if dist > 5 then
                        goal = root.Position
                else
                        goal = bodyPos
                        local now = os.clock()
                        if now - entity.lastHit >= 1.5 then
                                entity.lastHit = now

                                local pstats = statsOf(entity.target)
                                local defense = Balance.playerDefense(EquipService.armorDef(entity.target), pstats.vit)

                                local rawAtk = def.atk * (entity.enraged and (Balance.Boss.enrageAtk or 1) or 1)
                                local taken = Balance.damageTaken(rawAtk, defense)
                                local humanoid = entity.target.Character:FindFirstChildOfClass("Humanoid")
                                if humanoid then
                                        humanoid:TakeDamage(taken)
                                end
                        end
                end
        else

                if (bodyPos - entity.wanderTo).Magnitude < 3 then
                        entity.wanderTo = entity.home + Vector3.new(rng:NextNumber(-12, 12), 0, rng:NextNumber(-12, 12))
                        return
                end
                goal = entity.wanderTo
                speed = def.speed * 0.45
        end

        local dir = (goal - bodyPos) * Vector3.new(1, 0, 1)
        if dir.Magnitude > 0.4 then
                dir = dir.Unit
                local step = math.min(speed * dt, dir.Magnitude * 99)
                local newPos = bodyPos + dir * step

                                entity.model:PivotTo(CFrame.lookAt(newPos, newPos + dir))
        end
end

RunService.Heartbeat:Connect(function(dt)
        for _, entity in monsters do
                pcall(stepMonster, entity, dt)
        end
end)

function CombatService.startBoss()
        if boss then
                return
        end
        local def = Balance.Boss
        local center = zoneCenter("arena")
        local model, body = buildMonsterModel({ id = def.id, name = def.name, body = def.body }, center + Vector3.new(0, 2, 0), true)
        local maxHp = def.hp
        local bb = hpBillboard(body, def.name, maxHp, maxHp, true)

        boss = {
                def = def,
                zone = "arena",
                model = model,
                body = body,
                bb = bb,
                hp = maxHp,
                maxHp = maxHp,
                alive = true,
                home = center,
                target = nil,
                lastHit = 0,
                wanderTo = center,
                isBoss = true,
                unique = 0,
                spawnedAt = os.clock(),
        }
        monsterSeq += 1
        boss.unique = monsterSeq
        bossCredits = {}

        local prompt = body:FindFirstChildOfClass("ProximityPrompt")
        if prompt then
                prompt.Triggered:Connect(function(player)
                        if boss and boss.alive then
                                task.spawn(CombatService.playerAttack, player, boss)
                        end
                end)
        end
        monsters["m" .. boss.unique] = boss

        Remotes.get("BossState"):FireAllClients({
                active = true, name = def.name, hp = maxHp, maxHp = maxHp,
                zone = "Arena",
        })
        for _, player in Players:GetPlayers() do
                notify(player, "BOSS RAID!", def.name .. " muncul di Arena (Negeri Baja & Kristal)! Serang bersama untuk hadiah besar!")
        end
end

function CombatService.finishBoss()
        if not boss then
                return
        end
        local def = Balance.Boss
        local participants = {}
        local totalDmg = 0
        for player, dmg in bossCredits do
                if player.Parent then
                        table.insert(participants, { player = player, dmg = dmg })
                        totalDmg += dmg
                end
        end
        table.sort(participants, function(a, b)
                return a.dmg > b.dmg
        end)

        for rank, entry in participants do
                local share = entry.dmg / math.max(1, totalDmg)
                local coin = math.floor(def.participationCoin + share * (rng:NextInteger(def.coin[1], def.coin[2])))
                local xp = math.max(def.participationXp, math.floor(def.xp * share))
                DataService.addCoins(entry.player, coin, true)
                DataService.addXP(entry.player, xp)
                local extra = ""
                if rank == 1 then
                        DataService.addCoins(entry.player, def.topBonusCoin, true)
                        for _, drop in ipairs(def.drops) do
                                local n = rng:NextInteger(drop.min, drop.max)
                                DataService.giveItem(entry.player, "bag", drop.id, n)
                                extra = extra .. " +" .. n .. " " .. drop.id
                        end
                end
                notify(entry.player, "BOSS DIKALAHKAN!", rank == 1 and ("KAU PENYERANG TERAKHIR/TERBESAR! +" .. coin .. " Micda" .. extra)
                        or ("Kontribusi " .. math.floor(share * 100) .. "% - +" .. coin .. " Micda, +" .. xp .. " XP"))
                DataService.push(entry.player)
        end
        bossCredits = {}
end

local function bossLoop()
        while true do
                task.wait(5)
                local now = os.clock()
                if not boss and now >= bossNextSpawn then
                        CombatService.startBoss()
                end
                if boss and boss.alive then

                        if now - boss.spawnedAt > Balance.Boss.despawn then
                                bossCredits = {}
                                monsterDie(boss)
                                boss = nil
                                Remotes.get("BossState"):FireAllClients({ active = false, name = Balance.Boss.name })
                                Remotes.get("Notify"):FireAllClients("Boss Pergi", "Angka Sang Raja kembali ke tanah. Hati-hati, ia akan bangkit lagi!")
                        else
                                Remotes.get("BossState"):FireAllClients({
                                        active = true, name = Balance.Boss.name,
                                        hp = math.max(0, boss.hp), maxHp = boss.maxHp,
                                        zone = "Arena", enraged = boss.enraged == true,
                                })
                        end
                end
                if not boss then
                        bossNextSpawn = math.max(bossNextSpawn, now + Balance.Boss.respawn)
                end
        end
end

function CombatService.spawnMonsters()
        for _, zone in ipairs(Balance.Zones) do
                for _, spec in ipairs(zone.monsters) do
                        local def = nil
                        for _, m in ipairs(Balance.Monsters) do
                                if m.id == spec.id then
                                        def = m
                                        break
                                end
                        end
                        if def then
                                for _ = 1, spec.count do
                                        spawnMonster(def, zone.id)
                                end
                        end
                end
        end
        print("[AKIOMIDA] Monster dikerahkan di " .. #Balance.Zones .. " zona (semua di pulau monster terpisah).")
end

function CombatService.init()
        local newFolder = Instance.new("Folder")
        newFolder.Name = "AKM_Monster"
        newFolder.Parent = workspace
        monsterFolder = newFolder

        Remotes.get("Attack").OnServerInvoke = function(player, monsterId)
                if type(monsterId) ~= "string" then
                        return { ok = false, msg = "Tidak valid." }
                end
                local entity = monsters[monsterId] or boss
                if not entity or not entity.alive or ("m" .. entity.unique) ~= monsterId then
                        return { ok = false, msg = "Target tidak ada." }
                end
                return CombatService.playerAttack(player, entity)
        end

        Players.PlayerRemoving:Connect(function(player)
                lastAttack[player] = nil
                bossCredits[player] = nil
        end)

        bossNextSpawn = os.clock() + 360
        task.spawn(bossLoop)
end

return CombatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">CraftService</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Remotes)
local Balance = require(ReplicatedStorage.Shared.Balance)
local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)

local CropConfig = require(ReplicatedStorage.Shared.CropConfig)
local DataService = require(script.Parent.DataService)

local MAT_KIND_ORDER = { "bag", "crop", "fish" }

local function matKindOf(player: Player, id: string): string
	for _, kind in ipairs(MAT_KIND_ORDER) do
		if DataService.countItem(player, kind, id) > 0 then
			return kind
		end
	end
	return "bag"
end

local CraftService = {}

local STATION_TITLES = {
        tempa = "Pandai Besi - Pak Tempa",
        dapur = "Dapur Alam - Bu Masak",
}

local function nameOf(kind: string, id: string): string
        if kind == "equip" then
                for _, eq in ipairs(Balance.Equipment) do
                        if eq.id == id then
                                return eq.name
                        end
                end
        elseif kind == "use" then
                for _, u in ipairs(Balance.Usables) do
                        if u.id == id then
                                return u.name
                        end
                end
        else
                for _, res in ipairs(Config.Resources) do
                        if res.id == id then
                                return res.name
                        end
                end
                for _, crop in ipairs(CropConfig.Crops) do
                        if crop.id == id then
                                return crop.name
                        end
                end
                for _, fish in ipairs(Config.Fish) do
                        if fish.id == id then
                                return fish.name
                        end
                end
        end
        return id
end

local function recipeLabel(r: any): string
        local parts = {}
        for matId, count in pairs(r.recipe) do
                table.insert(parts, count .. "x " .. nameOf("bag", matId))
        end
        table.sort(parts)
        return table.concat(parts, " + ")
end

local recipeLabels: { [string]: string } = {}
for _, r in ipairs(Balance.Recipes) do
        recipeLabels[r.id] = recipeLabel(r)
end

local function onCraft(player: Player, recipeId: any)
        if not DataService.has(player) or type(recipeId) ~= "string" then
                return { ok = false, msg = "Permintaan tidak valid." }
        end
        local recipe = nil
        for _, r in ipairs(Balance.Recipes) do
                if r.id == recipeId then
                        recipe = r
                        break
                end
        end
        if not recipe then
                return { ok = false, msg = "Resep tidak dikenal." }
        end
        if DataService.levelOf(player) < recipe.level then
                return { ok = false, msg = "Butuh level " .. recipe.level .. " untuk resep ini." }
        end
        for matId, count in pairs(recipe.recipe) do
                if DataService.countItem(player, matKindOf(player, matId), matId) < count then
                        return { ok = false, msg = "Bahan kurang: " .. nameOf("bag", matId) .. " x" .. count }
                end
        end
        local data = DataService.get(player)
        for matId, count in pairs(recipe.recipe) do
                DataService.takeItem(player, matKindOf(player, matId), matId, count)
        end
        DataService.giveItem(player, recipe.kind, recipe.out, recipe.count)

        local prevCount = (data.CraftCount and data.CraftCount[recipe.id]) or 0
        data.CraftCount[recipe.id] = prevCount + 1
        local gainedXp = Balance.craftXpWithMastery(recipe.xp, prevCount + 1)
        DataService.addXP(player, gainedXp)
        local masteryLevel = Balance.craftMasteryLevel(prevCount + 1)
        if masteryLevel > Balance.craftMasteryLevel(prevCount) then
                Remotes.get("Notify"):FireClient(player, "MASTERY NAIK!",
                        nameOf(recipe.kind, recipe.out) .. " mastery " .. masteryLevel .. " - XP craft +" .. math.floor((Balance.CraftMasteryXpMult - 1) * math.min(masteryLevel, 3) * 100) .. "%!")
        end

        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root then
                local sparkColor = recipe.station == "tempa"
                        and Color3.fromRGB(255, 170, 90)
                        or Color3.fromRGB(250, 140, 150)
                Util.burst(root, sparkColor, 12, 7)
        end

        DataService.push(player)
        return {
                ok = true,
                msg = recipe.count .. "x " .. nameOf(recipe.kind, recipe.out) .. " selesai! (+" .. gainedXp .. " XP"
                        .. (masteryLevel > 0 and ("  M" .. masteryLevel) or "") .. ")",
        }
end

function CraftService.bindStation(prompt: ProximityPrompt, station: string)
        prompt.ActionText = "Buat"
        prompt.ObjectText = STATION_TITLES[station] or "Stasiun"
        prompt.MaxActivationDistance = 11
        prompt.HoldDuration = 0
        prompt.Triggered:Connect(function(player)
                if DataService.has(player) then
                        Remotes.get("OpenCraft"):FireClient(player, station)
                end
        end)
end

function CraftService.recipesFor(station: string)
        local out = {}
        for _, r in ipairs(Balance.Recipes) do
                if r.station == station then
                        table.insert(out, {
                                id = r.id,
                                out = r.out,
                                kind = r.kind,
                                name = nameOf(r.kind, r.out),
                                label = recipeLabels[r.id],
                                level = r.level,
                                xp = r.xp,
                                count = r.count,
                        })
                end
        end
        table.sort(out, function(a, b)
                return a.level < b.level
        end)
        return out
end

function CraftService.init()
        Remotes.get("Craft").OnServerInvoke = onCraft
        DataService.registerProvider("recipes", function()
                return {
                        tempa = CraftService.recipesFor("tempa"),
                        dapur = CraftService.recipesFor("dapur"),
                }
        end)
end

return CraftService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Balance = require(ReplicatedStorage.Shared.Balance)
local Util = require(ReplicatedStorage.Shared.Util)
local TasLogic = require(ReplicatedStorage.Shared.TasLogic)
local Remotes = require(ReplicatedStorage.Remotes)

local DataService = {}

local store = DataStoreService:GetDataStore(Config.Data.StoreName)

local sessions: { [Player]: { data: { [string]: any }, dirty: boolean, fallback: boolean } } = {}

local providers: { [string]: (Player) -> any } = {}

function DataService.registerProvider(name: string, fn: (Player) -> any)
        providers[name] = fn
end

local KIND_FIELD = {
        seed = "Seeds",
        crop = "Crops",
        bag = "Bag",
        fish = "Fish",
        equip = "Equips",
        use = "Usables",
}

function DataService.kindField(kind: string): string?
        return KIND_FIELD[kind]
end

local function defaultData(): { [string]: any }
        return {
                Coins = Config.Economy.StartCoins,
                XP = 0,
                Seeds = {},
                Crops = {},
                Bag = {},
                Fish = {},
                Stats = { str = 0, vit = 0, agi = 0, int = 0, dex = 0 },
                StatPoints = 0,
                Equips = {},
                EquipStars = {},
                CraftCount = {},
                Usables = {},
                Equipped = { weapon = "", armor = "" },
                Buff = { kind = "", expiry = 0 },
                TotalEarned = 0,
                LastLoginDay = 0,
                Streak = 0,
                HomeId = 0,
                LandName = "",
                KoperasiName = "",
                Dev = false,
                LastSeen = 0,
        }
end

local function sanitizeCount(v: any): number
        return math.max(0, math.floor(tonumber(v) or 0))
end

local function sanitize(raw: any): { [string]: any }
        local out = defaultData()
        if type(raw) ~= "table" then
                return out
        end
        out.Coins = sanitizeCount(raw.Coins)
        out.XP = sanitizeCount(raw.XP)
        out.Streak = math.clamp(math.floor(tonumber(raw.Streak) or 0), 0, 999)
        for kind, field in KIND_FIELD do
                if type(raw[field]) == "table" then
                        out[field] = {}
                        for id, count in raw[field] do
                                if type(id) == "string" then
                                        out[field][id] = sanitizeCount(count)
                                end
                        end
                end
        end
        if type(raw.CraftCount) == "table" then
                for id, n in raw.CraftCount do
                        if type(id) == "string" then
                                out.CraftCount[id] = math.clamp(math.floor(tonumber(n) or 0), 0, 9999)
                        end
                end
        end
        if type(raw.EquipStars) == "table" then
                for id, star in raw.EquipStars do
                        if type(id) == "string" then
                                out.EquipStars[id] = math.clamp(math.floor(tonumber(star) or 0), 0, 5)
                        end
                end
        end

        if type(raw.Stats) == "table" then
                for _, key in { "str", "vit", "agi", "int", "dex" } do
                        out.Stats[key] = math.clamp(math.floor(tonumber(raw.Stats[key]) or 0), 0, 60)
                end
        end
        out.StatPoints = math.clamp(math.floor(tonumber(raw.StatPoints) or 0), 0, 400)
        if type(raw.Equipped) == "table" then
                out.Equipped.weapon = type(raw.Equipped.weapon) == "string" and raw.Equipped.weapon or ""
                out.Equipped.armor = type(raw.Equipped.armor) == "string" and raw.Equipped.armor or ""
        end
        if type(raw.Buff) == "table" then
                out.Buff.kind = type(raw.Buff.kind) == "string" and raw.Buff.kind or ""
                out.Buff.expiry = math.floor(tonumber(raw.Buff.expiry) or 0)
        end
        out.TotalEarned = sanitizeCount(raw.TotalEarned)
        out.LastLoginDay = sanitizeCount(raw.LastLoginDay)

        out.HomeId = math.clamp(math.floor(tonumber(raw.HomeId) or 0), 0, Balance.HOME_COUNT)
        out.LandName = type(raw.LandName) == "string" and string.sub(raw.LandName, 1, 24) or ""
        out.KoperasiName = type(raw.KoperasiName) == "string" and string.sub(raw.KoperasiName, 1, 24) or ""
        out.Dev = raw.Dev == true
        out.LastSeen = tonumber(raw.LastSeen) or 0
        return out
end

function DataService.get(player: Player): { [string]: any }
        local s = sessions[player]
        return s and s.data or defaultData()
end

function DataService.has(player: Player): boolean
        return sessions[player] ~= nil
end

function DataService.markDirty(player: Player)
        local s = sessions[player]
        if s then
                s.dirty = true
        end
end

function DataService.levelOf(player: Player): number
        return Config.Level.levelFromXp(DataService.get(player).XP)
end

function DataService.getHomeId(player: Player): number
        return math.floor(DataService.get(player).HomeId or 0)
end

function DataService.setHomeId(player: Player, index: number)
        local data = DataService.get(player)
        data.HomeId = math.clamp(math.floor(index or 0), 0, Balance.HOME_COUNT)
        DataService.markDirty(player)
        DataService.push(player)
end

function DataService.getLandName(player: Player): string
        return DataService.get(player).LandName or ""
end

function DataService.setLandName(player: Player, name: string)
        DataService.get(player).LandName = string.sub(name, 1, 24)
        DataService.markDirty(player)
        DataService.push(player)
end

function DataService.getKoperasiName(player: Player): string
        return DataService.get(player).KoperasiName or ""
end

function DataService.ensureKoperasiName(player: Player): string
        local data = DataService.get(player)
        if data.KoperasiName == "" or data.KoperasiName == nil then
                data.KoperasiName = Balance.koperasiName()
                DataService.markDirty(player)
        end
        return data.KoperasiName
end

function DataService.addCoins(player: Player, amount: number, countAsEarned: boolean?)
        local data = DataService.get(player)
        data.Coins = math.max(0, math.floor(data.Coins + amount))
        if countAsEarned and amount > 0 then
                data.TotalEarned += math.floor(amount)
        end
        DataService.markDirty(player)
end

function DataService.spend(player: Player, amount: number): boolean
        local data = DataService.get(player)
        if data.Coins < amount then
                return false
        end
        data.Coins -= amount
        DataService.markDirty(player)
        return true
end

function DataService.addXP(player: Player, amount: number)
        local data = DataService.get(player)
        local before = Config.Level.levelFromXp(data.XP)
        data.XP = math.max(0, math.floor(data.XP + amount))
        local after = Config.Level.levelFromXp(data.XP)
        if after > before then

                data.StatPoints += (after - before) * Config.Level.StatPointsPerLevel
        end
        DataService.markDirty(player)
end

function DataService.giveItem(player: Player, kind: string, id: string, count: number)
        local field = KIND_FIELD[kind]
        if not field then
                return
        end
        local data = DataService.get(player)
        data[field][id] = (data[field][id] or 0) + count
        if data[field][id] <= 0 then
                data[field][id] = nil
        end
        DataService.markDirty(player)
end

function DataService.takeItem(player: Player, kind: string, id: string, count: number): boolean
        local field = KIND_FIELD[kind]
        if not field then
                return false
        end
        local data = DataService.get(player)
        local have = data[field][id] or 0
        if have < count then
                return false
        end
        data[field][id] = have - count
        if data[field][id] <= 0 then
                data[field][id] = nil
        end
        DataService.markDirty(player)
        return true
end

function DataService.countItem(player: Player, kind: string, id: string): number
        local field = KIND_FIELD[kind]
        if not field then
                return 0
        end
        local data = DataService.get(player)
        return data[field][id] or 0
end

function DataService.tasTables(player: Player): ({ [string]: number }, { [string]: number })
        local data = DataService.get(player)
        return data.Seeds, data.Crops
end

function DataService.addWithCap(player: Player, kind: string, id: string, count: number): number
        local field = KIND_FIELD[kind]
        if not field then
                return 0
        end
        local seeds, crops = DataService.tasTables(player)
        local room = TasLogic.roomFor(seeds, crops, kind, id, count)
        if room > 0 then
                local data = DataService.get(player)
                data[field][id] = (data[field][id] or 0) + room
                DataService.markDirty(player)
        end
        return room
end

function DataService.push(player: Player)
        if not DataService.has(player) then
                return
        end
        local data = DataService.get(player)

        local stats = player:FindFirstChild("leaderstats")
        if stats then
                local Micda = stats:FindFirstChild("Micda")
                if Micda and Micda:IsA("IntValue") then
                        Micda.Value = math.floor(data.Coins)
                end
                local xp = stats:FindFirstChild("XP")
                if xp and xp:IsA("IntValue") then
                        xp.Value = math.floor(data.XP)
                end
        end

        local okPlot, plotState = pcall(function()
                local fn = providers["farm"]
                if not fn then
                        return { lahan = 0 }
                end
                return fn(player)
        end)

        local level = Config.Level.levelFromXp(data.XP)
        local prev = Config.Level.thresholdOf(level)
        local next = Config.Level.thresholdOf(level + 1)
        local pct = (data.XP - prev) / math.max(1, next - prev)

        Remotes.get("StateSync"):FireClient(player, {
                Coins = math.floor(data.Coins),
                XP = math.floor(data.XP),
                Level = level,
                LevelPct = math.clamp(pct, 0, 1),
                Seeds = Util.deepCopy(data.Seeds),
                Crops = Util.deepCopy(data.Crops),
                Bag = Util.deepCopy(data.Bag),
                Fish = Util.deepCopy(data.Fish),
                Stats = Util.deepCopy(data.Stats),
                StatPoints = data.StatPoints,
                Equips = Util.deepCopy(data.Equips),
                EquipStars = Util.deepCopy(data.EquipStars),
                CraftCount = Util.deepCopy(data.CraftCount),
                Usables = Util.deepCopy(data.Usables),
                Equipped = Util.deepCopy(data.Equipped),
                Buff = Util.deepCopy(data.Buff),
                Farm = okPlot and plotState or { lahan = 0 },
                Dev = data.Dev,
                Streak = data.Streak,
                HomeId = data.HomeId,
                LandName = data.LandName,
                KoperasiName = data.KoperasiName,
        })
end

function DataService.load(player: Player): boolean
        local key = "p_" .. player.UserId
        local ok, raw = Util.retry(Config.Data.LoadRetries, function()
                return store:GetAsync(key)
        end)
        if not ok then
                return false
        end
        sessions[player] = { data = sanitize(raw), dirty = false, fallback = false }
        return true
end

function DataService.startSession(player: Player)
        if sessions[player] then
                return
        end
        sessions[player] = { data = defaultData(), dirty = false, fallback = true }
end

function DataService.save(player: Player): boolean
        local s = sessions[player]
        if not s then
                return false
        end
        if s.fallback then
                return false
        end
        s.data.LastSeen = os.time()
        local ok = Util.retry(Config.Data.LoadRetries, function()
                store:SetAsync("p_" .. player.UserId, s.data)
        end)
        if ok then
                s.dirty = false
        end
        return ok
end

function DataService.startLoops()
        task.spawn(function()
                while true do
                        task.wait(Config.Data.AutosaveInterval)
                        for player, s in sessions do
                                if s.dirty then
                                        task.spawn(DataService.save, player)
                                end
                        end
                end
        end)

        task.spawn(function()
                while true do
                        task.wait(15)
                        for player in sessions do
                                task.spawn(DataService.push, player)
                        end
                end
        end)

        Players.PlayerRemoving:Connect(function(player)
                DataService.save(player)
                sessions[player] = nil
        end)

        game:BindToClose(function()
                for player in sessions do
                        DataService.save(player)
                end
        end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">DevCodeVault</string>
