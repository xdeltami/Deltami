        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">GateService</string>
            <string name="Source"><![CDATA[local TeleportService = game:GetService("TeleportService")

local PlaceConfig = require(script.Parent.PlaceConfig)

local GateService = {}

local Land, Notify
local zoneOf: { [number]: string } = {}

function GateService.bind(deps)
        Land = deps.Land
        Notify = deps.Notify
end

function GateService.zoneOf(player): string
        return zoneOf[player.UserId] or "lahan"
end

function GateService.setZone(player, zone: string)
        zoneOf[player.UserId] = zone
end

function GateService.clear(player)
        zoneOf[player.UserId] = nil
end

local function destinationSpawn(target: string, player): (Vector3, SpawnLocation?)
        if target == "kota" then
                local sp = Land.kotaSpawn()
                if sp then
                        return sp.Position + Vector3.new(0, 4, 0), sp
                end
                return Vector3.new(0, 6, 0), nil
        end
        local index = Land.landOf(player)
        if index then
                local sp = Land.spawnOf(index)
                if sp then
                        return sp.Position + Vector3.new(0, 4, 0), sp
                end
        end
        local umum = Land.umumSpawn()
        if umum then
                return umum.Position + Vector3.new(0, 4, 0), umum
        end
        return Vector3.new(0, 6, 0), nil
end

function GateService.travel(player: Player, target: string)
        if target == "kota" and PlaceConfig.useTeleport() then
                TeleportService:TeleportAsync(PlaceConfig.KotaPlaceId, { player })
                return
        end
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
        if not root then
                return
        end
        local pos, sp = destinationSpawn(target, player)
        GateService.setZone(player, target)
        if sp then
                player.RespawnLocation = sp
        end
        root.CFrame = CFrame.new(pos)
        if target == "kota" then
                Notify(player, "Pusat Kota", "Selamat datang di Pusat Kota. Gerbang di dekatmu kembali ke lahan.")
        else
                Notify(player, "Lahan", "Kamu kembali di lahanku.")
        end
end

function GateService.attach(framePart: BasePart, target: string, label: string)
        local prompt = Instance.new("ProximityPrompt")
        prompt.ActionText = label
        prompt.ObjectText = "Gerbang"
        prompt.HoldDuration = 0.4
        prompt.MaxActivationDistance = 14
        prompt.RequiresLineOfSight = false
        prompt.Parent = framePart
        prompt.Triggered:Connect(function(player)
                GateService.travel(player, target)
        end)
end

return GateService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">LandService</string>
            <string name="Source"><![CDATA[local Layout = require(game:GetService("ReplicatedStorage").Shared.Layout)

local LandService = {}

local ownerOf: { [number]: number } = {}
local landOf: { [number]: number } = {}
local spawnOf: { [number]: SpawnLocation } = {}
local umumSpawn: SpawnLocation? = nil
local kotaSpawn: SpawnLocation? = nil

function LandService.registerSpawn(index: number, spawn: SpawnLocation)
	spawnOf[index] = spawn
end

function LandService.registerUmum(spawn: SpawnLocation)
	umumSpawn = spawn
end

function LandService.registerKota(spawn: SpawnLocation)
	kotaSpawn = spawn
end

function LandService.origin(index: number): Vector3
	local x, z = Layout.cellOrigin(index)
	return Vector3.new(x, 0, z)
end

function LandService.ownerOf(index: number): number?
	return ownerOf[index]
end

function LandService.landOf(player): number?
	return landOf[player.UserId]
end

function LandService.spawnOf(index: number): SpawnLocation?
	return spawnOf[index]
end

function LandService.umumSpawn(): SpawnLocation?
	return umumSpawn
end

function LandService.kotaSpawn(): SpawnLocation?
	return kotaSpawn
end

function LandService.assign(player): number
	for i = 1, Layout.LahanCount do
		if not ownerOf[i] then
			ownerOf[i] = player.UserId
			landOf[player.UserId] = i
			return i
		end
	end
	return 0
end

function LandService.release(player): number
	local idx = landOf[player.UserId]
	if idx and ownerOf[idx] == player.UserId then
		ownerOf[idx] = nil
		landOf[player.UserId] = nil
	end
	return idx or 0
end

function LandService.isInside(index: number, position: Vector3, margin: number): boolean
	local o = LandService.origin(index)
	local p = position - o
	return p.X >= -margin and p.X <= Layout.SizeX + margin and p.Z >= -margin and p.Z <= Layout.SizeZ + margin
end

return LandService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">PlaceConfig</string>
            <string name="Source"><![CDATA[local PlaceConfig = {}

PlaceConfig.LahanPlaceId = 77626159664192
PlaceConfig.KotaPlaceId = 0

function PlaceConfig.currentPlaceId(): number
	local ok, id = pcall(function()
		return game.PlaceId
	end)
	if ok then
		return id
	end
	return 0
end

function PlaceConfig.useTeleport(): boolean
	local id = PlaceConfig.currentPlaceId()
	return PlaceConfig.KotaPlaceId > 0 and PlaceConfig.KotaPlaceId ~= id
end

return PlaceConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">PlotService</string>
            <string name="Source"><![CDATA[local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CropData = require(ReplicatedStorage.Shared.CropData)
local Layout = require(ReplicatedStorage.Shared.Layout)

local PlotService = {}

local Land, Tas, Net
local rng = Random.new()

local folders: { [number]: Folder } = {}
local planted: { [number]: { [number]: any } } = {}
local running: { [number]: boolean } = {}

local RARITY_COLOR = {
        common = Color3.fromRGB(76, 145, 65),
        rare = Color3.fromRGB(58, 112, 200),
        epic = Color3.fromRGB(150, 80, 205),
}

function PlotService.bind(deps)
        Land = deps.Land
        Tas = deps.Tas
        Net = deps.Net
end

local function plotPos(index: number, idx: number): Vector3
        local o = Land.origin(index)
        local x, z = Layout.plotLocal(idx)
        return Vector3.new(o.X + x, 1.4, o.Z + z)
end

local function now(): number
        return Workspace:GetServerTimeNow()
end

local function sync(player: Player, index: number, idx: number)
        local rec = planted[index] and planted[index][idx]
        local st = "kosong"
        local crop, readyAt
        if rec then
                crop = rec.crop
                readyAt = rec.readyAt
                st = now() >= rec.readyAt and "siap" or "tumbuh"
        end
        Net.get("PlotSync"):FireClient(player, {
                lahan = index,
                idx = idx,
                st = st,
                crop = crop,
                readyAt = readyAt,
        })
end

local function makePlantModel(index: number, idx: number, cropId: string): Model
        local info = CropData.byId[cropId]
        local model = Instance.new("Model")
        model.Name = "Tanaman_" .. idx
        local pos = plotPos(index, idx)
        local stem = Instance.new("Part")
        stem.Anchored = true
        stem.CanQuery = false
        stem.Size = Vector3.new(1, 2, 1)
        stem.Position = pos + Vector3.new(0, 1, 0)
        stem.Color = Color3.fromRGB(96, 116, 58)
        stem.Material = Enum.Material.Grass
        stem.Parent = model
        local head = Instance.new("Part")
        head.Name = "Kepala"
        head.Anchored = true
        head.CanQuery = false
        head.Size = Vector3.new(2, 1, 2)
        head.Position = pos + Vector3.new(0, 2.5, 0)
        head.Color = RARITY_COLOR[info.rarity] or RARITY_COLOR.common
        head.Material = Enum.Material.SmoothPlastic
        head.Parent = model
        model:SetAttribute("PlotIdx", idx)
        model:SetAttribute("LahanIdx", index)
        model.Parent = folders[index]
        return model
end

function PlotService.buildGrid(index: number)
        if folders[index] then
                return
        end
        local root = Workspace:FindFirstChild("Dunia")
        if not root then
                return
        end
        local folder = Instance.new("Folder")
        folder.Name = "PlotGrid_" .. index
        local ox, oz = Layout.cellOrigin(index)
        local tmpl = Instance.new("Part")
        tmpl.Anchored = true
        tmpl.Size = Vector3.new(Layout.PlotSize, 0.4, Layout.PlotSize)
        tmpl.Color = Color3.fromRGB(96, 72, 48)
        tmpl.Material = Enum.Material.Ground
        tmpl.TopSurface = Enum.SurfaceType.Smooth
        for idx = 0, Layout.plotCount() - 1 do
                local p = tmpl:Clone()
                local x, z = Layout.plotLocal(idx)
                p.Position = Vector3.new(ox + x, 1.2, oz + z)
                p:SetAttribute("LahanIdx", index)
                p:SetAttribute("PlotIdx", idx)
                p.Parent = folder
        end
        tmpl:Destroy()
        folder.Parent = root
        folders[index] = folder
        planted[index] = {}
end

function PlotService.clearGrid(index: number)
        running[index] = false
        planted[index] = nil
        if folders[index] then
                folders[index]:Destroy()
                folders[index] = nil
        end
end

function PlotService.stateOf(index: number, idx: number): string
        local rec = planted[index] and planted[index][idx]
        if not rec then
                return "kosong"
        end
        if now() >= rec.readyAt then
                return "siap"
        end
        return "tumbuh"
end

function PlotService.startLoop(index: number, ownerPlayer: Player)
        if running[index] then
                return
        end
        running[index] = true
        task.spawn(function()
                while running[index] do
                        task.wait(1)
                        local pl = planted[index]
                        if pl then
                                for idx, rec in pairs(pl) do
                                        if not rec.ready and now() >= rec.readyAt then
                                                rec.ready = true
                                                local head = rec.model and rec.model:FindFirstChild("Kepala")
                                                if head then
                                                        head.Size = Vector3.new(3, 2, 3)
                                                        head.Position = plotPos(index, idx) + Vector3.new(0, 3, 0)
                                                end
                                                if ownerPlayer.Parent then
                                                        sync(ownerPlayer, index, idx)
                                                end
                                        end
                                end
                        end
                end
        end)
end

function PlotService.plant(player: Player, idx: number, cropId: string): (boolean, string)
        local index = Land.landOf(player)
        if not index then
                return false, "Kamu tidak punya lahan."
        end
        if type(idx) ~= "number" or idx < 0 or idx >= Layout.plotCount() then
                return false, "Plot tidak sah."
        end
        local info = CropData.byId[cropId]
        if not info then
                return false, "Tanaman tidak dikenal."
        end
        local pl = planted[index]
        if not pl then
                return false, "Lahan belum siap."
        end
        if pl[idx] then
                return false, "Plot masih terisi."
        end
        if Tas.count(player, "benih", cropId) < 1 then
                return false, "Benih tidak ada di tas."
        end
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
        if not root or (root.Position - plotPos(index, idx)).Magnitude > 48 then
                return false, "Terlalu jauh dari plot."
        end
        Tas.remove(player, "benih", cropId, 1)
        local model = makePlantModel(index, idx, cropId)
        pl[idx] = {
                crop = cropId,
                readyAt = now() + CropData.GrowTime,
                model = model,
                ready = false,
        }
        sync(player, index, idx)
        return true, "Ditanam."
end

function PlotService.harvest(player: Player, idx: number): (boolean, string)
        local index = Land.landOf(player)
        if not index then
                return false, "Kamu tidak punya lahan."
        end
        if type(idx) ~= "number" or idx < 0 or idx >= Layout.plotCount() then
                return false, "Plot tidak sah."
        end
        local rec = planted[index] and planted[index][idx]
        if not rec then
                return false, "Plot kosong."
        end
        if now() < rec.readyAt then
                return false, "Belum siap panen."
        end
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
        if not root or (root.Position - plotPos(index, idx)).Magnitude > 48 then
                return false, "Terlalu jauh dari plot."
        end
        local info = CropData.byId[rec.crop]
        local y = CropData.Yield[info.rarity]
        local jumlah = rng:NextInteger(y.min, y.max)
        if Tas.roomFor(player, "hasil", rec.crop, jumlah) < jumlah then
                return false, "Tas penuh! Kosongkan slot dulu."
        end
        rec.model:Destroy()
        planted[index][idx] = nil
        Tas.add(player, "hasil", rec.crop, jumlah)
        sync(player, index, idx)
        return true, "Panen " .. jumlah .. " " .. info.nama .. "."
end

return PlotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">RateLimit</string>
            <string name="Source"><![CDATA[local RateLimit = {}

RateLimit.clock = os.clock

local buckets: { [number]: { [string]: { tokens: number, last: number } } } = {}

function RateLimit.allow(userId: number, key: string, perSecond: number, burst: number): boolean
	local user = buckets[userId]
	if not user then
		user = {}
		buckets[userId] = user
	end
	local b = user[key]
	local now = RateLimit.clock()
	if not b then
		b = { tokens = burst, last = now }
		user[key] = b
	end
	b.tokens = math.min(burst, b.tokens + (now - b.last) * perSecond)
	b.last = now
	if b.tokens >= 1 then
		b.tokens -= 1
		return true
	end
	return false
end

function RateLimit.clear(userId: number)
	buckets[userId] = nil
end

return RateLimit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CropData = require(ReplicatedStorage.Shared.CropData)

local ShopService = {}

local Data, Tas
local rng = Random.new()
local shopPoint: Vector3? = nil

function ShopService.bind(deps)
	Data = deps.Data
	Tas = deps.Tas
end

function ShopService.setShopPoint(pos: Vector3)
	shopPoint = pos
end

function ShopService.shopPoint(): Vector3?
	return shopPoint
end

function ShopService.near(player, maxDist: number): boolean
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root or not shopPoint then
		return false
	end
	return (root.Position - shopPoint).Magnitude <= maxDist
end

function ShopService.buy(player, packId: any): (boolean, string)
	if type(packId) ~= "string" then
		return false, "Permintaan tidak sah."
	end
	local pack = CropData.Packs[packId]
	if not pack then
		return false, "Pack tidak dikenal."
	end
	if not ShopService.near(player, 30) then
		return false, "Terlalu jauh dari kasir."
	end
	local d = Data.get(player)
	if not d or d.m < pack.price then
		return false, "Micda tidak cukup."
	end
	local pool = CropData.byRarity(packId)
	local items = {}
	for _ = 1, pack.count do
		local pick = pool[rng:NextInteger(1, #pool)]
		table.insert(items, { kind = "benih", id = pick.id, count = 1 })
	end
	if not Tas.canFitBatch(player, items) then
		return false, "Tas penuh! Kosongkan slot dulu."
	end
	if not Data.trySpend(player, pack.price) then
		return false, "Micda tidak cukup."
	end
	local nama = {}
	for _, it in ipairs(items) do
		Tas.add(player, it.kind, it.id, it.count)
		table.insert(nama, CropData.byId[it.id].nama)
	end
	return true, "Pack " .. packId .. ": " .. table.concat(nama, ", ")
end

function ShopService.sell(player, cropId: any, count: any): (boolean, string)
	if type(cropId) ~= "string" or not CropData.byId[cropId] then
		return false, "Barang tidak dikenal."
	end
	if not ShopService.near(player, 30) then
		return false, "Terlalu jauh dari kasir."
	end
	local ada = Tas.count(player, "hasil", cropId)
	local n
	if count == nil then
		n = ada
	else
		if type(count) ~= "number" or count ~= count or count % 1 ~= 0 then
			return false, "Jumlah tidak sah."
		end
		n = math.floor(count)
	end
	if n <= 0 then
		return false, "Jumlah tidak sah."
	end
	if n > ada then
		n = ada
	end
	if n <= 0 then
		return false, "Tidak ada yang bisa dijual."
	end
	local info = CropData.byId[cropId]
	local total = info.jual * n
	Tas.remove(player, "hasil", cropId, n)
	Data.addMicda(player, total)
	return true, "Terjual " .. n .. " " .. info.nama .. " (+" .. total .. " Micda)."
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">SmashService</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CropData = require(ReplicatedStorage.Shared.CropData)

local SmashService = {}

local Land, Tas, Data, Net, Notify
local rng = Random.new()

local MAX_SLOTS = 6
local tables: { [number]: Vector3 } = {}
local slots: { [number]: { any } } = {}

local RARITY_COLOR = {
        common = Color3.fromRGB(96, 168, 74),
        rare = Color3.fromRGB(70, 128, 214),
        epic = Color3.fromRGB(168, 92, 224),
}
local RARITY_SIZE = {
        common = Vector3.new(2, 2, 2),
        rare = Vector3.new(2, 3, 2),
        epic = Vector3.new(3, 3, 3),
}

function SmashService.bind(deps)
        Land = deps.Land
        Tas = deps.Tas
        Data = deps.Data
        Net = deps.Net
        Notify = deps.Notify
end

function SmashService.registerTable(index: number, pos: Vector3)
        tables[index] = pos
        slots[index] = {}
end

function SmashService.tablePos(index: number): Vector3?
        return tables[index]
end

local function syncLahan(index: number, player: Player?)
        local arr = {}
        for i, s in ipairs(slots[index]) do
                arr[i] = { crop = s.crop, hits = s.hitsLeft, max = CropData.Smash[CropData.byId[s.crop].rarity].hits }
        end
        local ev = Net.get("SmashSync")
        if player then
                ev:FireClient(player, { lahan = index, slots = arr })
                return
        end
        for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
                if Land.landOf(p) == index then
                        ev:FireClient(p, { lahan = index, slots = arr })
                end
        end
end

function SmashService.clearLahan(index: number)
        slots[index] = {}
end

function SmashService.syncTo(player, index: number)
        syncLahan(index, player)
end

function SmashService.refundLahan(index: number, player)
        for _, s in ipairs(slots[index] or {}) do
                Tas.add(player, "hasil", s.crop, 1)
        end
        slots[index] = {}
end

function SmashService.place(player, cropId: any): (boolean, string)
        local index = Land.landOf(player)
        if not index then
                return false, "Kamu tidak punya lahan."
        end
        if type(cropId) ~= "string" or not CropData.byId[cropId] then
                return false, "Hasil panen tidak dikenal."
        end
        if #slots[index] >= MAX_SLOTS then
                return false, "Meja penuh. Pukul dulu yang ada."
        end
        if Tas.count(player, "hasil", cropId) < 1 then
                return false, "Hasil panen tidak ada di tas."
        end
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
        if not root or (root.Position - tables[index]).Magnitude > 24 then
                return false, "Terlalu jauh dari meja."
        end
        Tas.remove(player, "hasil", cropId, 1)
        local info = CropData.byId[cropId]
        local model = Instance.new("Model")
        model.Name = "Hasil_" .. #slots[index]
        local part = Instance.new("Part")
        part.Anchored = true
        part.CanQuery = false
        part.Size = RARITY_SIZE[info.rarity]
        part.Color = RARITY_COLOR[info.rarity]
        part.Material = Enum.Material.SmoothPlastic
        part.Position = tables[index] + Vector3.new(-10 + #slots[index] * 4, part.Size.Y / 2 + 0.1, 0)
        part.Parent = model
        model.Parent = workspace:FindFirstChild("Dunia")
        table.insert(slots[index], { crop = cropId, hitsLeft = CropData.Smash[info.rarity].hits, model = model })
        syncLahan(index, player)
        return true, info.nama .. " diletakkan di meja."
end

function SmashService.hit(player, slotIdx: any): (boolean, string)
        local index = Land.landOf(player)
        if not index then
                return false, "Kamu tidak punya lahan."
        end
        if type(slotIdx) ~= "number" or slotIdx < 1 or slotIdx > #slots[index] then
                return false, "Tidak ada hasil di posisi itu."
        end
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
        if not root or (root.Position - tables[index]).Magnitude > 24 then
                return false, "Terlalu jauh dari meja."
        end
        local s = slots[index][slotIdx]
        local info = CropData.byId[s.crop]
        local cfg = CropData.Smash[info.rarity]
        s.hitsLeft -= 1
        if s.hitsLeft <= 0 then
                s.model:Destroy()
                table.remove(slots[index], slotIdx)
                local micda = rng:NextInteger(cfg.micdaMin, cfg.micdaMax)
                Data.addMicda(player, micda)
                local pesan = "+" .. micda .. " Micda"
                if rng:NextNumber() < cfg.seed then
                        local put = Tas.add(player, "benih", s.crop, 1)
                        if put > 0 then
                                pesan ..= ", +1 Benih " .. info.nama
                        else
                                Notify(player, "Tas Penuh", "Benih gagal masuk, tas penuh.")
                        end
                end
                if rng:NextNumber() < cfg.blok then
                        local put = Tas.add(player, "blok", CropData.BlokId, 1)
                        if put > 0 then
                                pesan ..= ", +1 Blok Panen"
                        else
                                Notify(player, "Tas Penuh", "Blok panen gagal masuk, tas penuh.")
                        end
                end
                syncLahan(index, player)
                return true, pesan
        end
        local part = s.model:FindFirstChildWhichIsA("BasePart")
        if part then
                part.Size = part.Size * 0.92
        end
        syncLahan(index, player)
        return true, "Pukulan " .. (cfg.hits - s.hitsLeft) .. "/" .. cfg.hits
end

function SmashService.take(player, slotIdx: any): (boolean, string)
        local index = Land.landOf(player)
        if not index then
                return false, "Kamu tidak punya lahan."
        end
        if type(slotIdx) ~= "number" or slotIdx < 1 or slotIdx > #slots[index] then
                return false, "Tidak ada hasil di posisi itu."
        end
        local s = slots[index][slotIdx]
        if Tas.roomFor(player, "hasil", s.crop, 1) < 1 then
                return false, "Tas penuh!"
        end
        s.model:Destroy()
        table.remove(slots[index], slotIdx)
        Tas.add(player, "hasil", s.crop, 1)
        syncLahan(index, player)
        return true, "Diambil kembali."
end

return SmashService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">TasService</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local TasLogic = require(ReplicatedStorage.Shared.TasLogic)

local TasService = {}
local dataOf: any = nil

function TasService.bind(dataService)
	dataOf = dataService
end

function TasService.tas(player)
	local d = dataOf.get(player)
	return d and d.t or nil
end

function TasService.roomFor(player, kind: string, id: string, want: number): number
	local tas = TasService.tas(player)
	if not tas then
		return 0
	end
	return TasLogic.roomFor(tas, kind, id, want)
end

function TasService.add(player, kind: string, id: string, count: number): number
	local tas = TasService.tas(player)
	if not tas then
		return 0
	end
	local put = TasLogic.add(tas, kind, id, count)
	if put > 0 then
		dataOf.markDirty(player)
		dataOf.push(player)
	end
	return put
end

function TasService.remove(player, kind: string, id: string, count: number): number
	local tas = TasService.tas(player)
	if not tas then
		return 0
	end
	local took = TasLogic.remove(tas, kind, id, count)
	if took > 0 then
		dataOf.markDirty(player)
		dataOf.push(player)
	end
	return took
end

function TasService.count(player, kind: string, id: string): number
	local tas = TasService.tas(player)
	if not tas then
		return 0
	end
	return TasLogic.countOf(tas, kind, id)
end

function TasService.canFitBatch(player, items): boolean
	local tas = TasService.tas(player)
	if not tas then
		return false
	end
	return TasLogic.canFitBatch(tas, items)
end

return TasService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">WorldBuilder</string>
            <string name="Source"><![CDATA[local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Layout = require(ReplicatedStorage.Shared.Layout)
local BuildingKit = require(script.Parent.BuildingKit)

local WorldBuilder = {}

local GRASS = Color3.fromRGB(106, 148, 79)
local PATH = Color3.fromRGB(168, 162, 150)
local MARKER_A = Color3.fromRGB(120, 180, 220)
local MARKER_B = Color3.fromRGB(220, 170, 90)

local function groundTop(): number
        return 1
end

function WorldBuilder.build(hooks)
        local root = Instance.new("Folder")
        root.Name = "Dunia"
        root.Parent = Workspace

        local lahanArea = BuildingKit.part(root, Vector3.new(1440, 1, 560), CFrame.new(680, -0.5, 250), GRASS, Enum.Material.Grass)
        lahanArea.Name = "TanahLahan"

        for i = 1, Layout.LahanCount do
                WorldBuilder.buildLahan(root, i, hooks)
        end

        local umum = Instance.new("SpawnLocation")
        umum.Anchored = true
        umum.Size = Vector3.new(12, 1, 12)
        umum.Position = Vector3.new(-60, 0.5, 110)
        umum.Color = Color3.fromRGB(190, 190, 196)
        umum.Material = Enum.Material.SmoothPlastic
        umum.TopSurface = Enum.SurfaceType.Smooth
        umum.Duration = 0
        umum.Enabled = true
        umum.Parent = root
        if hooks and hooks.registerUmum then
                hooks.registerUmum(umum)
        end

        WorldBuilder.buildKota(root, hooks)
        return root
end

function WorldBuilder.buildLahan(root: Folder, index: number, hooks)
        local ox, oz = Layout.cellOrigin(index)
        local folder = Instance.new("Folder")
        folder.Name = "Lahan_" .. index
        folder.Parent = root
        local gt = groundTop()

        BuildingKit.part(folder, Vector3.new(Layout.SizeX, 1, Layout.SizeZ), CFrame.new(ox + Layout.SizeX / 2, gt - 0.5, oz + Layout.SizeZ / 2), GRASS, Enum.Material.Grass)

        BuildingKit.part(folder, Vector3.new(Layout.SizeX, 0.2, 10), CFrame.new(ox + Layout.SizeX / 2, gt + 0.1, oz + 25), PATH, Enum.Material.Concrete)
        BuildingKit.part(folder, Vector3.new(Layout.SizeX, 0.2, 10), CFrame.new(ox + Layout.SizeX / 2, gt + 0.1, oz + 155), PATH, Enum.Material.Concrete)
        BuildingKit.part(folder, Vector3.new(10, 0.2, 120), CFrame.new(ox + 165, gt + 0.1, oz + 90), PATH, Enum.Material.Concrete)
        BuildingKit.part(folder, Vector3.new(10, 0.2, 20), CFrame.new(ox + 120, gt + 0.1, oz + 10), PATH, Enum.Material.Concrete)

        BuildingKit.fenceLine(folder, ox, oz, ox, oz + Layout.SizeZ, gt)
        BuildingKit.fenceLine(folder, ox + Layout.SizeX, oz, ox + Layout.SizeX, oz + Layout.SizeZ, gt)
        BuildingKit.fenceLine(folder, ox, oz + Layout.SizeZ, ox + Layout.SizeX, oz + Layout.SizeZ, gt)
        BuildingKit.fenceLine(folder, ox, oz, ox + 108, oz, gt)
        BuildingKit.fenceLine(folder, ox + 132, oz, ox + Layout.SizeX, oz, gt)

        local postL = BuildingKit.part(folder, Vector3.new(2, 10, 2), CFrame.new(ox + 108, gt + 5, oz), BuildingKit.DARKWOOD, Enum.Material.Wood)
        local postR = BuildingKit.part(folder, Vector3.new(2, 10, 2), CFrame.new(ox + 132, gt + 5, oz), BuildingKit.DARKWOOD, Enum.Material.Wood)
        local beam = BuildingKit.part(folder, Vector3.new(26, 2, 2), CFrame.new(ox + 120, gt + 11, oz), BuildingKit.DARKWOOD, Enum.Material.Wood)
        if hooks and hooks.onGate then
                local prompt = Instance.new("ProximityPrompt")
                prompt.ActionText = "Pusat Kota"
                prompt.ObjectText = "Gerbang"
                prompt.HoldDuration = 0.4
                prompt.MaxActivationDistance = 14
                prompt.RequiresLineOfSight = false
                prompt.Parent = beam
                prompt.Triggered:Connect(function(player)
                        hooks.onGate(player, "kota")
                end)
        end
        local _unusedL = postL
        local _unusedR = postR

        local _signPost = BuildingKit.part(folder, Vector3.new(1, 8, 1), CFrame.new(ox + 96, gt + 4, oz + 8), BuildingKit.DARKWOOD, Enum.Material.Wood)
        local board = BuildingKit.part(folder, Vector3.new(8, 4, 0.5), CFrame.new(ox + 96, gt + 10, oz + 8), BuildingKit.DARKWOOD, Enum.Material.Wood)
        local gui = Instance.new("SurfaceGui")
        gui.Face = Enum.NormalId.Front
        gui.CanvasSize = Vector2.new(400, 200)
        local label = Instance.new("TextLabel")
        label.Name = "NamaLahan"
        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1
        label.Text = ""
        label.TextColor3 = Color3.fromRGB(255, 240, 200)
        label.TextScaled = true
        label.Font = Enum.Font.GothamBold
        label.Parent = gui
        gui.Parent = board
        board:SetAttribute("LahanIdx", index)
        folder:SetAttribute("PapanNama", true)

        local spawn = Instance.new("SpawnLocation")
        spawn.Anchored = true
        spawn.Size = Vector3.new(12, 1, 12)
        spawn.Position = Vector3.new(ox + 120, gt + 0.5, oz + 12)
        spawn.Color = Color3.fromRGB(235, 200, 110)
        spawn.Material = Enum.Material.SmoothPlastic
        spawn.TopSurface = Enum.SurfaceType.Smooth
        spawn.Duration = 0
        spawn.Enabled = false
        spawn.Parent = folder

        BuildingKit.streetLamp(folder, ox + 104, gt, oz + 24)
        BuildingKit.streetLamp(folder, ox + 166, gt, oz + 156)
        BuildingKit.streetLamp(folder, ox + 40, gt, oz + 210)

        local semai = BuildingKit.buildSemai(folder)
        semai:PivotTo(CFrame.new(ox + 185, gt, oz + 50))
        local tablePart
        for _, p in ipairs(semai:GetDescendants()) do
                if p:IsA("BasePart") and p.Size == Vector3.new(12, 4, 4) then
                        tablePart = p
                        break
                end
        end
        if tablePart then
                if hooks and hooks.registerTable then
                        hooks.registerTable(index, tablePart.Position + Vector3.new(0, 2, 0))
                end
                if hooks and hooks.onSemaiPrompt then
                        local prompt = Instance.new("ProximityPrompt")
                        prompt.ActionText = "Semai Panen"
                        prompt.ObjectText = "Meja Hasil"
                        prompt.HoldDuration = 0.3
                        prompt.MaxActivationDistance = 12
                        prompt.RequiresLineOfSight = false
                        prompt.Parent = tablePart
                        tablePart:SetAttribute("LahanIdx", index)
                        prompt.Triggered:Connect(function(player)
                                hooks.onSemaiPrompt(player, index)
                        end)
                end
        end

        BuildingKit.marker(folder, ox + 185, oz + 85, gt, 30, 30, MARKER_A)
        BuildingKit.marker(folder, ox + 195, oz + 125, gt, 50, 30, MARKER_A)
        BuildingKit.marker(folder, ox + 40, oz + 185, gt, 40, 40, MARKER_B)
        BuildingKit.marker(folder, ox + 82, oz + 177, gt, 24, 24, MARKER_B)
        BuildingKit.marker(folder, ox + 112, oz + 177, gt, 24, 24, MARKER_B)
        BuildingKit.marker(folder, ox + 142, oz + 177, gt, 24, 24, MARKER_B)
        BuildingKit.marker(folder, ox + 172, oz + 177, gt, 24, 24, MARKER_B)

        return folder
end

function WorldBuilder.buildKota(root: Folder, hooks)
        local kox = Layout.kotaOffsetX()
        local folder = Instance.new("Folder")
        folder.Name = "PusatKota"
        folder.Parent = root
        local gt = 0

        BuildingKit.part(folder, Vector3.new(400, 1, 400), CFrame.new(kox, -0.5, 0), GRASS, Enum.Material.Grass)
        BuildingKit.part(folder, Vector3.new(10, 0.2, 90), CFrame.new(kox, gt + 0.1, -1), PATH, Enum.Material.Concrete)

        local spawn = Instance.new("SpawnLocation")
        spawn.Anchored = true
        spawn.Size = Vector3.new(12, 1, 12)
        spawn.Position = Vector3.new(kox, gt + 0.5, 44)
        spawn.Color = Color3.fromRGB(235, 200, 110)
        spawn.Material = Enum.Material.SmoothPlastic
        spawn.TopSurface = Enum.SurfaceType.Smooth
        spawn.Duration = 0
        spawn.Enabled = true
        spawn.Parent = folder

        BuildingKit.part(folder, Vector3.new(2, 10, 2), CFrame.new(kox - 11, gt + 5, 20), BuildingKit.DARKWOOD, Enum.Material.Wood)
        BuildingKit.part(folder, Vector3.new(2, 10, 2), CFrame.new(kox + 11, gt + 5, 20), BuildingKit.DARKWOOD, Enum.Material.Wood)
        local beamKota = BuildingKit.part(folder, Vector3.new(26, 2, 2), CFrame.new(kox, gt + 11, 20), BuildingKit.DARKWOOD, Enum.Material.Wood)
        if hooks and hooks.onGate then
                local prompt = Instance.new("ProximityPrompt")
                prompt.ActionText = "Lahan"
                prompt.ObjectText = "Gerbang"
                prompt.HoldDuration = 0.4
                prompt.MaxActivationDistance = 14
                prompt.RequiresLineOfSight = false
                prompt.Parent = beamKota
                prompt.Triggered:Connect(function(player)
                        hooks.onGate(player, "lahan")
                end)
        end

        local toko = BuildingKit.buildToko(folder)
        toko:PivotTo(CFrame.new(kox, gt, -60) * CFrame.Angles(0, math.rad(180), 0))
        local kasir
        for _, p in ipairs(toko:GetDescendants()) do
                if p:IsA("BasePart") and p.Size == Vector3.new(12, 4, 3) then
                        kasir = p
                        break
                end
        end
        if kasir then
                if hooks and hooks.setShopPoint then
                        hooks.setShopPoint(kasir.Position)
                end
                if hooks and hooks.onShopPrompt then
                        local prompt = Instance.new("ProximityPrompt")
                        prompt.ActionText = "Toko Benih"
                        prompt.ObjectText = "Kasir"
                        prompt.HoldDuration = 0.3
                        prompt.MaxActivationDistance = 12
                        prompt.RequiresLineOfSight = false
                        prompt.Parent = kasir
                        prompt.Triggered:Connect(function(player)
                                hooks.onShopPrompt(player)
                        end)
                end
        end

        BuildingKit.streetLamp(folder, kox + 8, gt, 32)
        BuildingKit.streetLamp(folder, kox - 8, gt, 32)
        BuildingKit.streetLamp(folder, kox + 8, gt, -30)
        BuildingKit.streetLamp(folder, kox - 8, gt, -30)

        return folder
end

return WorldBuilder
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="24">
