	{ id = "ikan_langka", name = "Ikan Langka", sell = 65, chance = 0.10 },
	{ id = "sepatu", name = "Sepatu Bot Tua", sell = 3, chance = 0.05 },
}

Config.Data = {
	StoreName = "AKM_World_v3",
	OrderedStoreName = "AKM_XP_v3",
	AutosaveInterval = 120,
	LoadRetries = 3,
}

Config.Leaderboard = {
	RefreshInterval = 60,
	Size = 8,
}

return Config
]]></string>
