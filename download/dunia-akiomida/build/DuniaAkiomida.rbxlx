        for i = 1, 3 do
                part({
                        Name = "PancingJoran" .. i,
                        Shape = Enum.PartType.Cylinder,
                        Size = Vector3.new(8.4, 0.28, 0.28),
                        CFrame = CFrame.new(x - 9.2, 5.4 + (i - 1) * 0.5, z - 2.4 + i * 2.4) * CFrame.Angles(0, 0, math.rad(90)),
