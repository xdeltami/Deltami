        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	DataService.luau - progres pemain: XP, koin, jawaban benar per zona,
	bahasan dibaca, streak, status dev. DataStore + autosave + sanitize.
]]

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)

local DataService = {}

local store = DataStoreService:GetDataStore(Config.Data.StoreName)

local sessions: { [Player]: { data: { [string]: any }, dirty: boolean } } = {}

local function defaultData(): { [string]: any }
	local correct: { [string]: number } = {}
	for _, zone in Config.Zones do
		correct[zone.id] = 0
	end
	local mastered: { [string]: boolean } = {}
	for _, zone in Config.Zones do
		mastered[zone.id] = false
	end
	return {
		XP = 0,
		Coins = 0,
		Correct = correct,
		Mastered = mastered,
		Read = {}, -- topic ids
		Streak = 0,
		BestStreak = 0,
		Dev = false,
		LastSeen = 0,
	}
end

local function sanitize(raw: any): { [string]: any }
	local out = defaultData()
	if type(raw) ~= "table" then
		return out
	end
	out.XP = tonumber(raw.XP) or 0
	out.Coins = tonumber(raw.Coins) or 0
	out.Streak = tonumber(raw.Streak) or 0
	out.BestStreak = tonumber(raw.BestStreak) or 0
	out.Dev = raw.Dev == true
	if type(raw.Correct) == "table" then
		for _, zone in Config.Zones do
			out.Correct[zone.id] = math.max(0, math.floor(tonumber(raw.Correct[zone.id]) or 0))
		end
	end
	if type(raw.Mastered) == "table" then
		for _, zone in Config.Zones do
			out.Mastered[zone.id] = raw.Mastered[zone.id] == true
		end
	end
	if type(raw.Read) == "table" then
		for _, id in raw.Read do
			if type(id) == "string" then
				table.insert(out.Read, id)
			end
		end
	end
	out.LastSeen = tonumber(raw.LastSeen) or 0
	return out
end

function DataService.get(player: Player): { [string]: any }
	local s = sessions[player]
	return s and s.data or defaultData()
end

function DataService.has(player: Player): boolean
	return sessions[player] ~= nil
end

function DataService.markDirty(player: Player)
	local s = sessions[player]
	if s then
		s.dirty = true
	end
end

function DataService.load(player: Player): boolean
	local key = "p_" .. player.UserId
	local ok, raw = Util.retry(Config.Data.LoadRetries, function()
		return store:GetAsync(key)
	end)
	if not ok then
		return false
	end
	sessions[player] = { data = sanitize(raw), dirty = false }
	return true
end

function DataService.save(player: Player): boolean
	local s = sessions[player]
	if not s then
		return false
	end
	s.data.LastSeen = os.time()
	local ok = Util.retry(Config.Data.LoadRetries, function()
		store:SetAsync("p_" .. player.UserId, s.data)
	end)
	if ok then
		s.dirty = false
	end
	return ok
end

function DataService.startLoops()
	task.spawn(function()
		while true do
			task.wait(Config.Data.AutosaveInterval)
			for player, s in sessions do
				if s.dirty then
					task.spawn(DataService.save, player)
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		DataService.save(player)
		sessions[player] = nil
	end)

	game:BindToClose(function()
		for player in sessions do
			DataService.save(player)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
        LeaderboardService.luau - Top XP global (OrderedDataStore) + papan fisik.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Remotes)
local DataService = require(script.Parent.DataService)
local Util = require(ReplicatedStorage.Shared.Util)

local LeaderboardService = {}

local orderedStore = DataStoreService:GetOrderedDataStore(Config.Data.OrderedStoreName)
local latestRows: { { name: string, value: number } } = {}
local boards: { SurfaceGui } = {}

local function buildBoard(position: Vector3, lookAt: Vector3)
        local part = Util.create("Part", {
                Name = "PapanPenjelajah",
                Size = Vector3.new(16, 10, 1),
                Anchored = true,
                Material = Enum.Material.SmoothPlastic,
                Color = Color3.fromRGB(25, 28, 38),
                CFrame = CFrame.lookAt(position, lookAt),
        }, workspace)

        local gui = Util.create("SurfaceGui", {
                Face = Enum.NormalId.Front,
                SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
                PixelsPerStud = 50,
        }, part)

        Util.create("TextLabel", {
                Size = UDim2.fromScale(1, 0.18),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBlack,
                TextScaled = true,
                TextColor3 = Color3.fromRGB(255, 209, 102),
                Text = "PAPAN PENJELAJAH (XP)",
        }, gui)

        local list = Util.create("Frame", {
                Position = UDim2.fromScale(0.05, 0.22),
                Size = UDim2.fromScale(0.9, 0.74),
                BackgroundTransparency = 1,
        }, gui)
        Util.create("UIListLayout", { Padding = UDim.new(0.02, 0) }, list)

        for i = 1, Config.Leaderboard.Size do
                Util.create("TextLabel", {
                        Name = "Row" .. i,
                        Size = UDim2.fromScale(1, 0.09),
                        BackgroundTransparency = 1,
                        Font = Enum.Font.GothamBold,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        TextScaled = true,
                        TextColor3 = i == 1 and Color3.fromRGB(255, 215, 0) or Color3.fromRGB(230, 230, 240),
                        Text = i .. ". -",
                }, list)
        end
        table.insert(boards, gui)
end

local function renderRows()
        for _, gui in boards do
                local list = gui:FindFirstChildOfClass("Frame")
                if not list then
                        continue
                end
                for i = 1, Config.Leaderboard.Size do
                        local row = list:FindFirstChild("Row" .. i)
                        if not row then
                                continue
                        end
                        local entry = latestRows[i]
                        local rowLabel = row :: TextLabel
                        rowLabel.Text = entry and (i .. ". " .. entry.name .. " - " .. Util.formatNumber(entry.value) .. " XP")
                                or (i .. ". -")
                end
        end
end

local function refresh()
        for _, player in Players:GetPlayers() do
                if DataService.has(player) then
                        local data = DataService.get(player)
                        pcall(function()
                                orderedStore:SetAsync(tostring(player.UserId), math.floor(data.XP))
                        end)
                end
        end

        local ok, pages = pcall(function()
                return orderedStore:GetSortedAsync(false, Config.Leaderboard.Size)
        end)
        if not ok or not pages then
                return
        end
        local rows: { { name: string, value: number } } = {}
        for rank, entry in pages:GetCurrentPage() do
                local name = "Penjelajah " .. entry.key
                local online = Players:GetPlayerByUserId(tonumber(entry.key) or 0)
                if online then
                        name = online.DisplayName
                else
                        local okName, fetched = pcall(Players.GetNameFromUserIdAsync, Players, tonumber(entry.key) or 0)
                        if okName and fetched then
                                name = fetched
                        end
                end
                rows[rank] = { name = name, value = entry.value }
        end
        latestRows = rows
        renderRows()
end

function LeaderboardService.init()
        Remotes.get("GetLeaderboard").OnServerInvoke = function()
                return latestRows
        end

        buildBoard(Vector3.new(-14, 8, 26), Vector3.new(0, 7, 0))
        buildBoard(Vector3.new(14, 8, 26), Vector3.new(0, 7, 0))

        task.spawn(function()
                task.wait(5)
                while true do
                        refresh()
                        task.wait(Config.Leaderboard.RefreshInterval)
                end
        end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">MapService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	MapService.luau
	Pulau panjang berisi 6 zona (bioma prosedural, tanpa aset eksternal):
	  kamp - hutan - gunung - kota - lembah - salju
	Tiap zona: alas berwarna, gerbang label, NPC cerita (ProximityPrompt),
	dan Papan Bahasan (materi baca). Semua karya original.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Remotes)
local Util = require(ReplicatedStorage.Shared.Util)

local MapService = {}

local folder = Instance.new("Folder")
folder.Name = "DuniaAkiomida"

local function part(props): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = folder
	return p
end

local function zoneCenter(zoneIndex: number): Vector3
	return Vector3.new(0, 0, Config.World.StartZ + (zoneIndex - 1) * Config.World.ZoneSpacing)
end

--------------------------------------------------------------------
-- BIOMA (dekorasi per zona)
--------------------------------------------------------------------

local function biomeKamp(center: Vector3, color: Color3)
	-- tenda: dua papan miring membentuk atap
	for i = 0, 1 do
		part({
			Name = "Tenda" .. i,
			Size = Vector3.new(8, 0.8, 6),
			CFrame = CFrame.new(center + Vector3.new(-6, 4.2, 8)) * CFrame.Angles(i == 0 and math.rad(35) or math.rad(-35), 0, i == 0 and math.rad(-28) or math.rad(28)),
			Color = color,
			Material = Enum.Material.Fabric,
		})
	end
	-- api unggun
	part({
		Name = "ApiUnggun",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(2.4, 2.4, 2.4),
		CFrame = CFrame.new(center + Vector3.new(0, 1.8, 10)),
		Color = Color3.fromRGB(255, 140, 60),
		Material = Enum.Material.Neon,
	})
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 160, 80)
	light.Range = 22
	light.Brightness = 1.6
	light.Parent = folder.ApiUnggun
	-- kayu tumpuk
	for i = 1, 3 do
		part({
			Name = "Kayu" .. i,
			Size = Vector3.new(1.2, 1.2, 5),
			CFrame = CFrame.new(center + Vector3.new(7, 0.6 + (i - 1) * 1.2, 12)) * CFrame.Angles(0, math.rad(15 * i), 0),
			Color = Color3.fromRGB(120, 82, 45),
			Material = Enum.Material.Wood,
		})
	end
end

local function biomeHutan(center: Vector3, color: Color3)
	local rng = Random.new(11)
	for i = 1, 10 do
		local x = rng:NextNumber(-30, 30)
		local z = rng:NextNumber(-18, 18)
		part({
			Name = "Pohon" .. i,
			Size = Vector3.new(1.6, rng:NextNumber(7, 12), 1.6),
			CFrame = CFrame.new(center + Vector3.new(x, 5, z)),
			Color = Color3.fromRGB(46, 110, 88),
			Material = Enum.Material.Grass,
		})
		part({
			Name = "Dedaunan" .. i,
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(7, 7, 7),
			CFrame = CFrame.new(center + Vector3.new(x, 11, z)),
			Color = Color3.fromRGB(40, 150, 100),
			Material = Enum.Material.Grass,
		})
	end
	-- simbol matematika melayang
	local symbols = { "+", "-", "x", ":", "=", "pi" }
	for i, sym in symbols do
		local angle = (i / #symbols) * math.pi * 2
		part({
			Name = "Simbol" .. i,
			Size = Vector3.new(3, 3, 0.4),
			CFrame = CFrame.new(center + Vector3.new(math.cos(angle) * 22, 9 + (i % 3), math.sin(angle) * 22))
				* CFrame.Angles(0, angle + math.rad(90), 0),
			Color = color,
			Material = Enum.Material.Neon,
			Transparency = 0.15,
		})
	end
end

local function biomeGunung(center: Vector3, color: Color3)
	local specs = {
		{ x = -16, h = 26, r = 10 },
		{ x = 14, h = 34, r = 12 },
		{ x = 0, h = 44, r = 14 },
	}
	for i, spec in specs do
		local layers = 4
		for l = 1, layers do
			local t = l / layers
			part({
				Name = "Gunung" .. i .. "L" .. l,
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(spec.h / layers, spec.r * (1 - t) * 2 + 2, spec.r * (1 - t) * 2 + 2),
				CFrame = CFrame.new(center + Vector3.new(spec.x, spec.h / layers * (l - 0.5), 0))
					* CFrame.Angles(0, 0, math.rad(90)),
				Color = color:Lerp(Color3.fromRGB(255, 255, 255), t * 0.85),
				Material = Enum.Material.Slate,
			})
		end
	end
end

local function biomeKota(center: Vector3, color: Color3)
	-- kolom-kolom kota bukti
	local rng = Random.new(44)
	for i = 1, 6 do
		local x = rng:NextNumber(-26, 26)
		local z = rng:NextNumber(-14, 14)
		local h = rng:NextNumber(8, 18)
		part({
			Name = "Kolom" .. i,
			Size = Vector3.new(4, h, 4),
			CFrame = CFrame.new(center + Vector3.new(x, h / 2, z)),
			Color = Color3.fromRGB(235, 230, 220),
			Material = Enum.Material.Marble,
		})
		part({
			Name = "AtapKolom" .. i,
			Size = Vector3.new(5, 1, 5),
			CFrame = CFrame.new(center + Vector3.new(x, h + 0.5, z)),
			Color = color,
			Material = Enum.Material.Marble,
		})
	end
end

local function biomeLembah(center: Vector3, color: Color3)
	-- cekungan: dinding rendah keliling
	for i = 1, 4 do
		local angle = (i / 4) * math.pi * 2
		part({
			Name = "DindingLembah" .. i,
			Size = Vector3.new(40, 10, 3),
			CFrame = CFrame.new(center + Vector3.new(math.cos(angle) * 26, 5, math.sin(angle) * 26))
				* CFrame.Angles(0, -angle + math.rad(90), 0),
			Color = Color3.fromRGB(70, 55, 95),
			Material = Enum.Material.Slate,
		})
	end
	local rng = Random.new(5)
	for i = 1, 5 do
		part({
			Name = "KristalLembah" .. i,
			Size = Vector3.new(2.4, rng:NextNumber(5, 9), 2.4),
			CFrame = CFrame.new(center + Vector3.new(rng:NextNumber(-18, 18), 3.5, rng:NextNumber(-12, 12)))
				* CFrame.Angles(0, rng:NextNumber(0, math.pi), math.rad(14)),
			Color = color,
			Material = Enum.Material.Neon,
			Transparency = 0.1,
		})
	end
end

local function biomeSalju(center: Vector3, color: Color3)
	local layers = 4
	for l = 1, layers do
		local t = l / layers
		part({
			Name = "PuncakL" .. l,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(10, (16 * (1 - t)) * 2 + 2, (16 * (1 - t)) * 2 + 2),
			CFrame = CFrame.new(center + Vector3.new(0, 10 / layers * (l - 0.5) + 2, -4))
				* CFrame.Angles(0, 0, math.rad(90)),
			Color = Color3.fromRGB(240, 246, 255):Lerp(color, 0.25),
			Material = Enum.Material.Snow,
		})
	end
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(200, 230, 255)
	light.Range = 26
	light.Brightness = 0.9
	local holder = folder:FindFirstChild("PuncakL" .. layers)
	if holder then
		light.Parent = holder
	end
end

local BIOMES = { biomeKamp, biomeHutan, biomeGunung, biomeKota, biomeLembah, biomeSalju }

--------------------------------------------------------------------
-- NPC + PAPAN BAHASAN + GERBANG
--------------------------------------------------------------------

local function buildNPC(center: Vector3, zoneIndex: number, color: Color3)
	local name = "KAK " .. string.upper((Config.Zones[zoneIndex].name:split(" ")[2] or "AKIOMIDA"))
	local body = part({
		Name = "NPC_Body_" .. zoneIndex,
		Size = Vector3.new(2.4, 3, 1.6),
		CFrame = CFrame.new(center + Vector3.new(0, 2.5, -6)),
		Color = color,
		Material = Enum.Material.SmoothPlastic,
	})
	local head = part({
		Name = "NPC_Head_" .. zoneIndex,
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(1.8, 1.8, 1.8),
		CFrame = CFrame.new(center + Vector3.new(0, 5.2, -6)),
		Color = Color3.fromRGB(255, 224, 189),
		Material = Enum.Material.SmoothPlastic,
	})

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.new(0, 140, 0, 34)
	billboard.StudsOffset = Vector3.new(0, 1.6, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 60
	billboard.Parent = head
	Util.create("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack,
		TextScaled = true,
		TextColor3 = color,
		TextStrokeTransparency = 0.4,
		Text = name,
	}, billboard)

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Bicara"
	prompt.ObjectText = name
	prompt.MaxActivationDistance = 12
	prompt.HoldDuration = 0
	prompt.Parent = body
	prompt.Triggered:Connect(function(player)
		Remotes.get("ZoneEntered"):FireClient(player, { type = "npc", zone = zoneIndex })
	end)
end

local function buildBoard(center: Vector3, zoneIndex: number, color: Color3)
	local board = part({
		Name = "PapanBahasan_" .. zoneIndex,
		Size = Vector3.new(10, 6, 0.6),
		CFrame = CFrame.new(center + Vector3.new(-12, 6, -2)) * CFrame.Angles(0, math.rad(35), 0),
		Color = Color3.fromRGB(60, 45, 30),
		Material = Enum.Material.WoodPlanks,
	})
	Util.create("SurfaceGui", {
		Face = Enum.NormalId.Front,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 50,
	}, board)
	local gui = board:FindFirstChildOfClass("SurfaceGui")
	Util.create("TextLabel", {
		Size = UDim2.fromScale(1, 0.3),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack,
		TextScaled = true,
		TextColor3 = color,
		Text = "BAHASAN",
	}, gui)

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Baca Bahasan"
	prompt.ObjectText = Config.Zones[zoneIndex].name
	prompt.MaxActivationDistance = 10
	prompt.HoldDuration = 0
	prompt.Parent = board
	prompt.Triggered:Connect(function(player)
		Remotes.get("ZoneEntered"):FireClient(player, { type = "board", zone = zoneIndex })
	end)
end

local function buildGate(center: Vector3, zoneIndex: number, color: Color3)
	local zone = Config.Zones[zoneIndex]
	for side = -1, 1, 2 do
		part({
			Name = "GerbangPilar_" .. zoneIndex .. "_" .. side,
			Size = Vector3.new(1.6, 12, 1.6),
			CFrame = CFrame.new(center + Vector3.new(side * 7, 6, 16)),
			Color = Color3.fromRGB(60, 64, 80),
			Material = Enum.Material.SmoothPlastic,
		})
	end
	local beam = part({
		Name = "GerbangPalang_" .. zoneIndex,
		Size = Vector3.new(16, 2, 1.4),
		CFrame = CFrame.new(center + Vector3.new(0, 13, 16)),
		Color = Color3.fromRGB(25, 28, 38),
		Material = Enum.Material.SmoothPlastic,
	})
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 50
	gui.Parent = beam
	Util.create("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack,
		TextScaled = true,
		TextColor3 = color,
		Text = string.upper(zone.name),
	}, gui)
end

--------------------------------------------------------------------
-- BUILD ALL
--------------------------------------------------------------------

function MapService.init()
	folder.Parent = workspace

	-- pulau panjang
	local totalLen = Config.World.StartZ + (#Config.Zones - 1) * Config.World.ZoneSpacing + 80
	part({
		Name = "Pulau",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(Config.World.IslandHeight, totalLen, Config.World.IslandWidth * 2),
		CFrame = CFrame.new(0, -Config.World.IslandHeight / 2, totalLen / 2 - 20) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(95, 165, 75),
		Material = Enum.Material.Grass,
	})

	-- arch judul di spawn
	part({
		Name = "PilarKiri",
		Size = Vector3.new(2, 14, 2),
		CFrame = CFrame.new(-8, 7, 34),
		Color = Color3.fromRGB(60, 64, 80),
		Material = Enum.Material.SmoothPlastic,
	})
	part({
		Name = "PilarKanan",
		Size = Vector3.new(2, 14, 2),
		CFrame = CFrame.new(8, 7, 34),
		Color = Color3.fromRGB(60, 64, 80),
		Material = Enum.Material.SmoothPlastic,
	})
	local beam = part({
		Name = "PalangJudul",
		Size = Vector3.new(20, 3.5, 1.5),
		CFrame = CFrame.new(0, 15, 34),
		Color = Color3.fromRGB(25, 28, 38),
		Material = Enum.Material.SmoothPlastic,
	})
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 50
	gui.Parent = beam
	Util.create("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack,
		TextScaled = true,
		TextColor3 = Color3.fromRGB(255, 209, 102),
		Text = "DUNIA AKIOMIDA",
	}, gui)

	-- zona per zona
	for zoneIndex, zone in Config.Zones do
		local center = zoneCenter(zoneIndex)
		local color = Util.zoneColor(zone.color)

		-- alas zona berwarna
		part({
			Name = "AlasZona_" .. zoneIndex,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.4, 76, 76),
			CFrame = CFrame.new(center + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Color = color,
			Material = Enum.Material.SmoothPlastic,
			Transparency = 0.45,
		})

		buildGate(center, zoneIndex, color)
		buildNPC(center, zoneIndex, color)
		buildBoard(center, zoneIndex, color)
		BIOMES[zoneIndex](center, color)
	end
end

return MapService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">QuizService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
        QuizService.luau
        Mesin kuis server-authoritative:
          StartQuiz(zoneIndex)  -> server generate soal (MathGen), simpan jawaban
                                   di state server, kirim soal TANPA kunci jawaban.
          AnswerQuiz(qid, pilih) -> validasi, beri XP/koin/streak, kirim feedback.
        Soal aktif per pemain + kedaluwarsa + cooldown = anti-spam/anti-exploit.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Config = require(ReplicatedStorage.Shared.Config)
local MathGen = require(ReplicatedStorage.Shared.MathGen)
local Remotes = require(ReplicatedStorage.Remotes)
local DataService = require(script.Parent.DataService)

local QuizService = {}

local notify = Remotes.get("Notify")

local ANSWER_COOLDOWN = Config.Progress.AnswerCooldown

-- player -> soal aktif
local active: { [Player]: { qid: string, benar: number, zoneIndex: number, betul: string, salah: string, born: number } } = {}
local lastAnswer: { [Player]: number } = {}

local function unlockedZoneCount(data): number
        -- zona 1 selalu terbuka; zona N+1 terbuka jika zona N dikuasai
        local count = 1
        for i = 1, #Config.Zones - 1 do
                if data.Mastered[Config.Zones[i].id] then
                        count = i + 1
                else
                        break
                end
        end
        return count
end

function QuizService.unlockedZoneCount(player: Player): number
        local data = DataService.get(player)
        return unlockedZoneCount(data)
end

--------------------------------------------------------------------
-- REQUEST STORY (NPC cerita per zona)
--------------------------------------------------------------------

local function onRequestStory(player: Player, zoneIndex: any)
        if type(zoneIndex) ~= "number" or not DataService.has(player) then
                return nil
        end
        zoneIndex = math.clamp(math.floor(zoneIndex), 1, #Config.Zones)
        if zoneIndex > QuizService.unlockedZoneCount(player) then
                return { locked = true }
        end
        local zone = Config.Zones[zoneIndex]
        -- halaman cerita original, ditulis khusus versi Roblox
        local stories = {
                [1] = {
                        "Selamat datang di Kamp Angka! Aku Kak Satu, penjaga pintu kamp.",
                        "Semua petualangan matematika dimulai dari sini: berhitung. Tanpa berhitung, karavan tersesat dan gudang kosong.",
                        "Jawab tantanganku untuk membuka jalan ke Hutan Simbol. Siap? Ayo mulai!",
                },
                [2] = {
                        "Halo, aku Kak Simbol dari Hutan Simbol. Di sini tanda-tanda punya kuasa.",
                        "Kali, kurung, minus... satu tanda bisa mengubah segalanya. Hutan ini mengajarkan bahasa matematika.",
                        "Buktikan kamu paham bahasanya, dan Pegunungan Pola menantimu.",
                },
                [3] = {
                        "Selamat datang di Pegunungan Pola! Aku Kak Pola, pemandu pendakian.",
                        "Gunung ini penuh barisan: naik-turun yang beraturan. Siapa melihat pola, dia setengah jalan.",
                        "Tantanganmu: tebak langkah berikutnya. Pendaki hebat selalu melihat pola!",
                },
                [4] = {
                        "Aku Kak Bukti, wali Kota Bukti. Di kota ini, klaim tanpa bukti tak lulus sidang.",
                        "Persamaan, luas, pertidaksamaan - semua harus diuji dengan perhitungan.",
                        "Selesaikan sidangnya, dan Lembah Kedalaman terbuka untukmu.",
                },
                [5] = {
                        "Aku Kak Dalam dari Lembah Kedalaman. Di sini kita tak berhenti di permukaan.",
                        "Fungsi, pangkat, pecahan - kita gali sampai mengerti 'kenapa'-nya.",
                        "Jawab dengan pemahaman, bukan terkaan, dan puncak akan memanggilmu.",
                },
                [6] = {
                        "Akhirnya! Aku Kak Prima, penjaga Puncak Riset. Hanya penjelajah terdepan sampai sini.",
                        "Prima, modulo, pola Gauss - alat-alat para peneliti sejati.",
                        "Tak ada zona setelah ini. Tantanganmu sekarang: skor tertinggi di papan penjelajah!",
                },
        }
        return { npc = "KAK " .. string.upper(zone.name:split(" ")[2] or zone.name), zone = zoneIndex, pages = stories[zoneIndex] }
end

--------------------------------------------------------------------
-- START QUIZ
--------------------------------------------------------------------

local function onStartQuiz(player: Player, zoneIndex: any)
        if type(zoneIndex) ~= "number" or not DataService.has(player) then
                return nil
        end
        zoneIndex = math.clamp(math.floor(zoneIndex), 1, #Config.Zones)
        if zoneIndex > QuizService.unlockedZoneCount(player) then
                return { locked = true }
        end

        local q = MathGen.generate(zoneIndex)
        local qid = tostring(math.random(1, 1e9)) .. "-" .. tostring(os.clock())
        active[player] = {
                qid = qid,
                benar = q.benar,
                zoneIndex = zoneIndex,
                betul = q.betul,
                salah = q.salah,
                born = time(),
        }
        return {
                qid = qid,
                zone = zoneIndex,
                t = q.t,
                opsi = q.opsi,
                -- kunci jawaban TIDAK dikirim ke client
        }
end

--------------------------------------------------------------------
-- ANSWER QUIZ
--------------------------------------------------------------------

local function onAnswerQuiz(player: Player, qid: any, choice: any)
        local data = DataService.get(player)
        local now = time()

        if lastAnswer[player] and now - lastAnswer[player] < ANSWER_COOLDOWN then
                return nil
        end
        lastAnswer[player] = now

        local current = active[player]
        if not current or not DataService.has(player) or type(choice) ~= "number" then
                return nil
        end
        if type(qid) ~= "string" or qid ~= current.qid then
                return nil -- soal sudah basi / gak cocok
        end
        if now - current.born > Config.Progress.MaxActiveQuestionSeconds then
                active[player] = nil
                return { expired = true }
        end
        active[player] = nil

        local zone = Config.Zones[current.zoneIndex]
        local correct = (math.floor(choice) == current.benar)

        if not correct then
                data.Streak = 0
                DataService.markDirty(player)
                QuizService.pushState(player)
                return { correct = false, feedback = current.salah, zoneName = zone.name }
        end

        -- benar: streak + XP + koin
        data.Streak += 1
        data.BestStreak = math.max(data.BestStreak, data.Streak)
        local streakBonus = math.min(data.Streak, Config.Progress.StreakBonusMax)
        data.XP += Config.Progress.XpPerCorrect + streakBonus
        data.Coins += Config.Progress.CoinPerCorrect * current.zoneIndex

        local zoneId = zone.id
        data.Correct[zoneId] = (data.Correct[zoneId] or 0) + 1

        local justMastered = false
        if not data.Mastered[zoneId] and data.Correct[zoneId] >= Config.Progress.MasteryTarget then
                data.Mastered[zoneId] = true
                justMastered = true
                data.XP += Config.Progress.MasteryBonusXp
                data.Coins += Config.Progress.MasteryBonusCoins
                if Config.Progress.UnlockNextOnMastery and current.zoneIndex < #Config.Zones then
                        notify:FireClient(player, "Zona baru!", Config.Zones[current.zoneIndex + 1].name .. " telah terbuka!")
                end
        end

        DataService.markDirty(player)
        QuizService.pushState(player)
        return {
                correct = true,
                feedback = current.betul,
                zoneName = zone.name,
                streak = data.Streak,
                justMastered = justMastered,
        }
end

--------------------------------------------------------------------
-- BAHASAN (membaca topik)
--------------------------------------------------------------------

local function onReadTopic(player: Player, topicId: any)
        if type(topicId) ~= "string" or not DataService.has(player) then
                return nil
        end
        local data = DataService.get(player)
        if table.find(data.Read, topicId) then
                return { already = true, total = #data.Read }
        end
        table.insert(data.Read, topicId)
        data.XP += 5
        data.Coins += 2
        DataService.markDirty(player)
        QuizService.pushState(player)
        return { already = false, total = #data.Read, xp = data.XP }
end

--------------------------------------------------------------------
-- KODE PENJELAJAH (dev)
--------------------------------------------------------------------

local function onRedeemDevCode(player: Player, code: any)
        if type(code) ~= "string" or not DataService.has(player) then
                return false
        end
        if code ~= Config.DevCode then
                return false, "Kode salah."
        end
        local data = DataService.get(player)
        if data.Dev then
                return true, "Kode sudah aktif."
        end
        data.Dev = true
        DataService.markDirty(player)
        QuizService.pushState(player)
        notify:FireClient(player, "Penjelajah Dev", "Kode diterima. Selamat datang kembali, pembuat dunia!")
        return true, "Kode diterima!"
end

--------------------------------------------------------------------
-- STATE SYNC
--------------------------------------------------------------------

function QuizService.pushState(player: Player)
        if not DataService.has(player) then
                return
        end
        local data = DataService.get(player)

        -- sinkronkan leaderstats XP (papan peringkat standar Roblox)
        local stats = player:FindFirstChild("leaderstats")
        if stats then
                local xp = stats:FindFirstChild("XP")
                if xp and xp:IsA("IntValue") then
                        xp.Value = math.floor(data.XP)
                end
        end

        Remotes.get("StateSync"):FireClient(player, {
                XP = data.XP,
                Coins = data.Coins,
                Correct = data.Correct,
                Mastered = data.Mastered,
                Read = data.Read,
                ReadCount = #data.Read,
                Streak = data.Streak,
                BestStreak = data.BestStreak,
                Dev = data.Dev,
                Unlocked = QuizService.unlockedZoneCount(player),
                MasteryTarget = Config.Progress.MasteryTarget,
        })
end

--------------------------------------------------------------------
-- INIT
--------------------------------------------------------------------

function QuizService.init()
        Remotes.get("RequestStory").OnServerInvoke = onRequestStory
        Remotes.get("StartQuiz").OnServerInvoke = onStartQuiz
        Remotes.get("AnswerQuiz").OnServerInvoke = onAnswerQuiz
        Remotes.get("ReadTopic").OnServerInvoke = onReadTopic
        Remotes.get("RedeemDevCode").OnServerInvoke = onRedeemDevCode

        Players.PlayerRemoving:Connect(function(player)
                active[player] = nil
                lastAnswer[player] = nil
        end)
end

return QuizService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="15">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="16">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="17">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!nonstrict
--[[
	init.client.luau - bootstrap UI Dunia Akiomida.
]]

local UIController = require(script.UIController)

UIController.new()

print("[AKIOMIDA] Client siap.")
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">UIController</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
        UIController.luau - seluruh UI Dunia Akiomida (dibangun lewat kode):
          - HUD XP/koin/streak + chip zona saat menjelajah
          - panel cerita NPC -> kuis pilihan ganda + feedback edukatif
          - panel Bahasan (baca materi) + papan penjelajah + kode penjelajah
          - toast notifikasi
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local LessonData = require(ReplicatedStorage.Shared.LessonData)
local Remotes = require(ReplicatedStorage.Remotes)
local Util = require(ReplicatedStorage.Shared.Util)

local UIController = {}
UIController.__index = UIController

local T = {
        Bg = Color3.fromRGB(16, 19, 28),
        Panel = Color3.fromRGB(30, 34, 48),
        PanelLight = Color3.fromRGB(44, 49, 66),
        Gold = Color3.fromRGB(255, 209, 102),
        Green = Color3.fromRGB(88, 200, 130),
        Red = Color3.fromRGB(235, 100, 100),
        Blue = Color3.fromRGB(99, 200, 255),
        Text = Color3.fromRGB(238, 238, 246),
        TextDim = Color3.fromRGB(165, 170, 185),
        Disabled = Color3.fromRGB(70, 74, 88),
}

local player = Players.LocalPlayer

local function corner(parent, radius)
        return Util.create("UICorner", { CornerRadius = UDim.new(0, radius or 10) }, parent)
end

local function makeSound()
        return Util.create("Sound", {
                SoundId = "rbxasset://sounds/electronicpingshort.wav",
                Volume = 0.35,
        }, SoundService)
end

function UIController.new()
        local self = setmetatable({}, UIController)
        self.state = nil
        self.zoneIndex = 0
        self.sound = makeSound()

        self:buildRoot()
        self:buildHUD()
        self:buildZoneChip()
        self:buildDialog()
        self:buildQuiz()
        self:buildBahasan()
        self:buildLeaderboardPanel()
        self:buildDevPanel()
        self:buildNotify()
        self:wire()

        return self
end

--------------------------------------------------------------------
-- ROOT & HUD
--------------------------------------------------------------------

function UIController:buildRoot()
        self.gui = Util.create("ScreenGui", {
                Name = "AkiomidaUI",
                ResetOnSpawn = false,
                IgnoreGuiInset = true,
                ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        }, player:WaitForChild("PlayerGui"))
end

function UIController:buildHUD()
        local panel = Util.create("Frame", {
                Position = UDim2.new(0, 14, 0, 12),
                Size = UDim2.new(0, 300, 0, 40),
                BackgroundColor3 = T.Panel,
                Parent = self.gui,
        })
        corner(panel, 12)
        Util.create("UIListLayout", {
                FillDirection = Enum.FillDirection.Horizontal,
                Padding = UDim.new(0, 12),
                VerticalAlignment = Enum.VerticalAlignment.Center,
        }, panel)
        local function chip(text0: string, color: Color3)
                local l = Util.create("TextLabel", {
                        Size = UDim2.new(0, 92, 0, 26),
                        BackgroundTransparency = 1,
                        Font = Enum.Font.GothamBold,
                        Text = text0,
                        TextSize = 15,
                        TextColor3 = color,
                        Parent = panel,
                })
                return l
        end
        self.xpLabel = chip("XP 0", T.Gold)
        self.coinLabel = chip("Koin 0", T.Blue)
        self.streakLabel = chip("Runtun 0", T.Green)

        local lbBtn = Util.create("TextButton", {
                Position = UDim2.new(1, -134, 0, 12),
                Size = UDim2.new(0, 120, 0, 40),
                BackgroundColor3 = T.Panel,
                Font = Enum.Font.GothamBlack,
                Text = "PAPAN XP",
                TextSize = 16,
                TextColor3 = T.Text,
                Parent = self.gui,
        })
        corner(lbBtn, 12)
        lbBtn.Activated:Connect(function()
                self:setLBOpen(not self.lbOpen)
        end)

        local devBtn = Util.create("TextButton", {
                Position = UDim2.new(1, -168, 0, 12),
                Size = UDim2.new(0, 30, 0, 40),
                BackgroundColor3 = T.Panel,
                Font = Enum.Font.GothamBlack,
                Text = "*",
                TextSize = 22,
                TextColor3 = T.TextDim,
                Parent = self.gui,
        })
        corner(devBtn, 12)
        devBtn.Activated:Connect(function()
                self.devFrame.Visible = not self.devFrame.Visible
        end)
end

function UIController:buildZoneChip()
        local chip = Util.create("Frame", {
                AnchorPoint = Vector2.new(0.5, 0),
                Position = UDim2.new(0.5, 0, 0, 12),
                Size = UDim2.new(0, 320, 0, 56),
                BackgroundColor3 = T.Bg,
                BackgroundTransparency = 0.1,
                Parent = self.gui,
        })
        corner(chip, 14)
        Util.create("UIStroke", { Color = T.PanelLight, Thickness = 2 }, chip)
        self.zoneChip = chip

        self.zoneName = Util.create("TextLabel", {
                Position = UDim2.new(0, 12, 0, 8),
                Size = UDim2.new(1, -24, 0, 22),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBlack,
                Text = "",
                TextScaled = true,
                TextColor3 = T.Text,
                Parent = chip,
        })
        self.zoneSlogan = Util.create("TextLabel", {
                Position = UDim2.new(0, 12, 0, 32),
                Size = UDim2.new(1, -24, 0, 16),
                BackgroundTransparency = 1,
                Font = Enum.Font.Gotham,
                Text = "",
                TextScaled = true,
                TextColor3 = T.TextDim,
                Parent = chip,
        })
        self.zoneProgress = Util.create("TextLabel", {
                AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, -10, 0, 8),
                Size = UDim2.new(0, 80, 0, 16),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBold,
                Text = "",
                TextSize = 13,
                TextColor3 = T.Gold,
                TextXAlignment = Enum.TextXAlignment.Right,
                Parent = chip,
        })
end

