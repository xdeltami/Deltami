                        CFrame = CFrame.new(x + 1.4 + (i - 1) * 1.7, 2.9, z + 5.4),
                        Color = Color3.fromRGB(150 + i * 20, 170, 200),
                        Material = Enum.Material.SmoothPlastic,
                }, parent)
        end
        part({ Name = "PancingAkuariumKaca", Size = Vector3.new(9, 5, 3), CFrame = CFrame.new(x - 3, 6.5, z - 6.4), Color = Color3.fromRGB(180, 220, 240), Material = Enum.Material.Glass, Transparency = 0.55 }, parent)
        part({ Name = "PancingAkuariumAir", Size = Vector3.new(8.4, 4.2, 2.5), CFrame = CFrame.new(x - 3, 6.3, z - 6.4), Color = Color3.fromRGB(70, 150, 210), Material = Enum.Material.Glass, Transparency = 0.35, CanCollide = false }, parent)
        for i = 1, 3 do
                part({
                        Name = "PancingIkanHias" .. i,
                        Size = Vector3.new(1.2, 0.8, 0.5),
                        CFrame = CFrame.new(x - 6 + i * 2.4, 5.8 + (i % 2) * 1.2, z - 6.4) * CFrame.Angles(0, math.rad(i * 70), 0),
                        Color = Color3.fromHSV(i / 3, 0.7, 0.95),
                        Material = Enum.Material.SmoothPlastic,
                        CanCollide = false,
                }, parent)
        end
        part({ Name = "PancingTrofiRak", Size = Vector3.new(4.4, 0.4, 1.2), CFrame = CFrame.new(x + 6.4, 6.8, z + 1), Color = Color3.fromRGB(104, 90, 70), Material = Enum.Material.Wood }, parent)
        for i = 1, 2 do
                part({
                        Name = "PancingTrofi" .. i,
                        Size = Vector3.new(1.4, 0.9, 0.6),
                        CFrame = CFrame.new(x + 5.4 + i * 1.9, 7.5, z + 1) * CFrame.Angles(0, math.rad(i * 40 - 20), 0),
                        Color = Color3.fromRGB(240, 204, 108),
                        Material = Enum.Material.Metal,
                        CanCollide = false,
                }, parent)
        end
        infoPrompt(board, "RUANG PANCING", "Gudang pancing pribadimu - rak joran, meja umpan & akuarium ikan hias. Isi ruangan ini akan terus bertambah!")
end

local function buildKoperasi(index: number, center: Vector3, yawDeg: number, koperasiName: string, parent)
        local base = CFrame.new(center) * CFrame.Angles(0, math.rad(yawDeg), 0)
        part({ Name = "KoperasiLantai", Size = Vector3.new(14, 0.5, 12), CFrame = base * CFrame.new(0, 0.25, 0), Color = Color3.fromRGB(196, 188, 176), Material = Enum.Material.Concrete }, parent)
        for _, px in { -6, 6 } do
                for _, pz in { -5, 5 } do
                        part({ Name = "KoperasiTiang", Size = Vector3.new(0.8, 9, 0.8), CFrame = base * CFrame.new(px, 4.9, pz), Color = Color3.fromRGB(150, 108, 66), Material = Enum.Material.Wood }, parent)
                end
        end
        part({ Name = "KoperasiAtap", Size = Vector3.new(16, 1, 14), CFrame = base * CFrame.new(0, 10, 0), Color = Color3.fromRGB(178, 74, 60), Material = Enum.Material.Slate }, parent)
        part({ Name = "KoperasiKonter", Size = Vector3.new(9, 3.4, 2), CFrame = base * CFrame.new(0, 2.2, -3), Color = Color3.fromRGB(150, 108, 66), Material = Enum.Material.WoodPlanks }, parent)
        part({ Name = "KoperasiKonterAtas", Size = Vector3.new(10, 0.4, 2.6), CFrame = base * CFrame.new(0, 4.1, -3), Color = Color3.fromRGB(104, 78, 50), Material = Enum.Material.Wood }, parent)
        for i = 1, 2 do
                part({ Name = "KoperasiRak" .. i, Size = Vector3.new(2.6, 2, 1.2), CFrame = base * CFrame.new(-4 + (i - 1) * 8, 1.4, 3.6), Color = Color3.fromRGB(120, 92, 60), Material = Enum.Material.Wood }, parent)
                for g = 1, 3 do
                        part({
                                Name = "KoperasiBarang" .. i .. g,
                                Size = Vector3.new(0.9, 0.9, 0.9),
                                CFrame = base * CFrame.new(-4.8 + (i - 1) * 8 + g * 0.9, 2.4, 3.6),
                                Color = Color3.fromHSV((g + i) / 6, 0.55, 0.95),
                                Material = Enum.Material.SmoothPlastic,
                                CanCollide = false,
                        }, parent)
                end
        end
        local sign = part({
                Name = "KoperasiPapan",
                Size = Vector3.new(12, 3, 0.6),
                CFrame = base * CFrame.new(0, 12, -5.6),
                Color = Color3.fromRGB(34, 38, 52),
                Material = Enum.Material.SmoothPlastic,
        }, parent)
        surfaceText(sign, "KOPERASI", koperasiName, Color3.fromRGB(255, 209, 102))
        local prompt = Instance.new("ProximityPrompt")
        prompt.ActionText = "Buka Koperasi"
        prompt.ObjectText = "Koperasi " .. koperasiName
        prompt.MaxActivationDistance = 10
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
        prompt.Parent = sign
        prompt.Triggered:Connect(function(player: Player)
                Remotes.get("OpenKoperasi"):FireClient(player, koperasiName)
        end)
end

local function buildPond(center: Vector3, svc, parent)
        local terrain = workspace.Terrain
        terrain.WaterWaveSize = 0.14
        terrain.WaterWaveSpeed = 14
        terrain.WaterReflectance = 0.35
        terrain.WaterTransparency = 0.55
        terrain:FillBlock(CFrame.new(center.X, -3.6, center.Z), Vector3.new(44, 10, 36), Enum.Material.Air)
        terrain:FillBlock(CFrame.new(center.X, -5.1, center.Z), Vector3.new(50, 9.5, 42), Enum.Material.Sand)
        terrain:FillBlock(CFrame.new(center.X, -5.05, center.Z), Vector3.new(40, 9, 32), Enum.Material.Water)
        svc.Gather.buildPier(center + Vector3.new(14, 0, 0), Vector3.new(-1, 0, 0))
        local rng = Random.new(101 + math.floor(center.X))
        for i = 1, 4 do
                local ang = (i / 4) * math.pi * 2 + rng:NextNumber(-0.3, 0.3)
                local bx = center.X + math.cos(ang) * 21
                local bz = center.Z + math.sin(ang) * 17
                for s = -1, 1, 2 do
                        part({
                                Name = "Alang" .. i .. s,
                                Size = Vector3.new(0.24, 3.2, 0.24),
                                CFrame = CFrame.new(bx + s * 0.5, 1.4, bz),
                                Color = Color3.fromRGB(112, 156, 82),
                                Material = Enum.Material.Grass,
                                CanCollide = false,
                        }, parent)
                end
                part({
                        Name = "AlangKepala" .. i,
                        Size = Vector3.new(0.5, 1, 0.5),
                        CFrame = CFrame.new(bx, 3, bz),
                        Color = Color3.fromRGB(150, 116, 70),
                        Material = Enum.Material.SmoothPlastic,
                        CanCollide = false,
                }, parent)
        end
end

function PersonalWorldBuilder.buildShell(index: number)
        if built[index] then
                return
        end
        local hx, hz = Balance.homeCenter(index)
        local folder = lahanFolder(index)
        part({ Name = "LahanPlaza" .. index, Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 26, 26), CFrame = CFrame.new(hx + 70, 0.16, hz) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(196, 188, 176), Material = Enum.Material.Granite }, folder)
        part({ Name = "LahanJalan" .. index, Size = Vector3.new(120, 0.24, 7), CFrame = CFrame.new(hx + 27, 0.12, hz), Color = Color3.fromRGB(186, 180, 170), Material = Enum.Material.Concrete }, folder)
        part({ Name = "LahanPagarU" .. index, Size = Vector3.new(196, 3, 2), CFrame = CFrame.new(hx, 1.5, hz - 89), Color = Color3.fromRGB(66, 122, 66), Material = Enum.Material.Grass }, folder)
        part({ Name = "LahanPagarS" .. index, Size = Vector3.new(196, 3, 2), CFrame = CFrame.new(hx, 1.5, hz + 89), Color = Color3.fromRGB(66, 122, 66), Material = Enum.Material.Grass }, folder)
        part({ Name = "LahanPagarB" .. index, Size = Vector3.new(2, 3, 180), CFrame = CFrame.new(hx - 99, 1.5, hz), Color = Color3.fromRGB(66, 122, 66), Material = Enum.Material.Grass }, folder)
        part({ Name = "LahanPagarT1" .. index, Size = Vector3.new(2, 3, 56), CFrame = CFrame.new(hx + 99, 1.5, hz - 61), Color = Color3.fromRGB(66, 122, 66), Material = Enum.Material.Grass }, folder)
        part({ Name = "LahanPagarT2" .. index, Size = Vector3.new(2, 3, 56), CFrame = CFrame.new(hx + 99, 1.5, hz + 61), Color = Color3.fromRGB(66, 122, 66), Material = Enum.Material.Grass }, folder)
        signBoard("LahanPapanInfo" .. index, Vector3.new(hx + 86, 0, hz + 14), 90, "LAHAN " .. index, "Belum dimiliki - masuk lewat gerbang!", Color3.fromRGB(96, 66, 38), folder)
        built[index] = false
end

function PersonalWorldBuilder.buildFull(index: number, svc, koperasiName: string): boolean
        if built[index] then
                return false
        end
        PersonalWorldBuilder.buildShell(index)
        built[index] = true
        local hx, hz = Balance.homeCenter(index)
        local C = Vector3.new(hx, 0, hz)
        local folder = lahanFolder(index)
        local at = function(dx: number, dy: number, dz: number)
                return C + Vector3.new(dx, dy, dz)
        end

        part({ Name = "LahanJalanCabangRumah", Size = Vector3.new(6, 0.24, 34), CFrame = at(-32, 0.12, -18), Color = Color3.fromRGB(186, 180, 170), Material = Enum.Material.Concrete }, folder)
        part({ Name = "LahanJalanCabangKebun", Size = Vector3.new(6, 0.24, 9), CFrame = at(-48, 0.12, 8.75), Color = Color3.fromRGB(186, 180, 170), Material = Enum.Material.Concrete }, folder)
        part({ Name = "LahanJalanRuangan", Size = Vector3.new(84, 0.24, 6), CFrame = at(34, 0.12, 46), Color = Color3.fromRGB(186, 180, 170), Material = Enum.Material.Concrete }, folder)

        buildHouse(at(-52, 0, -38), folder)
        svc.Farm.buildField(index, at(-48, 0.4, 48))
        buildPond(at(40, 0, -50), svc, folder)

        buildSurgeryRoom(at(6, 0, 62), folder)
        buildScienceRoom(at(34, 0, 62), folder)
        buildStartopiaRoom(at(62, 0, 62), folder)
        buildFishingRoom(at(88, 0, 62), folder)

        buildKoperasi(index, at(74, 0, -24), 90, koperasiName, folder)

        nameBoard(index, at(88, 0, 16), 90, folder)
        for _, pos in { at(84, 0, 11), at(84, 0, -11), at(-14, 0, 9), at(-45, 0, 26), at(37, 0, 44), at(45, 0, -27), at(62, 0, -12) } do
                lamp(pos, folder)
        end
        decorativeTree(at(0, 0, -78), 300 + index * 2, folder)
        decorativeTree(at(80, 0, -64), 300 + index * 2 + 1, folder)
        decorativeTree(at(-84, 0, -6), 307 + index * 2, folder)

        local rng = Random.new(500 + index)
        local flowerColors = {
                Color3.fromRGB(255, 120, 150), Color3.fromRGB(255, 210, 90),
                Color3.fromRGB(150, 200, 255), Color3.fromRGB(200, 140, 255),
        }
        local function blocked(fx: number, fz: number): boolean
                if math.abs(fz) < 7 then return true end
                if fx > -70 and fx < -34 and fz > -54 and fz < -22 then return true end
                if fx > -95 and fx < -1 and fz > 10 and fz < 86 then return true end
                if fx > -8 and fx < 100 and fz > 50 and fz < 74 then return true end
                if fx > 12 and fx < 66 and fz > -72 and fz < -28 then return true end
                if math.abs(fx - 70) < 17 and math.abs(fz) < 17 then return true end
                if math.abs(fz + 24) < 9 and fx > 64 and fx < 86 then return true end
                return false
        end
        for i = 1, 10 do
                local fx = rng:NextNumber(-92, 92)
                local fz = rng:NextNumber(-82, 82)
                if not blocked(fx, fz) then
                        part({
                                Name = "LahanBunga" .. i,
                                Shape = Enum.PartType.Ball,
                                Size = Vector3.new(1, 1, 1) * rng:NextNumber(0.8, 1.4),
                                CFrame = at(fx, 0.55, fz),
                                Color = flowerColors[rng:NextInteger(1, #flowerColors)],
                                Material = Enum.Material.Grass,
                                CanCollide = false,
                        }, folder)
                end
        end

        local sx, sz = Balance.landSpawn(index)
        local spawn = Instance.new("SpawnLocation")
        spawn.Name = "SpawnLahan" .. index
        spawn.Size = Vector3.new(6, 0.4, 6)
        spawn.CFrame = CFrame.new(sx, 0.4, sz)
        spawn.Anchored = true
        spawn.Transparency = 1
        spawn.CanCollide = false
        spawn.Neutral = true
        spawn.Duration = 0
        spawn.Parent = folder
        return true
end

function PersonalWorldBuilder.isBuilt(index: number): boolean
        return built[index] == true
end

return PersonalWorldBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">RegionService</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Remotes = require(ReplicatedStorage.Remotes)
local Balance = require(ReplicatedStorage.Shared.Balance)
local Util = require(ReplicatedStorage.Shared.Util)

local RegionService = {}

local DataService
local FarmService
local PersonalWorldBuilder

local worldFolder: Folder? = nil
local homeTaken: { [number]: Player } = {}

local function world(): Folder
        local f = worldFolder
        if not f then
                f = workspace:FindFirstChild("AKM_Dunia") :: Folder?
                if not f then
                        f = Instance.new("Folder")
                        f.Name = "AKM_Dunia"
                        f.Parent = workspace
                end
                worldFolder = f
        end
        return f :: Folder
end

local function part(props): Part
        local p = Instance.new("Part")
        p.Anchored = true
        p.TopSurface = Enum.SurfaceType.Smooth
        p.BottomSurface = Enum.SurfaceType.Smooth
        for k, v in props do
                (p :: any)[k] = v
        end
        p.Parent = world()
        return p
end

local PORTAL_COLORS = {
        home = Color3.fromRGB(120, 220, 160),
        pusat = Color3.fromRGB(255, 209, 102),
        padang = Color3.fromRGB(240, 130, 90),
        hutan = Color3.fromRGB(130, 200, 235),
        baja = Color3.fromRGB(190, 120, 255),
}

local GATE_LABEL = {
        padang = "PADANG LIAR (MONSTER)",
        hutan = "HUTAN BAYANG (MONSTER)",
        baja = "NEGERI BAJA & KRISTAL (MONSTER)",
}

local function buildGate(pos: Vector3, nX: number, nZ: number, destId: string, label: string)
        local color = PORTAL_COLORS[destId] or Color3.fromRGB(200, 200, 210)
        local len = math.sqrt(nX * nX + nZ * nZ)
        if len < 0.001 then
                nX, nZ = 0, -1
                len = 1
        end
        local base = CFrame.lookAt(pos, pos + Vector3.new(nX / len, 0, nZ / len))

        part({
                Name = "PortalLantai",
                Size = Vector3.new(8, 0.3, 10),
                CFrame = base * CFrame.new(0, 0.15, 0),
                Color = Color3.fromRGB(198, 190, 178),
                Material = Enum.Material.Granite,
        })
        for _, side in { -1, 1 } do
                part({
                        Name = "PortalPilar",
                        Size = Vector3.new(2, 12, 2),
                        CFrame = base * CFrame.new(side * 4.4, 6, 0),
                        Color = Color3.fromRGB(72, 76, 92),
                        Material = Enum.Material.SmoothPlastic,
                })
                part({
                        Name = "PortalPilarOrnamen",
                        Shape = Enum.PartType.Ball,
                        Size = Vector3.new(1.6, 1.6, 1.6),
                        CFrame = base * CFrame.new(side * 4.4, 12.6, 0),
                        Color = color,
                        Material = Enum.Material.Neon,
                        CanCollide = false,
                })
        end
        part({
                Name = "PortalPalang",
                Size = Vector3.new(11, 2, 2.2),
                CFrame = base * CFrame.new(0, 13.4, 0),
                Color = Color3.fromRGB(44, 48, 62),
                Material = Enum.Material.SmoothPlastic,
        })
        local plane = part({
                Name = "PortalCahaya",
                Size = Vector3.new(7.6, 10.6, 0.4),
                CFrame = base * CFrame.new(0, 5.5, 0),
                Color = color,
                Material = Enum.Material.Neon,
                Transparency = 0.55,
                CanCollide = false,
        })
        local board = part({
                Name = "PortalPapan",
                Size = Vector3.new(10.5, 2.6, 0.6),
                CFrame = base * CFrame.new(0, 15.4, 0),
                Color = Color3.fromRGB(30, 34, 46),
                Material = Enum.Material.SmoothPlastic,
        })
        local gui = Instance.new("SurfaceGui")
        gui.Face = Enum.NormalId.Front
        gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
        gui.PixelsPerStud = 48
        gui.Parent = board
        Util.create("TextLabel", {
                Size = UDim2.fromScale(1, 1),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBlack,
                TextScaled = true,
                TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.35),
                Text = label,
        }, board)

        local prompt = Instance.new("ProximityPrompt")
        prompt.ActionText = "Masuki Portal"
        prompt.ObjectText = label
        prompt.MaxActivationDistance = 10
        prompt.HoldDuration = 0.35
        prompt.RequiresLineOfSight = false
        prompt.Parent = plane
        prompt.Triggered:Connect(function(player: Player)
                RegionService.travel(player, destId)
        end)
end

local function teleportTo(player: Player, regionId: string, fromRegionId: string)
        local ax, az = Balance.gateArrival(regionId, fromRegionId)
        if not ax then
                local r = Balance.regionById(regionId)
                ax, az = r and r.center[1] or 0, r and r.center[2] or 0
        end
        local character = player.Character
        if not character then
                return
        end
        local root = character:FindFirstChild("HumanoidRootPart")
        if root then
                root.Anchored = false
                character:PivotTo(CFrame.new(ax, 4, az) * CFrame.Angles(0, math.rad(Balance.regionById(regionId).kind == "hub" and 180 or 0), 0))
                Util.burst(root, Color3.fromRGB(255, 236, 170), 14, 8)
        end
        local region = Balance.regionById(regionId)
        Remotes.get("Notify"):FireClient(player, "-> " .. (region and region.name or regionId),
                regionId == "pusat" and "Selamat datang di Pusat Kota - TOKO BENIH ada di sini!"
                        or "Kau memasuki " .. (region and region.name or regionId) .. ".")
end

local function landSpawnLocation(index: number): SpawnLocation?
        local folder = world():FindFirstChild("Lahan" .. index)
        if not folder then
                return nil
        end
        return folder:FindFirstChild("SpawnLahan" .. index) :: SpawnLocation?
end

local function goToOwnLahan(player: Player): boolean
        local homeId = DataService.getHomeId(player)
        if homeId < 1 then
                return false
        end
        local spawnLoc = landSpawnLocation(homeId)
        local character = player.Character
        if not character then
                return true
        end
        local root = character:FindFirstChild("HumanoidRootPart")
        if not root then
                return true
        end
        if spawnLoc then
                player.RespawnLocation = spawnLoc
                character:PivotTo(spawnLoc.CFrame + Vector3.new(0, 4, 0))
        else
                local sx, sz = Balance.landSpawn(homeId)
                character:PivotTo(CFrame.new(sx, 4, sz))
        end
        Util.burst(root, Color3.fromRGB(150, 240, 180), 14, 8)
        return true
end

local function claimLahan(player: Player): number
        local homeId = DataService.getHomeId(player)
        if homeId >= 1 then
                return homeId
        end
        local taken = {}
        for idx, owner in homeTaken do
                if owner ~= player and owner.Parent then
                        taken[idx] = true
                end
        end
        local idx = Balance.nextFreeHome(taken)
        if idx < 1 then
                return 0
        end
        DataService.setHomeId(player, idx)
        homeTaken[idx] = player
        local koperasiName = DataService.ensureKoperasiName(player)
        PersonalWorldBuilder.buildFull(idx, { Farm = FarmService, Gather = require(script.Parent.GatherService) }, koperasiName)
        FarmService.claimFieldFor(player, idx)
        return idx
end

local function travelHome(player: Player)
        local idx = claimLahan(player)
        if idx < 1 then
                Remotes.get("Notify"):FireClient(player, "Lahan Penuh",
                        "Semua lahan sudah dimiliki pemain lain. Coba lagi nanti!")
                return
        end
        if goToOwnLahan(player) then
                Remotes.get("Notify"):FireClient(player, "LAHANMU!",
                        "Selamat datang di lahanmu sendiri: rumah 3 lantai + rooftop, kebun 500 petak, kolam air, ruang Bedah/Sains/Startopia/Pancing & koperasimu.")
        end
        local landName = DataService.getLandName(player)
        if landName == "" then
                task.delay(1.2, function()
                        if player.Parent then
                                Remotes.get("OpenLandBoard"):FireClient(player)
                        end
                end)
        end
end

function RegionService.travel(player: Player, destId: string)
        if not DataService.has(player) then
                return
        end
        local character = player.Character
        local fromId = "pusat"
        if character then
                local root = character:FindFirstChild("HumanoidRootPart")
                if root then
                        local p = root.Position
                        for _, r in ipairs(Balance.Regions) do
                                if math.abs(p.X - r.center[1]) <= r.half[1] and math.abs(p.Z - r.center[2]) <= r.half[2] then
                                        fromId = r.id
                                        break
                                end
                        end
                end
        end
        if destId == "home" then
                travelHome(player)
                return
        end
        if Balance.regionById(destId) then
                teleportTo(player, destId, fromId)
        end
end

function RegionService.onPlayerAdded(player: Player)
        local homeId = claimLahan(player)
        if homeId >= 1 then
                homeTaken[homeId] = player
                task.delay(2.5, function()
                        if not player.Parent then
                                return
                        end
                        goToOwnLahan(player)
                        local landName = DataService.getLandName(player)
                        if landName == "" then
                                Remotes.get("Notify"):FireClient(player, "PAPAN NAMA",
                                        "Isi papan nama lahanku supaya pengunjung tahu siapa pemiliknya!")
                                Remotes.get("OpenLandBoard"):FireClient(player)
                        end
                end)
        end
end

function RegionService.onCharacterAdded(player: Player)
        local homeId = DataService.getHomeId(player)
        if homeId < 1 then
                return
        end
        local spawnLoc = landSpawnLocation(homeId)
        if spawnLoc then
                player.RespawnLocation = spawnLoc
        end
end

function RegionService.onPlayerRemoving(player: Player)
        for idx, owner in homeTaken do
                if owner == player then
                        homeTaken[idx] = nil
                end
        end
end

local function handleLandBoard(player: Player, text: any)
        local cleaned = Balance.sanitizeLandName(text)
        if not cleaned then
                return false, "Nama lahan harus 3-20 huruf/angka (spasi, titik, minus, apostrof diperbolehkan)."
        end
        DataService.setLandName(player, cleaned)
        local homeId = DataService.getHomeId(player)
        if homeId >= 1 then
                PersonalWorldBuilder.setNameBoard(homeId, cleaned)
        end
        return true, "Papan nama lahanmu kini: " .. cleaned
end

function RegionService.init(svc)
        DataService = svc.Data
        FarmService = svc.Farm
        PersonalWorldBuilder = require(script.Parent.PersonalWorldBuilder)

        for _, region in ipairs(Balance.Regions) do
                for _, gate in ipairs(region.gates) do
                        local label = GATE_LABEL[gate.dest]
                        if gate.dest == "home" then
                                label = "LAHANMU (RUMAH & KEBUN)"
                        elseif gate.dest == "pusat" then
                                label = "PUSAT KOTA"
                        elseif not label then
                                local r = Balance.regionById(gate.dest)
                                label = r and string.upper(r.name) or string.upper(gate.dest)
                        end
                        local nX = region.center[1] - gate.pos[1]
                        local nZ = region.center[2] - gate.pos[2]
                        buildGate(Vector3.new(gate.pos[1], 0, gate.pos[2]), nX, nZ, gate.dest, label)
                end
        end

        Remotes.get("LandBoard").OnServerInvoke = handleLandBoard

        Players.PlayerAdded:Connect(function(player)
                player.CharacterAdded:Connect(function()
                        RegionService.onCharacterAdded(player)
                end)
                if player.Character then
                        RegionService.onCharacterAdded(player)
                end
        end)

        print("[AKIOMIDA] RegionService: " .. #Balance.Regions .. " wilayah & gerbang portal dibangun.")
end

return RegionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">SeedShopService</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Remotes)
local Util = require(ReplicatedStorage.Shared.Util)
local CropConfig = require(ReplicatedStorage.Shared.CropConfig)
local TasLogic = require(ReplicatedStorage.Shared.TasLogic)

local DataService = require(script.Parent.DataService)

local SeedShopService = {}

local function rollPack(pack): { { kind: string, id: string, n: number } }
        local pool = CropConfig.byRarity(pack.rarity)
        local out = {}
        for _ = 1, pack.count do
                local crop = pool[math.random(1, #pool)]
                table.insert(out, { kind = "seed", id = crop.id, n = 1 })
        end
        return out
end

local function summarize(items: { { kind: string, id: string, n: number } }): { [string]: number }
        local totals: { [string]: number } = {}
        for _, item in ipairs(items) do
                totals[item.id] = (totals[item.id] or 0) + item.n
        end
        return totals
end

local function buyPack(player: Player, packId: string)
        local pack = CropConfig.packById(packId)
        if not pack then
                return { ok = false, msg = "Pack tidak dikenal." }
        end
        local data = DataService.get(player)
        if data.Coins < pack.price then
                return { ok = false, msg = "Micda kurang! Butuh " .. Util.formatNumber(pack.price) .. ", punya " .. Util.formatNumber(data.Coins) .. "." }
        end
        local rolled = rollPack(pack)
        local seeds, crops = DataService.tasTables(player)
        if not TasLogic.canFitBatch(seeds, crops, rolled) then
                return { ok = false, msg = "TAS PENUH! Kosongkan slot tas dulu (maks 50 slot)." }
        end
        DataService.spend(player, pack.price)
        for _, item in ipairs(rolled) do
                DataService.giveItem(player, "seed", item.id, item.n)
        end
        DataService.push(player)
        local parts = {}
        for id, n in pairs(summarize(rolled)) do
                table.insert(parts, n .. "x Benih " .. CropConfig.nameOf(id))
        end
        table.sort(parts)
        return { ok = true, msg = pack.name .. " berisi: " .. table.concat(parts, ", ") }
end

local function combine(player: Player, idA: string, idB: string)
        if idA == idB then
                return { ok = false, msg = "Gabung butuh dua benih yang berbeda." }
        end
        local recipe = CropConfig.findRecipe(idA, idB)
        if not recipe then
                return { ok = false, msg = "Kombinasi ini tidak ada di daftar resep!" }
        end
        if DataService.countItem(player, "seed", recipe.inputs[1]) < 1
                or DataService.countItem(player, "seed", recipe.inputs[2]) < 1 then
                return { ok = false, msg = "Butuh 1 Benih " .. CropConfig.nameOf(recipe.inputs[1]) .. " + 1 Benih " .. CropConfig.nameOf(recipe.inputs[2]) .. "." }
        end
        DataService.takeItem(player, "seed", recipe.inputs[1], 1)
        DataService.takeItem(player, "seed", recipe.inputs[2], 1)
        local seeds, crops = DataService.tasTables(player)
        if TasLogic.roomFor(seeds, crops, "seed", recipe.out, 1) < 1 then
                DataService.giveItem(player, "seed", recipe.inputs[1], 1)
                DataService.giveItem(player, "seed", recipe.inputs[2], 1)
                return { ok = false, msg = "TAS PENUH! Tidak ada ruang untuk Benih " .. CropConfig.nameOf(recipe.out) .. "." }
        end
        DataService.giveItem(player, "seed", recipe.out, 1)
        DataService.push(player)
        return { ok = true, msg = "GABUNG BERHASIL: Benih " .. CropConfig.nameOf(recipe.inputs[1]) .. " + Benih " .. CropConfig.nameOf(recipe.inputs[2]) .. " = Benih " .. CropConfig.nameOf(recipe.out) .. "!" }
end

function SeedShopService.init()
        Remotes.get("TokoAct").OnServerInvoke = function(player, payload)
                if not DataService.has(player) or type(payload) ~= "table" then
                        return { ok = false, msg = "Permintaan tidak valid." }
                end
                if payload.action == "buyPack" then
                        return buyPack(player, tostring(payload.pack or ""))
                elseif payload.action == "combine" then
                        return combine(player, tostring(payload.a or ""), tostring(payload.b or ""))
                end
                return { ok = false, msg = "Aksi tidak dikenal." }
        end
end

return SeedShopService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="27">
