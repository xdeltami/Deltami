-- BUILD ALL
--------------------------------------------------------------------

function MapService.init(svc)
        folder.Parent = workspace

        ---------------------------------------------------------------- pulau & langit
        part({
                Name = "Pulau",
                Size = Vector3.new(640, 8, 640),
                CFrame = CFrame.new(0, -4, 0),
                Color = Color3.fromRGB(105, 168, 90),
                Material = Enum.Material.Grass,
        })
        part({
                Name = "Samudra",
                Size = Vector3.new(2600, 2, 2600),
                CFrame = CFrame.new(0, -3, 0),
                Color = Color3.fromRGB(48, 118, 180),
                Material = Enum.Material.Glass,
                Transparency = 0.2,
        })

        -- atmosfer cerah (bukan kabut kelabu!)
        local atmo = Instance.new("Atmosphere")
        atmo.Density = 0.14
        atmo.Offset = 0.2
        atmo.Color = Color3.fromRGB(205, 215, 235)
        atmo.Glare = 0.15
        atmo.Haze = 0.8
        atmo.Parent = game:GetService("Lighting")

        -- perbukitan cakrawala
        local rngBukit = Random.new(88)
        for i = 1, 10 do
                local angle = (i / 10) * math.pi * 2
                local dist = 285 + rngBukit:NextNumber(-15, 15)
                local h = rngBukit:NextNumber(24, 42)
                part({
                        Name = "Bukit" .. i,
                        Shape = Enum.PartType.Cylinder,
                        Size = Vector3.new(h, rngBukit:NextNumber(90, 130), rngBukit:NextNumber(90, 130)),
                        CFrame = CFrame.new(math.cos(angle) * dist, h / 2 - 8, math.sin(angle) * dist)
                                * CFrame.Angles(0, 0, math.rad(90)),
                        Color = Color3.fromRGB(70, 120, 78):Lerp(Color3.fromRGB(50, 90, 110), rngBukit:NextNumber(0, 0.5)),
                        Material = Enum.Material.Grass,
                })
        end

        -- awan
        local rngAwan = Random.new(77)
        for i = 1, 8 do
                part({
                        Name = "Awan" .. i,
                        Shape = Enum.PartType.Ball,
                        Size = Vector3.new(1, 1, 1) * rngAwan:NextNumber(28, 56),
                        CFrame = CFrame.new(rngAwan:NextNumber(-240, 240), rngAwan:NextNumber(85, 125), rngAwan:NextNumber(-240, 240)),
                        Color = Color3.new(1, 1, 1),
                        Material = Enum.Material.SmoothPlastic,
                        Transparency = 0.35,
                        CanCollide = false,
                })
        end

        ---------------------------------------------------------------- jalan
        part({
                Name = "JalanUtara",
                Size = Vector3.new(10, 0.3, 60),
                CFrame = CFrame.new(0, 0.15, -30),
                Color = Color3.fromRGB(178, 172, 162),
                Material = Enum.Material.Concrete,
        })
        part({
                Name = "JalanSelatan",
                Size = Vector3.new(10, 0.3, 105),
                CFrame = CFrame.new(0, 0.15, 52.5),
                Color = Color3.fromRGB(178, 172, 162),
                Material = Enum.Material.Concrete,
        })
        part({
                Name = "JalanTimurBarat",
                Size = Vector3.new(280, 0.3, 10),
                CFrame = CFrame.new(0, 0.15, 0),
                Color = Color3.fromRGB(178, 172, 162),
                Material = Enum.Material.Concrete,
        })
        part({
                Name = "JalanPasar",
                Size = Vector3.new(10, 0.3, 84),
                CFrame = CFrame.new(90, 0.15, 0),
                Color = Color3.fromRGB(178, 172, 162),
                Material = Enum.Material.Concrete,
        })
        part({
                Name = "PlazaLingkaran",
                Shape = Enum.PartType.Cylinder,
                Size = Vector3.new(0.3, 38, 38),
                CFrame = CFrame.new(0, 0.28, 0) * CFrame.Angles(0, 0, math.rad(90)),
                Color = Color3.fromRGB(196, 188, 176),
                Material = Enum.Material.Granite,
        })

        -- lampu jalan
        for _, z in { -50, -25, 25, 50, 75, 100 } do
                buildLamp(Vector3.new(-6.8, 0, z))
                buildLamp(Vector3.new(6.8, 0, z))
        end
        for _, x in { -125, -100, -75, -50, 50, 75, 100, 125 } do
                buildLamp(Vector3.new(x, 0, -6.8))
                buildLamp(Vector3.new(x, 0, 6.8))
        end

        ---------------------------------------------------------------- alun-alun
        buildPlaza()

        -- Kak Pintar: kuis opsional (tidak pernah memaksa!)
        local quizPrompt = buildNPC("KAK PINTAR", Vector3.new(10, 0, 14), Color3.fromRGB(88, 200, 130))
        svc.Quiz.bindPrompt(quizPrompt)

        -- v4 PAPAN JUAL: pasar pemain (jual-beli antar pemain dengan Micda)
        do
                local mx, mz = -10, 16
                part({
                        Name = "PapanJualTiang",
                        Size = Vector3.new(0.8, 6.4, 0.8),
                        CFrame = CFrame.new(mx, 3.2, mz),
                        Color = Color3.fromRGB(70, 74, 88),
                        Material = Enum.Material.Metal,
                })
                local board = part({
                        Name = "PapanJualBoard",
                        Size = Vector3.new(10.5, 6, 0.6),
                        CFrame = CFrame.new(mx, 7.4, mz) * CFrame.Angles(0, math.rad(-28), 0),
                        Color = Color3.fromRGB(28, 32, 42),
                        Material = Enum.Material.SmoothPlastic,
                })
                local gui = Instance.new("SurfaceGui")
                gui.Face = Enum.NormalId.Front
                gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
                gui.PixelsPerStud = 46
                gui.Parent = board
                Util.create("TextLabel", {
                        Size = UDim2.fromScale(1, 0.62),
                        BackgroundTransparency = 1,
                        Font = Enum.Font.GothamBlack,
                        TextScaled = true,
                        TextColor3 = Color3.fromRGB(233, 196, 106),
                        Text = "PAPAN JUAL",
                }, gui)
                Util.create("TextLabel", {
                        Position = UDim2.fromScale(0, 0.62),
                        Size = UDim2.fromScale(1, 0.38),
                        BackgroundTransparency = 1,
                        Font = Enum.Font.Gotham,
                        TextScaled = true,
                        TextColor3 = Color3.fromRGB(150, 158, 175),
                        Text = "JUAL & BELI BARANG PEMAIN - MICDA",
                }, gui)
                local marketPrompt = Instance.new("ProximityPrompt")
                marketPrompt.ActionText = "Buka Papan Jual"
                marketPrompt.ObjectText = "Pasar Pemain (Micda)"
                marketPrompt.MaxActivationDistance = 10
                marketPrompt.HoldDuration = 0
                marketPrompt.Parent = board
                svc.Market.bindPrompt(marketPrompt)
        end

        -- papan penunjuk arah
        buildSign("PASAR TIMUR >", Vector3.new(48, 0, 8), -90)
        buildSign("KAWASAN LADANG ^", Vector3.new(9, 0, -56), 0)
        buildSign("HUTAN KAYU <", Vector3.new(-52, 0, 8), 90)
        buildSign("TAMBANG SELATAN v", Vector3.new(9, 0, 96), 180)
        buildSign("DANAU TENANG \\", Vector3.new(-62, 0, 52), 90)
        buildSign("PAPAN JUAL <", Vector3.new(-34, 0, 10), 90, Color3.fromRGB(70, 74, 88))

        ---------------------------------------------------------------- v7 GUA KRISTAL (barat laut)
        do
                local gx, gz = -170, -175
                part({
                        Name = "GuaLantai",
                        Shape = Enum.PartType.Cylinder,
                        Size = Vector3.new(0.25, 64, 64),
                        CFrame = CFrame.new(gx, 0.14, gz) * CFrame.Angles(0, 0, math.rad(90)),
                        Color = Color3.fromRGB(58, 62, 78),
                        Material = Enum.Material.Slate,
                })
                -- dinding batu keliling (10 segmen)
                for i = 1, 10 do
                        local ang = (i / 10) * math.pi * 2
                        part({
                                Name = "GuaDinding" .. i,
                                Size = Vector3.new(22, 11, 3),
                                CFrame = CFrame.new(gx + math.cos(ang) * 32, 5.5, gz + math.sin(ang) * 32)
                                        * CFrame.Angles(0, -math.deg(ang) + 90, 0),
                                Color = Color3.fromRGB(66, 68, 84),
                                Material = Enum.Material.Rock,
                        })
                end
                -- kristal raksasa dekorasi (neon, tanpa light - hemat mobile)
                local rngK = Random.new(55)
                for i = 1, 8 do
                        local ang = (i / 8) * math.pi * 2 + rngK:NextNumber(-0.2, 0.2)
                        local d = rngK:NextNumber(8, 18)
                        local h = rngK:NextNumber(4, 9)
                        part({
                                Name = "GuaKristal" .. i,
                                Size = Vector3.new(2.4, h, 2.4),
                                CFrame = CFrame.new(gx + math.cos(ang) * d, h / 2, gz + math.sin(ang) * d)
                                        * CFrame.Angles(rngK:NextNumber(-0.3, 0.3), 0, rngK:NextNumber(-0.3, 0.3)),
                                Color = Color3.fromRGB(190, 120, 255),
                                Material = Enum.Material.Neon,
                                Transparency = 0.25,
                                CanCollide = false,
                        })
                end
                -- tambang kristal ekstra (bisa dipanen)
                svc.Gather.buildRock(Vector3.new(gx - 12, 0, gz + 10), "kristal", 210)
                svc.Gather.buildRock(Vector3.new(gx + 14, 0, gz - 8), "kristal", 211)
                svc.Gather.buildRock(Vector3.new(gx + 2, 0, gz - 16), "kristal", 212)
                buildSign("GUA KRISTAL ^", Vector3.new(-88, 0, -62), 0, Color3.fromRGB(140, 90, 200))
                buildSign("GUA KRISTAL", Vector3.new(gx, 0, gz + 36), 180, Color3.fromRGB(140, 90, 200))
        end

        ---------------------------------------------------------------- pasar timur (4 toko)
        local shops = {
                { id = "bibit", pos = Vector3.new(102, 0, -36), wall = Color3.fromRGB(120, 178, 110), roof = Color3.fromRGB(84, 110, 76), title = "Toko Bibit", npc = "KAK TANI", npcColor = Color3.fromRGB(120, 178, 110) },
                { id = "jual", pos = Vector3.new(102, 0, -12), wall = Color3.fromRGB(226, 168, 84), roof = Color3.fromRGB(150, 100, 50), title = "Pasar Pengepul", npc = "BU LARIS", npcColor = Color3.fromRGB(255, 209, 102) },
                { id = "alat", pos = Vector3.new(102, 0, 12), wall = Color3.fromRGB(110, 160, 210), roof = Color3.fromRGB(66, 96, 130), title = "Toko Alat", npc = "PAK BANG", npcColor = Color3.fromRGB(110, 160, 210) },
                { id = "pet", pos = Vector3.new(102, 0, 36), wall = Color3.fromRGB(224, 140, 190), roof = Color3.fromRGB(140, 84, 120), title = "Toko Peliharaan", npc = "MBAH SEKAR", npcColor = Color3.fromRGB(224, 140, 190) },
        }
        for _, shop in shops do
                buildShop(shop.pos, shop.wall, shop.roof, shop.title)
                local npcPos = shop.pos + Vector3.new(-11, 0, 0)
                local prompt = buildNPC(shop.npc, npcPos, shop.npcColor)
                svc.Shop.bindPrompt(prompt, shop.id)
        end

        ---------------------------------------------------------------- ladang utara (6 ladang)
        buildSign("KAWASAN LADANG", Vector3.new(0, 0, -64), 180, Color3.fromRGB(124, 94, 62))
        local plotSpots = {
                Vector3.new(-40, 0.5, -80), Vector3.new(0, 0.5, -80), Vector3.new(40, 0.5, -80),
                Vector3.new(-40, 0.5, -114), Vector3.new(0, 0.5, -114), Vector3.new(40, 0.5, -114),
        }
        for i, spot in plotSpots do
                svc.Farm.buildPlot(i, spot)
        end

        -- kincir angin & orang orangutan ladang (dekorasi)
        local towerX, towerZ = -24, -95
        part({
                Name = "KincirMenara",
                Size = Vector3.new(4, 18, 4),
                CFrame = CFrame.new(towerX, 9, towerZ),
                Color = Color3.fromRGB(214, 206, 192),
                Material = Enum.Material.WoodPlanks,
        })
        for blade = 1, 4 do
                part({
                        Name = "KincirBaling" .. blade,
                        Size = Vector3.new(1, 12, 0.6),
                        CFrame = CFrame.new(towerX, 19, towerZ - 2.4)
                                * CFrame.Angles(0, 0, math.rad(blade * 90)),
                        Color = Color3.fromRGB(240, 236, 226),
                        Material = Enum.Material.WoodPlanks,
                })
        end
        -- orang orangutan: tongkat + kepala + topi jerami
        part({
                Name = "OrorTongkat",
                Size = Vector3.new(0.5, 6, 0.5),
                CFrame = CFrame.new(14, 3, -95),
                Color = Color3.fromRGB(140, 100, 62),
                Material = Enum.Material.Wood,
        })
        part({
                Name = "OrorKepala",
                Shape = Enum.PartType.Ball,
                Size = Vector3.new(2.2, 2.2, 2.2),
                CFrame = CFrame.new(14, 6.6, -95),
                Color = Color3.fromRGB(255, 224, 189),
                Material = Enum.Material.SmoothPlastic,
        })
        part({
                Name = "OrorTopi",
                Shape = Enum.PartType.Cylinder,
                Size = Vector3.new(0.5, 4, 4),
                CFrame = CFrame.new(14, 8.2, -95) * CFrame.Angles(0, 0, math.rad(90)),
                Color = Color3.fromRGB(235, 205, 130),
                Material = Enum.Material.Grass,
        })

        ---------------------------------------------------------------- hutan barat
        buildSign("HUTAN KAYU", Vector3.new(-64, 0, 0), 90, Color3.fromRGB(60, 110, 70))
        local treeSpots = {
                Vector3.new(-105, 0, -55), Vector3.new(-125, 0, -60), Vector3.new(-140, 0, -45),
                Vector3.new(-112, 0, -38), Vector3.new(-132, 0, -22), Vector3.new(-145, 0, -5),
                Vector3.new(-118, 0, -14), Vector3.new(-128, 0, 18), Vector3.new(-108, 0, 25),
                Vector3.new(-142, 0, 30), Vector3.new(-122, 0, 40), Vector3.new(-98, 0, 12),
        }
        for i, spot in treeSpots do
                svc.Gather.buildTree(spot, 100 + i)
        end

        ---------------------------------------------------------------- tambang selatan
        part({
                Name = "TambangLantai",
                Shape = Enum.PartType.Cylinder,
                Size = Vector3.new(0.25, 60, 60),
                CFrame = CFrame.new(0, 0.14, 132) * CFrame.Angles(0, 0, math.rad(90)),
                Color = Color3.fromRGB(112, 112, 118),
                Material = Enum.Material.Slate,
        })
        buildSign("TAMBANG SELATAN", Vector3.new(0, 0, 108), 0, Color3.fromRGB(90, 90, 96))
        -- gerbang tambang + obor
        for side = -1, 1, 2 do
                part({
                        Name = "TambangPilar" .. side,
                        Size = Vector3.new(2.4, 10, 2.4),
                        CFrame = CFrame.new(side * 6, 5, 112),
                        Color = Color3.fromRGB(70, 70, 78),
                        Material = Enum.Material.Rock,
                })
                -- v4 perf: neon saja, tanpa PointLight
                part({
                        Name = "TambangObor" .. side,
                        Shape = Enum.PartType.Ball,
                        Size = Vector3.new(1.4, 1.4, 1.4),
                        CFrame = CFrame.new(side * 6, 10.6, 112),
                        Color = Color3.fromRGB(255, 150, 70),
                        Material = Enum.Material.Neon,
                })
        end
        part({
                Name = "TambangPalang",
                Size = Vector3.new(15, 2, 2),
                CFrame = CFrame.new(0, 11, 112),
                Color = Color3.fromRGB(48, 48, 56),
                Material = Enum.Material.Rock,
        })
        -- gua gelap di belakang gerbang
        part({
                Name = "TambangGua",
                Size = Vector3.new(12, 9, 6),
                CFrame = CFrame.new(0, 4.5, 118),
                Color = Color3.fromRGB(30, 30, 36),
                Material = Enum.Material.Rock,
        })

        local rocks = {
                { id = "batu", pos = Vector3.new(-14, 0, 118) },
                { id = "batu", pos = Vector3.new(12, 0, 122) },
                { id = "batu", pos = Vector3.new(-2, 0, 134) },
                { id = "besi", pos = Vector3.new(-16, 0, 142) },
                { id = "besi", pos = Vector3.new(10, 0, 146) },
                { id = "besi", pos = Vector3.new(-8, 0, 128) },
                { id = "kristal", pos = Vector3.new(8, 0, 154) },
                { id = "kristal", pos = Vector3.new(-12, 0, 152) },
        }
        for i, rock in rocks do
                svc.Gather.buildRock(rock.pos, rock.id, 200 + i)
        end

        ---------------------------------------------------------------- danau tenang
        part({
                Name = "DanauPasir",
                Shape = Enum.PartType.Cylinder,
                Size = Vector3.new(0.3, 64, 64),
                CFrame = CFrame.new(-115, 0.16, 95) * CFrame.Angles(0, 0, math.rad(90)),
                Color = Color3.fromRGB(238, 214, 160),
                Material = Enum.Material.Sand,
        })
        part({
                Name = "DanauAir",
                Shape = Enum.PartType.Cylinder,
                Size = Vector3.new(0.6, 56, 56),
                CFrame = CFrame.new(-115, 0.32, 95) * CFrame.Angles(0, 0, math.rad(90)),
                Color = Color3.fromRGB(70, 150, 200),
                Material = Enum.Material.Glass,
                Transparency = 0.3,
                CanCollide = false,
        })
        svc.Gather.buildPier(Vector3.new(-90, 0, 95), Vector3.new(-1, 0, 0))
        buildSign("DANAU TENANG", Vector3.new(-72, 0, 82), 90, Color3.fromRGB(60, 110, 130))

        ---------------------------------------------------------------- pandai besi (tempa) - timur laut pasar
        local forgeX, forgeZ = 102, -58
        part({
                Name = "TempaBadan",
                Size = Vector3.new(13, 8, 12),
                CFrame = CFrame.new(forgeX, 4, forgeZ),
                Color = Color3.fromRGB(90, 96, 110),
                Material = Enum.Material.Brick,
        })
        part({
                Name = "TempaAtap",
                Size = Vector3.new(15.5, 1.2, 14.5),
                CFrame = CFrame.new(forgeX, 8.6, forgeZ),
                Color = Color3.fromRGB(50, 54, 64),
                Material = Enum.Material.Slate,
        })
        local forgeSign = part({
                Name = "TempaPapanNama",
                Size = Vector3.new(0.5, 2.4, 10),
                CFrame = CFrame.new(forgeX - 6.8, 6.6, forgeZ),
                Color = Color3.fromRGB(34, 38, 52),
                Material = Enum.Material.SmoothPlastic,
        })
        local forgeGui = Instance.new("SurfaceGui")
        forgeGui.Face = Enum.NormalId.Left
        forgeGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
        forgeGui.PixelsPerStud = 50
        forgeGui.Parent = forgeSign
        Util.create("TextLabel", {
                Size = UDim2.fromScale(1, 1),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBlack,
                TextScaled = true,
                TextColor3 = Color3.fromRGB(255, 150, 90),
                Text = "PANDAI BESI",
        }, forgeGui)

        -- perapian (anvil) + tukul + api tempa
        local anvil = part({
                Name = "Perapian",
                Size = Vector3.new(3, 1.6, 1.6),
                CFrame = CFrame.new(forgeX - 10.5, 1.8, forgeZ) * CFrame.Angles(0, math.rad(20), 0),
                Color = Color3.fromRGB(60, 62, 72),
                Material = Enum.Material.Metal,
        })
        part({
                Name = "PerapianKaki",
                Size = Vector3.new(1.4, 1.2, 1.4),
                CFrame = CFrame.new(forgeX - 10.5, 0.6, forgeZ),
                Color = Color3.fromRGB(50, 52, 60),
                Material = Enum.Material.Metal,
        })
        local forgeFire = part({
                Name = "ApiTempa",
                Shape = Enum.PartType.Ball,
                Size = Vector3.new(1.8, 1.8, 1.8),
                CFrame = CFrame.new(forgeX - 14, 1.6, forgeZ + 4),
                Color = Color3.fromRGB(255, 130, 60),
                Material = Enum.Material.Neon,
        })
        do
                local light = Instance.new("PointLight")
                light.Color = Color3.fromRGB(255, 130, 60)
                light.Range = 16
                light.Brightness = 1.5
                light.Parent = forgeFire
        end
        local forgePrompt = buildNPC("PAK TEMPA", Vector3.new(forgeX - 14, 0, forgeZ - 3), Color3.fromRGB(255, 150, 90))
        local anvilPrompt = Instance.new("ProximityPrompt")
        anvilPrompt.Parent = anvil
        svc.Craft.bindStation(anvilPrompt, "tempa")
        -- sambungkan juga prompt NPC (dua cara akses)
        svc.Craft.bindStation(forgePrompt, "tempa")

        ---------------------------------------------------------------- dapur alam (api unggun) - tenggara alun-alun
        part({
                Name = "ApiUnggunBatu",
                Shape = Enum.PartType.Cylinder,
                Size = Vector3.new(0.8, 6, 6),
                CFrame = CFrame.new(26, 0.4, 26) * CFrame.Angles(0, 0, math.rad(90)),
                Color = Color3.fromRGB(120, 118, 124),
                Material = Enum.Material.Slate,
        })
        for i = 1, 4 do
                part({
                        Name = "ApiUnggunKayu" .. i,
                        Size = Vector3.new(0.7, 3.4, 0.7),
                        CFrame = CFrame.new(26, 1.4, 26) * CFrame.Angles(math.rad(24), math.rad(i * 90), 0) * CFrame.new(0, 1.2, 0),
                        Color = Color3.fromRGB(110, 76, 46),
                        Material = Enum.Material.Wood,
                })
        end
        local kitchenFire = part({
                Name = "ApiUnggunApi",
                Shape = Enum.PartType.Ball,
                Size = Vector3.new(2.4, 2.4, 2.4),
                CFrame = CFrame.new(26, 1.8, 26),
                Color = Color3.fromRGB(255, 160, 70),
                Material = Enum.Material.Neon,
        })
        do
                local light = Instance.new("PointLight")
                light.Color = Color3.fromRGB(255, 160, 70)
                light.Range = 18
                light.Brightness = 1.4
                light.Parent = kitchenFire
        end
        -- kuali & rak rempah
        part({
                Name = "Kuali",
                Shape = Enum.PartType.Cylinder,
                Size = Vector3.new(0.9, 3, 3),
                CFrame = CFrame.new(29, 1.1, 28) * CFrame.Angles(0, 0, math.rad(90)),
                Color = Color3.fromRGB(40, 42, 50),
                Material = Enum.Material.Metal,
        })
        buildNPC("BU MASAK", Vector3.new(23, 0, 29), Color3.fromRGB(240, 130, 150))
        local cookPrompt = buildNPC("KUALI AJAIB", Vector3.new(29, 0, 24), Color3.fromRGB(240, 130, 150))
        svc.Craft.bindStation(cookPrompt, "dapur")

        ---------------------------------------------------------------- papan tugas harian - barat laut alun-alun
        part({
                Name = "PapanTugasTiang",
                Size = Vector3.new(0.8, 6, 0.8),
                CFrame = CFrame.new(-16, 3, -18),
                Color = Color3.fromRGB(96, 66, 42),
                Material = Enum.Material.Wood,
        })
        local questBoard = part({
                Name = "PapanTugasPapan",
                Size = Vector3.new(8, 5, 0.7),
                CFrame = CFrame.new(-16, 6.4, -18) * CFrame.Angles(0, math.rad(35), 0),
                Color = Color3.fromRGB(178, 140, 90),
                Material = Enum.Material.WoodPlanks,
        })
        do
                local gui = Instance.new("SurfaceGui")
                gui.Face = Enum.NormalId.Back
                gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
                gui.PixelsPerStud = 40
                gui.Parent = questBoard
                Util.create("TextLabel", {
                        Size = UDim2.fromScale(1, 1),
                        BackgroundTransparency = 1,
                        Font = Enum.Font.GothamBlack,
                        TextScaled = true,
                        TextColor3 = Color3.fromRGB(90, 60, 30),
                        Text = "TUGAS HARIAN",
                }, gui)
        end
        buildNPC("KAK TUGAS", Vector3.new(-14, 0, -15), Color3.fromRGB(255, 209, 102))
        local questPrompt = buildNPC("PAPAN TUGAS", Vector3.new(-18, 0, -21), Color3.fromRGB(255, 209, 102))
        svc.Quest.bindBoard(questPrompt)

        ---------------------------------------------------------------- arena timur (koloseum boss)
        do
                local ax, az = 150, 92
                part({
                        Name = "ArenaLantai",
                        Shape = Enum.PartType.Cylinder,
                        Size = Vector3.new(0.3, 76, 76),
                        CFrame = CFrame.new(ax, 0.16, az) * CFrame.Angles(0, 0, math.rad(90)),
                        Color = Color3.fromRGB(196, 176, 150),
                        Material = Enum.Material.Sand,
                })
                -- dinding cincin (12 segmen)
                for i = 1, 12 do
                        local ang = (i / 12) * math.pi * 2
                        part({
                                Name = "ArenaDinding" .. i,
                                Size = Vector3.new(20, 9, 2.6),
                                CFrame = CFrame.new(ax + math.cos(ang) * 38, 4.5, az + math.sin(ang) * 38)
                                        * CFrame.Angles(0, -math.deg(ang) + 90, 0),
                                Color = Color3.fromRGB(150, 132, 110),
                                Material = Enum.Material.Slate,
                        })
                end
                -- obor arena
                for i = 1, 6 do
                        local ang = (i / 6) * math.pi * 2
                        -- v4 perf: neon saja, tanpa PointLight
                        part({
                                Name = "ArenaObor" .. i,
                                Shape = Enum.PartType.Ball,
                                Size = Vector3.new(1.6, 1.6, 1.6),
                                CFrame = CFrame.new(ax + math.cos(ang) * 32, 8.6, az + math.sin(ang) * 32),
                                Color = Color3.fromRGB(255, 140, 70),
                                Material = Enum.Material.Neon,
                        })
                end
                buildSign("ARENA TIMUR - PUNCAK ANGKA 9", Vector3.new(ax - 46, 0, az), 90, Color3.fromRGB(150, 90, 60))
                buildSign("PADANG TIMUR >", Vector3.new(52, 0, 16), -90, Color3.fromRGB(120, 150, 90))
        end

        print("[AKIOMIDA] Dunia siap: alun-alun, pasar, ladang, hutan, tambang, danau, pandai besi, dapur, papan tugas, arena boss.")
end

return MapService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">MarketService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	MarketService.luau - v4 "PAPAN JUAL" (pasar pemain gaya konsinyasi MMO):
	  - Papan fisik di alun-alun: pemain MENJUAL barang langsung ke pemain LAIN
	  - Harga ditentukan penjual; pembeli bayar penuh SEKALI (tanpa bunga/riba)
	  - Biaya jasa pasar 2% (min 1 Micda): TRANSPARAN, terlihat sebelum konfirmasi
	  - Barang & Micda aman di DataStore; hasil jual diantar lewat "kotak pos"
	    walau penjual sedang offline
	  - Tanpa undian, tanpa lotre, tanpa spekulasi tersembunyi -> syariah-safe
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")

local Remotes = require(ReplicatedStorage.Remotes)
local Config = require(ReplicatedStorage.Shared.Config)
local Balance = require(ReplicatedStorage.Shared.Balance)

local DataService = require(script.Parent.DataService)

local MarketService = {}

local STORE_NAME = "AKM_Market_v1"
local BOARD_KEY = "board"
local MAIL_KEY = "mail"
local MAX_LISTINGS_PER_PLAYER = 10
local MAX_BOARD = 60
local FEE_RATE = 0.02 -- biaya jasa pasar 2%, transparan (ujr, bukan riba)
local FEE_MIN = 1

local store = nil
local board: { any } = {} -- daftar lelangan aktif
local mail: { [number]: number } = {} -- userId -> Micda menunggu diambil
local listingSeq = 0
local dirtyBoard = false
local dirtyMail = false

local VALID: { [string]: { [string]: boolean } } = {}

local function buildValid()
	local function set(kind: string, ids: { string })
		VALID[kind] = {}
		for _, id in ids do
			VALID[kind][id] = true
		end
	end
	local cropIds = {}
	for _, c in ipairs(Config.Crops) do
		table.insert(cropIds, c.id)
	end
	set("seed", cropIds)
	set("crop", cropIds)
	local bagIds = {}
	for _, r in ipairs(Config.Resources) do
		table.insert(bagIds, r.id)
	end
	set("bag", bagIds)
	local fishIds = {}
	for _, f in ipairs(Config.Fish) do
		table.insert(fishIds, f.id)
	end
	set("fish", fishIds)
	local equipIds, useIds = {}, {}
	for _, e in ipairs(Balance.Equipment) do
		table.insert(equipIds, e.id)
	end
	set("equip", equipIds)
	for _, u in ipairs(Balance.Usables) do
		table.insert(useIds, u.id)
	end
	set("use", useIds)
end

function MarketService.feeOf(price: number): number
	return math.max(FEE_MIN, math.floor(price * FEE_RATE + 0.5))
end

local function publicListings()
	local out = {}
	for _, l in board do
		table.insert(out, l)
	end
	table.sort(out, function(a, b)
		return a.at < b.at
	end)
	return out
end

local function pushBoard(player: Player?)
	local snap = { listings = publicListings(), feeRate = FEE_RATE, feeMin = FEE_MIN }
	if player then
		Remotes.get("MarketSync"):FireClient(player, snap)
	else
		Remotes.get("MarketSync"):FireAllClients(snap)
	end
end

local function saveLoop()
	while true do
		task.wait(4)
		pcall(function()
			if dirtyBoard then
				dirtyBoard = false
				store:SetAsync(BOARD_KEY, board)
			end
			if dirtyMail then
				dirtyMail = false
				store:SetAsync(MAIL_KEY, mail)
			end
		end)
	end
end

function MarketService.myListings(player: Player)
	local out = {}
	for _, l in board do
		if l.sellerId == player.UserId then
			table.insert(out, l)
		end
	end
	return out
end

local function onMarketAction(player: Player, payload: any)
	if not DataService.has(player) or type(payload) ~= "table" or type(payload.action) ~= "string" then
		return { ok = false, msg = "Permintaan tidak valid." }
	end
	local action = payload.action

	---------------------------------------------------------- lihat papan
	if action == "browse" or action == "mine" then
		return {
			ok = true,
			listings = publicListings(),
			mine = MarketService.myListings(player),
			feeRate = FEE_RATE,
			feeMin = FEE_MIN,
		}
	end

	---------------------------------------------------------- jual
	if action == "list" then
		local kind, id = tostring(payload.kind or ""), tostring(payload.id or "")
		local count = math.floor(tonumber(payload.count) or 0)
		local price = math.floor(tonumber(payload.price) or 0)
		if not VALID[kind] or not VALID[kind][id] then
			return { ok = false, msg = "Barang tidak dikenal." }
		end
		if count < 1 then
			return { ok = false, msg = "Jumlah minimal 1." }
		end
		if price < 1 or price > 999999 then
			return { ok = false, msg = "Harga harus 1 - 999.999 Micda." }
		end
		if DataService.countItem(player, kind, id) < count then
			return { ok = false, msg = "Stok di tas tidak cukup." }
		end
		local mine = 0
		for _, l in board do
			if l.sellerId == player.UserId then
				mine += 1
			end
		end
		if mine >= MAX_LISTINGS_PER_PLAYER then
			return { ok = false, msg = "Maksimal " .. MAX_LISTINGS_PER_PLAYER .. " barang dijual sekaligus." }
		end
		if #board >= MAX_BOARD then
			return { ok = false, msg = "Papan penuh. Coba lagi nanti." }
		end
		DataService.takeItem(player, kind, id, count)
		listingSeq += 1
		table.insert(board, {
			lid = "L" .. listingSeq,
			sellerId = player.UserId,
			sellerName = player.DisplayName,
			kind = kind,
			id = id,
			count = count,
			price = price,
			at = os.time(),
		})
		dirtyBoard = true
		pushBoard(nil)
		DataService.push(player)
		return { ok = true, msg = "Terpasang di papan: " .. count .. "x @ " .. price .. " Micda (jasa " .. MarketService.feeOf(price) .. ")." }
	end

	---------------------------------------------------------- batal
	if action == "cancel" then
		local lid = tostring(payload.lid or "")
		for i, l in board do
			if l.lid == lid then
				if l.sellerId ~= player.UserId then
					return { ok = false, msg = "Bukan barangmu." }
				end
				table.remove(board, i)
				DataService.giveItem(player, l.kind, l.id, l.count)
				dirtyBoard = true
				pushBoard(nil)
				DataService.push(player)
				return { ok = true, msg = "Penjualan dibatalkan, barang kembali ke tas." }
			end
		end
		return { ok = false, msg = "Lelangan tidak ditemukan." }
	end

	---------------------------------------------------------- beli
	if action == "buy" then
		local lid = tostring(payload.lid or "")
		for i, l in board do
			if l.lid == lid then
				if l.sellerId == player.UserId then
					return { ok = false, msg = "Itu barangmu sendiri." }
				end
				local data = DataService.get(player)
				if data.Coins < l.price then
					return { ok = false, msg = "Micda tidak cukup (butuh " .. l.price .. ")." }
				end
				table.remove(board, i)
				DataService.addCoins(player, -l.price, false)
				DataService.giveItem(player, l.kind, l.id, l.count)
				-- hasil jual bersih (harga - jasa transparan) menuju penjual
				local proceeds = l.price - MarketService.feeOf(l.price)
				local seller = Players:GetPlayerByUserId(l.sellerId)
				if seller and DataService.has(seller) then
					DataService.addCoins(seller, proceeds, false)
					DataService.push(seller)
					Remotes.get("Notify"):FireClient(seller, "Terjual!",
						l.count .. "x barangmu terjual ke " .. player.DisplayName .. " (+" .. proceeds .. " Micda).")
				else
					mail[l.sellerId] = (mail[l.sellerId] or 0) + proceeds
					dirtyMail = true
				end
				dirtyBoard = true
				pushBoard(nil)
				DataService.push(player)
				return { ok = true, msg = "Membeli " .. l.count .. "x seharga " .. l.price .. " Micda. Cek tasmu!" }
			end
		end
		return { ok = false, msg = "Barang sudah terjual atau dihapus." }
	end

	return { ok = false, msg = "Aksi tidak dikenal." }
end

function MarketService.claimMail(player: Player)
	local amount = mail[player.UserId] or 0
	if amount <= 0 then
		return
	end
	mail[player.UserId] = nil
	dirtyMail = true
	if DataService.has(player) then
		DataService.addCoins(player, amount, false)
		DataService.push(player)
		task.delay(6, function()
			if player.Parent then
				Remotes.get("Notify"):FireClient(player, "Kotak Pos Pasar",
					"Hasil penjualanmu di Papan Jual: +" .. amount .. " Micda!")
			end
		end)
	end
end

function MarketService.bindPrompt(prompt: ProximityPrompt)
	prompt.Triggered:Connect(function(player)
		if DataService.has(player) then
			pushBoard(player)
			Remotes.get("OpenMarket"):FireClient(player)
		end
	end)
end

function MarketService.init()
	buildValid()
	local ok = pcall(function()
		store = DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok and store then
		local okBoard, data = pcall(function()
			return store:GetAsync(BOARD_KEY)
		end)
		if okBoard and type(data) == "table" then
			board = data
			for _, l in board do
				local n = tonumber(string.sub(tostring(l.lid), 2)) or 0
				if n > listingSeq then
					listingSeq = n
				end
			end
		end
		local okMail, mdata = pcall(function()
			return store:GetAsync(MAIL_KEY)
		end)
		if okMail and type(mdata) == "table" then
			mail = mdata
		end
		task.spawn(saveLoop)
	else
		warn("[AKIOMIDA] Market DataStore tidak tersedia; papan jalan per-sesi saja.")
	end
	Remotes.get("MarketAction").OnServerInvoke = onMarketAction
end

return MarketService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">PetService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
        PetService.luau - peliharaan mengikuti pemain & memberi bonus harga jual.
        Model pet dibuat lewat kode (bola menggembung + nama), digerakkan server
        lewat Heartbeat agar semua pemain melihatnya.
]]

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local DataService = require(script.Parent.DataService)

local PetService = {}

local active: { [Player]: { model: Part, petId: string } } = {}
local folder: Folder? = nil

local function petFolder(): Folder
        local f = folder
        if not f then
                f = Instance.new("Folder")
                f.Name = "AKM_Pets"
                f.Parent = workspace
                folder = f
        end
        return f :: Folder
end

local petById: { [string]: any } = {}
for _, pet in ipairs(Config.Pets) do
        petById[pet.id] = pet
end

function PetService.sellBonus(player: Player): number
        local data = DataService.get(player)
        local pet = petById[data.ActivePet]
        return pet and pet.bonus or 0
end

function PetService.attach(player: Player)
        PetService.cleanup(player)
        if not DataService.has(player) then
                return
        end
        local data = DataService.get(player)
        local def = petById[data.ActivePet]
        if not def then
                return
        end

        local body = Instance.new("Part")
        body.Name = "Pet_" .. player.UserId
        body.Shape = Enum.PartType.Ball
        body.Size = Vector3.new(2, 2, 2)
        body.Color = Color3.fromRGB(def.color[1], def.color[2], def.color[3])
        body.Material = data.Dev and Enum.Material.Neon or Enum.Material.SmoothPlastic
        body.Anchored = true
        body.CanCollide = false
        body.CanQuery = false

        local billboard = Instance.new("BillboardGui")
        billboard.Size = UDim2.new(0, 120, 0, 26)
        billboard.StudsOffset = Vector3.new(0, 1.6, 0)
        billboard.AlwaysOnTop = true
        billboard.MaxDistance = 50
        billboard.Parent = body
        local label = Instance.new("TextLabel")
        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1
        label.Font = Enum.Font.GothamBold
        label.TextScaled = true
        label.TextColor3 = body.Color
        label.TextStrokeTransparency = 0.5
        label.Text = def.name
        label.Parent = billboard

        body.Parent = petFolder()
        active[player] = { model = body, petId = def.id }
end

function PetService.cleanup(player: Player)
        local entry = active[player]
        if entry and entry.model then
                entry.model:Destroy()
        end
        active[player] = nil
end

function PetService.init()
        local Remotes = require(ReplicatedStorage.Remotes)
        Remotes.get("EquipPet").OnServerInvoke = function(player, petId)
                return PetService.equip(player, petId)
        end

        local t = 0
        RunService.Heartbeat:Connect(function(dt)
                t += dt
                for player, entry in active do
                        local character = player.Character
                        local root = character and character:FindFirstChild("HumanoidRootPart")
                        if root then
                                local bob = math.sin(t * 2.2 + player.UserId % 7) * 0.4
                                local target = (root :: BasePart).CFrame
                                        * CFrame.new(2.4, 2.6 + bob, 2.4)
                                entry.model.CFrame = entry.model.CFrame:Lerp(target, math.clamp(dt * 6, 0, 1))
                        end
                end
        end)

        local Players = game:GetService("Players")
        Players.PlayerRemoving:Connect(function(player)
                PetService.cleanup(player)
        end)
end

function PetService.equip(player: Player, petId: any)
        if not DataService.has(player) then
                return { ok = false, msg = "Data belum siap." }
        end
        if type(petId) ~= "string" or petId ~= "" and not petById[petId] then
                return { ok = false, msg = "Peliharaan tidak dikenal." }
        end
        local data = DataService.get(player)
        if petId ~= "" and not data.Pets[petId] then
                return { ok = false, msg = "Kamu belum punya peliharaan itu." }
        end
        data.ActivePet = petId
        DataService.markDirty(player)
        PetService.attach(player)
        DataService.push(player)
        if petId == "" then
                return { ok = true, msg = "Peliharaan diistirahatkan." }
        end
        return { ok = true, msg = petById[petId].name .. " menemanimu!" }
end

return PetService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">QuestService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
        QuestService.luau - v3 "Toram-grade" papan tugas:
          - Rotasi harian 3 tugas dari kolam Balance.Quests (deterministik
            per hari, sama untuk semua server)
          - Terima 1 tugas aktif, progres otomatis dari aktivitas dunia:
            harvest / chop / mine / fish / kill / craft / cook
          - Klaim hadiah Micda+XP di papan tugas
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Remotes)
local Balance = require(ReplicatedStorage.Shared.Balance)

local DataService = require(script.Parent.DataService)

local QuestService = {}

local questById: { [string]: any } = {}
for _, q in ipairs(Balance.Quests) do
        questById[q.id] = q
end

--------------------------------------------------------------------
-- ROTASI HARIAN (di Balance - dipakai server & client)
--------------------------------------------------------------------

function QuestService.todayQuestIds(): { string }
	return Balance.todayQuestIds()
end

--------------------------------------------------------------------
-- AKSI TUGAS
--------------------------------------------------------------------

local function snapshot(player: Player)
        local data = DataService.get(player)
        local active = nil
        if data.Quest.id ~= "" then
                local q = questById[data.Quest.id]
                if q then
                        active = {
                                id = q.id,
                                title = q.title,
                                desc = q.desc,
                                prog = math.min(data.Quest.prog, q.goal.count),
                                count = q.goal.count,
                                done = data.Quest.done,
                                coins = q.reward.coins,
                                xp = q.reward.xp,
                        }
                end
        end
        local offers = {}
        for _, id in QuestService.todayQuestIds() do
                local q = questById[id]
                if q and id ~= data.Quest.id then
                        table.insert(offers, { id = q.id, title = q.title, desc = q.desc, coins = q.reward.coins, xp = q.reward.xp })
                end
        end
        return { active = active, offers = offers }
end

local function onQuestAction(player: Player, action: any, questId: any)
        if not DataService.has(player) or type(action) ~= "string" then
                return { ok = false, msg = "Permintaan tidak valid." }
        end
        local data = DataService.get(player)

        if action == "list" then
                return { ok = true, board = snapshot(player) }
        end

        if action == "accept" then
                if type(questId) ~= "string" then
                        return { ok = false, msg = "Tugas tidak dikenal." }
                end
                if data.Quest.id ~= "" and not data.Quest.done then
                        return { ok = false, msg = "Selesaikan tugas yang sedang berjalan dulu!" }
                end
                local offered = false
                for _, id in QuestService.todayQuestIds() do
                        if id == questId then
                                offered = true
                                break
                        end
                end
                local q = questById[questId]
                if not offered or not q then
                        return { ok = false, msg = "Tugas itu tidak ada di papan hari ini." }
                end
                data.Quest = { id = questId, prog = 0, acceptedAt = os.time(), done = false }
                DataService.markDirty(player)
                DataService.push(player)
                return { ok = true, msg = "Tugas diterima: " .. q.title .. " - " .. q.desc, board = snapshot(player) }
        end

        if action == "claim" then
                if data.Quest.id == "" then
                        return { ok = false, msg = "Belum ada tugas aktif." }
                end
                local q = questById[data.Quest.id]
                if not q or not data.Quest.done then
                        return { ok = false, msg = "Tugas belum selesai. Semangat!" }
                end
                DataService.addCoins(player, q.reward.coins, true)
                DataService.addXP(player, q.reward.xp)
                data.Quest = { id = "", prog = 0, acceptedAt = 0, done = false }
                DataService.markDirty(player)
                DataService.push(player)
                return { ok = true, msg = "Tugas selesai! +" .. q.reward.coins .. " Micda, +" .. q.reward.xp .. " XP", board = snapshot(player) }
        end

        return { ok = false, msg = "Aksi tidak dikenal." }
end

--------------------------------------------------------------------
-- HOOK PROGRES DARI LAYANAN LAIN
--------------------------------------------------------------------

--- type: "harvest" | "chop" | "mine" | "fish" | "kill" | "craft" | "cook"
function QuestService.progress(player: Player, kind: string, amount: number)
        if not DataService.has(player) then
                return
        end
        local data = DataService.get(player)
        if data.Quest.id == "" or data.Quest.done then
                return
        end
        local q = questById[data.Quest.id]
        if not q or q.goal.type ~= kind then
                return
        end
        data.Quest.prog = math.min(q.goal.count, data.Quest.prog + math.max(1, amount))
        if data.Quest.prog >= q.goal.count then
                data.Quest.done = true
                Remotes.get("Notify"):FireClient(player, "Tugas Selesai!",
                        q.title .. " selesai! Kembali ke Papan Tugas di alun-alun untuk klaim hadiah.")
        else
                Remotes.get("Notify"):FireClient(player, "Progres Tugas",
                        q.title .. ": " .. data.Quest.prog .. "/" .. q.goal.count)
        end
        DataService.markDirty(player)
end

--------------------------------------------------------------------
-- INIT
--------------------------------------------------------------------

function QuestService.bindBoard(prompt: ProximityPrompt)
        prompt.ActionText = "Lihat Tugas"
        prompt.ObjectText = "Papan Tugas Harian"
        prompt.MaxActivationDistance = 11
        prompt.HoldDuration = 0
        prompt.Triggered:Connect(function(player)
                if DataService.has(player) then
                        Remotes.get("OpenQuest"):FireClient(player)
                end
        end)
end

function QuestService.init()
        Remotes.get("QuestAction").OnServerInvoke = onQuestAction
end

return QuestService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">QuizService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	QuizService.luau - KUIS OPSIONAL.
	Kuis BUKAN lagi inti gameplay: tidak ada popup paksa, tidak ada zona
	terkunci. Hanya Kak Pintar di alun-alun yang menawarkan soal bonus -
	penjumlahan buatan sendiri (original) dengan hadiah Micda. Pemain yang
	hanya mau bertani/mengelana bisa mengabaikannya sepenuhnya.
	Juga menangani kode penjelajah (server-only via DevCodeVault).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Config = require(ReplicatedStorage.Shared.Config)
local MathGen = require(ReplicatedStorage.Shared.MathGen)
local Remotes = require(ReplicatedStorage.Remotes)

local DataService = require(script.Parent.DataService)
local DevCodeVault = require(script.Parent.DevCodeVault)

local QuizService = {}

local active: { [Player]: { qid: string, benar: number, betul: string, salah: string, born: number } } = {}
local lastRequest: { [Player]: number } = {}

--------------------------------------------------------------------
-- NPC KAK PINTAR -> panel opsional
--------------------------------------------------------------------

function QuizService.bindPrompt(prompt: ProximityPrompt)
	prompt.ActionText = "Ikut Kuis Bonus"
	prompt.ObjectText = "Kak Pintar"
	prompt.MaxActivationDistance = 11
	prompt.HoldDuration = 0
	prompt.Triggered:Connect(function(player)
		if DataService.has(player) then
			Remotes.get("OpenQuiz"):FireClient(player)
		end
	end)
end

--------------------------------------------------------------------
-- MINTA SOAL
--------------------------------------------------------------------

local function onQuizRequest(player: Player)
	if not DataService.has(player) then
		return nil
	end
	local now = time()
	if lastRequest[player] and now - lastRequest[player] < Config.Economy.QuizCooldown then
		return { cooldown = math.ceil(Config.Economy.QuizCooldown - (now - lastRequest[player])) }
	end
	lastRequest[player] = now

	-- tingkat soal mengikuti level pemain (1-6)
	local level = math.clamp(DataService.levelOf(player), 1, 6)
	local q = MathGen.generate(level)
	local qid = tostring(math.random(1, 1e9)) .. "-" .. tostring(os.clock())
	active[player] = {
		qid = qid,
		benar = q.benar,
		betul = q.betul,
		salah = q.salah,
		born = now,
	}
	return {
		qid = qid,
		t = q.t,
		opsi = q.opsi,
		reward = Config.Economy.QuizRewardCoins,
		-- kunci jawaban TIDAK dikirim ke client
	}
end

--------------------------------------------------------------------
-- JAWAB SOAL
--------------------------------------------------------------------

local function onQuizAnswer(player: Player, qid: any, choice: any)
	if not DataService.has(player) or type(choice) ~= "number" then
		return nil
	end
	local current = active[player]
	if not current or type(qid) ~= "string" or qid ~= current.qid then
		return nil
	end
	if time() - current.born > 60 then
		active[player] = nil
		return { correct = false, msg = "Waktu habis - soal kedaluwarsa." }
	end
	active[player] = nil

	local correct = math.floor(choice) == current.benar
	if not correct then
		DataService.markDirty(player)
		return { correct = false, msg = current.salah }
	end

	DataService.addCoins(player, Config.Economy.QuizRewardCoins, true)
	DataService.addXP(player, Config.Economy.QuizRewardXp)
	DataService.push(player)
	return {
		correct = true,
		msg = current.betul,
		reward = Config.Economy.QuizRewardCoins,
	}
end

--------------------------------------------------------------------
-- KODE PENJELAJAH (dev)
--------------------------------------------------------------------

local function onRedeemDevCode(player: Player, code: any)
	if type(code) ~= "string" or not DataService.has(player) then
		return false, "Kode tidak valid."
	end
	if code ~= DevCodeVault.CODE then
		return false, "Kode salah."
	end
	local data = DataService.get(player)
	if data.Dev then
		return true, "Kode sudah aktif sebelumnya."
	end
	data.Dev = true
	DataService.addCoins(player, 5000, false)
	DataService.addXP(player, 500)
	DataService.markDirty(player)
	DataService.push(player)
	Remotes.get("Notify"):FireClient(player, "Penjelajah Dev",
		"Kode diterima! +5.000 Micda & +500 XP. Selamat datang kembali, pembuat dunia!")
	return true, "Kode diterima! Hadiah dev masuk."
end

--------------------------------------------------------------------
-- INIT
--------------------------------------------------------------------

function QuizService.init()
	Remotes.get("QuizRequest").OnServerInvoke = onQuizRequest
	Remotes.get("QuizAnswer").OnServerInvoke = onQuizAnswer
	Remotes.get("RedeemDevCode").OnServerInvoke = onRedeemDevCode

	Players.PlayerRemoving:Connect(function(player)
		active[player] = nil
		lastRequest[player] = nil
	end)
end

return QuizService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
        ShopService.luau - roda ekonomi dunia:
          Toko Bibit        : jual bibit (syarat level)
          Pasar Pengepul    : beli hasil panen/sumber daya/ikan (harga pasar dinamis)
          Toko Alat         : kaleng siram, pancing, belik, sepeda
          Toko Peliharaan   : pet memberi bonus harga jual
        Permintaan pasar berubah tiap 10 menit (0.8x - 1.35x) - harga hidup.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Remotes)
local Util = require(ReplicatedStorage.Shared.Util)

local DataService = require(script.Parent.DataService)
local PetService = require(script.Parent.PetService)

local ShopService = {}

local cropById, toolById, petById, resById, fishById = {}, {}, {}, {}, {}
for _, crop in ipairs(Config.Crops) do
        cropById[crop.id] = crop
end
for _, tool in ipairs(Config.Tools) do
        toolById[tool.id] = tool
end
for _, pet in ipairs(Config.Pets) do
        petById[pet.id] = pet
end
for _, res in ipairs(Config.Resources) do
        resById[res.id] = res
end
for _, fish in ipairs(Config.Fish) do
        fishById[fish.id] = fish
end

--------------------------------------------------------------------
-- HARGA PASAR DINAMIS (sama untuk semua server: berbasis os.time)
--------------------------------------------------------------------

local function hashString(s: string): number
        local h = 0
        for i = 1, #s do
                h = (h * 31 + string.byte(s, i)) % 1000000007
        end
        return h
end

--- permintaan pasar 0.80 - 1.35 berganti tiap MarketPeriod detik
function ShopService.demandOf(itemId: string): number
        local period = math.floor(os.time() / Config.Economy.MarketPeriod)
        local rng = Random.new(period * 131 + hashString(itemId))
        return math.floor(rng:NextNumber(0.80, 1.35) * 100) / 100
end

function ShopService.getDemand(): { [string]: number }
        local out = {}
        for id in cropById do
                out[id] = ShopService.demandOf(id)
        end
        return out
end

function ShopService.demandSnapshot()
        return ShopService.getDemand()
end

--- harga jual final = dasar x permintaan x bonus peliharaan
function ShopService.sellPrice(player: Player, baseSell: number, itemId: string): number
        local demand = ShopService.demandOf(itemId)
        local bonus = PetService.sellBonus(player)
        return math.max(1, math.floor(baseSell * demand * (1 + bonus) + 0.5))
end

--------------------------------------------------------------------
-- NPC TOKO -> buka panel
--------------------------------------------------------------------

function ShopService.bindPrompt(prompt: ProximityPrompt, shopId: string)
        local titles = {
                bibit = "Toko Bibit",
                jual = "Pasar Pengepul",
                alat = "Toko Alat",
                pet = "Toko Peliharaan",
        }
        prompt.ActionText = "Belanja"
        prompt.ObjectText = titles[shopId] or "Toko"
        prompt.MaxActivationDistance = 11
        prompt.HoldDuration = 0
        prompt.Triggered:Connect(function(player)
                if DataService.has(player) then
                        Remotes.get("OpenShop"):FireClient(player, shopId)
                end
        end)
end

--------------------------------------------------------------------
-- BELI
--------------------------------------------------------------------

local function applySpeed(player: Player)
        local character = player.Character
        if not character then
                return
        end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
                humanoid.WalkSpeed = DataService.get(player).Tools.bike and 26 or 16
        end
end

local function onBuyItem(player: Player, shopId: any, itemId: any)
        if not DataService.has(player) or type(shopId) ~= "string" or type(itemId) ~= "string" then
                return { ok = false, msg = "Permintaan tidak valid." }
        end

        -------------------------------------------------- TOKO BIBIT
        if shopId == "bibit" then
                local crop = cropById[itemId]
                if not crop then
                        return { ok = false, msg = "Bibit tidak dikenal." }
                end
                local level = DataService.levelOf(player)
                if level < crop.level then
                        return { ok = false, msg = "Butuh level " .. crop.level .. ". Kumpulkan XP dari panen & aktivitas!" }
                end
                if not DataService.spend(player, crop.cost) then
                        return { ok = false, msg = "Micda kurang! Jual hasil panenmu di Pasar Pengepul." }
                end
                DataService.giveItem(player, "seed", itemId, 1)
                DataService.push(player)
                return { ok = true, msg = "Bibit " .. crop.name .. " dibeli!" }

        -------------------------------------------------- TOKO ALAT
        elseif shopId == "alat" then
                local tool = toolById[itemId]
                if not tool then
                        return { ok = false, msg = "Alat tidak dikenal." }
                end
                local data = DataService.get(player)
                if itemId == "pick2" and data.Tools.pickTier >= 2 or itemId == "pick3" and data.Tools.pickTier >= 3 then
                        return { ok = false, msg = "Kamu sudah punya belik yang lebih bagus." }
                end
                if (itemId == "can" and data.Tools.can) or (itemId == "rod" and data.Tools.rod) or (itemId == "bike" and data.Tools.bike) then
                        return { ok = false, msg = "Alat ini sudah kamu miliki." }
                end
                if not DataService.spend(player, tool.cost) then
                        return { ok = false, msg = "Micda kurang! Jual dulu hasil panenmu." }
                end
                if tool.tier then
                        data.Tools.pickTier = tool.tier
                elseif itemId == "can" then
                        data.Tools.can = true
                elseif itemId == "rod" then
                        data.Tools.rod = true
                elseif itemId == "bike" then
                        data.Tools.bike = true
                end
                DataService.markDirty(player)
                applySpeed(player)
                DataService.push(player)
                return { ok = true, msg = tool.name .. " dibeli! " .. tool.desc }

        -------------------------------------------------- TOKO PELIHARAAN
        elseif shopId == "pet" then
                local pet = petById[itemId]
                if not pet then
                        return { ok = false, msg = "Peliharaan tidak dikenal." }
                end
                local data = DataService.get(player)
                if data.Pets[itemId] then
                        DataService.markDirty(player)
                        data.ActivePet = itemId
                        PetService.attach(player)
                        DataService.push(player)
                        return { ok = true, msg = pet.name .. " kembali menemanimu!" }
                end
                if not DataService.spend(player, pet.cost) then
                        return { ok = false, msg = "Micda kurang! Peliharaan ini mahal - kumpulkan hasil panen dulu." }
                end
                data.Pets[itemId] = true
                data.ActivePet = itemId
                DataService.markDirty(player)
                PetService.attach(player)
                DataService.push(player)
                return { ok = true, msg = pet.name .. " ikut bertualang bersamamu! " .. pet.desc }
        end

        return { ok = false, msg = "Toko tidak dikenal." }
end

--------------------------------------------------------------------
-- JUAL
--------------------------------------------------------------------

--- kind: "crop" | "bag" | "fish"
local function baseSellOf(kind: string, id: string): number?
        if kind == "crop" then
                local crop = cropById[id]
                return crop and crop.sell
        elseif kind == "bag" then
                local res = resById[id]
                return res and res.sell
        elseif kind == "fish" then
                local fish = fishById[id]
                return fish and fish.sell
        end
        return nil
end

local function _kindLabel(kind: string): string
        if kind == "crop" then
                return "Hasil Panen"
        elseif kind == "bag" then
                return "Sumber Daya"
        elseif kind == "fish" then
                return "Ikan"
        end
        return "Barang"
end

local function onSellItem(player: Player, kind: any, itemId: any, all: any)
        if not DataService.has(player) or type(kind) ~= "string" or type(itemId) ~= "string" then
                return { ok = false, msg = "Permintaan tidak valid." }
        end
        local base = baseSellOf(kind, itemId)
        if not base then
                return { ok = false, msg = "Barang tidak dikenal." }
        end
        local have = DataService.countItem(player, kind, itemId)
        if have <= 0 then
                return { ok = false, msg = "Kamu tidak punya barang itu." }
        end
        local count = (all == true) and have or 1
        local unit = ShopService.sellPrice(player, base, itemId)
        local total = unit * count

        DataService.takeItem(player, kind, itemId, count)
        DataService.addCoins(player, total, true)
        DataService.addXP(player, count)
        DataService.push(player)
        return { ok = true, msg = "Terjual " .. count .. "x - +" .. Util.formatNumber(total) .. " Micda!", total = total }
end

--------------------------------------------------------------------
-- JUAL SEMUA SATU KLIK
--------------------------------------------------------------------

local function onSellAll(player: Player)
        if not DataService.has(player) then
                return { ok = false, msg = "Data belum siap." }
        end
        local data = DataService.get(player)
        local total = 0
        local items = 0

        local function flush(kind: string, tableData: { [string]: number }, lookup: { [string]: any })
                for id, count in tableData do
                        if lookup[id] and count > 0 then
                                local unit = ShopService.sellPrice(player, lookup[id].sell, id)
                                DataService.takeItem(player, kind, id, count)
                                total += unit * count
                                items += count
                        end
                end
        end

        flush("crop", data.Crops, cropById)
        flush("bag", data.Bag, resById)
        flush("fish", data.Fish, fishById)

        if items == 0 then
                return { ok = false, msg = "Tas masih kosong. Tanam, tebang, atau mancing dulu!" }
        end
        DataService.addCoins(player, total, true)
        DataService.addXP(player, items)
        DataService.push(player)
        return { ok = true, msg = items .. " barang terjual - +" .. Util.formatNumber(total) .. " Micda!", total = total }
end

--------------------------------------------------------------------
-- INIT
--------------------------------------------------------------------

function ShopService.init()
        Remotes.get("BuyItem").OnServerInvoke = onBuyItem
        Remotes.get("SellItem").OnServerInvoke = onSellItem
        Remotes.get("SellAll").OnServerInvoke = onSellAll
        -- daftarkan snapshot permintaan pasar ke DataService (tanpa siklus require)
        DataService.registerProvider("demand", function()
                return ShopService.getDemand()
        end)
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">TradeService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
        TradeService.luau - v3 dagang antar pemain (gaya MMO klasik):
          - Undang pemain terdekat via panel (validasi jarak & data)
          - Dua sisi menawar barang & Micda, lalu keduanya "SIAP"
          - Eksekusi atomik & tervalidasi di server (anti-scam dasar)
          - Perubahan tawaran kapan pun mereset status SIAP kedua sisi
          - TradeSync: snapshot langsung ke kedua sisi setiap perubahan
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Remotes)

local DataService = require(script.Parent.DataService)

local TradeService = {}

-- sesi aktif: player -> session (kedua sisi menunjuk tabel sama)
local sessions: { [Player]: any } = {}
-- undangan menunggu: target -> {from, expires}
local invites: { [Player]: any } = {}

--------------------------------------------------------------------
-- SNAPSHOT
--------------------------------------------------------------------

local function offerOf(session: any, player: Player)
        return session[player == session.a and "offerA" or "offerB"]
end

local function pushSync(session: any)
        local snapA = {
                me = { name = session.a.DisplayName, items = session.offerA, coins = session.coinsA, ready = session.readyA },
                partner = { name = session.b.DisplayName, items = session.offerB, coins = session.coinsB, ready = session.readyB },
        }
        local snapB = {
                me = { name = session.b.DisplayName, items = session.offerB, coins = session.coinsB, ready = session.readyB },
                partner = { name = session.a.DisplayName, items = session.offerA, coins = session.coinsA, ready = session.readyA },
        }
        if session.a.Parent then
                Remotes.get("TradeSync"):FireClient(session.a, snapA)
        end
        if session.b.Parent then
                Remotes.get("TradeSync"):FireClient(session.b, snapB)
        end
end

local function closeSession(session: any, reason: string)
        for _, p in { session.a, session.b } do
                if sessions[p] == session then
                        sessions[p] = nil
                end
                if p.Parent and reason ~= "" then
                        Remotes.get("Notify"):FireClient(p, "Dagang", reason)
                end
        end
end

--------------------------------------------------------------------
-- EKSEKUSI (atomik)
--------------------------------------------------------------------

local function canDeliver(player: Player, items: { [string]: any }, coins: number): boolean
        local data = DataService.get(player)
        if data.Coins < coins then
                return false
        end
        for kind, list in items do
                for id, count in list do
                        if DataService.countItem(player, kind, id) < count then
                                return false
                        end
                end
        end
        return true
end

local function deliver(player: Player, items: { [string]: any }, coins: number)
        for kind, list in items do
                for id, count in list do
                        DataService.takeItem(player, kind, id, count)
                end
        end
        DataService.addCoins(player, -coins)
end

local function executeTrade(session: any)
        local a, b = session.a, session.b
        if not DataService.has(a) or not DataService.has(b) then
                closeSession(session, "Dagangan gagal - data pemain tidak siap.")
                return
        end
        if not canDeliver(a, session.offerA, session.coinsA) or not canDeliver(b, session.offerB, session.coinsB) then
                closeSession(session, "Dagangan gagal - barang/Micda berubah saat dagang.")
                pushSync(session)
                return
        end
        -- eksekusi: tukar
        deliver(a, session.offerA, session.coinsA)
        deliver(b, session.offerB, session.coinsB)
        for kind, list in session.offerA do
                for id, count in list do
                        DataService.giveItem(b, kind, id, count)
                end
        end
        for kind, list in session.offerB do
                for id, count in list do
                        DataService.giveItem(a, kind, id, count)
                end
        end
        DataService.addCoins(a, session.coinsB, false)
        DataService.addCoins(b, session.coinsA, false)

        Remotes.get("Notify"):FireClient(a, "Dagangan Sukses", "Tukar-menukar dengan " .. b.DisplayName .. " selesai!")
        Remotes.get("Notify"):FireClient(b, "Dagangan Sukses", "Tukar-menukar dengan " .. a.DisplayName .. " selesai!")
        DataService.push(a)
        DataService.push(b)
        closeSession(session, "")
end

--------------------------------------------------------------------
-- AKSI
--------------------------------------------------------------------

local function onTradeAction(player: Player, payload: any)
        if not DataService.has(player) or type(payload) ~= "table" or type(payload.action) ~= "string" then
                return { ok = false, msg = "Permintaan tidak valid." }
        end
        local action = payload.action

        -- sedang dalam sesi? kecuali invite, semua aksi butuh sesi
        local session = sessions[player]

        ---------------------------------------------------------------- undang
        if action == "invite" then
                if session then
                        return { ok = false, msg = "Kamu sedang dagang dengan " .. (player == session.a and session.b.DisplayName or session.a.DisplayName) .. "." }
                end
                local target = typeof(payload.target) == "string" and Players:FindFirstChild(payload.target) or nil
                if not target or target == player then
                        return { ok = false, msg = "Pemain tidak ditemukan di server ini." }
                end
                if not DataService.has(target) or sessions[target] then
                        return { ok = false, msg = "Pemain itu sedang tidak bisa diajak dagang." }
                end
                -- jarak: hanya pemain di dekatmu (biar interaksi tatap muka)
                local myRoot = player.Character and player.Character.PrimaryPart
                local theirRoot = target.Character and target.Character.PrimaryPart
                if not myRoot or not theirRoot or (myRoot.Position - theirRoot.Position).Magnitude > 60 then
                        return { ok = false, msg = "Dekati pemain itu dulu untuk mengundang dagang." }
                end
                invites[target] = { from = player, expires = os.time() + 45 }
                Remotes.get("Notify"):FireClient(target, "Undangan Dagang",
                        player.DisplayName .. " mengundangmu berdagang! Buka panel Dagang untuk menerima.")
                return { ok = true, msg = "Undangan terkirim ke " .. target.DisplayName .. ". Menunggu jawaban..." }

        ---------------------------------------------------------------- terima/tolak
        elseif action == "accept" then
                if session then
                        return { ok = false, msg = "Kamu sudah dalam sesi dagang." }
                end
                local inv = invites[player]
                if not inv or os.time() > inv.expires or not inv.from.Parent then
                        invites[player] = nil
                        return { ok = false, msg = "Undangan sudah kedaluwarsa." }
                end
                local from = inv.from
                if sessions[from] then
                        invites[player] = nil
                        return { ok = false, msg = "Pemain itu sudah dagang dengan orang lain." }
                end
                invites[player] = nil
                local newSession = {
                        a = from, b = player,
                        offerA = {}, offerB = {},
                        coinsA = 0, coinsB = 0,
                        readyA = false, readyB = false,
                }
                sessions[from] = newSession
                sessions[player] = newSession
                Remotes.get("OpenTrade"):FireClient(from)
                Remotes.get("OpenTrade"):FireClient(player)
                pushSync(newSession)
                return { ok = true, msg = "Dagangan dengan " .. from.DisplayName .. " dimulai." }

        elseif action == "decline" then
                local inv = invites[player]
                if inv and inv.from.Parent then
                        Remotes.get("Notify"):FireClient(inv.from, "Dagang", player.DisplayName .. " menolak undanganmu.")
                end
                invites[player] = nil
                return { ok = true, msg = "Undangan ditolak." }

        ---------------------------------------------------------------- isi sesi
        elseif action == "offer" and session then
                if type(payload.kind) ~= "string" or type(payload.id) ~= "string" then
                        return { ok = false, msg = "Tidak valid." }
                end
                local count = math.floor(tonumber(payload.count) or 0)
                local myOffer = offerOf(session, player)
                local have = DataService.countItem(player, payload.kind, payload.id)
                if count <= 0 then
                        myOffer[payload.kind][payload.id] = nil
                else
                        if have < count then
                                return { ok = false, msg = "Stok tidak cukup (" .. have .. ")." }
                        end
                        myOffer[payload.kind] = myOffer[payload.kind] or {}
                        myOffer[payload.kind][payload.id] = count
                end
                session.readyA = false
                session.readyB = false
                pushSync(session)
                return { ok = true }

        elseif action == "coin" and session then
                local amount = math.max(0, math.floor(tonumber(payload.amount) or 0))
                local data = DataService.get(player)
                if amount > data.Coins then
                        amount = data.Coins
                end
                if player == session.a then
                        session.coinsA = amount
                else
                        session.coinsB = amount
                end
                session.readyA = false
                session.readyB = false
                pushSync(session)
                return { ok = true }

        elseif action == "ready" and session then
                local value = payload.value == true
                if player == session.a then
                        session.readyA = value
                else
                        session.readyB = value
                end
                pushSync(session)
                if session.readyA and session.readyB then
                        task.defer(executeTrade, session)
                end
                return { ok = true }

        elseif action == "cancel" and session then
                closeSession(session, "Dagangan dibatalkan.")
                return { ok = true, msg = "Dagangan dibatalkan." }
        end

        return { ok = false, msg = "Kamu tidak sedang berdagang." }
end

--------------------------------------------------------------------
-- INIT
--------------------------------------------------------------------

function TradeService.init()
        Remotes.get("TradeAction").OnServerInvoke = onTradeAction

        Players.PlayerRemoving:Connect(function(player)
                -- undangan
                invites[player] = nil
                for target, inv in invites do
                        if inv.from == player then
                                invites[target] = nil
                        end
                end
                -- sesi dagang
                local session = sessions[player]
                if session then
                        closeSession(session, "Partner dagangmu keluar server - dagangan dibatalkan.")
                end
        end)
end

return TradeService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="27">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="28">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="29">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!nonstrict
--[[
	init.client.luau - bootstrap UI Dunia Akiomida.
]]

local UIController = require(script.UIController)

UIController.new()

print("[AKIOMIDA] Client siap.")
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Ambience</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
        Ambience.luau - v20 musik latar ORIGINAL disintesis kode:
          Satu nada dasar (bunyi elektronik bawaan platform) di-pitch
          mengikuti rasio setengah nada (2^(n/12)) membentuk skala
          PENTATONIK mayor - melodi lembut bergaya pedangan damai.
          Tanpa satu pun aset pihak ketiga. Bisa dimatikan lewat tombol♪.
]]

local SoundService = game:GetService("SoundService")

local Ambience = {}

-- skala pentatonik mayor dalam semiton dari nada dasar (dua oktaf)
local SCALE = { 0, 2, 4, 7, 9, 12, 14, 16 }
-- melodi 16 langkah (indeks skala) - tenang, untuk menjelajah dunia terbuka
local MELODY = { 1, 3, 5, 4, 6, 5, 3, 2, 4, 6, 8, 7, 5, 3, 2, 1 }
local BASS_EVERY = 4 -- nada bass tiap 4 langkah
local BASE_SPEED = 0.62 -- pitch nada dasar (nada rendah lembut)
local STEP = 0.55 -- detik per langkah

local enabled = true
local running = false

function Ambience.isEnabled(): boolean
        return enabled
end

--- Nyalakan/matikan musik. Return status terbaru.
function Ambience.toggle(): boolean
        enabled = not enabled
        return enabled
end

local function note(speed: number, volume: number)
        local s = Instance.new("Sound")
        s.SoundId = "rbxasset://sounds/electronicpingshort.wav"
        s.Volume = volume
        s.PlaybackSpeed = speed
        s.Parent = SoundService
        s:Play()
        s.Ended:Once(function()
                s:Destroy()
        end)
        task.delay(4, function()
                if s.Parent then
                        s:Destroy()
                end
        end)
end

function Ambience.start()
        if running then
                return
        end
        running = true
        task.spawn(function()
                local step = 0
                while running do
                        if enabled then
                                local idx = MELODY[(step % #MELODY) + 1]
                                local semi = SCALE[idx] or 0
                                note(BASE_SPEED * (2 ^ (semi / 12)), 0.085)
                                if step % BASS_EVERY == 0 then
                                        note(BASE_SPEED * 0.5, 0.07) -- bass satu oktaf ke bawah
                                end
                        end
                        step += 1
                        task.wait(STEP)
                end
        end)
end

return Ambience
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">UIController</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
        UIController.luau - seluruh UI Dunia Akiomida v2 (dibangun lewat kode):
          HUD   : Micda, level + bar XP, tombol Tas / Kode / Bantuan, tips, toast
          Toko  : tab Beli (bibit/alat/pet) & Jual (harga pasar dinamis)
          Tas   : bibit, hasil panen, sumber daya, ikan, alat, peliharaan
          Tanam : pilih bibit untuk petak ladang
          Kuis  : OPSIONAL - hanya muncul jika pemain menemui Kak Pintar
        Tidak ada popup paksa. Semua panel tertutup saat pemain menjelajah.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Config = require(ReplicatedStorage.Shared.Config)
local Balance = require(ReplicatedStorage.Shared.Balance)
local Remotes = require(ReplicatedStorage.Remotes)
local Util = require(ReplicatedStorage.Shared.Util)
local Ambience = require(script.Parent.Ambience)

local UIController = {}
UIController.__index = UIController

-- v4 TEMMINIMAL: satu aksen emas, panel gelap flat, tanpa warna-warni pelangi
local T = {
        Bg = Color3.fromRGB(14, 16, 20),
        Panel = Color3.fromRGB(22, 25, 32),
        PanelLight = Color3.fromRGB(36, 40, 50),
        Gold = Color3.fromRGB(233, 196, 106),
        Green = Color3.fromRGB(96, 200, 140),
        Red = Color3.fromRGB(228, 104, 104),
        Blue = Color3.fromRGB(122, 168, 226),
        Text = Color3.fromRGB(232, 234, 240),
        TextDim = Color3.fromRGB(138, 144, 158),
        Disabled = Color3.fromRGB(70, 75, 88),
}

local player = Players.LocalPlayer

local function corner(parent, radius)
        return Util.create("UICorner", { CornerRadius = UDim.new(0, radius or 10) }, parent)
end

local function makeSound(pitch: number?): Sound
        local s = Util.create("Sound", {
                SoundId = "rbxasset://sounds/electronicpingshort.wav",
                Volume = 0.3,
                PlaybackSpeed = pitch or 1,
        }, SoundService)
        return s :: Sound
end

local function btn(props): TextButton
        local b = Util.create("TextButton", {
                Font = Enum.Font.GothamBold,
                TextColor3 = T.Text,
                TextScaled = true,
                AutoButtonColor = true,
                BackgroundColor3 = T.PanelLight,
                BorderSizePixel = 0,
        }, props.parent)
        for k, v in props do
                if k ~= "parent" and k ~= "_radius" then
                        (b :: any)[k] = v
                end
        end
        corner(b, props._radius or 8)
        return b
end

function UIController.new()
        local self = setmetatable({}, UIController)

        self.state = nil
        self.activePanel = nil
        self.shopId = nil
        self.shopTab = "beli"
        self.pendingPlant = nil
        self.craftStation = nil
        self.tradeSnap = nil
        self.inviteFrom = nil
        self.bossInfo = nil
        self.marketTab = "papan"
        self.marketSnap = nil
        self.kiosMode = nil
        self.kiosSnap = nil

        self:buildGui()
        self:buildHud()
        self:buildShopPanel()
        self:buildPlantPanel()
        self:buildInvPanel()
        self:buildQuizPanel()
        self:buildCodePanel()
        self:buildHelpPanel()
        self:buildCharPanel()
        self:buildCraftPanel()
        self:buildQuestPanel()
        self:buildTradePanel()
        self:buildMarketPanel()
        self:buildKiosPanel()
        self:wireRemotes()
        self:startTips()
        Ambience.start() -- v20: BGM pentatonik sintesis kode

        return self
end

--------------------------------------------------------------------
-- GUI DASAR
--------------------------------------------------------------------

function UIController:buildGui()
        self.gui = Util.create("ScreenGui", {
                Name = "AKM_HUD",
                ResetOnSpawn = false,
                IgnoreGuiInset = true,
                ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        }, player:WaitForChild("PlayerGui"))
end

function UIController:panelFrame(name: string, sizeScale: number, heightScale: number): Frame
        local frame = Util.create("Frame", {
                Name = name,
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.fromScale(0.5, 0.5),
                Size = UDim2.fromScale(sizeScale, heightScale),
                BackgroundColor3 = T.Panel,
                BorderSizePixel = 0,
                Visible = false,
        }, self.gui)
        corner(frame, 14)
        Util.create("UISizeConstraint", { MinSize = Vector2.new(430, 360) }, frame)
        return frame
end

function UIController:showPanel(name: string?)
        local TweenService = game:GetService("TweenService")
        for _, n in { "Shop", "Plant", "Inv", "Quiz", "Code", "Help", "Char", "Craft", "Quest", "Trade", "Market", "Kios" } do
                local f = self.gui:FindFirstChild(n)
                if f then
                        (f :: Frame).Visible = (n == name)
                end
        end
        if self.navHolder then
                self.navHolder.Visible = (name == nil)
        end
        if name then
                -- v7 pop-in halus (rasa premium, bukan pop-up kasar)
                local f = self.gui:FindFirstChild(name)
                if f and f:IsA("Frame") then
                        f.Size = UDim2.fromScale(f.Size.X.Scale * 0.94, f.Size.Y.Scale * 0.94)
                        TweenService:Create(f, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                                Size = UDim2.fromScale(f.Size.X.Scale / 0.94, f.Size.Y.Scale / 0.94),
                        }):Play()
                end
        end
        self.activePanel = name
end

--------------------------------------------------------------------
-- HUD
--------------------------------------------------------------------

function UIController:buildHud()
        ---------------------------------------------------------------- chip Micda
        local coinChip = Util.create("Frame", {
                Name = "MicdaChip",
                Position = UDim2.fromOffset(16, 14),
                Size = UDim2.fromOffset(170, 46),
                BackgroundColor3 = T.Bg,
                BackgroundTransparency = 0.15,
                BorderSizePixel = 0,
        }, self.gui)
        corner(coinChip, 12)
        local coinIcon = Util.create("Frame", {
                Position = UDim2.fromOffset(7, 7),
                Size = UDim2.fromOffset(32, 32),
                BackgroundColor3 = T.Gold,
                BorderSizePixel = 0,
        }, coinChip)
        corner(coinIcon, 16)
        Util.create("TextLabel", {
                Size = UDim2.fromScale(1, 1),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBlack,
                TextScaled = true,
                TextColor3 = Color3.fromRGB(120, 86, 20),
                Text = "M",
        }, coinIcon)
        self.coinText = Util.create("TextLabel", {
                Position = UDim2.fromOffset(44, 0),
                Size = UDim2.new(1, -50, 1, 0),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBlack,
                TextScaled = true,
                TextColor3 = T.Gold,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = "0",
        }, coinChip)

        ---------------------------------------------------------------- chip level + XP
        local levelChip = Util.create("Frame", {
                Name = "LevelChip",
                Position = UDim2.fromOffset(16, 66),
                Size = UDim2.fromOffset(170, 58),
                BackgroundColor3 = T.Bg,
                BackgroundTransparency = 0.15,
                BorderSizePixel = 0,
        }, self.gui)
        corner(levelChip, 12)
        self.levelText = Util.create("TextLabel", {
                Position = UDim2.fromOffset(10, 4),
                Size = UDim2.new(1, -20, 0, 26),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBold,
                TextScaled = true,
                TextColor3 = T.Blue,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = "Level 1",
        }, levelChip)
        local barBg = Util.create("Frame", {
                Position = UDim2.fromOffset(10, 34),
                Size = UDim2.new(1, -20, 0, 14),
                BackgroundColor3 = T.PanelLight,
                BorderSizePixel = 0,
        }, levelChip)
        corner(barBg, 7)
        self.xpBar = Util.create("Frame", {
                Size = UDim2.fromScale(0, 1),
                BackgroundColor3 = T.Blue,
                BorderSizePixel = 0,
        }, barBg)
        corner(self.xpBar, 7)

        ---------------------------------------------------------------- chip HP (v3)
        local hpChip = Util.create("Frame", {
                Name = "HpChip",
                Position = UDim2.fromOffset(16, 130),
                Size = UDim2.fromOffset(170, 46),
                BackgroundColor3 = T.Bg,
                BackgroundTransparency = 0.15,
                BorderSizePixel = 0,
        }, self.gui)
        corner(hpChip, 12)
        self.hpText = Util.create("TextLabel", {
                Position = UDim2.fromOffset(10, 3),
                Size = UDim2.new(1, -20, 0, 22),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBold,
                TextScaled = true,
                TextColor3 = T.Red,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = "HP 100/100",
        }, hpChip)
        local hpBg = Util.create("Frame", {
                Position = UDim2.fromOffset(10, 28),
                Size = UDim2.new(1, -20, 0, 12),
                BackgroundColor3 = T.PanelLight,
                BorderSizePixel = 0,
        }, hpChip)
        corner(hpBg, 6)
        self.hpBar = Util.create("Frame", {
                Size = UDim2.fromScale(1, 1),
                BackgroundColor3 = Color3.fromRGB(235, 90, 90),
                BorderSizePixel = 0,
        }, hpBg)
        corner(self.hpBar, 6)

        ---------------------------------------------------------------- chip tugas aktif (v3)
        self.questChip = Util.create("TextLabel", {
                Name = "QuestChip",
                Position = UDim2.fromOffset(16, 182),
                Size = UDim2.fromOffset(240, 54),
                BackgroundTransparency = 1,
                Font = Enum.Font.Gotham,
                TextScaled = true,
                TextColor3 = T.Gold,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextStrokeTransparency = 0.8,
                Text = "",
                Visible = false,
        }, self.gui)

        ---------------------------------------------------------------- bar boss raid (v3, atas tengah)
        local bossBar = Util.create("Frame", {
                Name = "BossBar",
                AnchorPoint = Vector2.new(0.5, 0),
                Position = UDim2.new(0.5, 0, 0, 12),
                Size = UDim2.fromOffset(430, 62),
                BackgroundColor3 = T.Bg,
                BackgroundTransparency = 0.2,
                BorderSizePixel = 0,
                Visible = false,
        }, self.gui)
        corner(bossBar, 12)
        self.bossTitle = Util.create("TextLabel", {
                Size = UDim2.new(1, -16, 0, 24),
                Position = UDim2.fromOffset(8, 4),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBlack,
                TextScaled = true,
                TextColor3 = Color3.fromRGB(255, 90, 90),
                Text = "RAJA GOLEM",
        }, bossBar)
        local bossBg = Util.create("Frame", {
                Position = UDim2.fromOffset(12, 32),
                Size = UDim2.new(1, -24, 0, 20),
                BackgroundColor3 = Color3.fromRGB(60, 20, 20),
                BorderSizePixel = 0,
        }, bossBar)
        corner(bossBg, 8)
        self.bossHp = Util.create("Frame", {
                Size = UDim2.fromScale(1, 1),
                BackgroundColor3 = Color3.fromRGB(255, 80, 80),
                BorderSizePixel = 0,
        }, bossBg)
        corner(self.bossHp, 8)
        self.bossBar = bossBar

        ---------------------------------------------------------------- tombol kanan atas
        local actions = {
                { name = "Tas", label = "Tas", cb = function()
                        self:renderInv()
                        self:showPanel("Inv")
                end },
                { name = "Kar", label = "Kar", cb = function()
                        self:renderChar()
                        self:showPanel("Char")
                end },
                { name = "Tugas", label = "Tugas", cb = function()
                        self:renderQuest()
                        self:showPanel("Quest")
                end },
                { name = "Dagang", label = "Dagang", cb = function()
                        self:renderTrade()
                        self:showPanel("Trade")
                end },
                { name = "Pasar", label = "Pasar", cb = function()
                        self:showPanel("Market")
                        self:refreshMarket()
                end },
                { name = "Musik", label = "Musik", cb = function()
                        local on = Ambience.toggle()
                        self:toast("Musik Latar", on and "Musik dinyalakan." or "Musik dimatikan.", T.Gold)
                end },
                { name = "Kode", label = "Kode", cb = function()
                        self:showPanel("Code")
                end },
                { name = "Bantuan", label = "?", cb = function()
                        self:showPanel("Help")
                end },
        }
        local i = 0
        for _, act in actions do
                i += 1
                local rowIdx = math.floor((i - 1) / 4)
                local colIdx = (i - 1) % 4
                local b = btn({
                        parent = self.gui,
                        Name = "Btn" .. act.name,
                        AnchorPoint = Vector2.new(1, 0),
                        Position = UDim2.new(1, -16 - colIdx * 84, 0, 14 + rowIdx * 50),
                        Size = UDim2.fromOffset(76, 42),
                        BackgroundColor3 = T.Panel,
                        BackgroundTransparency = 0.12,
                        TextColor3 = T.Text,
                        Text = act.label,
                        _radius = 8,
                })
                b.Activated:Connect(act.cb)
        end

        ---------------------------------------------------------------- tips bawah
        self.tipLabel = Util.create("TextLabel", {
                Name = "Tips",
                AnchorPoint = Vector2.new(0.5, 1),
                Position = UDim2.new(0.5, 0, 1, -14),
                Size = UDim2.fromOffset(640, 34),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBold,
                TextScaled = true,
                TextColor3 = T.TextDim,
                TextStrokeTransparency = 0.7,
                Text = "",
        }, self.gui)

        ---------------------------------------------------------------- kompas zona (v9)
        self.navRows = {}
        local navTargets = {
                { name = "Papan Jual", pos = Vector3.new(-10, 0, 16) },
                { name = "Ladang", pos = Vector3.new(0, 0, -97) },
                { name = "Hutan", pos = Vector3.new(-122, 0, -8) },
                { name = "Tambang", pos = Vector3.new(0, 0, 136) },
                { name = "Gua Kristal", pos = Vector3.new(-170, 0, -175) },
                { name = "Arena Boss", pos = Vector3.new(150, 0, 92) },
        }
        local navHolder = Util.create("Frame", {
                Name = "Kompas",
                AnchorPoint = Vector2.new(0, 1),
                Position = UDim2.new(0, 12, 1, -150),
                Size = UDim2.fromOffset(170, 6 * 30),
                BackgroundTransparency = 1,
                Visible = false,
        }, self.gui)
        Util.create("UIListLayout", { Padding = UDim.new(0, 4) }, navHolder)
        for _, nt in navTargets do
                local chip = Util.create("Frame", {
                        Size = UDim2.new(1, 0, 0, 26),
                        BackgroundColor3 = T.Panel,
                        BackgroundTransparency = 0.25,
                        BorderSizePixel = 0,
                }, navHolder)
                corner(chip, 6)
                Util.create("TextLabel", {
                        Position = UDim2.fromOffset(8, 0),
                        Size = UDim2.new(0.55, 0, 1, 0),
                        BackgroundTransparency = 1,
                        Font = Enum.Font.GothamBold,
                        TextScaled = true,
                        TextColor3 = T.TextDim,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        Text = nt.name,
                }, chip)
                local dist = Util.create("TextLabel", {
                        AnchorPoint = Vector2.new(1, 0),
                        Position = UDim2.new(1, -8, 0, 0),
                        Size = UDim2.new(0.4, 0, 1, 0),
                        BackgroundTransparency = 1,
                        Font = Enum.Font.GothamBold,
                        TextScaled = true,
                        TextColor3 = T.Gold,
                        TextXAlignment = Enum.TextXAlignment.Right,
                        Text = "-",
                }, chip)
                self.navRows[nt.name] = { label = dist, pos = nt.pos }
        end
        self.navHolder = navHolder

        task.spawn(function()
                while true do
                        local char = player.Character
                        local root = char and char.PrimaryPart
                        if root then
                                for name, nav in pairs(self.navRows or {}) do
                                        nav.label.Text = math.floor((nav.pos - root.Position).Magnitude) .. "m"
                                end
                        end
                        task.wait(0.5)
                end
            end)
        ---------------------------------------------------------------- chip event dunia (v6)
        self.eventChip = Util.create("TextLabel", {
                Name = "EventChip",
                AnchorPoint = Vector2.new(0.5, 0),
                Position = UDim2.new(0.5, 0, 0, 84),
                Size = UDim2.fromOffset(360, 40),
                BackgroundColor3 = T.Panel,
                BackgroundTransparency = 0.15,
                Font = Enum.Font.GothamBlack,
                TextScaled = true,
                TextColor3 = T.Gold,
                Text = "",
                Visible = false,
        }, self.gui)
        corner(self.eventChip, 8)

        ---------------------------------------------------------------- tombol skill senjata (v5)
        self.skillBtns = {}
        for idx, sk in ipairs(Balance.Skills) do
                local b = btn({
                        parent = self.gui,
                        Name = "Skill" .. sk.id,
                        AnchorPoint = Vector2.new(1, 1),
                        Position = UDim2.new(1, -16, 1, -108 - (idx - 1) * 56),
                        Size = UDim2.fromOffset(200, 46),
                        BackgroundColor3 = T.Panel,
                        BackgroundTransparency = 0.12,
                        TextColor3 = T.Gold,
                        Text = sk.name,
                        _radius = 8,
                        Visible = false,
                })
                b.Activated:Connect(function()
                        local res = Remotes.get("Skill"):InvokeServer({ skillId = sk.id })
                        self:handleResult(res)
                        if res and res.ok then
                                b.TextColor3 = T.Disabled
                                task.spawn(function()
                                        for t = sk.cooldown, 1, -1 do
                                                if not b.Parent then
                                                        return
                                                end
                                                b.Text = sk.name .. " (" .. t .. "s)"
                                                task.wait(1)
                                        end
                                        if b.Parent then
                                                b.Text = sk.name
                                                b.TextColor3 = T.Gold
                                        end
                                end)
                        end
                end)
                self.skillBtns[sk.id] = b
        end

        ---------------------------------------------------------------- kontainer toast
        self.toastHolder = Util.create("Frame", {
                Name = "Toasts",
                AnchorPoint = Vector2.new(0.5, 1),
                Position = UDim2.new(0.5, 0, 1, -56),
                Size = UDim2.fromOffset(460, 150),
                BackgroundTransparency = 1,
        }, self.gui)
        Util.create("UIListLayout", {
                Padding = UDim.new(0, 6),
                VerticalAlignment = Enum.VerticalAlignment.Bottom,
                HorizontalAlignment = Enum.HorizontalAlignment.Center,
        }, self.toastHolder)
end

local TIPS = {
        "Ladang pertama GRATIS! Ladang lain dibeli lunas pakai Micda di Kawasan Ladang (Utara).",
        "Jual hasil panen ke Bu Laris di Pasar Pengepul - harga pasar berubah tiap 10 menit!",
        "Tempa balok besi dari bijih di PAK TEMPA, lalu buat Pedang Besi & Zirah!",
        "Monster berwujud ANGKA dengan AURA berkeliaran - lawan Angka Satu di Padang Timur!",
        "BOSS RAID: Angka Sang Raja (9) muncul di Arena Timur - serang bersama semua pemain!",
        "Naik level dapat 2 poin stat - buka panel Kar dan bagikan ke STR/VIT/AGI!",
        "Makan Roti Aktif dari Bu Masak untuk lari lebih cepat 12%!",
        "Dagang aman antar pemain: tombol Dagang, dekati partner, undang & SIAP!",
        "PAPAN JUAL di alun-alun: pasang barang, pemain lain beli - Micda masuk walau kamu offline!",
        "Punya ladang? Pasang KIOS di pad dekat papan ladangmu - pemain lain belanja langsung ke kiosmu!",
        "Papan Tugas Harian di alun-alun memberi Micda & XP besar - ambil tiap hari!",
        "Kucing Micda memberi +10% harga jual. Lihat Toko Peliharaan!",
        "Bonus login harian 100 Micda. Datang lagi besok!",
        "Kuis Kak Pintar di alun-alun memberi Micda bonus - sepenuhnya opsional.",
}

function UIController:startTips()
        task.spawn(function()
                local idx = 0
                while true do
                        idx += 1
                        local tip = TIPS[(idx - 1) % #TIPS + 1]
                        if self.tipLabel then
                                self.tipLabel.Text = tip
                        end
                        task.wait(14)
                end
        end)
end

function UIController:toast(title: string, text: string, color: Color3?)
        local c = color or T.Gold
        local toast = Util.create("Frame", {
                Size = UDim2.new(1, 0, 0, 52),
                BackgroundColor3 = T.Bg,
                BackgroundTransparency = 0.12,
                BorderSizePixel = 0,
        }, self.toastHolder)
        corner(toast, 10)
        Util.create("Frame", {
                Size = UDim2.fromOffset(6, 36),
                Position = UDim2.fromOffset(8, 8),
                BackgroundColor3 = c,
                BorderSizePixel = 0,
        }, toast)
        Util.create("TextLabel", {
                Position = UDim2.fromOffset(22, 3),
                Size = UDim2.new(1, -30, 0, 20),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBold,
                TextScaled = true,
                TextColor3 = c,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = title,
        }, toast)
        Util.create("TextLabel", {
                Position = UDim2.fromOffset(22, 24),
                Size = UDim2.new(1, -30, 0, 26),
                BackgroundTransparency = 1,
                Font = Enum.Font.Gotham,
                TextScaled = true,
                TextColor3 = T.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = text,
        }, toast)

        task.delay(4.5, function()
                if toast.Parent then
                        toast:Destroy()
                end
        end)
end

--------------------------------------------------------------------
-- STATE -> HUD
--------------------------------------------------------------------

function UIController:renderState()
        local s = self.state
        if not s then
                return
        end
        self.coinText.Text = Util.formatNumber(s.Coins)
        self.levelText.Text = "Level " .. s.Level .. (s.Dev and "  [DEV]" or "")
        self.xpBar.Size = UDim2.fromScale(math.clamp(s.LevelPct, 0.02, 1), 1)

        self:renderHudExtras()

        -- v5: tombol skill muncul sesuai level
        for _, sk in ipairs(Balance.Skills) do
                local b = self.skillBtns[sk.id]
                if b then
                        b.Visible = s.Level >= sk.level
                end
        end

        -- refresh panel terbuka supaya harga/inv tetap segar
        if self.activePanel == "Shop" and self.shopId then
                self:renderShop()
        elseif self.activePanel == "Plant" and self.pendingPlant then
                self:renderPlantPanel()
        elseif self.activePanel == "Inv" then
                self:renderInv()
        elseif self.activePanel == "Char" then
                self:renderChar()
        elseif self.activePanel == "Craft" then
                self:renderCraft()
        elseif self.activePanel == "Quest" then
                self:renderQuest()
        end
end

--------------------------------------------------------------------
-- HP / TUGAS / BOSS: pembaruan HUD tiap state
--------------------------------------------------------------------

function UIController:renderHudExtras()
        local s = self.state
        if not s then
                return
        end

        -- tugas aktif
        local q = s.Quest
        if q and q.id ~= "" then
                local def = nil
                for _, d in ipairs(Balance.Quests) do
                        if d.id == q.id then
                                def = d
                                break
                        end
                end
                if def then
                        self.questChip.Visible = true
                        self.questChip.Text = (q.done and "[SIAP KLAIM] " or "Tugas: ") .. def.title .. " "
                                .. math.min(q.prog, def.goal.count) .. "/" .. def.goal.count
                        self.questChip.TextColor3 = q.done and T.Green or T.Gold
                end
        else
                self.questChip.Visible = false
        end
end

