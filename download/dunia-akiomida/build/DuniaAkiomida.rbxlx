        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">DoorKit</string>
            <string name="Source"><![CDATA[local DoorKit = {}

DoorKit.CHAR_HEIGHT = 5
DoorKit.DOOR_HEIGHT = DoorKit.CHAR_HEIGHT * 2
DoorKit.DOOR_WIDTH = 4.6
DoorKit.DOOR_THICK = 0.5

function DoorKit.part(props, parent): Part
        local p = Instance.new("Part")
        p.Anchored = true
        p.TopSurface = Enum.SurfaceType.Smooth
        p.BottomSurface = Enum.SurfaceType.Smooth
        for k, v in props do
                (p :: any)[k] = v
        end
        p.Parent = parent
        return p
end

function DoorKit.frame(center: Vector3, yawDeg: number, parent, width: number?, height: number?)
        local w = width or DoorKit.DOOR_WIDTH
        local h = height or DoorKit.CHAR_HEIGHT * 4
        local base = CFrame.new(center) * CFrame.Angles(0, math.rad(yawDeg), 0)
        local frameC = Color3.fromRGB(96, 72, 46)
        DoorKit.part({
                Name = "BingkaiKiri",
                Size = Vector3.new(0.7, h, 1.1),
                CFrame = base * CFrame.new(-w / 2 - 0.35, h / 2, 0),
                Color = frameC,
                Material = Enum.Material.Wood,
        }, parent)
        DoorKit.part({
                Name = "BingkaiKanan",
                Size = Vector3.new(0.7, h, 1.1),
                CFrame = base * CFrame.new(w / 2 + 0.35, h / 2, 0),
                Color = frameC,
                Material = Enum.Material.Wood,
        }, parent)
        DoorKit.part({
                Name = "BingkaiAtas",
                Size = Vector3.new(w + 1.4, 0.7, 1.1),
                CFrame = base * CFrame.new(0, h + 0.35, 0),
                Color = frameC,
                Material = Enum.Material.Wood,
        }, parent)
end

function DoorKit.hinged(center: Vector3, yawDeg: number, parent, width: number?, height: number?, color: Color3?)
        local w = width or DoorKit.DOOR_WIDTH
        local h = height or DoorKit.DOOR_HEIGHT
        local base = CFrame.new(center) * CFrame.Angles(0, math.rad(yawDeg), 0)
        local hinge = base * CFrame.new(-w / 2, h / 2, 0)
        local woodColor = color or Color3.fromRGB(146, 104, 62)

        local panel = DoorKit.part({
                Name = "Pintu",
                Size = Vector3.new(w, h, DoorKit.DOOR_THICK),
                Color = woodColor,
                Material = Enum.Material.WoodPlanks,
        }, parent)

        local trim1 = DoorKit.part({
                Name = "PintuRapih1",
                Size = Vector3.new(w - 0.9, h / 3.4, 0.16),
                Color = woodColor:Lerp(Color3.new(0, 0, 0), 0.14),
                Material = Enum.Material.Wood,
                CanCollide = false,
                Massless = true,
        }, parent)
        local trim2 = DoorKit.part({
                Name = "PintuRapih2",
                Size = Vector3.new(w - 0.9, h / 3.4, 0.16),
                Color = woodColor:Lerp(Color3.new(0, 0, 0), 0.14),
                Material = Enum.Material.Wood,
                CanCollide = false,
                Massless = true,
        }, parent)
        local knob = DoorKit.part({
                Name = "PintuGagang",
                Shape = Enum.PartType.Ball,
                Size = Vector3.new(0.5, 0.5, 0.5),
                Color = Color3.fromRGB(240, 204, 108),
                Material = Enum.Material.Metal,
                CanCollide = false,
                Massless = true,
        }, parent)

        local OPEN_DEG = 104
        local function layout(deg: number)
                local doorCF = hinge * CFrame.Angles(0, math.rad(deg), 0) * CFrame.new(w / 2, 0, 0)
                panel.CFrame = doorCF
                trim1.CFrame = doorCF * CFrame.new(0, h / 4.4, DoorKit.DOOR_THICK / 2 + 0.09)
                trim2.CFrame = doorCF * CFrame.new(0, -h / 4.4, DoorKit.DOOR_THICK / 2 + 0.09)
                knob.CFrame = doorCF * CFrame.new(w - 0.7, 0, DoorKit.DOOR_THICK / 2 + 0.16)
        end
        layout(0)

        local open = false
        local busy = false
        local prompt = Instance.new("ProximityPrompt")
        prompt.ActionText = "Buka"
        prompt.ObjectText = "Pintu"
        prompt.MaxActivationDistance = 7
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
        prompt.Parent = panel
        prompt.Triggered:Connect(function()
                if busy then
                        return
                end
                busy = true
                open = not open
                prompt.ActionText = open and "Tutup" or "Buka"
                local startCF = panel.CFrame
                local startTrim1, startTrim2, startKnob = trim1.CFrame, trim2.CFrame, knob.CFrame
                local targetCF = hinge * CFrame.Angles(0, math.rad(OPEN_DEG), 0) * CFrame.new(w / 2, 0, 0)
                local targetTrim1 = targetCF * CFrame.new(0, h / 4.4, DoorKit.DOOR_THICK / 2 + 0.09)
                local targetTrim2 = targetCF * CFrame.new(0, -h / 4.4, DoorKit.DOOR_THICK / 2 + 0.09)
                local targetKnob = targetCF * CFrame.new(w - 0.7, 0, DoorKit.DOOR_THICK / 2 + 0.16)
                task.spawn(function()
                        local steps = 9
                        for step = 1, steps do
                                local alpha = step / steps
                                panel.CFrame = startCF:Lerp(targetCF, alpha)
                                trim1.CFrame = startTrim1:Lerp(targetTrim1, alpha)
                                trim2.CFrame = startTrim2:Lerp(targetTrim2, alpha)
                                knob.CFrame = startKnob:Lerp(targetKnob, alpha)
                                task.wait(0.03)
                        end
                        panel.CFrame = targetCF
                        trim1.CFrame = targetTrim1
                        trim2.CFrame = targetTrim2
                        knob.CFrame = targetKnob
                        busy = false
                end)
        end)
        return panel
end

return DoorKit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">EquipService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Remotes)
local Balance = require(ReplicatedStorage.Shared.Balance)

local DataService = require(script.Parent.DataService)

local EquipService = {}

local equipById: { [string]: any } = {}
for _, eq in ipairs(Balance.Equipment) do
        equipById[eq.id] = eq
end
local usableById: { [string]: any } = {}
for _, u in ipairs(Balance.Usables) do
        usableById[u.id] = u
end

function EquipService.statsOf(player: Player)
        local data = DataService.get(player)
        return data.Stats or { str = 0, vit = 0, agi = 0, int = 0, dex = 0 }
end

function EquipService.weaponAtk(player: Player): number
        local data = DataService.get(player)
        local id = data.Equipped.weapon
        if id == "" then
                return 0
        end
        local eq = equipById[id]
        if not eq then
                return 0
        end
        local star = (data.EquipStars and data.EquipStars[id]) or 0
        return Balance.starScaled(eq.atk, star)
end

function EquipService.armorDef(player: Player): number
        local data = DataService.get(player)
        local id = data.Equipped.armor
        if id == "" then
                return 0
        end
        local eq = equipById[id]
        if not eq then
                return 0
        end
        local star = (data.EquipStars and data.EquipStars[id]) or 0
        return Balance.starScaled(eq.def, star)
end

function EquipService.upgrade(player: Player, equipId: unknown): { [string]: any }
        if type(equipId) ~= "string" then
                return { ok = false, msg = "Tidak valid." }
        end
        local eq = equipById[equipId]
        if not eq then
                return { ok = false, msg = "Peralatan tidak dikenal." }
        end
        local data = DataService.get(player)
        if (data.Equips[equipId] or 0) < 1 then
                return { ok = false, msg = "Kamu tidak punya " .. eq.name .. ". Tempa dulu!" }
        end
        local star = (data.EquipStars and data.EquipStars[equipId]) or 0
        if star >= Balance.MaxStar then
                return { ok = false, msg = eq.name .. " sudah maksimal (+" .. Balance.MaxStar .. ")." }
        end
        local micda, mat, matCount = Balance.upgradeCost(star)
        if data.Coins < micda then
                return { ok = false, msg = "Butuh " .. micda .. " Micda. Micdamu: " .. data.Coins .. "." }
        end
        if DataService.countItem(player, "bag", mat) < matCount then
                return { ok = false, msg = "Butuh " .. matCount .. "x " .. mat .. " dari tambang." }
        end
        DataService.addCoins(player, -micda, false)
        DataService.takeItem(player, "bag", mat, matCount)
        data.EquipStars[equipId] = star + 1
        DataService.push(player)
        local stat = eq.kind == "weapon" and ("ATK " .. Balance.starScaled(eq.atk, star + 1)) or ("DEF " .. Balance.starScaled(eq.def, star + 1))
        return { ok = true, msg = eq.name .. " naik ke +" .. (star + 1) .. "! " .. stat .. "." }
end

local function buildWeaponTool(equipId: string): Tool
        local eq = equipById[equipId]
        local color = Color3.fromRGB(eq.color[1], eq.color[2], eq.color[3])

        local tool = Instance.new("Tool")
        tool.Name = eq.name
        tool.RequiresHandle = true
        tool.CanBeDropped = false
        tool.ToolTip = "ATK +" .. eq.atk

        local handle = Instance.new("Part")
        handle.Name = "Handle"
        handle.Size = Vector3.new(0.5, 5.2, 0.5)
        handle.Color = color
        handle.Material = Enum.Material.Metal
        handle.CanCollide = false
        handle.Parent = tool

        local grip = Instance.new("Part")
        grip.Name = "Grip"
        grip.Size = Vector3.new(0.6, 2, 0.6)
        grip.Color = Color3.fromRGB(105, 74, 46)
        grip.Material = Enum.Material.Wood
        grip.CanCollide = false
        local weld = Instance.new("Weld")
        weld.Part0 = handle
        weld.Part1 = grip
        weld.C0 = CFrame.new(0, -2.4, 0)
        grip.Parent = tool
        weld.Parent = handle

        local guard = Instance.new("Part")
        guard.Name = "Guard"
        guard.Size = Vector3.new(1.6, 0.4, 1.6)
        guard.Color = Color3.fromRGB(255, 209, 102)
        guard.Material = Enum.Material.Metal
        guard.CanCollide = false
        local weld2 = Instance.new("Weld")
        weld2.Part0 = handle
        weld2.Part1 = guard
        weld2.C0 = CFrame.new(0, 0.6, 0)
        guard.Parent = tool
        weld2.Parent = handle

        if eq.kind == "weapon" and eq.atk >= 26 then

                local glow = Instance.new("PointLight")
                glow.Color = color
                glow.Range = 8
                glow.Brightness = 0.8
                glow.Parent = handle
        end

        return tool
end

function EquipService.apply(player: Player)
        local character = player.Character
        if not character then
                return
        end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid then
                return
        end
        local data = DataService.get(player)
        local stats = EquipService.statsOf(player)

        local maxHp = Balance.maxHp(stats.vit)
        humanoid.MaxHealth = maxHp
        if humanoid.Health > maxHp then
                humanoid.Health = maxHp
        end

        local speed = Balance.walkSpeed(stats.agi)

        if data.Buff.kind == "speed" and os.time() < (data.Buff.expiry or 0) then
                speed = speed * (1 + 0.12)
        end
        humanoid.WalkSpeed = speed

        local backpack = player:FindFirstChild("Backpack")
        if backpack then
                local old = backpack:FindFirstChild("AKM_Senjata")
                if old then
                        old:Destroy()
                end
        end
        local carried = character:FindFirstChild("AKM_Senjata")
        if carried then
                carried:Destroy()
        end
        local weaponId = data.Equipped.weapon
        if weaponId ~= "" and equipById[weaponId] and backpack then
                local tool = buildWeaponTool(weaponId)
                tool.Name = "AKM_Senjata"
                local wstar = (data.EquipStars and data.EquipStars[weaponId]) or 0
                tool.ToolTip = equipById[weaponId].name .. (wstar > 0 and " +" .. wstar or "")
                tool.Parent = backpack
        end
end

local function onEquip(player: Player, kind: any, id: any)
        if not DataService.has(player) or type(kind) ~= "string" or type(id) ~= "string" then
                return { ok = false, msg = "Permintaan tidak valid." }
        end
        local data = DataService.get(player)
        if id ~= "" then
                local eq = equipById[id]
                if not eq or eq.kind ~= kind then
                        return { ok = false, msg = "Peralatan tidak dikenal." }
                end
                if (data.Equips[id] or 0) <= 0 then
                        return { ok = false, msg = "Kamu belum punya " .. eq.name .. ". Tempa di Pak Tempa!" }
                end
                if DataService.levelOf(player) < eq.level then
                        return { ok = false, msg = "Butuh level " .. eq.level .. " untuk memakai " .. eq.name .. "." }
                end
                data.Equipped[kind] = id
                EquipService.apply(player)
                DataService.markDirty(player)
                DataService.push(player)
                return { ok = true, msg = eq.name .. " dipakai! " .. (kind == "weapon" and ("ATK +" .. eq.atk) or ("DEF +" .. eq.def)) }
        else

                if data.Equipped[kind] == "" then
                        return { ok = false, msg = "Tidak ada yang dilepas." }
                end
                data.Equipped[kind] = ""
                EquipService.apply(player)
                DataService.markDirty(player)
                DataService.push(player)
                return { ok = true, msg = "Peralatan dilepas." }
        end
end

local function onUseItem(player: Player, id: any)
        if not DataService.has(player) or type(id) ~= "string" then
                return { ok = false, msg = "Permintaan tidak valid." }
        end
        local data = DataService.get(player)
        if (data.Usables[id] or 0) <= 0 then
                return { ok = false, msg = "Kamu tidak punya barang itu." }
        end
        local u = usableById[id]
        if not u then
                return { ok = false, msg = "Item tidak dikenal." }
        end
        DataService.takeItem(player, "use", id, 1)

        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")

        if u.effect == "heal" and humanoid then
                local boost = 1 + EquipService.statsOf(player).int * 0.01
                local heal = math.floor(humanoid.MaxHealth * math.min(1, u.power * boost))
                humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + heal)
                DataService.push(player)
                return { ok = true, msg = u.name .. " dimakan! HP +" .. heal }
        elseif u.effect == "speed" then
                data.Buff = { kind = "speed", expiry = os.time() + u.duration }
                DataService.markDirty(player)
                EquipService.apply(player)
                DataService.push(player)
                return { ok = true, msg = u.name .. " dimakan! Lari +12% selama " .. math.floor(u.duration / 60) .. " menit." }
        end
        DataService.push(player)
        return { ok = true, msg = u.name .. " dimakan." }
end

local function onAllocStat(player: Player, statId: any)
        if not DataService.has(player) or type(statId) ~= "string" then
                return { ok = false, msg = "Permintaan tidak valid." }
        end
        local valid = false
        for _, s in ipairs(Balance.Stats) do
                if s.id == statId then
                        valid = true
                        break
                end
        end
        if not valid then
                return { ok = false, msg = "Stat tidak dikenal." }
        end
        local data = DataService.get(player)
        if data.StatPoints <= 0 then
                return { ok = false, msg = "Poin stat habis. Naik level untuk lebih banyak poin!" }
        end
        if data.Stats[statId] >= Balance.MaxStatPerStat then
                return { ok = false, msg = "Atribut ini sudah maksimum (60)." }
        end
        data.StatPoints -= 1
        data.Stats[statId] += 1
        DataService.markDirty(player)
        EquipService.apply(player)
        DataService.push(player)
        return { ok = true, msg = "Poin diterapkan!" }
end

function EquipService.init()
        Remotes.get("Equip").OnServerInvoke = onEquip
        Remotes.get("UseItem").OnServerInvoke = onUseItem
        Remotes.get("AllocStat").OnServerInvoke = onAllocStat

        Players.PlayerAdded:Connect(function(player)
                player.CharacterAdded:Connect(function()
                        task.wait(0.4)
                        if DataService.has(player) then
                                EquipService.apply(player)
                        end
                end)
        end)
        for _, player in Players:GetPlayers() do
                player.CharacterAdded:Connect(function()
                        task.wait(0.4)
                        if DataService.has(player) then
                                EquipService.apply(player)
                        end
                end)
        end
end

return EquipService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">FarmService</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Remotes)
local Util = require(ReplicatedStorage.Shared.Util)
local CropConfig = require(ReplicatedStorage.Shared.CropConfig)
local TasLogic = require(ReplicatedStorage.Shared.TasLogic)

local DataService = require(script.Parent.DataService)

local FarmService = {}

local COLS = 25
local ROWS = 20
local PLOT_COUNT = COLS * ROWS
local PLOT_SIZE = 3.4
local GROW = CropConfig.GrowTime

local fields: { [number]: any } = {}
local worldFolder: Folder? = nil

local function world(): Folder
        local f = worldFolder
        if not f then
                f = workspace:FindFirstChild("AKM_Dunia") :: Folder?
                if not f then
                        f = Instance.new("Folder")
                        f.Name = "AKM_Dunia"
                        f.Parent = workspace
                end
                worldFolder = f
        end
        return f :: Folder
end

local function part(props, parent): Part
        local p = Instance.new("Part")
        p.Anchored = true
        p.TopSurface = Enum.SurfaceType.Smooth
        p.BottomSurface = Enum.SurfaceType.Smooth
        for k, v in props do
                (p :: any)[k] = v
        end
        p.Parent = parent or world()
        return p
end

local function fieldFolder(index: number): Folder
        local f = world():FindFirstChild("Kebun" .. index) :: Folder?
        if not f then
                f = Instance.new("Folder")
                f.Name = "Kebun" .. index
                f.Parent = world()
        end
        return f
end

function FarmService.plotCount(): number
        return PLOT_COUNT
end

function FarmService.getField(index: number)
        return fields[index]
end

function FarmService.isOwner(player: Player, index: number): boolean
        local field = fields[index]
        return field ~= nil and field.owner == player
end

local function plotCenter(field, plotNo: number): Vector3
        local col = (plotNo - 1) % COLS
        local row = math.floor((plotNo - 1) / COLS)
        return field.origin + Vector3.new(col * PLOT_SIZE, 0, row * PLOT_SIZE)
end

local function plotState(state: { crop: string?, at: number? }): number
        if not state or not state.crop then
                return 0
        end
        if os.clock() - (state.at or 0) >= GROW then
                return 2
        end
        return 1
end

local function refreshPlot(field, plotNo: number)
        local partPlot = field.parts[plotNo]
        if not partPlot then
                return
        end
        local st = field.plots[plotNo]
        local state = plotState(st)
        partPlot:SetAttribute("State", state)
        partPlot:SetAttribute("Crop", st and st.crop or "")
        local model = field.plants[plotNo]
        if state == 0 then
                if model then
                        model:Destroy()
                        field.plants[plotNo] = nil
                end
                return
        end
        local crop = CropConfig.byId(st.crop or "")
        local color = crop and Color3.fromRGB(crop.color[1], crop.color[2], crop.color[3]) or Color3.fromRGB(120, 180, 90)
        if not model then
                model = Instance.new("Part")
                model.Name = "Tanaman" .. plotNo
                model.Anchored = true
                model.CanCollide = false
                model.CanTouch = false
                model.CastShadow = false
                model.Shape = Enum.PartType.Ball
                model.Material = Enum.Material.Grass
                model.Parent = field.folder
                field.plants[plotNo] = model
        end
        local size = state == 2 and 1.9 or 1.1
        model.Size = Vector3.new(size, size * 1.25, size)
        model.Color = color
        model.CFrame = CFrame.new(plotCenter(field, plotNo) + Vector3.new(0, (state == 2 and 1.35 or 0.8), 0))
end

function FarmService.buildField(index: number, center: Vector3)
        local folder = fieldFolder(index)
        local field = fields[index]
        if field then
                return field
        end
        field = {
                index = index,
                owner = nil,
                origin = center - Vector3.new((COLS - 1) * PLOT_SIZE / 2, 0, (ROWS - 1) * PLOT_SIZE / 2),
                plots = {},
                parts = {},
                plants = {},
                folder = folder,
        }
        fields[index] = field

        part({
                Name = "KebunDasar" .. index,
                Size = Vector3.new(COLS * PLOT_SIZE + 4, 0.3, ROWS * PLOT_SIZE + 4),
                CFrame = CFrame.new(center.X, 0.15, center.Z),
                Color = Color3.fromRGB(122, 94, 66),
                Material = Enum.Material.Ground,
        }, folder)

        for plotNo = 1, PLOT_COUNT do
                local pos = plotCenter(field, plotNo)
                local soil = part({
                        Name = "Petak" .. plotNo,
                        Size = Vector3.new(PLOT_SIZE - 0.5, 0.36, PLOT_SIZE - 0.5),
                        CFrame = CFrame.new(pos.X, 0.42, pos.Z),
                        Color = Color3.fromRGB(96, 72, 50),
                        Material = Enum.Material.Ground,
                }, folder)
                field.parts[plotNo] = soil
        end

        local boardPos = center + Vector3.new(COLS * PLOT_SIZE / 2 + 4, 0, -ROWS * PLOT_SIZE / 2 + 8)
        part({
                Name = "KebunPapanTiang",
                Size = Vector3.new(0.7, 3.2, 0.7),
                CFrame = CFrame.new(boardPos + Vector3.new(0, 1.6, 0)) * CFrame.Angles(0, math.rad(90), 0),
                Color = Color3.fromRGB(96, 66, 38),
                Material = Enum.Material.WoodPlanks,
        }, folder)
        local board = part({
                Name = "KebunPapan",
                Size = Vector3.new(10, 2.8, 0.5),
                CFrame = CFrame.new(boardPos + Vector3.new(0, 4.6, 0)) * CFrame.Angles(0, math.rad(90), 0),
                Color = Color3.fromRGB(96, 66, 38),
                Material = Enum.Material.WoodPlanks,
        }, folder)
        local gui = Instance.new("SurfaceGui")
        gui.Face = Enum.NormalId.Front
        gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
        gui.PixelsPerStud = 50
        gui.Parent = board
        Util.create("TextLabel", {
                Size = UDim2.fromScale(1, 0.6),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBlack,
                TextScaled = true,
                TextColor3 = Color3.fromRGB(255, 226, 150),
                Text = "KEBUN " .. PLOT_COUNT .. " PETAK",
        }, gui)
        Util.create("TextLabel", {
                Position = UDim2.fromScale(0, 0.6),
                Size = UDim2.fromScale(1, 0.4),
                BackgroundTransparency = 1,
                Font = Enum.Font.Gotham,
                TextScaled = true,
                TextColor3 = Color3.fromRGB(210, 214, 224),
                Text = "Tanam & panen di sini",
        }, gui)
        local prompt = Instance.new("ProximityPrompt")
        prompt.ActionText = "Buka Kebun"
        prompt.ObjectText = "Kebun " .. PLOT_COUNT .. " Petak"
        prompt.MaxActivationDistance = 10
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
        prompt.Parent = board
        prompt.Triggered:Connect(function(player: Player)
                if FarmService.isOwner(player, index) then
                        Remotes.get("OpenFarm"):FireClient(player, index)
                else
                        Remotes.get("Notify"):FireClient(player, "Kebun Orang Lain", "Kebun ini bukan milikmu. Setiap pemain punya satu lahan sendiri!")
                end
        end)

        for plotNo = 1, PLOT_COUNT do
                refreshPlot(field, plotNo)
        end
        return field
end

function FarmService.claimFieldFor(player: Player, index: number)
        local field = fields[index]
        if not field then
                return false
        end
        field.owner = player
        for plotNo = 1, PLOT_COUNT do
                field.plots[plotNo] = nil
                refreshPlot(field, plotNo)
        end
        return true
end

local function counts(field)
        local kosong, tumbuh, siap = 0, 0, 0
        for plotNo = 1, PLOT_COUNT do
                local st = plotState(field.plots[plotNo])
                if st == 0 then
                        kosong += 1
                elseif st == 1 then
                        tumbuh += 1
                else
                        siap += 1
                end
        end
        return kosong, tumbuh, siap
end

local function statesArray(field): { number }
        local out = table.create(PLOT_COUNT)
        for plotNo = 1, PLOT_COUNT do
                out[plotNo] = plotState(field.plots[plotNo])
        end
        return out
end

local function snapshot(player: Player, index: number)
        local field = fields[index]
        if not field or field.owner ~= player then
                return nil
        end
        local kosong, tumbuh, siap = counts(field)
        return {
                lahan = index,
                total = PLOT_COUNT,
                kosong = kosong,
                tumbuh = tumbuh,
                siap = siap,
                states = statesArray(field),
        }
end

local function actionPlant(player: Player, index: number, plotNo: number, seedId: string)
        local field = fields[index]
        if not field or field.owner ~= player then
                return { ok = false, msg = "Kebun ini bukan milikmu." }
        end
        if not CropConfig.byId(seedId) then
                return { ok = false, msg = "Benih tidak dikenal." }
        end
        if field.plots[plotNo] and field.plots[plotNo].crop then
                return { ok = false, msg = "Petak itu masih tertanam." }
        end
        if DataService.countItem(player, "seed", seedId) < 1 then
                return { ok = false, msg = "Benih " .. CropConfig.nameOf(seedId) .. " habis di tas." }
        end
        DataService.takeItem(player, "seed", seedId, 1)
        field.plots[plotNo] = { crop = seedId, at = os.clock() }
        refreshPlot(field, plotNo)
        DataService.push(player)
        return { ok = true, msg = CropConfig.nameOf(seedId) .. " ditanam di petak " .. plotNo .. "! Tumbuh dalam " .. GROW .. " detik." }
end

local function actionPlantAll(player: Player, index: number, seedId: string)
        local field = fields[index]
        if not field or field.owner ~= player then
                return { ok = false, msg = "Kebun ini bukan milikmu." }
        end
        if not CropConfig.byId(seedId) then
                return { ok = false, msg = "Benih tidak dikenal." }
        end
        local stock = DataService.countItem(player, "seed", seedId)
        if stock < 1 then
                return { ok = false, msg = "Benih " .. CropConfig.nameOf(seedId) .. " habis di tas." }
        end
        local planted = 0
        for plotNo = 1, PLOT_COUNT do
                if planted >= stock then
                        break
                end
                local st = field.plots[plotNo]
                if not st or not st.crop then
                        field.plots[plotNo] = { crop = seedId, at = os.clock() }
                        refreshPlot(field, plotNo)
                        planted += 1
                end
        end
        if planted == 0 then
                return { ok = false, msg = "Semua petak masih tertanam." }
        end
        DataService.takeItem(player, "seed", seedId, planted)
        DataService.push(player)
        return { ok = true, msg = planted .. " benih " .. CropConfig.nameOf(seedId) .. " ditanam sekaligus!" }
end

local function actionHarvest(player: Player, index: number, plotNo: number)
        local field = fields[index]
        if not field or field.owner ~= player then
                return { ok = false, msg = "Kebun ini bukan milikmu." }
        end
        local st = field.plots[plotNo]
        if not st or not st.crop then
                return { ok = false, msg = "Petak itu kosong." }
        end
        if plotState(st) ~= 2 then
                return { ok = false, msg = "Belum siap panen! Tunggu " .. GROW .. " detik." }
        end
        local yield = math.random(CropConfig.YieldMin, CropConfig.YieldMax)
        local seeds, crops = DataService.tasTables(player)
        local room = TasLogic.roomFor(seeds, crops, "crop", st.crop, yield)
        if room <= 0 then
                return { ok = false, msg = "TAS PENUH! Jual hasil panenmu di Koperasi dulu." }
        end
        DataService.giveItem(player, "crop", st.crop, room)
        field.plots[plotNo] = nil
        refreshPlot(field, plotNo)
        DataService.push(player)
        return { ok = true, msg = "Panen " .. room .. "x " .. CropConfig.nameOf(st.crop) .. "!" }
end

local function actionHarvestAll(player: Player, index: number)
        local field = fields[index]
        if not field or field.owner ~= player then
                return { ok = false, msg = "Kebun ini bukan milikmu." }
        end
        local totals: { [string]: number } = {}
        local fullBag = false
        for plotNo = 1, PLOT_COUNT do
                local st = field.plots[plotNo]
                if st and st.crop and plotState(st) == 2 then
                        local yield = math.random(CropConfig.YieldMin, CropConfig.YieldMax)
                        local seeds, crops = DataService.tasTables(player)
                        local room = TasLogic.roomFor(seeds, crops, "crop", st.crop, yield)
                        if room <= 0 then
                                fullBag = true
                                continue
                        end
                        DataService.giveItem(player, "crop", st.crop, room)
                        totals[st.crop] = (totals[st.crop] or 0) + room
                        field.plots[plotNo] = nil
                        refreshPlot(field, plotNo)
                end
        end
        local parts = {}
        local totalItems = 0
        for id, n in pairs(totals) do
                table.insert(parts, n .. "x " .. CropConfig.nameOf(id))
                totalItems += n
        end
        table.sort(parts)
        DataService.push(player)
        if totalItems == 0 then
                if fullBag then
                        return { ok = false, msg = "TAS PENUH! Jual hasil panenmu di Koperasi dulu." }
                end
                return { ok = false, msg = "Belum ada tanaman yang siap panen." }
        end
        local msg = "Panen raya: " .. table.concat(parts, ", ")
        if fullBag then
                msg ..= " (tas penuh, sebagian petak tersisa)"
        end
        return { ok = true, msg = msg }
end

function FarmService.init()
        Remotes.get("FarmAct").OnServerInvoke = function(player, payload)
                if not DataService.has(player) or type(payload) ~= "table" then
                        return { ok = false, msg = "Permintaan tidak valid." }
                end
                local index = tonumber(payload.lahan) or 0
                local action = payload.action
                if action == "info" then
                        local snap = snapshot(player, index)
                        if not snap then
                                return { ok = false, msg = "Kebun ini bukan milikmu." }
                        end
                        return { ok = true, farm = snap }
                elseif action == "plant" then
                        return actionPlant(player, index, tonumber(payload.plot) or 0, tostring(payload.seed or ""))
                elseif action == "plantAll" then
                        return actionPlantAll(player, index, tostring(payload.seed or ""))
                elseif action == "harvest" then
                        return actionHarvest(player, index, tonumber(payload.plot) or 0)
                elseif action == "harvestAll" then
                        return actionHarvestAll(player, index)
                end
                return { ok = false, msg = "Aksi tidak dikenal." }
        end
        DataService.registerProvider("farm", function(player: Player)
                local homeId = DataService.getHomeId(player)
                if homeId < 1 then
                        return { lahan = 0 }
                end
                local snap = snapshot(player, homeId)
                if not snap then
                        return { lahan = homeId, total = PLOT_COUNT, kosong = PLOT_COUNT, tumbuh = 0, siap = 0, states = {} }
                end
                return snap
        end)
end

function FarmService.startLoop()
        task.spawn(function()
                while true do
                        task.wait(1)
                        for _, field in pairs(fields) do
                                for plotNo = 1, PLOT_COUNT do
                                        local st = field.plots[plotNo]
                                        if st and st.crop then
                                                local attr = field.parts[plotNo] and field.parts[plotNo]:GetAttribute("State")
                                                if attr ~= plotState(st) then
                                                        refreshPlot(field, plotNo)
                                                end
                                        end
                                end
                        end
                end
        end)
end

return FarmService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">GatherService</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Remotes)

local DataService = require(script.Parent.DataService)

local GatherService = {}

local FISH_COOLDOWN = 4
local fishCooldown: { [Player]: number } = {}

local worldFolder: Folder? = nil

local function world(): Folder
	local f = worldFolder
	if not f then
		f = workspace:FindFirstChild("AKM_Dunia") :: Folder?
		if not f then
			f = Instance.new("Folder")
			f.Name = "AKM_Dunia"
			f.Parent = workspace
		end
		worldFolder = f
	end
	return f :: Folder
end

local function part(props): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		(p :: any)[k] = v
	end
	p.Parent = world()
	return p
end

local function notify(player: Player, title: string, text: string)
	Remotes.get("Notify"):FireClient(player, title, text)
end

function GatherService.buildPier(basePosition: Vector3, direction: Vector3)
	local planks = part({
		Name = "DermagaPapan",
		Size = Vector3.new(14, 0.5, 4),
		CFrame = CFrame.new(basePosition + Vector3.new(0, 1.2, 0)) * CFrame.Angles(0, math.atan2(direction.X, direction.Z) + math.rad(90), 0),
		Color = Color3.fromRGB(146, 106, 66),
		Material = Enum.Material.WoodPlanks,
	})
	for i = -1, 1 do
		part({
			Name = "DermagaTiang" .. i,
			Size = Vector3.new(0.8, 3, 0.8),
			CFrame = CFrame.new(basePosition + Vector3.new(i * 5.5, 0.4, 0)),
			Color = Color3.fromRGB(110, 80, 50),
			Material = Enum.Material.Wood,
		})
	end

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Pancing Ikan"
	prompt.ObjectText = "Kolam Memancing"
	prompt.MaxActivationDistance = 10
	prompt.HoldDuration = 2.5
	prompt.Parent = planks

	prompt.Triggered:Connect(function(player)
		if not DataService.has(player) then
			return
		end
		local now = time()
		if fishCooldown[player] and now - fishCooldown[player] < FISH_COOLDOWN then
			return
		end
		fishCooldown[player] = now

		local roll = math.random()
		local acc = 0
		local caught = Config.Fish[#Config.Fish]
		for _, fish in Config.Fish do
			acc += fish.chance
			if roll <= acc then
				caught = fish
				break
			end
		end

		DataService.giveItem(player, "fish", caught.id, 1)
		DataService.addXP(player, 5)
		if caught.id == "sepatu" then
			notify(player, "Tidak Nyangka...", "Kamu menarik Sepatu Bot Tua?! Tetap dijual saja di koperasi.")
		else
			notify(player, "Dapat Ikan!", "+" .. caught.name .. " - jual di koperasi lahanku!")
		end
		DataService.push(player)
	end)
end

function GatherService.init()
	local Players = game:GetService("Players")
	Players.PlayerRemoving:Connect(function(player)
		fishCooldown[player] = nil
	end)
end

return GatherService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">KoperasiService</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Remotes)
local Util = require(ReplicatedStorage.Shared.Util)
local CropConfig = require(ReplicatedStorage.Shared.CropConfig)
local Config = require(ReplicatedStorage.Shared.Config)

local DataService = require(script.Parent.DataService)

local KoperasiService = {}

local KINDS = {
        { kind = "crop", list = nil, priceOf = function(id)
                return CropConfig.sellOf(id)
        end, nameOf = function(id)
                return CropConfig.nameOf(id)
        end },
        { kind = "bag", list = Config.Resources, priceOf = function(res)
                return res.sell
        end, nameOf = function(res)
                return res.name
        end },
        { kind = "fish", list = Config.Fish, priceOf = function(res)
                return res.sell
        end, nameOf = function(res)
                return res.name
        end },
}

function KoperasiService.priceOf(kind: string, id: string): number
        for _, entry in ipairs(KINDS) do
                if entry.kind == kind then
                        if entry.list then
                                for _, res in ipairs(entry.list) do
                                        if res.id == id then
                                                return entry.priceOf(res)
                                        end
                                end
                        elseif kind == "crop" then
                                return entry.priceOf(id)
                        end
                end
        end
        return 0
end

function KoperasiService.nameOf(kind: string, id: string): string
        for _, entry in ipairs(KINDS) do
                if entry.kind == kind then
                        if entry.list then
                                for _, res in ipairs(entry.list) do
                                        if res.id == id then
                                                return entry.nameOf(res)
                                        end
                                end
                        elseif kind == "crop" then
                                return entry.nameOf(id)
                        end
                end
        end
        return id
end

local function offerCount(player: Player, kind: string, id: string): number
        return DataService.countItem(player, kind, id)
end

function KoperasiService.offers(player: Player): { any }
        local out = {}
        for _, entry in ipairs(KINDS) do
                if entry.list then
                        for _, res in ipairs(entry.list) do
                                local n = offerCount(player, entry.kind, res.id)
                                if n > 0 then
                                        table.insert(out, { kind = entry.kind, id = res.id, name = entry.nameOf(res), price = entry.priceOf(res), count = n })
                                end
                        end
                elseif entry.kind == "crop" then
                        local crops = DataService.get(player).Crops
                        local ids = {}
                        for id in pairs(crops) do
                                table.insert(ids, id)
                        end
                        table.sort(ids)
                        for _, id in ipairs(ids) do
                                local n = crops[id] or 0
                                if n > 0 then
                                        table.insert(out, { kind = "crop", id = id, name = CropConfig.nameOf(id), price = CropConfig.sellOf(id), count = n })
                                end
                        end
                end
        end
        return out
end

local function sell(player: Player, kind: string, id: string, wantAll: boolean)
        local price = KoperasiService.priceOf(kind, id)
        if price <= 0 then
                return { ok = false, msg = "Item tidak bisa dijual." }
        end
        local have = offerCount(player, kind, id)
        if have < 1 then
                return { ok = false, msg = "Kamu tidak punya item itu." }
        end
        local n = wantAll and have or 1
        local total = price * n
        DataService.takeItem(player, kind, id, n)
        DataService.addCoins(player, total, true)
        DataService.push(player)
        return { ok = true, msg = "Terjual " .. n .. "x " .. KoperasiService.nameOf(kind, id) .. " = " .. Util.formatNumber(total) .. " Micda." }
end

local function sellEverything(player: Player)
        local total = 0
        local parts = {}
        for _, entry in ipairs(KINDS) do
                if entry.list then
                        for _, res in ipairs(entry.list) do
                                local have = offerCount(player, entry.kind, res.id)
                                if have > 0 then
                                        local earned = entry.priceOf(res) * have
                                        DataService.takeItem(player, entry.kind, res.id, have)
                                        DataService.addCoins(player, earned, true)
                                        total += earned
                                        table.insert(parts, have .. "x " .. entry.nameOf(res))
                                end
                        end
                elseif entry.kind == "crop" then
                        local crops = DataService.get(player).Crops
                        local ids = {}
                        for id in pairs(crops) do
                                table.insert(ids, id)
                        end
                        table.sort(ids)
                        for _, id in ipairs(ids) do
                                local have = crops[id] or 0
                                if have > 0 then
                                        local earned = CropConfig.sellOf(id) * have
                                        DataService.takeItem(player, "crop", id, have)
                                        DataService.addCoins(player, earned, true)
                                        total += earned
                                        table.insert(parts, have .. "x " .. CropConfig.nameOf(id))
                                end
                        end
                end
        end
        table.sort(parts)
        DataService.push(player)
        if total == 0 then
                return { ok = false, msg = "Tidak ada yang bisa dijual." }
        end
        return { ok = true, msg = "Terjual semuanya (" .. table.concat(parts, ", ") .. ") = " .. Util.formatNumber(total) .. " Micda!" }
end

function KoperasiService.init()
        Remotes.get("KoperasiAct").OnServerInvoke = function(player, payload)
                if not DataService.has(player) or type(payload) ~= "table" then
                        return { ok = false, msg = "Permintaan tidak valid." }
                end
                if payload.action == "offers" then
                        return { ok = true, offers = KoperasiService.offers(player) }
                elseif payload.action == "sell" then
                        return sell(player, tostring(payload.kind or ""), tostring(payload.id or ""), payload.all == true)
                elseif payload.action == "sellAll" then
                        return sellEverything(player)
                end
                return { ok = false, msg = "Aksi tidak dikenal." }
        end
end

return KoperasiService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Remotes)
local DataService = require(script.Parent.DataService)
local Util = require(ReplicatedStorage.Shared.Util)

local LeaderboardService = {}

local orderedStore = DataStoreService:GetOrderedDataStore(Config.Data.OrderedStoreName)
local latestRows: { { name: string, value: number } } = {}
local boards: { SurfaceGui } = {}

local function buildBoard(position: Vector3, lookAt: Vector3)
        local part = Util.create("Part", {
                Name = "PapanPenjelajah",
                Size = Vector3.new(16, 10, 1),
                Anchored = true,
                Material = Enum.Material.SmoothPlastic,
                Color = Color3.fromRGB(25, 28, 38),
                CFrame = CFrame.lookAt(position, lookAt),
        }, workspace)

        local gui = Util.create("SurfaceGui", {
                Face = Enum.NormalId.Front,
                SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
                PixelsPerStud = 50,
        }, part)

        Util.create("TextLabel", {
                Size = UDim2.fromScale(1, 0.18),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBlack,
                TextScaled = true,
                TextColor3 = Color3.fromRGB(255, 209, 102),
                Text = "PAPAN JUARA DUNIA (XP)",
        }, gui)

        local list = Util.create("Frame", {
                Position = UDim2.fromScale(0.05, 0.22),
                Size = UDim2.fromScale(0.9, 0.74),
                BackgroundTransparency = 1,
        }, gui)
        Util.create("UIListLayout", { Padding = UDim.new(0.02, 0) }, list)

        for i = 1, Config.Leaderboard.Size do
                Util.create("TextLabel", {
                        Name = "Row" .. i,
                        Size = UDim2.fromScale(1, 0.09),
                        BackgroundTransparency = 1,
                        Font = Enum.Font.GothamBold,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        TextScaled = true,
                        TextColor3 = i == 1 and Color3.fromRGB(255, 215, 0) or Color3.fromRGB(230, 230, 240),
                        Text = i .. ". -",
                }, list)
        end
        table.insert(boards, gui)
end

local function renderRows()
        for _, gui in boards do
                local list = gui:FindFirstChildOfClass("Frame")
                if not list then
                        continue
                end
                for i = 1, Config.Leaderboard.Size do
                        local row = list:FindFirstChild("Row" .. i)
                        if not row then
                                continue
                        end
                        local entry = latestRows[i]
                        local rowLabel = row :: TextLabel
                        rowLabel.Text = entry and (i .. ". " .. entry.name .. " - " .. Util.formatNumber(entry.value) .. " XP")
                                or (i .. ". -")
                end
        end
end

local function refresh()
        for _, player in Players:GetPlayers() do
                if DataService.has(player) then
                        local data = DataService.get(player)
                        pcall(function()
                                orderedStore:SetAsync(tostring(player.UserId), math.floor(data.XP))
                        end)
                end
        end

        local ok, pages = pcall(function()
                return orderedStore:GetSortedAsync(false, Config.Leaderboard.Size)
        end)
        if not ok or not pages then
                return
        end
        local rows: { { name: string, value: number } } = {}
        for rank, entry in pages:GetCurrentPage() do
                local name = "Penjelajah " .. entry.key
                local online = Players:GetPlayerByUserId(tonumber(entry.key) or 0)
                if online then
                        name = online.DisplayName
                else
                        local okName, fetched = pcall(Players.GetNameFromUserIdAsync, Players, tonumber(entry.key) or 0)
                        if okName and fetched then
                                name = fetched
                        end
                end
                rows[rank] = { name = name, value = entry.value }
        end
        latestRows = rows
        renderRows()
end

function LeaderboardService.init()
        Remotes.get("GetLeaderboard").OnServerInvoke = function()
                return latestRows
        end

        buildBoard(Vector3.new(-14, 8, -14), Vector3.new(0, 7, 24))
        buildBoard(Vector3.new(14, 8, -14), Vector3.new(0, 7, 24))

        task.spawn(function()
                task.wait(5)
                while true do
                        refresh()
                        task.wait(Config.Leaderboard.RefreshInterval)
                end
        end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">MapService</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Remotes)
local Util = require(ReplicatedStorage.Shared.Util)
local Balance = require(ReplicatedStorage.Shared.Balance)
local CropConfig = require(ReplicatedStorage.Shared.CropConfig)
local DoorKit = require(script.Parent.DoorKit)

local MapService = {}

local folder = Instance.new("Folder")
folder.Name = "AKM_Dunia"

local function part(props): Part
        local p = Instance.new("Part")
        p.Anchored = true
        p.TopSurface = Enum.SurfaceType.Smooth
        p.BottomSurface = Enum.SurfaceType.Smooth
        for k, v in props do
                (p :: any)[k] = v
        end
        p.Parent = folder
        return p
end

local function surfaceText(board: Part, title: string, sub: string?, color: Color3)
        local gui = Instance.new("SurfaceGui")
        gui.Face = Enum.NormalId.Front
        gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
        gui.PixelsPerStud = 50
        gui.Parent = board
        Util.create("TextLabel", {
                Size = sub and UDim2.fromScale(1, 0.62) or UDim2.fromScale(1, 1),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBlack,
                TextScaled = true,
                TextColor3 = color,
                Text = title,
        }, gui)
        if sub then
                Util.create("TextLabel", {
                        Position = UDim2.fromScale(0, 0.62),
                        Size = UDim2.fromScale(1, 0.38),
                        BackgroundTransparency = 1,
                        Font = Enum.Font.Gotham,
                        TextScaled = true,
                        TextColor3 = Color3.fromRGB(214, 218, 228),
                        Text = sub,
                }, gui)
        end
end

local function buildLamp(position: Vector3)
        part({
                Name = "LampuTiang",
                Size = Vector3.new(0.7, 7, 0.7),
                CFrame = CFrame.new(position + Vector3.new(0, 3.5, 0)),
                Color = Color3.fromRGB(58, 62, 74),
                Material = Enum.Material.Metal,
        })
        part({
                Name = "LampuKepala",
                Shape = Enum.PartType.Ball,
                Size = Vector3.new(1.7, 1.7, 1.7),
                CFrame = CFrame.new(position + Vector3.new(0, 7.4, 0)),
                Color = Color3.fromRGB(255, 226, 160),
                Material = Enum.Material.Neon,
                CanCollide = false,
        })
end

local function buildTerrain()
        local terrain = workspace.Terrain
        terrain.WaterWaveSize = 0.16
        terrain.WaterWaveSpeed = 16
        terrain.WaterReflectance = 0.4
        terrain.WaterTransparency = 0.6

        terrain:FillBlock(CFrame.new(260, -7, 0), Vector3.new(3400, 12, 3000), Enum.Material.Water)

        for _, r in ipairs(Balance.Regions) do
                local cx, cz = r.center[1], r.center[2]
                local hx, hz = r.half[1], r.half[2]
                terrain:FillBlock(CFrame.new(cx, -5.1, cz), Vector3.new(hx * 2 + 14, 9.5, hz * 2 + 14), Enum.Material.Sand)
                terrain:FillBlock(CFrame.new(cx, -5, cz), Vector3.new(hx * 2, 10, hz * 2), Enum.Material.Grass)
        end
end

local function seedPacketRow(center: Vector3, yawDeg: number, count: number, palette: { Color3 }, rng)
        local base = CFrame.new(center) * CFrame.Angles(0, math.rad(yawDeg), 0)
        for i = 1, count do
                local c = palette[(i - 1) % #palette + 1]
                part({
                        Name = "KemasanBenih",
                        Size = Vector3.new(0.85, 1.25, 0.22),
                        CFrame = base * CFrame.new((i - (count + 1) / 2) * 1.15, 0.62, 0) * CFrame.Angles(rng:NextNumber(-0.12, 0.12), 0, rng:NextNumber(-0.08, 0.08)),
                        Color = c,
                        Material = Enum.Material.SmoothPlastic,
                        CanCollide = false,
                })
                part({
                        Name = "KemasanLipatan",
                        Size = Vector3.new(0.85, 0.16, 0.24),
                        CFrame = base * CFrame.new((i - (count + 1) / 2) * 1.15, 1.32, 0),
                        Color = c:Lerp(Color3.new(0, 0, 0), 0.25),
                        Material = Enum.Material.SmoothPlastic,
                        CanCollide = false,
                })
        end
end

local function displayPlanter(center: Vector3, cropId: string)
        local crop = CropConfig.byId(cropId)
        local color = crop and Color3.fromRGB(crop.color[1], crop.color[2], crop.color[3]) or Color3.fromRGB(120, 200, 90)
        part({
                Name = "PlanterKotak",
                Size = Vector3.new(4.4, 1.4, 2.2),
                CFrame = CFrame.new(center + Vector3.new(0, 0.7, 0)),
                Color = Color3.fromRGB(134, 100, 66),
                Material = Enum.Material.Wood,
        })
        part({
                Name = "PlanterTanah",
                Size = Vector3.new(4, 0.3, 1.8),
                CFrame = CFrame.new(center + Vector3.new(0, 1.5, 0)),
                Color = Color3.fromRGB(96, 72, 50),
                Material = Enum.Material.Ground,
        })
        for i = 1, 3 do
                part({
                        Name = "PlanterTanaman" .. i,
                        Shape = Enum.PartType.Ball,
                        Size = Vector3.new(1.5, 1.8, 1.5),
                        CFrame = CFrame.new(center + Vector3.new(-1.3 + (i - 1) * 1.3, 2.3, 0)),
                        Color = color,
                        Material = Enum.Material.Grass,
                        CanCollide = false,
                })
                part({
                        Name = "PlanterBuah" .. i,
                        Shape = Enum.PartType.Ball,
                        Size = Vector3.new(0.7, 0.7, 0.7),
                        CFrame = CFrame.new(center + Vector3.new(-1.3 + (i - 1) * 1.3, 3.3, 0.3)),
                        Color = color:Lerp(Color3.new(1, 1, 1), 0.2),
                        Material = Enum.Material.SmoothPlastic,
                        CanCollide = false,
                })
        end
end

local function buildTokoBenih(svc)
        local X, Z = -60, -28
        local wallC = Color3.fromRGB(236, 226, 204)
        local woodC = Color3.fromRGB(120, 88, 56)
        local roofC = Color3.fromRGB(88, 122, 74)

        part({ Name = "TokoLantai", Size = Vector3.new(28, 0.5, 24), CFrame = CFrame.new(X, 0.25, Z), Color = Color3.fromRGB(178, 138, 92), Material = Enum.Material.WoodPlanks })
        part({ Name = "TokoDindingB", Size = Vector3.new(1, 20, 24), CFrame = CFrame.new(X - 14, 10, Z), Color = wallC, Material = Enum.Material.WoodPlanks })
        part({ Name = "TokoDindingU", Size = Vector3.new(28, 20, 1), CFrame = CFrame.new(X, 10, Z - 12), Color = wallC, Material = Enum.Material.WoodPlanks })
        part({ Name = "TokoDindingS", Size = Vector3.new(28, 20, 1), CFrame = CFrame.new(X, 10, Z + 12), Color = wallC, Material = Enum.Material.WoodPlanks })
        part({ Name = "TokoDindingDU", Size = Vector3.new(1, 20, 9.2), CFrame = CFrame.new(X + 14, 10, Z - 7.4), Color = wallC, Material = Enum.Material.WoodPlanks })
        part({ Name = "TokoDindingDS", Size = Vector3.new(1, 20, 9.2), CFrame = CFrame.new(X + 14, 10, Z + 7.4), Color = wallC, Material = Enum.Material.WoodPlanks })
        part({ Name = "TokoPalangPintu", Size = Vector3.new(1, 10, 4.6), CFrame = CFrame.new(X + 14, 15, Z), Color = wallC, Material = Enum.Material.WoodPlanks })
        DoorKit.frame(Vector3.new(X + 14, 0, Z), 90, folder, DoorKit.DOOR_WIDTH, DoorKit.DOOR_HEIGHT)
        DoorKit.hinged(Vector3.new(X + 14, 0, Z), 90, folder, DoorKit.DOOR_WIDTH, DoorKit.DOOR_HEIGHT, Color3.fromRGB(104, 140, 78))

        for _, side in { -1, 1 } do
                part({
                        Name = "TokoJendela" .. side,
                        Size = Vector3.new(9, 6, 0.5),
                        CFrame = CFrame.new(X - 5, 12, Z + side * 11.6),
                        Color = Color3.fromRGB(172, 216, 236),
                        Material = Enum.Material.Glass,
                        Transparency = 0.45,
                })
                part({
                        Name = "TokoJendelaDepan" .. side,
                        Size = Vector3.new(0.5, 6, 8),
                        CFrame = CFrame.new(X + 13.6, 12, Z + side * 7.4),
                        Color = Color3.fromRGB(172, 216, 236),
                        Material = Enum.Material.Glass,
                        Transparency = 0.45,
                })
        end

        part({ Name = "TokoAtap", Size = Vector3.new(31, 1.4, 27), CFrame = CFrame.new(X, 20.7, Z), Color = roofC, Material = Enum.Material.Slate })
        part({ Name = "TokoAtapKedua", Size = Vector3.new(24, 1.2, 20), CFrame = CFrame.new(X, 22, Z), Color = roofC:Lerp(Color3.new(1, 1, 1), 0.1), Material = Enum.Material.Slate })
        part({ Name = "TokoLengkungDepan", Size = Vector3.new(18, 0.8, 6), CFrame = CFrame.new(X + 14, 4.6, Z) * CFrame.Angles(0, 0, math.rad(10)), Color = roofC, Material = Enum.Material.Fabric, CanCollide = false })
        part({ Name = "TokoGagangLengkung1", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 7, 0.4), CFrame = CFrame.new(X + 17.5, 2.2, Z - 2.4) * CFrame.Angles(math.rad(90), 0, 0), Color = woodC, Material = Enum.Material.Wood })
        part({ Name = "TokoGagangLengkung2", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 7, 0.4), CFrame = CFrame.new(X + 17.5, 2.2, Z + 2.4) * CFrame.Angles(math.rad(90), 0, 0), Color = woodC, Material = Enum.Material.Wood })

        local sign = part({
                Name = "TokoPapanNama",
                Size = Vector3.new(14, 3.4, 0.7),
                CFrame = CFrame.new(X + 14.6, 17.4, Z) * CFrame.Angles(0, math.rad(90), 0),
                Color = Color3.fromRGB(52, 64, 44),
                Material = Enum.Material.Wood,
        })
        surfaceText(sign, "TOKO BENIH", "Bibit berkualitas untuk kebunmu", Color3.fromRGB(190, 236, 150))

        part({ Name = "TokoKonter", Size = Vector3.new(12, 3.4, 2.4), CFrame = CFrame.new(X + 8, 2.2, Z + 3), Color = Color3.fromRGB(150, 108, 66), Material = Enum.Material.WoodPlanks })
        part({ Name = "TokoKonterAtas", Size = Vector3.new(13, 0.4, 3), CFrame = CFrame.new(X + 8, 4.1, Z + 3), Color = Color3.fromRGB(70, 72, 80), Material = Enum.Material.Slate })
        part({ Name = "TokoKasir", Size = Vector3.new(1.8, 1.2, 1.4), CFrame = CFrame.new(X + 11.4, 4.9, Z + 3), Color = Color3.fromRGB(60, 64, 76), Material = Enum.Material.Metal })
        part({ Name = "TokoKasirLayar", Size = Vector3.new(1.4, 1, 0.2), CFrame = CFrame.new(X + 11.4, 5.9, Z + 3.4) * CFrame.Angles(math.rad(-18), 0, 0), Color = Color3.fromRGB(140, 220, 170), Material = Enum.Material.Neon, CanCollide = false })
        part({ Name = "TokoTimbangan", Size = Vector3.new(1, 0.9, 1), CFrame = CFrame.new(X + 4.8, 4.8, Z + 3), Color = Color3.fromRGB(220, 224, 228), Material = Enum.Material.Metal })

        local rng = Random.new(4242)
        local palettes = {
                { Color3.fromRGB(178, 182, 190), Color3.fromRGB(150, 156, 168), Color3.fromRGB(200, 204, 212) },
                { Color3.fromRGB(104, 172, 242), Color3.fromRGB(140, 196, 250), Color3.fromRGB(90, 150, 220) },
                { Color3.fromRGB(188, 124, 246), Color3.fromRGB(210, 160, 250), Color3.fromRGB(160, 100, 220) },
        }
        local shelfX = { X - 10.5, X - 4.5, X + 1.5 }
        local rarityNames = { "COMMON", "RARE", "EPIC" }
        for i = 1, 3 do
                local sx = shelfX[i]
                part({ Name = "RakBenihDudukan" .. i, Size = Vector3.new(9, 0.5, 2.2), CFrame = CFrame.new(sx, 3.6, Z - 8.6), Color = woodC, Material = Enum.Material.Wood })
                part({ Name = "RakBenihDinding" .. i, Size = Vector3.new(9, 0.5, 2.2), CFrame = CFrame.new(sx, 7.4, Z - 8.6), Color = woodC, Material = Enum.Material.Wood })
                part({ Name = "RakBenihPunggung" .. i, Size = Vector3.new(9, 9, 0.4), CFrame = CFrame.new(sx, 5.6, Z - 9.7), Color = woodC:Lerp(Color3.new(0, 0, 0), 0.2), Material = Enum.Material.Wood })
                seedPacketRow(Vector3.new(sx, 3.85, Z - 8.6), 0, 6, palettes[i], rng)
                seedPacketRow(Vector3.new(sx, 7.65, Z - 8.6), 0, 6, palettes[i], rng)
                local tag = part({
                        Name = "RakLabel" .. i,
                        Size = Vector3.new(2.6, 1, 0.3),
                        CFrame = CFrame.new(sx, 9.4, Z - 9.3),
                        Color = Color3.fromRGB(34, 38, 46),
                        Material = Enum.Material.SmoothPlastic,
                        CanCollide = false,
                })
                surfaceText(tag, rarityNames[i], nil, Color3.fromRGB(255, 226, 150))
        end

        part({ Name = "RakPotDudukan", Size = Vector3.new(8, 0.5, 2), CFrame = CFrame.new(X - 8, 3.2, Z + 8.4), Color = woodC, Material = Enum.Material.Wood })
        for i = 1, 4 do
                part({
                        Name = "PotTanah" .. i,
                        Shape = Enum.PartType.Cylinder,
                        Size = Vector3.new(1.1, 1.5, 1.5),
                        CFrame = CFrame.new(X - 10.5 + (i - 1) * 1.7, 4, Z + 8.4) * CFrame.Angles(0, 0, math.rad(90)),
                        Color = Color3.fromRGB(160, 116, 76),
                        Material = Enum.Material.SmoothPlastic,
                })
        end

        displayPlanter(Vector3.new(X - 11, 0, Z + 1), "wortel")
        displayPlanter(Vector3.new(X - 11, 0, Z - 3), "jeruk_mandarin")
        displayPlanter(Vector3.new(X - 6.5, 0, Z + 1), "tangelo")

        for i = 1, 3 do
                part({
                        Name = "TokoLampuGantungTali" .. i,
                        Size = Vector3.new(0.15, 2, 0.15),
                        CFrame = CFrame.new(X - 6 + (i - 1) * 7, 17.6, Z),
                        Color = Color3.fromRGB(70, 70, 76),
                        Material = Enum.Material.Metal,
                        CanCollide = false,
                })
                part({
                        Name = "TokoLampuGantung" .. i,
                        Shape = Enum.PartType.Ball,
                        Size = Vector3.new(1.5, 1.5, 1.5),
                        CFrame = CFrame.new(X - 6 + (i - 1) * 7, 16.4, Z),
                        Color = Color3.fromRGB(255, 226, 160),
                        Material = Enum.Material.Neon,
                        CanCollide = false,
                })
        end

        local priceBoard = part({
                Name = "TokoPapanHarga",
                Size = Vector3.new(11, 7, 0.4),
                CFrame = CFrame.new(X - 13.6, 12, Z - 5) * CFrame.Angles(0, math.rad(90), 0),
                Color = Color3.fromRGB(44, 40, 34),
                Material = Enum.Material.Wood,
        })
        local gui = Instance.new("SurfaceGui")
        gui.Face = Enum.NormalId.Front
        gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
        gui.PixelsPerStud = 42
        gui.Parent = priceBoard
        Util.create("TextLabel", {
                Size = UDim2.fromScale(1, 0.24),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBlack,
                TextScaled = true,
                TextColor3 = Color3.fromRGB(255, 226, 150),
                Text = "HARGA PACK (3 BENIH ACAK)",
        }, gui)
        local rows = {
                { "PACK COMMON - 400 MICDA", Color3.fromRGB(178, 182, 190) },
                { "PACK RARE - 1.500 MICDA", Color3.fromRGB(104, 172, 242) },
                { "PACK EPIC - 3.500 MICDA", Color3.fromRGB(188, 124, 246) },
        }
        for i, row in ipairs(rows) do
                Util.create("TextLabel", {
                        Position = UDim2.fromScale(0, 0.24 + (i - 1) * 0.25),
                        Size = UDim2.fromScale(1, 0.25),
                        BackgroundTransparency = 1,
                        Font = Enum.Font.GothamBold,
                        TextScaled = true,
                        TextColor3 = row[2],
                        Text = row[1],
                }, gui)
        end

        local counterPromptPart = part({
                Name = "TokoBantuBelanja",
                Shape = Enum.PartType.Ball,
                Size = Vector3.new(1.6, 1.6, 1.6),
                CFrame = CFrame.new(X + 9.6, 5.4, Z + 3),
                Color = Color3.fromRGB(150, 220, 130),
                Material = Enum.Material.SmoothPlastic,
        })
        local prompt = Instance.new("ProximityPrompt")
        prompt.ActionText = "Belanja Benih"
        prompt.ObjectText = "Toko Benih"
        prompt.MaxActivationDistance = 11
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
        prompt.Parent = counterPromptPart
        prompt.Triggered:Connect(function(player: Player)
                Remotes.get("OpenToko"):FireClient(player)
        end)
end

local function warningSign(pos: Vector3, text: string)
        local board = part({
                Name = "PapanPeringatan",
                Size = Vector3.new(9, 2.6, 0.5),
                CFrame = CFrame.new(pos + Vector3.new(0, 3.6, 0)) * CFrame.Angles(0, math.rad(90), 0),
                Color = Color3.fromRGB(96, 66, 38),
                Material = Enum.Material.WoodPlanks,
        })
        part({
                Name = "PapanPeringatanTiang",
                Size = Vector3.new(0.6, 2.6, 0.6),
                CFrame = CFrame.new(pos + Vector3.new(0, 1.3, 0)),
                Color = Color3.fromRGB(96, 66, 38),
                Material = Enum.Material.WoodPlanks,
        })
        surfaceText(board, text, nil, Color3.fromRGB(255, 160, 140))
end

local function buildStation(pos: Vector3, yawDeg: number, station: string, svc, label: string)
        local base = CFrame.new(pos) * CFrame.Angles(0, math.rad(yawDeg), 0)
        if station == "tempa" then
                part({ Name = "TempaLandasan", Size = Vector3.new(10, 0.5, 8), CFrame = base * CFrame.new(0, 0.25, 0), Color = Color3.fromRGB(88, 90, 98), Material = Enum.Material.Slate })
                part({ Name = "TempaAnvil", Size = Vector3.new(3, 1.6, 1.6), CFrame = base * CFrame.new(0, 1.8, 0), Color = Color3.fromRGB(52, 54, 62), Material = Enum.Material.Metal })
                part({ Name = "TempaAnvilTunggal", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.6, 1, 1), CFrame = base * CFrame.new(1.8, 1.8, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(52, 54, 62), Material = Enum.Material.Metal })
                part({ Name = "TempaTungku", Size = Vector3.new(2.6, 3, 2.6), CFrame = base * CFrame.new(-3.4, 2, -1.4), Color = Color3.fromRGB(64, 56, 52), Material = Enum.Material.Rock })
                part({ Name = "TempaApi", Shape = Enum.PartType.Ball, Size = Vector3.new(1.8, 2.2, 1.8), CFrame = base * CFrame.new(-3.4, 4, -1.4), Color = Color3.fromRGB(255, 150, 70), Material = Enum.Material.Neon, CanCollide = false })
        else
                part({ Name = "DapurLandasan", Size = Vector3.new(10, 0.5, 8), CFrame = base * CFrame.new(0, 0.25, 0), Color = Color3.fromRGB(126, 100, 70), Material = Enum.Material.Ground })
                for i = -1, 1 do
                        part({ Name = "DapurKayuApi" .. i, Size = Vector3.new(3.4, 0.7, 0.9), CFrame = base * CFrame.new(0, 0.8 + i * 0.55, 0) * CFrame.Angles(0, math.rad(i * 55), 0), Color = Color3.fromRGB(104, 78, 52), Material = Enum.Material.Wood })
                end
                part({ Name = "DapurApi", Shape = Enum.PartType.Ball, Size = Vector3.new(2.2, 2.6, 2.2), CFrame = base * CFrame.new(0, 1.8, 0), Color = Color3.fromRGB(255, 150, 70), Material = Enum.Material.Neon, CanCollide = false })
                part({ Name = "DapurPanci", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.6, 3, 3), CFrame = base * CFrame.new(0, 3.4, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(70, 74, 84), Material = Enum.Material.Metal })
        end
        local sign = part({
                Name = "StasiunPapan",
                Size = Vector3.new(8, 2.4, 0.5),
                CFrame = base * CFrame.new(0, 6.4, -4.2),
                Color = Color3.fromRGB(52, 44, 36),
                Material = Enum.Material.Wood,
        })
        surfaceText(sign, label, nil, Color3.fromRGB(255, 200, 140))
        local prompt = Instance.new("ProximityPrompt")
        prompt.MaxActivationDistance = 11
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
        prompt.Parent = sign
        svc.Craft.bindStation(prompt, station)
end

local function buildMonsterIslands(svc)
        local P = Vector3.new(640, 0, -320)
        buildStation(P + Vector3.new(30, 0, 66), 180, "dapur", svc, "DAPUR ALAM - BU MASAK")
        warningSign(P + Vector3.new(-96, 0, 0), "PADANG LIAR - MONSTER LV 1-3")
        local rng = Random.new(911)
        for i = 1, 6 do
                part({
                        Name = "PadangBatu",
                        Shape = Enum.PartType.Ball,
                        Size = Vector3.new(1, 1, 1) * rng:NextNumber(2.4, 4.6),
                        CFrame = CFrame.new(P + Vector3.new(rng:NextNumber(-100, 100), 0.6, rng:NextNumber(-100, 100))),
                        Color = Color3.fromRGB(128, 126, 122),
                        Material = Enum.Material.Slate,
                })
        end
        for i = 1, 4 do
                part({
                        Name = "PadangPohonBatang",
                        Size = Vector3.new(1.2, rng:NextNumber(7, 10), 1.2),
                        CFrame = CFrame.new(P + Vector3.new(rng:NextNumber(-110, 110), 4.4, rng:NextNumber(-110, 110))),
                        Color = Color3.fromRGB(112, 88, 60),
                        Material = Enum.Material.Wood,
                })
        end

        local H = Vector3.new(640, 0, 60)
        warningSign(H + Vector3.new(-96, 0, 0), "HUTAN BAYANG - MONSTER LV 3-5")
        for i = 1, 10 do
                local ang = (i / 10) * math.pi * 2
                local d = 62 + (i % 3) * 24
                part({
                        Name = "BayangBatang",
                        Size = Vector3.new(1.6, 11, 1.6),
                        CFrame = CFrame.new(H + Vector3.new(math.cos(ang) * d, 5.5, math.sin(ang) * d)),
                        Color = Color3.fromRGB(70, 60, 66),
                        Material = Enum.Material.Wood,
                })
                part({
                        Name = "BayangDedaun",
                        Shape = Enum.PartType.Ball,
                        Size = Vector3.new(9, 7, 9),
                        CFrame = CFrame.new(H + Vector3.new(math.cos(ang) * d, 12.5, math.sin(ang) * d)),
                        Color = Color3.fromRGB(52, 84, 62),
                        Material = Enum.Material.Grass,
                })
        end

        local B = Vector3.new(760, 0, 560)
        buildStation(Vector3.new(605, 0, 466), 0, "tempa", svc, "PANDAI BESI - PAK TEMPA")
        warningSign(B + Vector3.new(-196, 0, 0), "NEGERI BAJA & KRISTAL - MONSTER LV 5+")
        part({
                Name = "BajaLantai",
                Shape = Enum.PartType.Cylinder,
                Size = Vector3.new(0.25, 60, 60),
                CFrame = CFrame.new(605, 0.14, 430) * CFrame.Angles(0, 0, math.rad(90)),
                Color = Color3.fromRGB(96, 98, 106),
                Material = Enum.Material.Slate,
        })
        for i = 1, 4 do
                part({
                        Name = "BajaBatuBesar",
                        Shape = Enum.PartType.Ball,
                        Size = Vector3.new(1, 1, 1) * (5 + i),
                        CFrame = CFrame.new(605 + (i % 2 == 0 and 18 or -20), 2 + i * 0.4, 430 + (i < 3 and 20 or -18)),
                        Color = Color3.fromRGB(118, 120, 128),
                        Material = Enum.Material.Rock,
                })
        end
        local gx, gz = 920, 430
        part({
                Name = "GuaLantai",
                Shape = Enum.PartType.Cylinder,
                Size = Vector3.new(0.25, 64, 64),
                CFrame = CFrame.new(gx, 0.14, gz) * CFrame.Angles(0, 0, math.rad(90)),
                Color = Color3.fromRGB(58, 62, 78),
                Material = Enum.Material.Slate,
        })
        for i = 1, 10 do
                local ang = (i / 10) * math.pi * 2
                local diff = math.abs(math.atan2(math.sin(ang - math.pi), math.cos(ang - math.pi)))
                if diff > math.pi / 10 then
                        part({
                                Name = "GuaDinding",
                                Size = Vector3.new(22, 11, 3),
                                CFrame = CFrame.new(gx + math.cos(ang) * 32, 5.5, gz + math.sin(ang) * 32)
                                        * CFrame.Angles(0, -math.deg(ang) + 90, 0),
                                Color = Color3.fromRGB(66, 68, 84),
                                Material = Enum.Material.Rock,
                        })
                end
        end
        local rngK = Random.new(55)
        for i = 1, 8 do
                local ang = (i / 8) * math.pi * 2 + rngK:NextNumber(-0.2, 0.2)
                local d = rngK:NextNumber(8, 18)
                local h = rngK:NextNumber(4, 9)
                part({
                        Name = "GuaKristal",
                        Size = Vector3.new(2.4, h, 2.4),
                        CFrame = CFrame.new(gx + math.cos(ang) * d, h / 2, gz + math.sin(ang) * d)
                                * CFrame.Angles(rngK:NextNumber(-0.3, 0.3), 0, rngK:NextNumber(-0.3, 0.3)),
                        Color = Color3.fromRGB(190, 120, 255),
                        Material = Enum.Material.Neon,
                        Transparency = 0.25,
                        CanCollide = false,
                })
        end
        local ax, az = 760, 650
        part({
                Name = "ArenaLantai",
                Shape = Enum.PartType.Cylinder,
                Size = Vector3.new(0.3, 76, 76),
                CFrame = CFrame.new(ax, 0.16, az) * CFrame.Angles(0, 0, math.rad(90)),
                Color = Color3.fromRGB(196, 176, 150),
                Material = Enum.Material.Sand,
        })
        for i = 1, 12 do
                local ang = ((i - 0.5) / 12) * math.pi * 2
                local diffU = math.abs(math.atan2(math.sin(ang + math.pi / 2), math.cos(ang + math.pi / 2)))
                local diffS = math.abs(math.atan2(math.sin(ang - math.pi / 2), math.cos(ang - math.pi / 2)))
                if diffU > math.pi / 12 and diffS > math.pi / 12 then
                        part({
                                Name = "ArenaDinding",
                                Size = Vector3.new(20, 9, 2.6),
                                CFrame = CFrame.new(ax + math.cos(ang) * 38, 4.5, az + math.sin(ang) * 38)
                                        * CFrame.Angles(0, -math.deg(ang) + 90, 0),
                                Color = Color3.fromRGB(150, 132, 110),
                                Material = Enum.Material.Slate,
                        })
                end
        end
        for i = 1, 6 do
                local ang = (i / 6) * math.pi * 2
                part({
                        Name = "ArenaObor",
                        Shape = Enum.PartType.Ball,
                        Size = Vector3.new(1.6, 1.6, 1.6),
                        CFrame = CFrame.new(ax + math.cos(ang) * 32, 8.6, az + math.sin(ang) * 32),
                        Color = Color3.fromRGB(255, 140, 70),
                        Material = Enum.Material.Neon,
                        CanCollide = false,
                })
        end
end

local function buildPusatKota(svc)
        part({
                Name = "PlazaPusat",
                Shape = Enum.PartType.Cylinder,
                Size = Vector3.new(0.3, 34, 34),
                CFrame = CFrame.new(0, 0.16, 0) * CFrame.Angles(0, 0, math.rad(90)),
                Color = Color3.fromRGB(196, 188, 176),
                Material = Enum.Material.Granite,
        })
        part({
                Name = "AirMancurDasar",
                Shape = Enum.PartType.Cylinder,
                Size = Vector3.new(0.5, 10, 10),
                CFrame = CFrame.new(0, 0.4, 0) * CFrame.Angles(0, 0, math.rad(90)),
                Color = Color3.fromRGB(170, 176, 186),
                Material = Enum.Material.Concrete,
        })
        part({
                Name = "AirMancurAir",
                Shape = Enum.PartType.Cylinder,
                Size = Vector3.new(0.3, 9, 9),
                CFrame = CFrame.new(0, 0.55, 0) * CFrame.Angles(0, 0, math.rad(90)),
                Color = Color3.fromRGB(120, 190, 235),
                Material = Enum.Material.Glass,
                Transparency = 0.25,
        })
        part({
                Name = "AirMancurTiang",
                Size = Vector3.new(1, 5, 1),
                CFrame = CFrame.new(0, 3, 0),
                Color = Color3.fromRGB(170, 176, 186),
                Material = Enum.Material.Concrete,
        })
        part({
                Name = "AirMancurBola",
                Shape = Enum.PartType.Ball,
                Size = Vector3.new(2.4, 2.4, 2.4),
                CFrame = CFrame.new(0, 6, 0),
                Color = Color3.fromRGB(255, 226, 160),
                Material = Enum.Material.Neon,
                CanCollide = false,
        })

        for _, pos in {
                Vector3.new(-14, 0, 14), Vector3.new(14, 0, 14), Vector3.new(-14, 0, -14), Vector3.new(14, 0, -14),
                Vector3.new(120, 0, -60), Vector3.new(120, 0, 40), Vector3.new(120, 0, 130), Vector3.new(0, 0, 118),
        } do
                buildLamp(pos)
        end

        local sign = part({
                Name = "PapanPusatKota",
                Size = Vector3.new(13, 3, 0.7),
                CFrame = CFrame.new(0, 5.2, 126) * CFrame.Angles(0, math.rad(180), 0),
                Color = Color3.fromRGB(52, 64, 44),
                Material = Enum.Material.Wood,
        })
        surfaceText(sign, "PUSAT KOTA", "Toko Benih di sebelah barat - gerbang lahanmu di utara!", Color3.fromRGB(190, 236, 150))

        buildTokoBenih(svc)

        local spawnLoc = Instance.new("SpawnLocation")
        spawnLoc.Name = "SpawnPusat"
        spawnLoc.Size = Vector3.new(10, 0.4, 10)
        spawnLoc.CFrame = CFrame.new(0, 0.4, 22)
        spawnLoc.Anchored = true
        spawnLoc.Transparency = 0.35
        spawnLoc.Color = Color3.fromRGB(240, 220, 150)
        spawnLoc.Material = Enum.Material.Neon
        spawnLoc.Neutral = true
        spawnLoc.Duration = 0
        spawnLoc.Parent = folder
end

function MapService.init(svc)
        folder.Parent = workspace

        local atmo = Instance.new("Atmosphere")
        atmo.Density = 0.14
        atmo.Offset = 0.2
        atmo.Color = Color3.fromRGB(205, 215, 235)
        atmo.Glare = 0.15
        atmo.Haze = 0.8
        atmo.Parent = game:GetService("Lighting")

        local rngAwan = Random.new(77)
        for i = 1, 6 do
                part({
                        Name = "Awan",
                        Shape = Enum.PartType.Ball,
                        Size = Vector3.new(1, 1, 1) * rngAwan:NextNumber(28, 56),
                        CFrame = CFrame.new(rngAwan:NextNumber(-400, 400), rngAwan:NextNumber(85, 125), rngAwan:NextNumber(-500, 500)),
                        Color = Color3.new(1, 1, 1),
                        Material = Enum.Material.SmoothPlastic,
                        Transparency = 0.35,
                        CanCollide = false,
                })
        end

        buildTerrain()
        buildPusatKota(svc)
        buildMonsterIslands(svc)

        local PersonalWorldBuilder = require(script.Parent.PersonalWorldBuilder)
        for i = 1, Balance.HOME_COUNT do
                PersonalWorldBuilder.buildShell(i)
        end

        print("[AKIOMIDA] Dunia v7 siap: Pusat Kota (Toko Benih), 3 pulau monster, "
                .. Balance.HOME_COUNT .. " lahan pribadi (rumah 3 lantai + rooftop, kebun 500 petak, "
                .. "kolam air sungguhan, ruang Bedah/Sains/Startopia/Pancing, koperasi).")
end

return MapService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">PersonalWorldBuilder</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Remotes)
local Util = require(ReplicatedStorage.Shared.Util)
local Balance = require(ReplicatedStorage.Shared.Balance)
local DoorKit = require(script.Parent.DoorKit)

local PersonalWorldBuilder = {}

local STORY = DoorKit.CHAR_HEIGHT * 4
local DOOR_H = DoorKit.CHAR_HEIGHT * 2
local DOOR_W = DoorKit.DOOR_WIDTH

local worldFolder: Folder? = nil
local nameBoards: { [number]: TextLabel } = {}
local built: { [number]: boolean } = {}

local function world(): Folder
        local f = worldFolder
        if not f then
                f = workspace:FindFirstChild("AKM_Dunia") :: Folder?
                if not f then
                        f = Instance.new("Folder")
                        f.Name = "AKM_Dunia"
                        f.Parent = workspace
                end
                worldFolder = f
        end
        return f :: Folder
end

local function lahanFolder(index: number): Folder
        local name = "Lahan" .. index
        local f = world():FindFirstChild(name) :: Folder?
        if not f then
                f = Instance.new("Folder")
                f.Name = name
                f.Parent = world()
        end
        return f
end

local function part(props, parent): Part
        local p = Instance.new("Part")
        p.Anchored = true
        p.TopSurface = Enum.SurfaceType.Smooth
        p.BottomSurface = Enum.SurfaceType.Smooth
        for k, v in props do
                (p :: any)[k] = v
        end
        p.Parent = parent or world()
        return p
end

local function lamp(position: Vector3, parent)
        part({
                Name = "LampuTiang",
                Size = Vector3.new(0.6, 7.4, 0.6),
                CFrame = CFrame.new(position + Vector3.new(0, 3.7, 0)),
                Color = Color3.fromRGB(58, 62, 74),
                Material = Enum.Material.Metal,
        }, parent)
        part({
                Name = "LampuKepala",
                Shape = Enum.PartType.Ball,
                Size = Vector3.new(1.5, 1.5, 1.5),
                CFrame = CFrame.new(position + Vector3.new(0, 7.7, 0)),
                Color = Color3.fromRGB(255, 226, 160),
                Material = Enum.Material.Neon,
                CanCollide = false,
        }, parent)
end

local function surfaceText(board: Part, text: string, sub: string?, color: Color3)
        local gui = Instance.new("SurfaceGui")
        gui.Face = Enum.NormalId.Front
        gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
        gui.PixelsPerStud = 50
        gui.Parent = board
        local title = Util.create("TextLabel", {
                Size = sub and UDim2.fromScale(1, 0.6) or UDim2.fromScale(1, 1),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBlack,
                TextScaled = true,
                TextColor3 = color,
                Text = text,
        }, gui)
        if sub then
                Util.create("TextLabel", {
                        Position = UDim2.fromScale(0, 0.6),
                        Size = UDim2.fromScale(1, 0.4),
                        BackgroundTransparency = 1,
                        Font = Enum.Font.Gotham,
                        TextScaled = true,
                        TextColor3 = Color3.fromRGB(210, 214, 224),
                        Text = sub,
                }, gui)
        end
        return title
end

local function signBoard(name: string, pos: Vector3, yawDeg: number, title: string, sub: string?, color: Color3, parent): Part
        local board = part({
                Name = name,
                Size = Vector3.new(9, 3.2, 0.6),
                CFrame = CFrame.new(pos + Vector3.new(0, 4.4, 0)) * CFrame.Angles(0, math.rad(yawDeg), 0),
                Color = Color3.fromRGB(84, 62, 40),
                Material = Enum.Material.WoodPlanks,
        }, parent)
        part({
                Name = name .. "Tiang",
                Size = Vector3.new(0.6, 3, 0.6),
                CFrame = CFrame.new(pos + Vector3.new(0, 1.5, 0)),
                Color = Color3.fromRGB(84, 62, 40),
                Material = Enum.Material.WoodPlanks,
        }, parent)
        surfaceText(board, title, sub, color)
        return board
end

local function nameBoard(index: number, pos: Vector3, yawDeg: number, parent)
        local board = part({
                Name = "PapanNama" .. index,
                Size = Vector3.new(11, 3.6, 0.7),
                CFrame = CFrame.new(pos + Vector3.new(0, 5.2, 0)) * CFrame.Angles(0, math.rad(yawDeg), 0),
                Color = Color3.fromRGB(58, 44, 30),
                Material = Enum.Material.Wood,
        }, parent)
        part({
                Name = "PapanNamaTiang1",
                Size = Vector3.new(0.7, 4, 0.7),
                CFrame = CFrame.new(pos + Vector3.new(-4, 2, 0)),
                Color = Color3.fromRGB(84, 62, 40),
                Material = Enum.Material.Wood,
        }, parent)
        part({
                Name = "PapanNamaTiang2",
                Size = Vector3.new(0.7, 4, 0.7),
                CFrame = CFrame.new(pos + Vector3.new(4, 2, 0)),
                Color = Color3.fromRGB(84, 62, 40),
                Material = Enum.Material.Wood,
        }, parent)
        local label = surfaceText(board, "PAPAN NAMA BELUM DIISI", "Dekati & isi namamu!", Color3.fromRGB(255, 226, 150))
        nameBoards[index] = label

        local prompt = Instance.new("ProximityPrompt")
        prompt.ActionText = "Isi Papan Nama"
        prompt.ObjectText = "Papan Nama Lahan"
        prompt.MaxActivationDistance = 9
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
        prompt.Parent = board
        prompt.Triggered:Connect(function(player: Player)
                Remotes.get("OpenLandBoard"):FireClient(player)
        end)
end

function PersonalWorldBuilder.setNameBoard(index: number, name: string)
        local label = nameBoards[index]
        if label then
                label.Text = name
        end
end

local function decorativeTree(pos: Vector3, seed: number, parent)
        local rng = Random.new(seed or 1)
        part({
                Name = "PohonBatang",
                Size = Vector3.new(1.4, 7 + rng:NextNumber(0, 2.4), 1.4),
                CFrame = CFrame.new(pos + Vector3.new(0, 3.8, 0)),
                Color = Color3.fromRGB(112, 88, 60),
                Material = Enum.Material.Wood,
        }, parent)
        part({
                Name = "PohonDedaun",
                Shape = Enum.PartType.Ball,
                Size = Vector3.new(8, 6.4, 8),
                CFrame = CFrame.new(pos + Vector3.new(0, 9.4, 0)),
                Color = Color3.fromRGB(72, 138, 70),
                Material = Enum.Material.Grass,
        }, parent)
        part({
                Name = "PohonDedaunAtas",
                Shape = Enum.PartType.Ball,
                Size = Vector3.new(5.4, 4.4, 5.4),
                CFrame = CFrame.new(pos + Vector3.new(0, 12.4, 0)),
                Color = Color3.fromRGB(88, 158, 82),
                Material = Enum.Material.Grass,
                CanCollide = false,
        }, parent)
end

local function stairs(x: number, z: number, y0: number, parent, color: Color3)
        for i = 1, 10 do
                part({
                        Name = "Tangga" .. i,
                        Size = Vector3.new(4, 2, 2.2),
                        CFrame = CFrame.new(x, y0 + i * 1 - 1, z + (i - 1) * 2.2),
                        Color = color,
                        Material = Enum.Material.WoodPlanks,
                }, parent)
        end
end

local function buildHouse(center: Vector3, parent)
        local hx, hz = center.X, center.Z
        local wall = Color3.fromRGB(234, 222, 200)
        local wood = Color3.fromRGB(150, 108, 66)
        local roof = Color3.fromRGB(148, 66, 54)
        local halfW, halfD = 13.5, 10.5

        for story = 0, 2 do
                local y = story * STORY
                local wallMat = Enum.Material.WoodPlanks
                part({ Name = "RumahDindingB" .. story, Size = Vector3.new(1, STORY, 21), CFrame = CFrame.new(hx - halfW, y + STORY / 2, hz), Color = wall, Material = wallMat }, parent)
                part({ Name = "RumahDindingU" .. story, Size = Vector3.new(27, STORY, 1), CFrame = CFrame.new(hx, y + STORY / 2, hz - halfD), Color = wall, Material = wallMat }, parent)
                part({ Name = "RumahDindingS" .. story, Size = Vector3.new(27, STORY, 1), CFrame = CFrame.new(hx, y + STORY / 2, hz + halfD), Color = wall, Material = wallMat }, parent)
                if story == 0 then
                        part({ Name = "RumahDindingDU", Size = Vector3.new(1, STORY, 7.6), CFrame = CFrame.new(hx + halfW, STORY / 2, hz - 6.7), Color = wall, Material = wallMat }, parent)
                        part({ Name = "RumahDindingDS", Size = Vector3.new(1, STORY, 7.6), CFrame = CFrame.new(hx + halfW, STORY / 2, hz + 6.7), Color = wall, Material = wallMat }, parent)
                        part({ Name = "RumahPalangPintu", Size = Vector3.new(1, STORY - DOOR_H, 4.6), CFrame = CFrame.new(hx + halfW, DOOR_H + (STORY - DOOR_H) / 2, hz), Color = wall, Material = wallMat }, parent)
                        DoorKit.frame(Vector3.new(hx + halfW, 0, hz), 90, parent, DOOR_W, DOOR_H)
                        DoorKit.hinged(Vector3.new(hx + halfW, 0, hz), 90, parent, DOOR_W, DOOR_H, Color3.fromRGB(130, 92, 58))
                else
                        part({ Name = "RumahDindingD" .. story, Size = Vector3.new(1, STORY, 21), CFrame = CFrame.new(hx + halfW, y + STORY / 2, hz), Color = wall, Material = wallMat }, parent)
                end
                for _, side in { -1, 1 } do
                        part({
                                Name = "RumahJendela" .. story .. side,
                                Size = Vector3.new(5.4, 5, 0.5),
                                CFrame = CFrame.new(hx - 4, y + STORY * 0.55, hz + side * (halfD - 0.3)),
                                Color = Color3.fromRGB(172, 216, 236),
                                Material = Enum.Material.Glass,
                                Transparency = 0.45,
                        }, parent)
                end
                part({
                        Name = "RumahJendelaD" .. story,
                        Size = Vector3.new(0.5, 5, 7),
                        CFrame = CFrame.new(hx + halfW - 0.3, y + STORY * 0.55, hz - 5.6),
                        Color = Color3.fromRGB(172, 216, 236),
                        Material = Enum.Material.Glass,
                        Transparency = 0.45,
                }, parent)
        end

        part({ Name = "RumahLantai0", Size = Vector3.new(27, 0.5, 21), CFrame = CFrame.new(hx, 0.25, hz), Color = Color3.fromRGB(172, 130, 84), Material = Enum.Material.WoodPlanks }, parent)
        part({ Name = "RumahLantai1", Size = Vector3.new(27, 0.5, 12.5), CFrame = CFrame.new(hx, STORY + 0.25, hz + 4), Color = Color3.fromRGB(172, 130, 84), Material = Enum.Material.WoodPlanks }, parent)
        part({ Name = "RumahLantai1T", Size = Vector3.new(8.6, 0.5, 8.6), CFrame = CFrame.new(hx + 9.2, STORY + 0.25, hz - 6.2), Color = Color3.fromRGB(172, 130, 84), Material = Enum.Material.WoodPlanks }, parent)
        part({ Name = "RumahLantai2", Size = Vector3.new(27, 0.5, 12.5), CFrame = CFrame.new(hx, STORY * 2 + 0.25, hz + 4), Color = Color3.fromRGB(172, 130, 84), Material = Enum.Material.WoodPlanks }, parent)
        part({ Name = "RumahLantai2T", Size = Vector3.new(8.6, 0.5, 8.6), CFrame = CFrame.new(hx + 9.2, STORY * 2 + 0.25, hz - 6.2), Color = Color3.fromRGB(172, 130, 84), Material = Enum.Material.WoodPlanks }, parent)

        stairs(hx - 11, hz - 8.8, 0, parent, wood)
        stairs(hx - 11, hz - 8.8, STORY, parent, wood)
        stairs(hx - 11, hz - 8.8, STORY * 2, parent, wood)

        for story = 1, 2 do
                local y = story * STORY
                part({ Name = "RumahRelKiri" .. story, Size = Vector3.new(0.4, 3.4, 0.4), CFrame = CFrame.new(hx + 8.4, y + 1.7, hz - 8.8), Color = wood, Material = Enum.Material.Wood }, parent)
                part({ Name = "RumahRelKanan" .. story, Size = Vector3.new(0.4, 3.4, 0.4), CFrame = CFrame.new(hx + 8.4, y + 1.7, hz - 4.4), Color = wood, Material = Enum.Material.Wood }, parent)
                part({ Name = "RumahRelAtas" .. story, Size = Vector3.new(0.3, 0.3, 4.8), CFrame = CFrame.new(hx + 8.4, y + 3.4, hz - 6.6), Color = wood, Material = Enum.Material.Wood }, parent)
        end

        part({ Name = "RumahAtapDasar", Size = Vector3.new(29, 1.2, 23), CFrame = CFrame.new(hx, STORY * 3 + 0.6, hz), Color = roof, Material = Enum.Material.Slate }, parent)
        local parapetC = Color3.fromRGB(196, 188, 176)
        part({ Name = "RooftopParapetU", Size = Vector3.new(27, 3, 1), CFrame = CFrame.new(hx, STORY * 3 + 2.1, hz - 10), Color = parapetC, Material = Enum.Material.Concrete }, parent)
        part({ Name = "RooftopParapetS", Size = Vector3.new(27, 3, 1), CFrame = CFrame.new(hx, STORY * 3 + 2.1, hz + 10), Color = parapetC, Material = Enum.Material.Concrete }, parent)
        part({ Name = "RooftopParapetB", Size = Vector3.new(1, 3, 21), CFrame = CFrame.new(hx - 13, STORY * 3 + 2.1, hz), Color = parapetC, Material = Enum.Material.Concrete }, parent)
        part({ Name = "RooftopParapetT", Size = Vector3.new(1, 3, 21), CFrame = CFrame.new(hx + 13, STORY * 3 + 2.1, hz), Color = parapetC, Material = Enum.Material.Concrete }, parent)
        local roofY = STORY * 3
        for _, px in { -10, 10 } do
                for _, pz in { -6, 6 } do
                        part({ Name = "PergolaTiang", Size = Vector3.new(0.9, 8, 0.9), CFrame = CFrame.new(hx + px, roofY + 4, hz + pz), Color = wood, Material = Enum.Material.Wood }, parent)
                end
        end
        part({ Name = "PergolaBalok1", Size = Vector3.new(21, 0.7, 1), CFrame = CFrame.new(hx, roofY + 8.2, hz - 6), Color = wood, Material = Enum.Material.Wood }, parent)
        part({ Name = "PergolaBalok2", Size = Vector3.new(21, 0.7, 1), CFrame = CFrame.new(hx, roofY + 8.2, hz + 6), Color = wood, Material = Enum.Material.Wood }, parent)
        part({ Name = "PergolaAtap", Size = Vector3.new(23, 0.6, 15), CFrame = CFrame.new(hx, roofY + 8.8, hz), Color = roof:Lerp(Color3.new(1, 1, 1), 0.1), Material = Enum.Material.Slate }, parent)
        for i = 1, 2 do
                part({ Name = "RooftopPlanter" .. i, Size = Vector3.new(5, 1.2, 2), CFrame = CFrame.new(hx - 7 + (i - 1) * 14, roofY + 1.2, hz + 7.6), Color = Color3.fromRGB(150, 108, 66), Material = Enum.Material.Wood }, parent)
                for f = 1, 3 do
                        part({
                                Name = "RooftopBunga" .. i .. f,
                                Shape = Enum.PartType.Ball,
                                Size = Vector3.new(1, 1, 1) * 0.9,
                                CFrame = CFrame.new(hx - 8.6 + (i - 1) * 14 + f * 1.6, roofY + 2.2, hz + 7.6),
                                Color = Color3.fromHSV((f + i) / 5, 0.6, 0.95),
                                Material = Enum.Material.Grass,
                                CanCollide = false,
                        }, parent)
                end
        end
        part({ Name = "RooftopBangku", Size = Vector3.new(6, 0.7, 2), CFrame = CFrame.new(hx + 8, roofY + 0.95, hz - 6), Color = wood, Material = Enum.Material.WoodPlanks }, parent)
        part({ Name = "RooftopPayungTiang", Size = Vector3.new(0.4, 7, 0.4), CFrame = CFrame.new(hx + 8, roofY + 4.1, hz + 2), Color = wood, Material = Enum.Material.Wood }, parent)
        part({ Name = "RooftopPayungAtap", Shape = Enum.PartType.Ball, Size = Vector3.new(6.4, 2.4, 6.4), CFrame = CFrame.new(hx + 8, roofY + 7.6, hz + 2), Color = Color3.fromRGB(240, 170, 90), Material = Enum.Material.Fabric, CanCollide = false }, parent)

        part({ Name = "RumahTeras", Size = Vector3.new(8, 0.4, 11), CFrame = CFrame.new(hx + 17.5, 0.2, hz), Color = parapetC, Material = Enum.Material.Concrete }, parent)
        for _, side in { -1, 1 } do
                part({ Name = "RumahPilarTeras" .. side, Size = Vector3.new(1, 6.4, 1), CFrame = CFrame.new(hx + 21, 3.2, hz + side * 4.6), Color = wood, Material = Enum.Material.Wood }, parent)
        end
        part({ Name = "RumahPalangTeras", Size = Vector3.new(1, 1, 10.4), CFrame = CFrame.new(hx + 21, 6.6, hz), Color = wood, Material = Enum.Material.Wood }, parent)

        part({ Name = "RumahKarpet", Size = Vector3.new(14, 0.12, 10), CFrame = CFrame.new(hx - 4, 0.56, hz + 2), Color = Color3.fromRGB(158, 76, 66), Material = Enum.Material.Fabric }, parent)
        part({ Name = "RumahSofaDuduk", Size = Vector3.new(9, 1.4, 3.4), CFrame = CFrame.new(hx - 7, 1.3, hz + 6.4), Color = Color3.fromRGB(120, 132, 158), Material = Enum.Material.Fabric }, parent)
        part({ Name = "RumahSofaPunggung", Size = Vector3.new(9, 2.6, 1), CFrame = CFrame.new(hx - 7, 2.4, hz + 8.2), Color = Color3.fromRGB(120, 132, 158), Material = Enum.Material.Fabric }, parent)
        for _, side in { -1, 1 } do
                part({ Name = "RumahSofaArm" .. side, Size = Vector3.new(1, 2, 3.4), CFrame = CFrame.new(hx - 7 + side * 5, 1.6, hz + 6.4), Color = Color3.fromRGB(120, 132, 158), Material = Enum.Material.Fabric }, parent)
        end
        part({ Name = "RumahMejaKecilKaki", Size = Vector3.new(3.4, 0.9, 2), CFrame = CFrame.new(hx - 7, 1.05, hz + 2.4), Color = wood, Material = Enum.Material.WoodPlanks }, parent)
        part({ Name = "RumahTVLayar", Size = Vector3.new(8.4, 5, 0.5), CFrame = CFrame.new(hx - 12.4, 5.4, hz + 2), Color = Color3.fromRGB(24, 26, 34), Material = Enum.Material.SmoothPlastic }, parent)
        part({ Name = "RumahTVKaca", Size = Vector3.new(7.4, 4, 0.3), CFrame = CFrame.new(hx - 12, 5.4, hz + 2) * CFrame.Angles(0, math.rad(-90), 0), Color = Color3.fromRGB(120, 180, 255), Material = Enum.Material.Neon, CanCollide = false }, parent)
        part({ Name = "RumahTVRak", Size = Vector3.new(2.4, 1, 6), CFrame = CFrame.new(hx - 11.6, 1.1, hz + 2), Color = wood, Material = Enum.Material.Wood }, parent)
        part({ Name = "RumahRakDinding", Size = Vector3.new(0.7, 0.5, 7), CFrame = CFrame.new(hx - 3, 6.6, hz - 8.6), Color = wood, Material = Enum.Material.Wood }, parent)
        for i = 1, 3 do
                part({
                        Name = "RumahHiasan" .. i,
                        Size = Vector3.new(0.9, 1.1, 0.9),
                        CFrame = CFrame.new(hx - 3, 7.4, hz - 10.6 + i * 2),
                        Color = Color3.fromRGB(255, 209, 102):Lerp(Color3.fromRGB(120, 200, 235), (i - 1) / 2),
                        Material = Enum.Material.SmoothPlastic,
                        CanCollide = false,
                }, parent)
        end
        local bulb1 = part({ Name = "RumahLampuGantung1", Shape = Enum.PartType.Ball, Size = Vector3.new(1.3, 1.3, 1.3), CFrame = CFrame.new(hx - 2, 7.6, hz + 2), Color = Color3.fromRGB(255, 226, 160), Material = Enum.Material.Neon, CanCollide = false }, parent)
        local light1 = Instance.new("PointLight")
        light1.Color = Color3.fromRGB(255, 226, 160)
        light1.Range = 22
        light1.Brightness = 0.9
        light1.Shadows = false
        light1.Parent = bulb1

        local y2 = STORY
        part({ Name = "RumahKarpet2", Size = Vector3.new(13, 0.12, 9), CFrame = CFrame.new(hx - 2, y2 + 0.56, hz + 3), Color = Color3.fromRGB(96, 130, 96), Material = Enum.Material.Fabric }, parent)
        part({ Name = "RumahCounterL1", Size = Vector3.new(9, 3, 2.2), CFrame = CFrame.new(hx - 8, y2 + 1.9, hz - 8.4), Color = Color3.fromRGB(210, 208, 200), Material = Enum.Material.SmoothPlastic }, parent)
        part({ Name = "RumahCounterL2", Size = Vector3.new(2.2, 3, 7), CFrame = CFrame.new(hx - 12.3, y2 + 1.9, hz - 4), Color = Color3.fromRGB(210, 208, 200), Material = Enum.Material.SmoothPlastic }, parent)
        part({ Name = "RumahCounterTop", Size = Vector3.new(9.6, 0.4, 2.8), CFrame = CFrame.new(hx - 8, y2 + 3.5, hz - 8.3), Color = Color3.fromRGB(60, 62, 70), Material = Enum.Material.Slate }, parent)
        part({ Name = "RumahSink", Size = Vector3.new(2.4, 0.5, 1.6), CFrame = CFrame.new(hx - 6, y2 + 3.5, hz - 8.3), Color = Color3.fromRGB(190, 196, 205), Material = Enum.Material.Metal }, parent)
        part({ Name = "RumahKran", Size = Vector3.new(0.35, 1.4, 0.35), CFrame = CFrame.new(hx - 6, y2 + 4.4, hz - 9), Color = Color3.fromRGB(180, 186, 195), Material = Enum.Material.Metal }, parent)
        for i = 1, 4 do
                part({
                        Name = "RumahTungku" .. i,
                        Shape = Enum.PartType.Cylinder,
                        Size = Vector3.new(0.3, 1.3, 1.3),
                        CFrame = CFrame.new(hx - 10.4 + i * 1.4, y2 + 3.8, hz - 8.3) * CFrame.Angles(0, 0, math.rad(90)),
                        Color = Color3.fromRGB(40, 40, 48),
                        Material = Enum.Material.SmoothPlastic,
                }, parent)
        end
        part({ Name = "RumahKulkas", Size = Vector3.new(3.2, 7.4, 2.8), CFrame = CFrame.new(hx + 11, y2 + 4.1, hz - 8.4), Color = Color3.fromRGB(226, 230, 234), Material = Enum.Material.SmoothPlastic }, parent)
        part({ Name = "RumahKulkasGagang", Size = Vector3.new(0.3, 3.4, 0.3), CFrame = CFrame.new(hx + 9.3, y2 + 4.4, hz - 7), Color = Color3.fromRGB(170, 176, 186), Material = Enum.Material.Metal }, parent)
        part({ Name = "RumahLemariAtas1", Size = Vector3.new(8, 3, 1.6), CFrame = CFrame.new(hx - 8, y2 + 6.6, hz - 9.4), Color = Color3.fromRGB(176, 140, 96), Material = Enum.Material.WoodPlanks }, parent)
        part({ Name = "RumahLemariAtas2", Size = Vector3.new(4.4, 3, 1.6), CFrame = CFrame.new(hx + 4.4, y2 + 6.6, hz - 9.4), Color = Color3.fromRGB(176, 140, 96), Material = Enum.Material.WoodPlanks }, parent)
        part({ Name = "RumahMejaMakan", Size = Vector3.new(6, 0.5, 3.4), CFrame = CFrame.new(hx + 2, y2 + 2, hz + 3), Color = wood, Material = Enum.Material.WoodPlanks }, parent)
        for _, leg in { { -2.6, -1.3 }, { 2.6, -1.3 }, { -2.6, 1.3 }, { 2.6, 1.3 } } do
                part({ Name = "RumahMejaKaki", Size = Vector3.new(0.5, 1.8, 0.5), CFrame = CFrame.new(hx + 2 + leg[1], y2 + 0.9, hz + 3 + leg[2]), Color = wood, Material = Enum.Material.Wood }, parent)
        end
        for _, seat in { { 0, -2.8, 0 }, { 0, 2.8, 180 }, { -3.8, 0, 90 }, { 3.8, 0, -90 } } do
                part({ Name = "RumahKursiMakan", Size = Vector3.new(1.7, 0.6, 1.7), CFrame = CFrame.new(hx + 2 + seat[1], y2 + 0.9, hz + 3 + seat[2]), Color = wood, Material = Enum.Material.WoodPlanks }, parent)
                part({ Name = "RumahKursiSandal", Size = Vector3.new(1.7, 2, 0.4), CFrame = CFrame.new(hx + 2 + seat[1] + math.sin(math.rad(seat[3])) * 0.7, y2 + 1.6, hz + 3 + seat[2] + math.cos(math.rad(seat[3])) * 0.7) * CFrame.Angles(0, math.rad(seat[3]), 0), Color = wood, Material = Enum.Material.WoodPlanks }, parent)
        end
        part({ Name = "RumahBuahMangkuk", Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 0.8, 1.4), CFrame = CFrame.new(hx + 2, y2 + 2.6, hz + 3), Color = Color3.fromRGB(255, 150, 90), Material = Enum.Material.SmoothPlastic, CanCollide = false }, parent)

        local y3 = STORY * 2
        part({ Name = "RumahKarpet3", Size = Vector3.new(12, 0.12, 9), CFrame = CFrame.new(hx + 2, y3 + 0.56, hz + 3), Color = Color3.fromRGB(146, 108, 158), Material = Enum.Material.Fabric }, parent)
        part({ Name = "RumahRanjang", Size = Vector3.new(4.4, 1.1, 7.4), CFrame = CFrame.new(hx + 9.5, y3 + 1.15, hz - 4.6), Color = wood, Material = Enum.Material.WoodPlanks }, parent)
        part({ Name = "RumahKasur", Size = Vector3.new(4.2, 0.7, 7), CFrame = CFrame.new(hx + 9.5, y3 + 2, hz - 4.6), Color = Color3.fromRGB(240, 238, 232), Material = Enum.Material.Fabric }, parent)
        part({ Name = "RumahBantal", Size = Vector3.new(3.4, 0.9, 1.8), CFrame = CFrame.new(hx + 9.5, y3 + 2.5, hz - 7.2), Color = Color3.fromRGB(255, 255, 250), Material = Enum.Material.Fabric }, parent)
        part({ Name = "RumahSelimut", Size = Vector3.new(4.3, 0.5, 4.4), CFrame = CFrame.new(hx + 9.5, y3 + 2.4, hz - 2.6), Color = Color3.fromRGB(96, 130, 170), Material = Enum.Material.Fabric }, parent)
        part({ Name = "RumahLemariBadan", Size = Vector3.new(1.4, 9, 6.4), CFrame = CFrame.new(hx - 12.3, y3 + 4.9, hz - 4), Color = Color3.fromRGB(134, 100, 66), Material = Enum.Material.Wood }, parent)
        for _, side in { -1, 1 } do
                part({ Name = "RumahLemariPintu" .. side, Size = Vector3.new(0.25, 8.2, 2.9), CFrame = CFrame.new(hx - 11.5, y3 + 4.9, hz - 4 + side * 1.55), Color = Color3.fromRGB(150, 116, 78), Material = Enum.Material.WoodPlanks }, parent)
                part({ Name = "RumahLemariGagang" .. side, Size = Vector3.new(0.3, 1.6, 0.3), CFrame = CFrame.new(hx - 11.3, y3 + 4.9, hz - 4 + side * 0.4), Color = Color3.fromRGB(240, 204, 108), Material = Enum.Material.Metal }, parent)
        end
        part({ Name = "RumahMejaKerja", Size = Vector3.new(5, 0.4, 2.4), CFrame = CFrame.new(hx - 8, y3 + 2.1, hz + 7.4), Color = wood, Material = Enum.Material.WoodPlanks }, parent)
        for _, leg in { { -2.2, -0.9 }, { 2.2, -0.9 }, { -2.2, 0.9 }, { 2.2, 0.9 } } do
                part({ Name = "RumahMejaKerjaKaki", Size = Vector3.new(0.4, 2, 0.4), CFrame = CFrame.new(hx - 8 + leg[1], y3 + 1, hz + 7.4 + leg[2]), Color = wood, Material = Enum.Material.Wood }, parent)
        end
        part({ Name = "RumahKursiKerja", Size = Vector3.new(1.8, 0.6, 1.8), CFrame = CFrame.new(hx - 8, y3 + 0.9, hz + 5.6), Color = wood, Material = Enum.Material.WoodPlanks }, parent)
        part({ Name = "RumahLampuTidur", Shape = Enum.PartType.Ball, Size = Vector3.new(1.1, 1.1, 1.1), CFrame = CFrame.new(hx + 12.4, y3 + 3.2, hz - 8.4), Color = Color3.fromRGB(255, 226, 160), Material = Enum.Material.Neon, CanCollide = false }, parent)
end

local function roomShell(center: Vector3, judul: string, floorC: Color3, wallC: Color3, roofC: Color3, parent)
        local x, z = center.X, center.Z
        part({ Name = judul .. "Lantai", Size = Vector3.new(20, 0.4, 16), CFrame = CFrame.new(x, 0.2, z), Color = floorC, Material = Enum.Material.Concrete }, parent)
        part({ Name = judul .. "DindingSel", Size = Vector3.new(20, STORY, 1), CFrame = CFrame.new(x, STORY / 2, z + 8), Color = wallC, Material = Enum.Material.SmoothPlastic }, parent)
        part({ Name = judul .. "DindingBar", Size = Vector3.new(1, STORY, 16), CFrame = CFrame.new(x - 10, STORY / 2, z), Color = wallC, Material = Enum.Material.SmoothPlastic }, parent)
        part({ Name = judul .. "DindingTim", Size = Vector3.new(1, STORY, 16), CFrame = CFrame.new(x + 10, STORY / 2, z), Color = wallC, Material = Enum.Material.SmoothPlastic }, parent)
        part({ Name = judul .. "DindingDepU", Size = Vector3.new(7.7, STORY, 1), CFrame = CFrame.new(x - 6.15, STORY / 2, z - 8), Color = wallC, Material = Enum.Material.SmoothPlastic }, parent)
        part({ Name = judul .. "DindingDepS", Size = Vector3.new(7.7, STORY, 1), CFrame = CFrame.new(x + 6.15, STORY / 2, z - 8), Color = wallC, Material = Enum.Material.SmoothPlastic }, parent)
        part({ Name = judul .. "PalangPintu", Size = Vector3.new(20, STORY - DOOR_H, 1), CFrame = CFrame.new(x, DOOR_H + (STORY - DOOR_H) / 2, z - 8), Color = wallC, Material = Enum.Material.SmoothPlastic }, parent)
        part({ Name = judul .. "Atap", Size = Vector3.new(22, 1.2, 18), CFrame = CFrame.new(x, STORY + 0.6, z), Color = roofC, Material = Enum.Material.Slate }, parent)
        DoorKit.frame(Vector3.new(x, 0, z - 8), 0, parent, DOOR_W, DOOR_H)
        DoorKit.hinged(Vector3.new(x, 0, z - 8), 0, parent, DOOR_W, DOOR_H, wallC:Lerp(Color3.new(0, 0, 0), 0.25))
        local board = part({
                Name = judul .. "Papan",
                Size = Vector3.new(8.5, 2.2, 0.5),
                CFrame = CFrame.new(x, DOOR_H + 2.6, z - 8.8) * CFrame.Angles(0, math.rad(180), 0),
                Color = Color3.fromRGB(34, 38, 52),
                Material = Enum.Material.SmoothPlastic,
                CanCollide = false,
        }, parent)
        surfaceText(board, judul, nil, Color3.fromRGB(255, 226, 150))
        return board
end

local function infoPrompt(parentPart: Part, title: string, body: string)
        local prompt = Instance.new("ProximityPrompt")
        prompt.ActionText = "Baca Info"
        prompt.ObjectText = title
        prompt.MaxActivationDistance = 9
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
        prompt.Parent = parentPart
        prompt.Triggered:Connect(function(player: Player)
                Remotes.get("Notify"):FireClient(player, title, body)
        end)
end

