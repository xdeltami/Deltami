      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">MathGen</string>
          <string name="Source"><![CDATA[--!nonstrict
--[[
        MathGen.luau
        Generator soal matematika prosedural (karya original, gaya edukatif
        peduli umpan balik). Satu generator per zona, tingkat kesulitan naik.

        Output per soal:
        { t = teks soal, opsi = {3 teks}, benar = index (1..3),
          betul = pujian/penguatan, salah = petunjuk lembut }
]]

local MathGen = {}

local function shuffledOptions(correct: number, decoys: { number }): ({ string }, number)
        local opts = { tostring(correct) }
        for _, d in decoys do
                if #opts >= 3 then
                        break
                end
                if d ~= correct then
                        table.insert(opts, tostring(d))
                end
        end
        -- fallback decoys bila kurang
        local filler = correct + 1
        while #opts < 3 do
                if filler ~= correct and table.find(opts, tostring(filler)) == nil then
                        table.insert(opts, tostring(filler))
                end
                filler += 1
        end
        -- shuffle
        for i = #opts, 2, -1 do
                local j = math.random(1, i)
                opts[i], opts[j] = opts[j], opts[i]
        end
        local correctIndex = table.find(opts, tostring(correct)) or 1
        return opts, correctIndex
end

local function question(t: string, correct: number, decoys: { number }, betul: string, salah: string)
        local opsi, benar = shuffledOptions(correct, decoys)
        return { t = t, opsi = opsi, benar = benar, betul = betul, salah = salah }
end

local function near(n: number): { number }
        -- decoys "klik terdekat" yang masuk akal secara pedagogis
        local out = {}
        local candidates = { n + 1, n - 1, n + 2, n - 2, n + 10, n - 10, n * 2 }
        for _, c in candidates do
                if c >= 0 and c ~= n and table.find(out, c) == nil then
                        table.insert(out, c)
                end
        end
        return out
end

--------------------------------------------------------------------
-- ZONA 1: KAMP ANGKA - berhitung dasar
--------------------------------------------------------------------
local function kamp(): any
        local pick = math.random(1, 4)
        if pick == 1 then
                local a, b = math.random(2, 9), math.random(2, 9)
                return question(
                        ("Tenda butuh %d tiang. Sudah berdiri %d. Berapa tiang lagi yang harus dipasang?"):format(a + b, a),
                        b,
                        near(b),
                        ("Tepat! Dari %d menuju %d: %d langkah. Satu tiang berdiri!"):format(a, a + b, b),
                        "Hitung maju pelan-pelan dari " .. a .. " sampai " .. (a + b) .. ". Berapa langkah itu?"
                )
        elseif pick == 2 then
                local a, b = math.random(2, 6), math.random(2, 6)
                return question(
                        ("Kayu unggun disusun %d tumpukan, tiap tumpukan berisi %d kayu. Semuanya berapa kayu?"):format(a, b),
                        a * b,
                        near(a * b),
                        ("Benar! %d x %d = %d. Menjumlah berulang seperti ini adalah bibit perkalian!"):format(a, b, a * b),
                        "Coba hitung tumpuk demi tumpuk, tambahkan terus jumlahnya."
                )
        elseif pick == 3 then
                local total = math.random(5, 12)
                local ambil = math.random(1, total - 2)
                return question(
                        (("%d batu dikumpulkan, lalu %d dipakai bikin tungku. Sisa berapa batu?"):format(total, ambil)),
                        total - ambil,
                        near(total - ambil),
                        "Benar! Mengambil dari jumlah itu artinya berkurang.",
                        "Mulai dari " .. total .. ", lalu hitung mundur sebanyak " .. ambil .. "."
                )
        else
                local domba, kandang = math.random(6, 15), math.random(2, 5)
                return question(
                        (("%d domba dibagi rata ke %d kandang. Tiap kandang berisi berapa domba?"):format(domba, kandang)),
                        math.floor(domba / kandang),
                        near(math.floor(domba / kandang)),
                        "Benar! Membagi rata = membagi sama besar ke tiap kelompok.",
                        ("Bayangkan membagikan domba satu per satu bergiliran ke %d kandang."):format(kandang)
                )
        end
end

--------------------------------------------------------------------
-- ZONA 2: HUTAN SIMBOL - tanda, urutan operasi, bilangan negatif
--------------------------------------------------------------------
local function hutan(): any
        local pick = math.random(1, 4)
        if pick == 1 then
                local a, b, c = math.random(2, 6), math.random(2, 6), math.random(2, 6)
                local correct = a + b * c
                return question(
                        ("Berapa hasil dari %d + %d x %d?"):format(a, b, c),
                        correct,
                        { a * b + c, correct + b, correct - a },
                        "Benar! Kali dulu, baru tambah - urutan operasi menyelamatkanmu.",
                        "Ingat aturan hutan: kali dibahas lebih dulu daripada tambah."
                )
        elseif pick == 2 then
                local a = math.random(3, 12)
                local b = math.random(1, a + 4)
                local correct = a - b
                return question(
                        ("Suhu di hutan %d derajat, malamnya turun %d derajat. Suhu sekarang?"):format(a, b),
                        correct,
                        { a + b, math.abs(correct) + 1, correct + 1 },
                        "Benar! Turun dari angka positif bisa mendarat di wilayah negatif.",
                        "Melangkah mundur dari " .. a .. " sebanyak " .. b .. " kali - bisa lewat nol!"
                )
        elseif pick == 3 then
                local a, b = math.random(-9, 9), math.random(-9, 9)
                if a == b then
                        b = b + 1
                end
                local larger = math.max(a, b)
                return question(
                        ("Mana yang LEBIH BESAR: %d atau %d?"):format(a, b),
                        larger,
                        { math.min(a, b), math.abs(a), math.abs(b) },
                        "Benar! Garis bilangan: makin ke kanan makin besar, minus itu di kiri nol.",
                        "Bayangkan garis bilangan: -5 -4 -3 -2 -1 0 1 2 3 ..."
                )
        else
                local a, b = math.random(2, 9), math.random(2, 9)
                local correct = a * b
                return question(
                        ("Simbol misteri: %d ? %d = %d. Simbol ? seharusnya..."):format(a, b, correct),
                        correct,
                        { a + b, correct + a, math.abs(a - b) },
                        "Benar! Tanda itu tanda kali - simbol punya makna, bukan hiasan.",
                        "Periksa: apakah hasilnya jauh lebih besar dari kedua bilangan? Itu petunjuk perkalian."
                )
        end
end

--------------------------------------------------------------------
-- ZONA 3: PEGUNUNGAN POLA - pola barisan
--------------------------------------------------------------------
local function gunung(): any
        local pick = math.random(1, 3)
        if pick == 1 then
                local start, step = math.random(1, 9), math.random(2, 7)
                local seq = { start, start + step, start + 2 * step, start + 3 * step }
                local nxt = start + 4 * step
                return question(
                        ("Barisan gunung: %d, %d, %d, %d, ... Berapa angka berikutnya?"):format(seq[1], seq[2], seq[3], seq[4]),
                        nxt,
                        { nxt + step, nxt - 1, seq[4] + 1 },
                        ("Benar! Beda tetap +%d. Pola itu tangganya."):format(step),
                        "Cari selisih dua angka yang berdekatan - selisihnya selalu sama."
                )
        elseif pick == 2 then
                local start = math.random(1, 4)
                local seq = { start, start * 2, start * 4, start * 8 }
                local nxt = start * 16
                return question(
                        ("Jejak di gunung: %d, %d, %d, %d, ... angka berikutnya?"):format(seq[1], seq[2], seq[3], seq[4]),
                        nxt,
                        { start * 12, nxt + 2, seq[4] + 8 },
                        "Benar! Tiap langkah dikali 2 - pola perkalian meledak tingginya!",
                        "Bandingkan tiap angka dengan sebelumnya: berapa kali lipat?"
                )
        else
                local rows = math.random(3, 8)
                local correct = rows * (rows + 1) / 2
                return question(
                        ("Susunan kaki gunung: baris 1 ada 1 batu, baris 2 ada 2 batu, sampai baris %d. Total batu?"):format(rows),
                        correct,
                        near(correct),
                        "Benar! 1+2+...+n = n(n+1)/2 - pola segitiga legendaris.",
                        "Jumlahkan bertahap: 1+2=3, 3+3=6, 6+4=10 ... terus sampai baris " .. rows .. "."
                )
        end
end

--------------------------------------------------------------------
-- ZONA 4: KOTA BUKTI - aljabar & pembuktian sederhana
--------------------------------------------------------------------
local function kota(): any
        local pick = math.random(1, 3)
        if pick == 1 then
                local a = math.random(2, 9)
                local x = math.random(2, 9)
                local b = math.random(1, 9)
                return question(
                        ("Selesaikan: %dx + %d = %d. Berapa x?"):format(a, b, a * x + b),
                        x,
                        { x + 1, x - 1, a + x },
                        "Benar! Pindahkan konstanta, lalu bagi - kasus hukum di Kota Bukti selesai.",
                        "Kurangi kedua ruas dengan " .. b .. " dulu, baru bagi dengan " .. a .. "."
                )
        elseif pick == 2 then
                local a, b = math.random(2, 12), math.random(2, 12)
                local correct = a * a + b
                return question(
                        ("Klaim warga: %d x %d + %d = %d. Benar atau tidak? (pilih nilai yang benar)"):format(a, a, b, correct + 2),
                        correct,
                        { correct + 2, a * a - b, a * 2 + b },
                        "Benar! Hitung sendiri = membuktikan. Itu jiwa Kota Bukti.",
                        "Kuadratkan dulu, lalu tambahkan. Jangan percaya klaim tanpa perhitungan!"
                )
        else
                local n = math.random(4, 12)
                local correct = n * n
                return question(
                        ("Luas pelataran kota berbentuk persegi dengan sisi %d. Berapa luasnya?"):format(n),
                        correct,
                        { 4 * n, n * 2, correct + n },
                        "Benar! Luas persegi = sisi x sisi. Bukti geometris selesai.",
                        "Luas bukan keliling - keliling yang 4 x sisi."
                )
        end
end

--------------------------------------------------------------------
-- ZONA 5: LEMBAH KEDALAMAN - pangkat, akar, fungsi
--------------------------------------------------------------------
local function lembah(): any
        local pick = math.random(1, 3)
        if pick == 1 then
                local base = math.random(2, 6)
                local exp = math.random(2, 3)
                local correct = base ^ exp
                return question(
                        ("Teropong riset memperbesar %d kali tiap lapis. Setelah %d lapis: berapa %d^%d?"):format(base, exp, base, exp),
                        correct,
                        { base * exp, correct + base, correct - base },
                        "Benar! Pangkat = perkalian berulang. Semakin dalam, semakin terpahami.",
                        ("%d dipangkatkan %d artinya %d dikalikan dirinya sendiri %d kali."):format(base, exp, base, exp)
                )
        elseif pick == 2 then
                local x = math.random(1, 8)
                local a, b = math.random(2, 5), math.random(1, 6)
                local correct = a * x + b
                return question(
                        ("Fungsi f(x) = %dx + %d. Berapa f(%d)?"):format(a, b, x),
                        correct,
                        near(correct),
                        ("Benar! Masukkan %d ke x: %d(%d) + %d = %d."):format(x, a, x, b, correct),
                        ("Ganti setiap x dengan %d, lalu hitung sesuai urutan operasi."):format(x)
                )
        else
                local root = math.random(2, 12)
                local square = root * root
                return question(
                        ("Akar dari %d?"):format(square),
                        root,
                        { root + 1, root - 1, root * 2 },
                        ("Benar! %d x %d kembali ke %d. Akar adalah kebalikan kuadrat."):format(root, root, square),
                        "Coba kuadratkan pilihan-pilihannya - mana yang kembali ke " .. square .. "?"
                )
        end
end

--------------------------------------------------------------------
-- ZONA 6: PUNCAK RISET - prima, modulo, nalar tingkat lanjut
--------------------------------------------------------------------
local function salju(): any
        local pick = math.random(1, 3)
        if pick == 1 then
                local primes = { 7, 11, 13, 17, 19, 23 }
                local p = primes[math.random(1, #primes)]
                local composites = { 9, 15, 21, 25, 27, 33 }
                local c = composites[math.random(1, #composites)]
                local correct = math.random() < 0.5 and p or c
                local askPrima = correct == p
                return question(
                        "Manakah bilangan PRIMA di antara pilihan berikut?",
                        correct,
                        { askPrima and c or p },
                        "Benar! Prima hanya habis dibagi 1 dan dirinya sendiri.",
                        ("Uji bagi: apakah %d bisa dibagi bilangan lain selain 1 dan dirinya?"):format(askPrima and c or p)
                )
        elseif pick == 2 then
                local a = math.random(10, 40)
                local n = math.random(3, 6)
                local correct = a % n
                return question(
                        ("Sisa pembagian %d mod %d?"):format(a, n),
                        correct,
                        near(correct),
                        "Benar! Modulo = sisa setelah dibagi rata. Jam bergulir juga begitu.",
                        ("%d dibagi %d: kali berapa supaya mendekati, sisanya berapa?"):format(a, n)
                )
        else
                local a = math.random(3, 9)
                local correct = a * (a + 1) / 2 * 2
                return question(
                        ("Jumlah 1 + 2 + ... + %d, lalu dikali 2. Hasilnya?"):format(a),
                        correct,
                        near(correct),
                        "Benar! Rumus Gauss n(n+1)/2 lalu dilipatgandakan - riset dimulai dari tools yang tepat.",
                        ("Hitung 1+2+...+%d = %d(%d+1)/2 dulu, baru kali 2."):format(a, a, a)
                )
        end
end

local GENERATORS = { kamp, hutan, gunung, kota, lembah, salju }

--- zoneIndex 1..6
function MathGen.generate(zoneIndex: number): any
        local gen = GENERATORS[math.clamp(zoneIndex, 1, #GENERATORS)]
        return gen()
end

return MathGen
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[--!nonstrict
--[[
	Util.luau - helper bersama (server & client).
]]

local Util = {}

local SUFFIXES = { "", "K", "M", "B", "T" }

function Util.formatNumber(n: number): string
	n = math.floor(n)
	if n < 1000 then
		return tostring(n)
	end
	local idx = math.floor(math.log10(n) / 3)
	if idx >= #SUFFIXES then
		idx = #SUFFIXES - 1
	end
	local m = n / (1000 ^ idx)
	local text
	if m >= 100 then
		text = string.format("%.0f", m)
	elseif m >= 10 then
		text = string.format("%.1f", m)
	else
		text = string.format("%.2f", m)
	end
	text = text:gsub("%.?0+$", "")
	return text .. SUFFIXES[idx + 1]
end

function Util.deepCopy<T>(t: T): T
	if type(t) ~= "table" then
		return t
	end
	local out = {}
	for k, v in pairs(t :: any) do
		out[k] = Util.deepCopy(v)
	end
	return out :: any
end

function Util.retry<T>(attempts: number, fn: () -> ...any): (boolean, ...any)
	local ok, a, b, c = false, nil, nil, nil
	for i = 1, attempts do
		ok, a, b, c = pcall(fn)
		if ok then
			return true, a, b, c
		end
		task.wait(i * 2)
	end
	return false, a
end

function Util.create(className: string, props: { [string]: any }?, parent: Instance?): Instance
	local inst = Instance.new(className)
	if props then
		for k, v in pairs(props) do
			(inst :: any)[k] = v
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

--- Warna zona dari Config.Zones (array {r,g,b} 0-255) -> Color3.
function Util.zoneColor(rgb): Color3
	return Color3.fromRGB(rgb[1], rgb[2], rgb[3])
end

return Util
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="8">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="9">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!nonstrict
--[[
        init.server.luau - bootstrap DUNIA AKIOMIDA v3 "Toram-grade".
        Ekonomi hidup + KOMBAT, TEMPAA (crafting), STAT & PERALATAN,
        TUGAS HARIAN, BOSS RAID, DAGANG ANTAR PEMAIN. Kuis opsional.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Remotes)
local Config = require(ReplicatedStorage.Shared.Config)

Remotes.init()

local Modules = script.Modules
local DataService = require(Modules.DataService)
local FarmService = require(Modules.FarmService)
local GatherService = require(Modules.GatherService)
local ShopService = require(Modules.ShopService)
local PetService = require(Modules.PetService)
local QuizService = require(Modules.QuizService)
local LeaderboardService = require(Modules.LeaderboardService)
local EquipService = require(Modules.EquipService)
local QuestService = require(Modules.QuestService)
local CraftService = require(Modules.CraftService)
local CombatService = require(Modules.CombatService)
local TradeService = require(Modules.TradeService)
local MapService = require(Modules.MapService)

-- bangun dunia (butuh referensi layanan untuk menghubungkan NPC)
MapService.init({
        Farm = FarmService,
        Gather = GatherService,
        Shop = ShopService,
        Quiz = QuizService,
        Craft = CraftService,
        Quest = QuestService,
})

FarmService.init()
FarmService.startLoop()
GatherService.init()
ShopService.init()
PetService.init()
QuizService.init()
LeaderboardService.init()
EquipService.init()
QuestService.init()
CraftService.init()
TradeService.init()
CombatService.init()
CombatService.spawnMonsters()
DataService.startLoops()

--------------------------------------------------------------------
-- PEMAIN
--------------------------------------------------------------------

local function applySpeed(player: Player)
        -- v3: semua perhitungan laju/HP/senjata ada di EquipService.apply
        local EquipService = require(script.Modules.EquipService)
        EquipService.apply(player)
end

local function onPlayerAdded(player: Player)
        local ok = DataService.load(player)
        if not ok then
                -- JANGAN kick pemain: pakai sesi memori supaya game tetap bisa dimainkan
                DataService.startSession(player)
                warn("[AKIOMIDA] DataStore gagal, sesi memori dipakai untuk " .. player.Name)
                task.delay(5, function()
                        if player.Parent then
                                Remotes.get("Notify"):FireClient(player, "Mode Sesi",
                                        "Progres sementara hanya tersimpan di sesi ini. Keluar-masuk lagi nanti untuk simpan permanen.")
                        end
                end)
        end

        -- leaderstats standar Roblox
        local leaderstats = Instance.new("Folder")
        leaderstats.Name = "leaderstats"
        local koin = Instance.new("IntValue")
        koin.Name = "Koin"
        koin.Value = math.floor(DataService.get(player).Coins)
        koin.Parent = leaderstats
        local xp = Instance.new("IntValue")
        xp.Name = "XP"
        xp.Value = math.floor(DataService.get(player).XP)
        xp.Parent = leaderstats
        leaderstats.Parent = player

        -- bonus login harian
        local today = tonumber(os.date("!%Y%m%d")) or 0
        local data = DataService.get(player)
        if data.LastLoginDay ~= today then
                data.LastLoginDay = today
                DataService.markDirty(player)
                DataService.addCoins(player, Config.Economy.DailyBonus, false)
                task.delay(5, function()
                        if player.Parent then
                                Remotes.get("Notify"):FireClient(player, "Bonus Harian",
                                        "+" .. Config.Economy.DailyBonus .. " koin untuk petualangan hari ini!")
                        end
                end)
        end

        player.CharacterAdded:Connect(function()
                task.wait(0.5)
                applySpeed(player)
        end)
        if player.Character then
                applySpeed(player)
        end

        task.delay(4, function()
                if not player.Parent then
                        return
                end
                DataService.push(player)
                Remotes.get("Notify"):FireClient(player, "Selamat Datang di Dunia Akiomida!",
                        "Tanam, tebang, tambang, mancing, lawan monster, tempa senjata, kalahkan Raja Golem, dan berdagang dengan pemain lain!")
        end)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
        task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
        FarmService.releasePlot(player)
        PetService.cleanup(player)
end)

-- client bisa minta refresh state (fallback kalau StateSync terlewat)
Remotes.get("GetState").OnServerInvoke = function(player)
        DataService.push(player)
        return true
end

print("[AKIOMIDA] Server v3 siap: kombat, tempa, stat & peralatan, tugas, boss raid, dagang - di atas fondasi ekonomi hidup.")
]]></string>
      </Properties>
      <Item class="Folder" referent="10">
        <Properties>
          <string name="Name">Modules</string>
        </Properties>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">CombatService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
        CombatService.luau - v3 "Toram-grade" kombat dunia terbuka:
          - 4 makhluk original: Gelatin Hijau, Serigala Bayang, Golem Batu,
            Gelatin Raksasa (elite) + BOSS RAID "Raja Golem" di Arena Timur
          - AI: berkeliaran, mengejar pemain dalam radius aggro, menyerang balik
          - Serang lewat ProximityPrompt "Serang" + validasi jarak di server
          - Damage dari STR/DEX/INT/level + senjata tempaan (EquipService)
          - Drop material -> bahan tempa (objek jadi bahan!)
          - Boss raid kooperatif: semua pemain memukul bersama, hadiah
            dibagi menurut kontribusi damage. Broadcast BossState ke UI.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Remotes = require(ReplicatedStorage.Remotes)
local Balance = require(ReplicatedStorage.Shared.Balance)
local Util = require(ReplicatedStorage.Shared.Util)

local DataService = require(script.Parent.DataService)
local EquipService = require(script.Parent.EquipService)
local QuestService = require(script.Parent.QuestService)

local CombatService = {}

--------------------------------------------------------------------
-- STATE
--------------------------------------------------------------------

local monsterFolder: Folder? = nil
local monsters: { [string]: any } = {} -- id unik -> entitas
local monsterSeq = 0
local lastAttack: { [Player]: number } = {}
local rng = Random.new(tick() * 1000)

local boss: any = nil
local bossCredits: { [Player]: number } = {}
local bossNextSpawn = 0

--------------------------------------------------------------------
-- HELPERS
--------------------------------------------------------------------

local function notify(player: Player, title: string, text: string)
        Remotes.get("Notify"):FireClient(player, title, text)
end

local function statsOf(player: Player)
        return EquipService.statsOf(player)
end

local function isAliveCharacter(player: Player): boolean
        local character = player.Character
        if not character or not character.Parent then
                return false
        end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        return humanoid ~= nil and humanoid.Health > 0 and character.PrimaryPart ~= nil
end

--------------------------------------------------------------------
-- MODEL MONSTER (karya original: badan + mata + inti)
--------------------------------------------------------------------

local function part(props): Part
        local p = Instance.new("Part")
        p.Anchored = true
        p.TopSurface = Enum.SurfaceType.Smooth
        p.BottomSurface = Enum.SurfaceType.Smooth
        for k, v in props do
                (p :: any)[k] = v
        end
        p.Parent = monsterFolder
        return p
end

local function hpBillboard(body: Part, name: string, hp: number, maxHp: number, isBoss: boolean)
        local gui = Instance.new("BillboardGui")
        gui.Name = "HPBar"
        gui.Size = isBoss and UDim2.new(0, 260, 0, 54) or UDim2.new(0, 150, 0, 40)
        gui.StudsOffset = Vector3.new(0, (isBoss and 12 or 7), 0)
        gui.AlwaysOnTop = true
        gui.MaxDistance = 140
        gui.Parent = body

        local nameLabel = Util.create("TextLabel", {
                Size = UDim2.new(1, 0, 0, isBoss and 26 or 18),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBlack,
                TextScaled = true,
                TextColor3 = isBoss and Color3.fromRGB(255, 90, 90) or Color3.fromRGB(255, 230, 160),
                TextStrokeTransparency = 0.4,
                Text = name,
        }, gui)

        local barBg = Util.create("Frame", {
                Position = UDim2.new(0, 8, 0, isBoss and 28 or 20),
                Size = UDim2.new(1, -16, 0, isBoss and 16 or 12),
                BackgroundColor3 = Color3.fromRGB(40, 20, 20),
                BorderSizePixel = 0,
        }, gui)
        Util.create("UICorner", { CornerRadius = UDim.new(0, 6) }, barBg)
        local bar = Util.create("Frame", {
                Size = UDim2.fromScale(1, 1),
                BackgroundColor3 = isBoss and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(90, 220, 120),
                BorderSizePixel = 0,
        }, barBg)
        Util.create("UICorner", { CornerRadius = UDim.new(0, 6) }, bar)

        local hpLabel = Util.create("TextLabel", {
                Position = UDim2.new(0, 0, 0, isBoss and 44 or 32),
                Size = UDim2.new(1, 0, 0, 10),
                BackgroundTransparency = 1,
                Font = Enum.Font.Gotham,
                TextScaled = true,
                TextColor3 = Color3.fromRGB(230, 230, 235),
                Text = hp .. " / " .. maxHp,
        }, gui)

        return { gui = gui, bar = bar, label = hpLabel, name = nameLabel }
end

local function buildMonsterModel(def: any, position: Vector3, isBoss: boolean): (Model, Part)
        local model = Instance.new("Model")
        model.Name = isBoss and "RajaGolem" or ("Monster_" .. def.id)

        local bodyColor = Color3.fromRGB(def.body.color[1], def.body.color[2], def.body.color[3])
        local size = def.body.size
        local body: Part

        if def.body.shape == "ball" then
                body = part({
                        Name = "Badan",
                        Shape = Enum.PartType.Ball,
                        Size = Vector3.new(1, 1, 1) * size,
                        CFrame = CFrame.new(position + Vector3.new(0, size / 2, 0)),
                        Color = bodyColor,
                        Material = Enum.Material.SmoothPlastic,
                        Transparency = 0.12,
                })
        else
                body = part({
                        Name = "Badan",
                        Size = Vector3.new(size * 0.9, size * 0.8, size * 0.9),
                        CFrame = CFrame.new(position + Vector3.new(0, size * 0.4, 0)),
                        Color = bodyColor,
                        Material = Enum.Material.Slate,
                })
        end
        body.Parent = model
        model.PrimaryPart = body

        -- mata (dua titik gelap) supaya terlihat hidup
        local eyeColor = Color3.fromRGB(30, 30, 36)
        local eyeZ = -(size * 0.42)
        local eyeSize = math.max(0.5, size * 0.14)
        for side = -1, 1, 2 do
                local eye = part({
                        Name = "Mata" .. side,
                        Shape = Enum.PartType.Ball,
                        Size = Vector3.new(1, 1, 1) * eyeSize,
                        CFrame = body.CFrame * CFrame.new(Vector3.new(side * eyeSize, size * 0.16, eyeZ)),
                        Color = isBoss and Color3.fromRGB(255, 80, 60) or eyeColor,
                        Material = isBoss and Enum.Material.Neon or Enum.Material.SmoothPlastic,
                        CanCollide = false,
                })
                eye.Parent = model
        end

        if def.body.shape == "box" then
                -- inti bercahaya di dada (golem/wolf)
                local core = part({
                        Name = "Inti",
                        Shape = Enum.PartType.Ball,
                        Size = Vector3.new(1, 1, 1) * size * 0.22,
                        CFrame = body.CFrame * CFrame.new(0, size * 0.08, size * 0.48),
                        Color = isBoss and Color3.fromRGB(255, 120, 60) or Color3.fromRGB(255, 170, 90),
                        Material = Enum.Material.Neon,
                        CanCollide = false,
                })
                core.Parent = model
        end

        if isBoss then
                -- mahkota duri raja
                for i = 1, 5 do
                        local spike = part({
                                Name = "Duri" .. i,
                                Size = Vector3.new(1.2, 4, 1.2),
                                CFrame = body.CFrame * CFrame.new((i - 3) * 2.4, size * 0.62, 0) * CFrame.Angles(math.rad(rng:NextNumber(-12, 12)), 0, math.rad(rng:NextNumber(-12, 12))),
                                Color = Color3.fromRGB(70, 70, 82),
                                Material = Enum.Material.Rock,
                                CanCollide = false,
                        })
                        spike.Parent = model
                end
                local light = Instance.new("PointLight")
                light.Color = Color3.fromRGB(255, 110, 60)
                light.Range = 34
                light.Brightness = 1.6
                light.Parent = body
        end

        body.CanCollide = true

        local prompt = Instance.new("ProximityPrompt")
        prompt.ActionText = "Serang"
        prompt.ObjectText = def.name
        prompt.MaxActivationDistance = 9
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
        prompt.Parent = body

        return model, body
end

--------------------------------------------------------------------
-- SPAWN & AI
--------------------------------------------------------------------

local function zoneCenter(zoneId: string): Vector3
        for _, zone in ipairs(Balance.Zones) do
                if zone.id == zoneId then
                        return Vector3.new(zone.center[1], zone.center[2], zone.center[3])
                end
        end
        return Vector3.new(0, 0, 0)
end

local function spawnMonster(def: any, zoneId: string, isBoss: boolean?)
        local center = zoneCenter(zoneId)
        local offset = Vector3.new(rng:NextNumber(-1, 1) * 12, 0, rng:NextNumber(-1, 1) * 12)
        local position = center + offset
        local model, body = buildMonsterModel(def, position, isBoss == true)

        local maxHp = def.hp
        local bb = hpBillboard(body, def.name, maxHp, maxHp, isBoss == true)

        local entity = {
                def = def,
                zone = zoneId,
                model = model,
                body = body,
                bb = bb,
                hp = maxHp,
                maxHp = maxHp,
                alive = true,
                home = position,
                target = nil :: Player?,
                lastHit = 0,
                lastMove = 0,
                wanderTo = position,
                isBoss = isBoss == true,
                unique = 0,
        }
        monsterSeq += 1
        entity.unique = monsterSeq

        local prompt = body:FindFirstChildOfClass("ProximityPrompt")
        if prompt then
                prompt.Triggered:Connect(function(player)
                        if entity.alive then
                                task.spawn(CombatService.playerAttack, player, entity)
                        end
                end)
        end

        monsters["m" .. entity.unique] = entity
        return entity
end

local function disablePrompt(p: Part)
        local pr = p:FindFirstChildOfClass("ProximityPrompt")
        if pr then
                pr.Enabled = false
        end
end

local function monsterDie(entity: any, byPlayer: Player?)
        entity.alive = false
        local def = entity.def

        -- animasi kematian sederhana: tenggelam & hilang
        for _, p in entity.model:GetChildren() do
                if p:IsA("BasePart") then
                        p.CanCollide = false
                        disablePrompt(p)
                end
        end
        local body = entity.body
        body.Anchored = true
        task.spawn(function()
                for t = 1, 10 do
                        if body.Parent then
                                body.CFrame = body.CFrame - Vector3.new(0, 0.25, 0)
                                body.Transparency = t / 10
                        end
                        task.wait(0.05)
                end
                if entity.model.Parent then
                        entity.model:Destroy()
                end
        end)

        monsters["m" .. entity.unique] = nil

        if entity.isBoss then
                boss = nil
                return -- boss tidak respawn otomatis (diatur bossLoop)
        end

        -- respawn di zona setelah jeda
        task.delay(def.respawn, function()
                if monsterFolder and monsterFolder.Parent then
                        spawnMonster(def, entity.zone)
                end
        end)
end

--------------------------------------------------------------------
-- SERANGAN PEMAIN
--------------------------------------------------------------------

function CombatService.playerAttack(player: Player, entity: any)
        if not entity or not entity.alive or not DataService.has(player) then
                return { ok = false, msg = "Target tidak valid." }
        end
        if not isAliveCharacter(player) then
                return { ok = false, msg = "Kamu tidak bisa menyerang sekarang." }
        end
        -- jarak server-side
        local root = player.Character and player.Character.PrimaryPart
        if not root or (root.Position - entity.body.Position).Magnitude > 14 then
                return { ok = false, msg = "Terlalu jauh!" }
        end
        -- jeda serangan (AGI mempercepat)
        local now = os.clock()
        local cd = Balance.attackCooldown(statsOf(player).agi)
        if lastAttack[player] and now - lastAttack[player] < cd then
                return { ok = false, msg = "Serangan belum siap." }
        end
        lastAttack[player] = now

        local stats = statsOf(player)
        local level = DataService.levelOf(player)
        local atk = Balance.playerAttack({
                weaponAtk = EquipService.weaponAtk(player),
                str = stats.str,
                dex = stats.dex,
                int = stats.int,
                level = level,
        })
        local crit = rng:NextNumber() < Balance.critChance(stats.dex)
        if crit then
                atk = math.floor(atk * Balance.CritMult + 0.5)
        end
        -- kurva pelunakan dengan pertahanan monster
        local def = entity.def.def or 0
        local dmg = math.max(1, math.floor(atk * (1 - def / (def + 60)) + 0.5))

        entity.hp -= dmg
        local bb = entity.bb
        bb.bar.Size = UDim2.fromScale(math.clamp(entity.hp / entity.maxHp, 0, 1), 1)
        bb.label.Text = math.max(0, entity.hp) .. " / " .. entity.maxHp

        -- krediting boss raid
        if entity.isBoss then
                bossCredits[player] = (bossCredits[player] or 0) + dmg
        end

        local killed = entity.hp <= 0

        if killed then
                CombatService.onKill(player, entity)
                if entity.isBoss then
                        -- bagi hadiah raid SEBELUM boss dibersihkan
                        CombatService.finishBoss()
                end
                monsterDie(entity, player)
        else
                -- monster berbalik mengejar penyerang
                entity.target = player
        end

        DataService.push(player)
        return { ok = true, dmg = dmg, crit = crit, killed = killed, name = entity.def.name }
end

function CombatService.onKill(player: Player, entity: any)
        local def = entity.def

        -- XP & koin
        DataService.addXP(player, def.xp)
        local coin = rng:NextInteger(def.coin[1], def.coin[2])
        DataService.addCoins(player, coin, true)

        -- progres tugas "kalahkan monster"
        QuestService.progress(player, "kill", 1)

        -- drop material -> bahan craft
        local dropTexts = {}
        for _, drop in ipairs(def.drops) do
                if rng:NextNumber() <= drop.chance then
                        local n = rng:NextInteger(drop.min, drop.max)
                        DataService.giveItem(player, "bag", drop.id, n)
                        table.insert(dropTexts, "+" .. n .. " " .. drop.id)
                end
        end

        local msg = def.name .. " dikalahkan! +" .. def.xp .. " XP, +" .. coin .. " koin"
        if #dropTexts > 0 then
                msg = msg .. " (" .. table.concat(dropTexts, ", ") .. ")"
        end
        notify(player, "KOMBAT!", msg)

        -- boss raid: broadcast peristiwa
        if entity.isBoss then
                Remotes.get("BossState"):FireAllClients({ active = false, killed = true, name = def.name })
        end
end

--------------------------------------------------------------------
-- AI LOOP (wander / chase / attack)
--------------------------------------------------------------------

local function stepMonster(entity: any, dt: number)
        if not entity.alive or not entity.body.Parent then
                return
        end
        local def = entity.def

        -- validasi target
        local targetPlayer = entity.target
        if targetPlayer then
                local valid = targetPlayer.Parent ~= nil and isAliveCharacter(targetPlayer)
                if valid then
                        local root = targetPlayer.Character.PrimaryPart
                        local dist = (root.Position - entity.home).Magnitude
                        if dist > def.aggro * 2.2 then
                                valid = false -- terlalu jauh dari rumahnya, pulang
                        end
                end
                if not valid then
                        entity.target = nil
                end
        end

        -- cari target baru dalam radius aggro
        if not entity.target then
                for _, player in Players:GetPlayers() do
                        if isAliveCharacter(player) and DataService.has(player) then
                                local root = player.Character.PrimaryPart
                                if (root.Position - entity.body.Position).Magnitude <= def.aggro then
                                        entity.target = player
                                        break
                                end
                        end
                end
        end

        local bodyPos = entity.body.Position
        local goal: Vector3
        local speed = def.speed

        if entity.target then
                local root = entity.target.Character.PrimaryPart
                local dist = (root.Position - bodyPos).Magnitude
                if dist > 5 then
                        goal = root.Position
                else
                        goal = bodyPos -- dekat: berhenti & serang
                        local now = os.clock()
                        if now - entity.lastHit >= 1.5 then
                                entity.lastHit = now
                                -- damage ke pemain dengan pertahanan zirah + VIT
                                local pstats = statsOf(entity.target)
                                local defense = Balance.playerDefense(EquipService.armorDef(entity.target), pstats.vit)
                                local taken = Balance.damageTaken(def.atk, defense)
                                local humanoid = entity.target.Character:FindFirstChildOfClass("Humanoid")
                                if humanoid then
                                        humanoid:TakeDamage(taken)
                                end
                        end
                end
        else
                -- berkeliaran di sekitar rumah
                if (bodyPos - entity.wanderTo).Magnitude < 3 then
                        entity.wanderTo = entity.home + Vector3.new(rng:NextNumber(-12, 12), 0, rng:NextNumber(-12, 12))
                        return
                end
                goal = entity.wanderTo
                speed = def.speed * 0.45
        end

        local dir = (goal - bodyPos) * Vector3.new(1, 0, 1)
        if dir.Magnitude > 0.4 then
                dir = dir.Unit
                local step = math.min(speed * dt, dir.Magnitude * 99)
                local newPos = bodyPos + dir * step
                entity.body.CFrame = CFrame.lookAt(newPos, newPos + dir)
        end
end

RunService.Heartbeat:Connect(function(dt)
        for _, entity in monsters do
                pcall(stepMonster, entity, dt)
        end
end)

--------------------------------------------------------------------
-- BOSS RAID (kooperatif - kegiatan multiplayer terancang)
--------------------------------------------------------------------

function CombatService.startBoss()
        if boss then
                return
        end
        local def = Balance.Boss
        local center = zoneCenter("arena")
        local model, body = buildMonsterModel({ id = def.id, name = def.name, body = def.body }, center + Vector3.new(0, 2, 0), true)
        local maxHp = def.hp
        local bb = hpBillboard(body, def.name, maxHp, maxHp, true)

        boss = {
                def = def,
                zone = "arena",
                model = model,
                body = body,
                bb = bb,
                hp = maxHp,
                maxHp = maxHp,
                alive = true,
                home = center,
                target = nil,
                lastHit = 0,
                wanderTo = center,
                isBoss = true,
                unique = 0,
                spawnedAt = os.clock(),
        }
        monsterSeq += 1
        boss.unique = monsterSeq
        bossCredits = {}

        local prompt = body:FindFirstChildOfClass("ProximityPrompt")
        if prompt then
                prompt.Triggered:Connect(function(player)
                        if boss and boss.alive then
                                task.spawn(CombatService.playerAttack, player, boss)
                        end
                end)
        end
        monsters["m" .. boss.unique] = boss

        Remotes.get("BossState"):FireAllClients({
                active = true, name = def.name, hp = maxHp, maxHp = maxHp,
                zone = "Arena Timur",
        })
        for _, player in Players:GetPlayers() do
                notify(player, "BOSS RAID!", def.name .. " muncul di Arena Timur! Serang bersama untuk hadiah besar!")
        end
end

function CombatService.finishBoss()
        if not boss then
                return
        end
        local def = Balance.Boss
        local participants = {}
        local totalDmg = 0
        for player, dmg in bossCredits do
                if player.Parent then
                        table.insert(participants, { player = player, dmg = dmg })
                        totalDmg += dmg
                end
        end
        table.sort(participants, function(a, b)
                return a.dmg > b.dmg
        end)

        for rank, entry in participants do
                local share = entry.dmg / math.max(1, totalDmg)
                local coin = math.floor(def.participationCoin + share * (rng:NextInteger(def.coin[1], def.coin[2])))
                local xp = math.max(def.participationXp, math.floor(def.xp * share))
                DataService.addCoins(entry.player, coin, true)
                DataService.addXP(entry.player, xp)
                local extra = ""
                if rank == 1 then
                        DataService.addCoins(entry.player, def.topBonusCoin, true)
                        for _, drop in ipairs(def.drops) do
                                local n = rng:NextInteger(drop.min, drop.max)
                                DataService.giveItem(entry.player, "bag", drop.id, n)
                                extra = extra .. " +" .. n .. " " .. drop.id
                        end
                end
                notify(entry.player, "BOSS DIKALAHKAN!", rank == 1 and ("KAU PENYERANG TERAKHIR/TERBESAR! +" .. coin .. " koin" .. extra)
                        or ("Kontribusi " .. math.floor(share * 100) .. "% - +" .. coin .. " koin, +" .. xp .. " XP"))
                DataService.push(entry.player)
        end
        bossCredits = {}
end

local function bossLoop()
        while true do
                task.wait(5)
                local now = os.clock()
                if not boss and now >= bossNextSpawn then
                        CombatService.startBoss()
                end
                if boss and boss.alive then
                        -- despawn kalau terlalu lama tak dibunuh
                        if now - boss.spawnedAt > Balance.Boss.despawn then
                                bossCredits = {}
                                monsterDie(boss)
                                boss = nil
                                Remotes.get("BossState"):FireAllClients({ active = false, name = Balance.Boss.name })
                                Remotes.get("Notify"):FireAllClients("Boss Pergi", "Raja Golem kembali ke tanah. Hati-hati, ia akan bangkit lagi!")
                        else
                                Remotes.get("BossState"):FireAllClients({
                                        active = true, name = Balance.Boss.name,
                                        hp = math.max(0, boss.hp), maxHp = boss.maxHp,
                                        zone = "Arena Timur",
                                })
                        end
                end
                if not boss then
                        bossNextSpawn = math.max(bossNextSpawn, now + Balance.Boss.respawn)
                end
        end
end

--------------------------------------------------------------------
-- INIT
--------------------------------------------------------------------

function CombatService.spawnMonsters()
        for _, zone in ipairs(Balance.Zones) do
                for _, spec in ipairs(zone.monsters) do
                        local def = nil
                        for _, m in ipairs(Balance.Monsters) do
                                if m.id == spec.id then
                                        def = m
                                        break
                                end
                        end
                        if def then
                                for _ = 1, spec.count do
                                        spawnMonster(def, zone.id)
                                end
                        end
                end
        end
        print("[AKIOMIDA] Monster dikerahkan di 4 zona.")
end

function CombatService.init()
        local newFolder = Instance.new("Folder")
        newFolder.Name = "AKM_Monster"
        newFolder.Parent = workspace
        monsterFolder = newFolder

        Remotes.get("Attack").OnServerInvoke = function(player, monsterId)
                if type(monsterId) ~= "string" then
                        return { ok = false, msg = "Tidak valid." }
                end
                local entity = monsters[monsterId] or boss
                if not entity or not entity.alive or ("m" .. entity.unique) ~= monsterId then
                        return { ok = false, msg = "Target tidak ada." }
                end
                return CombatService.playerAttack(player, entity)
        end

        Players.PlayerRemoving:Connect(function(player)
                lastAttack[player] = nil
                bossCredits[player] = nil
        end)

        -- boss pertama muncul 6 menit setelah server hidup (biar pemain sempat latihan)
        bossNextSpawn = os.clock() + 360
        task.spawn(bossLoop)
end

return CombatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">CraftService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
        CraftService.luau - v3 "Toram-grade" profesing crafting:
          - Stasiun TEMPAA (anvil Pak Tempa): smelting balok besi/kristal,
            senjata (pedang kayu/besi/kristal), zirah (kulit/besi/kristal)
          - Stasiun DAPUR (api unggun Bu Masak): makanan buff & ramuan
          - Resep dari Balance.Recipes: objek alam -> bahan -> peralatan
          - XP craft + hook tugas (craft / cook)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Remotes)
local Balance = require(ReplicatedStorage.Shared.Balance)
local Config = require(ReplicatedStorage.Shared.Config)

local DataService = require(script.Parent.DataService)
local QuestService = require(script.Parent.QuestService)

local CraftService = {}

local STATION_TITLES = {
        tempa = "Pandai Besi - Pak Tempa",
        dapur = "Dapur Alam - Bu Masak",
}

local function nameOf(kind: string, id: string): string
        if kind == "equip" then
                for _, eq in ipairs(Balance.Equipment) do
                        if eq.id == id then
                                return eq.name
                        end
                end
        elseif kind == "use" then
                for _, u in ipairs(Balance.Usables) do
                        if u.id == id then
                                return u.name
                        end
                end
        else
                for _, res in ipairs(Config.Resources) do
                        if res.id == id then
                                return res.name
                        end
                end
                for _, crop in ipairs(Config.Crops) do
                        if crop.id == id then
                                return crop.name
                        end
                end
                for _, fish in ipairs(Config.Fish) do
                        if fish.id == id then
                                return fish.name
                        end
                end
        end
        return id
end

local function recipeLabel(r: any): string
        local parts = {}
        for matId, count in pairs(r.recipe) do
                table.insert(parts, count .. "x " .. nameOf("bag", matId))
        end
        table.sort(parts)
        return table.concat(parts, " + ")
end

-- label resep untuk client (satu kali saja, dipasangkan via provider)
local recipeLabels: { [string]: string } = {}
for _, r in ipairs(Balance.Recipes) do
        recipeLabels[r.id] = recipeLabel(r)
end

--------------------------------------------------------------------
-- JALANKAN RESEP
--------------------------------------------------------------------

local function onCraft(player: Player, recipeId: any)
        if not DataService.has(player) or type(recipeId) ~= "string" then
                return { ok = false, msg = "Permintaan tidak valid." }
        end
        local recipe = nil
        for _, r in ipairs(Balance.Recipes) do
                if r.id == recipeId then
                        recipe = r
                        break
                end
        end
        if not recipe then
                return { ok = false, msg = "Resep tidak dikenal." }
        end
        if DataService.levelOf(player) < recipe.level then
                return { ok = false, msg = "Butuh level " .. recipe.level .. " untuk resep ini." }
        end
        -- cek bahan
        for matId, count in pairs(recipe.recipe) do
                if DataService.countItem(player, "bag", matId) < count then
                        return { ok = false, msg = "Bahan kurang: " .. nameOf("bag", matId) .. " x" .. count }
                end
        end
        -- potong bahan
        for matId, count in pairs(recipe.recipe) do
                DataService.takeItem(player, "bag", matId, count)
        end
        DataService.giveItem(player, recipe.kind, recipe.out, recipe.count)
        DataService.addXP(player, recipe.xp)

        local hook = recipe.station == "tempa" and "craft" or "cook"
        QuestService.progress(player, hook, 1)

        DataService.push(player)
        return {
                ok = true,
                msg = recipe.count .. "x " .. nameOf(recipe.kind, recipe.out) .. " selesai! (+" .. recipe.xp .. " XP)",
        }
end

--------------------------------------------------------------------
-- STASIUN DI DUNIA
--------------------------------------------------------------------

function CraftService.bindStation(prompt: ProximityPrompt, station: string)
        prompt.ActionText = "Buat"
        prompt.ObjectText = STATION_TITLES[station] or "Stasiun"
        prompt.MaxActivationDistance = 11
        prompt.HoldDuration = 0
        prompt.Triggered:Connect(function(player)
                if DataService.has(player) then
                        Remotes.get("OpenCraft"):FireClient(player, station)
                end
        end)
end

-- daftar resep per stasiun untuk snapshot client
function CraftService.recipesFor(station: string)
        local out = {}
        for _, r in ipairs(Balance.Recipes) do
                if r.station == station then
                        table.insert(out, {
                                id = r.id,
                                out = r.out,
                                kind = r.kind,
                                name = nameOf(r.kind, r.out),
                                label = recipeLabels[r.id],
                                level = r.level,
                                xp = r.xp,
                                count = r.count,
                        })
                end
        end
        table.sort(out, function(a, b)
                return a.level < b.level
        end)
        return out
end

function CraftService.init()
        Remotes.get("Craft").OnServerInvoke = onCraft
        DataService.registerProvider("recipes", function()
                return {
                        tempa = CraftService.recipesFor("tempa"),
                        dapur = CraftService.recipesFor("dapur"),
                }
        end)
end

return CraftService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
        DataService.luau - data pemain v2 "Ekonomi Hidup":
        koin, XP, bibit, hasil panen, sumber daya, ikan, alat, peliharaan.
        DataStore + autosave + snapshot state untuk client.
]]

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)
local Remotes = require(ReplicatedStorage.Remotes)

local DataService = {}

local store = DataStoreService:GetDataStore(Config.Data.StoreName)

local sessions: { [Player]: { data: { [string]: any }, dirty: boolean, fallback: boolean } } = {}

-- provider state tambahan dari layanan lain (didftar lewat init, tanpa siklus require)
local providers: { [string]: (Player) -> any } = {}

function DataService.registerProvider(name: string, fn: (Player) -> any)
        providers[name] = fn
end

-- kind -> nama tabel inventaris
local KIND_FIELD = {
        seed = "Seeds",
        crop = "Crops",
        bag = "Bag",
        fish = "Fish",
        equip = "Equips", -- v3: senjata & zirah tempaan
        use = "Usables", -- v3: makanan & ramuan
}

function DataService.kindField(kind: string): string?
        return KIND_FIELD[kind]
end

local function defaultData(): { [string]: any }
        return {
                Coins = Config.Economy.StartCoins,
                XP = 0,
                Seeds = Util.deepCopy(Config.Economy.StartSeeds),
                Crops = {},
                Bag = {},
                Fish = {},
                Tools = { pickTier = 1, can = false, rod = false, bike = false },
                Pets = {},
                ActivePet = "",
                -- v3: Toram-grade progression
                Stats = { str = 0, vit = 0, agi = 0, int = 0, dex = 0 },
                StatPoints = 0, -- poin gratis dari naik level
                Equips = {},
                Usables = {},
                Equipped = { weapon = "", armor = "" },
                Buff = { kind = "", expiry = 0 },
                Quest = { id = "", prog = 0, acceptedAt = 0, done = false },
                TotalEarned = 0,
                LastLoginDay = 0,
                Dev = false,
                LastSeen = 0,
        }
end

local function sanitizeCount(v: any): number
        return math.max(0, math.floor(tonumber(v) or 0))
end

local function sanitize(raw: any): { [string]: any }
        local out = defaultData()
        if type(raw) ~= "table" then
                return out
        end
        out.Coins = sanitizeCount(raw.Coins)
        out.XP = sanitizeCount(raw.XP)
        for kind, field in KIND_FIELD do
                if type(raw[field]) == "table" then
                        out[field] = {} -- timpa default supaya inventaris lama dihormati
                        for id, count in raw[field] do
                                if type(id) == "string" then
                                        out[field][id] = sanitizeCount(count)
                                end
                        end
                end
        end
        if type(raw.Tools) == "table" then
                out.Tools.pickTier = math.clamp(math.floor(tonumber(raw.Tools.pickTier) or 1), 1, 3)
                out.Tools.can = raw.Tools.can == true
                out.Tools.rod = raw.Tools.rod == true
                out.Tools.bike = raw.Tools.bike == true
        end
        if type(raw.Pets) == "table" then
                for id, owned in raw.Pets do
                        if type(id) == "string" and owned == true then
                                out.Pets[id] = true
                        end
                end
        end
        -- v3: stat & poin
        if type(raw.Stats) == "table" then
                for _, key in { "str", "vit", "agi", "int", "dex" } do
                        out.Stats[key] = math.clamp(math.floor(tonumber(raw.Stats[key]) or 0), 0, 60)
                end
        end
        out.StatPoints = math.clamp(math.floor(tonumber(raw.StatPoints) or 0), 0, 400)
        if type(raw.Equipped) == "table" then
                out.Equipped.weapon = type(raw.Equipped.weapon) == "string" and raw.Equipped.weapon or ""
                out.Equipped.armor = type(raw.Equipped.armor) == "string" and raw.Equipped.armor or ""
        end
        if type(raw.Buff) == "table" then
                out.Buff.kind = type(raw.Buff.kind) == "string" and raw.Buff.kind or ""
                out.Buff.expiry = math.floor(tonumber(raw.Buff.expiry) or 0)
        end
        if type(raw.Quest) == "table" then
                out.Quest.id = type(raw.Quest.id) == "string" and raw.Quest.id or ""
                out.Quest.prog = sanitizeCount(raw.Quest.prog)
                out.Quest.acceptedAt = sanitizeCount(raw.Quest.acceptedAt)
                out.Quest.done = raw.Quest.done == true
        end
        out.ActivePet = type(raw.ActivePet) == "string" and raw.ActivePet or ""
        out.TotalEarned = sanitizeCount(raw.TotalEarned)
        out.LastLoginDay = sanitizeCount(raw.LastLoginDay)
        out.Dev = raw.Dev == true
        out.LastSeen = tonumber(raw.LastSeen) or 0
        return out
end

function DataService.get(player: Player): { [string]: any }
        local s = sessions[player]
        return s and s.data or defaultData()
end

function DataService.has(player: Player): boolean
        return sessions[player] ~= nil
end

function DataService.markDirty(player: Player)
        local s = sessions[player]
        if s then
                s.dirty = true
        end
end

function DataService.levelOf(player: Player): number
        return Config.Level.levelFromXp(DataService.get(player).XP)
end

--------------------------------------------------------------------
-- PERUBAHAN EKONOMI
--------------------------------------------------------------------

function DataService.addCoins(player: Player, amount: number, countAsEarned: boolean?)
        local data = DataService.get(player)
        data.Coins = math.max(0, math.floor(data.Coins + amount))
        if countAsEarned and amount > 0 then
                data.TotalEarned += math.floor(amount)
        end
        DataService.markDirty(player)
end

function DataService.spend(player: Player, amount: number): boolean
        local data = DataService.get(player)
        if data.Coins < amount then
                return false
        end
        data.Coins -= amount
        DataService.markDirty(player)
        return true
end

function DataService.addXP(player: Player, amount: number)
        local data = DataService.get(player)
        local before = Config.Level.levelFromXp(data.XP)
        data.XP = math.max(0, math.floor(data.XP + amount))
        local after = Config.Level.levelFromXp(data.XP)
        if after > before then
                -- v3: naik level memberi poin stat gratis (gaya Toram)
                data.StatPoints += (after - before) * Config.Level.StatPointsPerLevel
        end
        DataService.markDirty(player)
end

function DataService.giveItem(player: Player, kind: string, id: string, count: number)
        local field = KIND_FIELD[kind]
        if not field then
                return
        end
        local data = DataService.get(player)
        data[field][id] = (data[field][id] or 0) + count
        if data[field][id] <= 0 then
                data[field][id] = nil
        end
        DataService.markDirty(player)
end

function DataService.takeItem(player: Player, kind: string, id: string, count: number): boolean
        local field = KIND_FIELD[kind]
        if not field then
                return false
        end
        local data = DataService.get(player)
        local have = data[field][id] or 0
        if have < count then
                return false
        end
        data[field][id] = have - count
        if data[field][id] <= 0 then
                data[field][id] = nil
        end
        DataService.markDirty(player)
        return true
end

function DataService.countItem(player: Player, kind: string, id: string): number
        local field = KIND_FIELD[kind]
        if not field then
                return 0
        end
        local data = DataService.get(player)
        return data[field][id] or 0
end

--------------------------------------------------------------------
-- SNAPSHOT STATE -> CLIENT
--------------------------------------------------------------------

function DataService.push(player: Player)
        if not DataService.has(player) then
                return
        end
        local data = DataService.get(player)

        -- sinkronkan leaderstats Roblox (Koin + XP)
        local stats = player:FindFirstChild("leaderstats")
        if stats then
                local koin = stats:FindFirstChild("Koin")
                if koin and koin:IsA("IntValue") then
                        koin.Value = math.floor(data.Coins)
                end
                local xp = stats:FindFirstChild("XP")
                if xp and xp:IsA("IntValue") then
                        xp.Value = math.floor(data.XP)
                end
        end

        -- snapshot dari provider lain (FarmService = ladang, ShopService = pasar)
        local okPlot, plotState = pcall(function()
                local fn = providers["plot"]
                if not fn then
                        return { claimed = false, tiles = {} }
                end
                return fn(player)
        end)
        local okDemand, demand = pcall(function()
                local fn = providers["demand"]
                if not fn then
                        return {}
                end
                return fn(player)
        end)

        local level = Config.Level.levelFromXp(data.XP)
        local prev = Config.Level.thresholdOf(level)
        local next = Config.Level.thresholdOf(level + 1)
        local pct = (data.XP - prev) / math.max(1, next - prev)

        Remotes.get("StateSync"):FireClient(player, {
                Coins = math.floor(data.Coins),
                XP = math.floor(data.XP),
                Level = level,
                LevelPct = math.clamp(pct, 0, 1),
                Seeds = Util.deepCopy(data.Seeds),
                Crops = Util.deepCopy(data.Crops),
                Bag = Util.deepCopy(data.Bag),
                Fish = Util.deepCopy(data.Fish),
                Tools = Util.deepCopy(data.Tools),
                Pets = Util.deepCopy(data.Pets),
                ActivePet = data.ActivePet,
                -- v3
                Stats = Util.deepCopy(data.Stats),
                StatPoints = data.StatPoints,
                Equips = Util.deepCopy(data.Equips),
                Usables = Util.deepCopy(data.Usables),
                Equipped = Util.deepCopy(data.Equipped),
                Buff = Util.deepCopy(data.Buff),
                Quest = Util.deepCopy(data.Quest),
                Plot = okPlot and plotState or { claimed = false, tiles = {} },
                Demand = okDemand and demand or {},
                Dev = data.Dev,
        })
end

--------------------------------------------------------------------
-- LOAD / SAVE / LOOPS
--------------------------------------------------------------------

function DataService.load(player: Player): boolean
        local key = "p_" .. player.UserId
        local ok, raw = Util.retry(Config.Data.LoadRetries, function()
                return store:GetAsync(key)
        end)
        if not ok then
                return false
        end
        sessions[player] = { data = sanitize(raw), dirty = false, fallback = false }
        return true
end

--- Sesi cadangan (memori saja) saat DataStore tidak tersedia,
--- supaya pemain tetap bisa bermain tanpa di-kick.
function DataService.startSession(player: Player)
        if sessions[player] then
                return
        end
        sessions[player] = { data = defaultData(), dirty = false, fallback = true }
end

function DataService.save(player: Player): boolean
        local s = sessions[player]
        if not s then
                return false
        end
        if s.fallback then
                return false -- sesi memori: tidak ada tempat menyimpan
        end
        s.data.LastSeen = os.time()
        local ok = Util.retry(Config.Data.LoadRetries, function()
                store:SetAsync("p_" .. player.UserId, s.data)
        end)
        if ok then
                s.dirty = false
        end
        return ok
end

function DataService.startLoops()
        task.spawn(function()
                while true do
                        task.wait(Config.Data.AutosaveInterval)
                        for player, s in sessions do
                                if s.dirty then
                                        task.spawn(DataService.save, player)
                                end
                        end
                end
        end)

        -- push state berkala (progres tanaman & harga pasar)
        task.spawn(function()
                while true do
                        task.wait(15)
                        for player in sessions do
                                task.spawn(DataService.push, player)
                        end
                end
        end)

        Players.PlayerRemoving:Connect(function(player)
                DataService.save(player)
                sessions[player] = nil
        end)

        game:BindToClose(function()
                for player in sessions do
                        DataService.save(player)
                end
        end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">DevCodeVault</string>
            <string name="Source"><![CDATA[--!strict
--[[
	DevCodeVault.luau
	SERVER-ONLY: kode penjelajah (dev) milik owner AKIOMIDA.
	Jangan pernah pindahkan nilai ini ke Shared/ReplicatedStorage -
	client tidak boleh bisa membacanya saat runtime.
]]

local DevCodeVault = {}

-- Kode internal pemilik dunia. Diverifikasi hanya di QuizService (server).
DevCodeVault.CODE = "CKZhwbrsRLjms6Da5h"

return DevCodeVault
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">EquipService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	EquipService.luau - v3 "Toram-grade":
	  - Pakai/lepas senjata & zirah tempaan
	  - Terapkan stat ke humanoid: HP (VIT), laju lari (AGI/bike)
	  - Visual senjata kayu (pedang original dari part) di tangan
	  - Makan makanan (buff laju) & ramuan (pulihkan HP)
	  - Bagi poin stat (STR/VIT/AGI/INT/DEX)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Remotes)
local Balance = require(ReplicatedStorage.Shared.Balance)

local DataService = require(script.Parent.DataService)

local EquipService = {}

local equipById: { [string]: any } = {}
for _, eq in ipairs(Balance.Equipment) do
	equipById[eq.id] = eq
end
local usableById: { [string]: any } = {}
for _, u in ipairs(Balance.Usables) do
	usableById[u.id] = u
end

--------------------------------------------------------------------
-- STAT READERS
--------------------------------------------------------------------

function EquipService.statsOf(player: Player)
	local data = DataService.get(player)
	return data.Stats or { str = 0, vit = 0, agi = 0, int = 0, dex = 0 }
end

function EquipService.weaponAtk(player: Player): number
	local data = DataService.get(player)
	local id = data.Equipped.weapon
	if id == "" then
		return 0
	end
	local eq = equipById[id]
	return eq and eq.atk or 0
end

function EquipService.armorDef(player: Player): number
	local data = DataService.get(player)
	local id = data.Equipped.armor
	if id == "" then
		return 0
	end
	local eq = equipById[id]
	return eq and eq.def or 0
end

--------------------------------------------------------------------
-- TERAPKAN KE HUMANOID
--------------------------------------------------------------------

local function buildWeaponTool(equipId: string): Tool
	local eq = equipById[equipId]
	local color = Color3.fromRGB(eq.color[1], eq.color[2], eq.color[3])

	local tool = Instance.new("Tool")
	tool.Name = eq.name
	tool.RequiresHandle = true
	tool.CanBeDropped = false
	tool.ToolTip = "ATK +" .. eq.atk

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.5, 5.2, 0.5)
	handle.Color = color
	handle.Material = Enum.Material.Metal
	handle.CanCollide = false
	handle.Parent = tool

	-- gagang kayu di bawah bilah
	local grip = Instance.new("Part")
	grip.Name = "Grip"
	grip.Size = Vector3.new(0.6, 2, 0.6)
	grip.Color = Color3.fromRGB(105, 74, 46)
	grip.Material = Enum.Material.Wood
	grip.CanCollide = false
	local weld = Instance.new("Weld")
	weld.Part0 = handle
	weld.Part1 = grip
	weld.C0 = CFrame.new(0, -2.4, 0)
	grip.Parent = tool
	weld.Parent = handle

	-- pelindung tangan
	local guard = Instance.new("Part")
	guard.Name = "Guard"
	guard.Size = Vector3.new(1.6, 0.4, 1.6)
	guard.Color = Color3.fromRGB(255, 209, 102)
	guard.Material = Enum.Material.Metal
	guard.CanCollide = false
	local weld2 = Instance.new("Weld")
	weld2.Part0 = handle
	weld2.Part1 = guard
	weld2.C0 = CFrame.new(0, 0.6, 0)
	guard.Parent = tool
	weld2.Parent = handle

	if eq.kind == "weapon" and eq.atk >= 26 then
		-- pedang kristal: kilau neon tipis
		local glow = Instance.new("PointLight")
		glow.Color = color
		glow.Range = 8
		glow.Brightness = 0.8
		glow.Parent = handle
	end

	return tool
end

--- Terapkan HP/laju + beri visual senjata sesuai data.
function EquipService.apply(player: Player)
	local character = player.Character
	if not character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local data = DataService.get(player)
	local stats = EquipService.statsOf(player)

	local maxHp = Balance.maxHp(stats.vit)
	humanoid.MaxHealth = maxHp
	if humanoid.Health > maxHp then
		humanoid.Health = maxHp
	end

	local speed = Balance.walkSpeed(stats.agi)
	if data.Tools.bike then
		speed = math.max(speed, 26)
	end
	-- buff makanan: laju
	if data.Buff.kind == "speed" and os.time() < (data.Buff.expiry or 0) then
		speed = speed * (1 + 0.12)
	end
	humanoid.WalkSpeed = speed

	-- visual senjata: hapus lama, beri baru
	local backpack = player:FindFirstChild("Backpack")
	if backpack then
		local old = backpack:FindFirstChild("AKM_Senjata")
		if old then
			old:Destroy()
		end
	end
	local carried = character:FindFirstChild("AKM_Senjata")
	if carried then
		carried:Destroy()
	end
	local weaponId = data.Equipped.weapon
	if weaponId ~= "" and equipById[weaponId] and backpack then
		local tool = buildWeaponTool(weaponId)
		tool.Name = "AKM_Senjata"
		tool.ToolTip = equipById[weaponId].name
		tool.Parent = backpack
	end
end

--------------------------------------------------------------------
-- PAKAI / LEPAS PERALATAN
--------------------------------------------------------------------

local function onEquip(player: Player, kind: any, id: any)
	if not DataService.has(player) or type(kind) ~= "string" or type(id) ~= "string" then
		return { ok = false, msg = "Permintaan tidak valid." }
	end
	local data = DataService.get(player)
	if id ~= "" then
		local eq = equipById[id]
		if not eq or eq.kind ~= kind then
			return { ok = false, msg = "Peralatan tidak dikenal." }
		end
		if (data.Equips[id] or 0) <= 0 then
			return { ok = false, msg = "Kamu belum punya " .. eq.name .. ". Tempa di Pak Tempa!" }
		end
		if DataService.levelOf(player) < eq.level then
			return { ok = false, msg = "Butuh level " .. eq.level .. " untuk memakai " .. eq.name .. "." }
		end
		data.Equipped[kind] = id
		EquipService.apply(player)
		DataService.markDirty(player)
		DataService.push(player)
		return { ok = true, msg = eq.name .. " dipakai! " .. (kind == "weapon" and ("ATK +" .. eq.atk) or ("DEF +" .. eq.def)) }
	else
		-- lepas
		if data.Equipped[kind] == "" then
			return { ok = false, msg = "Tidak ada yang dilepas." }
		end
		data.Equipped[kind] = ""
		EquipService.apply(player)
		DataService.markDirty(player)
		DataService.push(player)
		return { ok = true, msg = "Peralatan dilepas." }
	end
end

--------------------------------------------------------------------
-- MAKAN / RAMUAN
--------------------------------------------------------------------

local function onUseItem(player: Player, id: any)
	if not DataService.has(player) or type(id) ~= "string" then
		return { ok = false, msg = "Permintaan tidak valid." }
	end
	local data = DataService.get(player)
	if (data.Usables[id] or 0) <= 0 then
		return { ok = false, msg = "Kamu tidak punya barang itu." }
	end
	local u = usableById[id]
	if not u then
		return { ok = false, msg = "Item tidak dikenal." }
	end
	DataService.takeItem(player, "use", id, 1)

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if u.effect == "heal" and humanoid then
		local boost = 1 + EquipService.statsOf(player).int * 0.01 -- INT memperkuat ramuan
		local heal = math.floor(humanoid.MaxHealth * math.min(1, u.power * boost))
		humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + heal)
		DataService.push(player)
		return { ok = true, msg = u.name .. " dimakan! HP +" .. heal }
	elseif u.effect == "speed" then
		data.Buff = { kind = "speed", expiry = os.time() + u.duration }
		DataService.markDirty(player)
		EquipService.apply(player)
		DataService.push(player)
		return { ok = true, msg = u.name .. " dimakan! Lari +12% selama " .. math.floor(u.duration / 60) .. " menit." }
	end
	DataService.push(player)
	return { ok = true, msg = u.name .. " dimakan." }
end

--------------------------------------------------------------------
-- POIN STAT
--------------------------------------------------------------------

local function onAllocStat(player: Player, statId: any)
	if not DataService.has(player) or type(statId) ~= "string" then
		return { ok = false, msg = "Permintaan tidak valid." }
	end
	local valid = false
	for _, s in ipairs(Balance.Stats) do
		if s.id == statId then
			valid = true
			break
		end
	end
	if not valid then
		return { ok = false, msg = "Stat tidak dikenal." }
	end
	local data = DataService.get(player)
	if data.StatPoints <= 0 then
		return { ok = false, msg = "Poin stat habis. Naik level untuk lebih banyak poin!" }
	end
	if data.Stats[statId] >= Balance.MaxStatPerStat then
		return { ok = false, msg = "Atribut ini sudah maksimum (60)." }
	end
	data.StatPoints -= 1
	data.Stats[statId] += 1
	DataService.markDirty(player)
	EquipService.apply(player)
	DataService.push(player)
	return { ok = true, msg = "Poin diterapkan!" }
end

--------------------------------------------------------------------
-- INIT
--------------------------------------------------------------------

function EquipService.init()
	Remotes.get("Equip").OnServerInvoke = onEquip
	Remotes.get("UseItem").OnServerInvoke = onUseItem
	Remotes.get("AllocStat").OnServerInvoke = onAllocStat

	-- respawn: terapkan ulang stat & senjata
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			task.wait(0.4)
			if DataService.has(player) then
				EquipService.apply(player)
			end
		end)
	end)
	for _, player in Players:GetPlayers() do
		player.CharacterAdded:Connect(function()
			task.wait(0.4)
			if DataService.has(player) then
				EquipService.apply(player)
			end
		end)
	end
end

return EquipService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">FarmService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
        FarmService.luau - jantung ekonomi: ladang pribadi pemain.
        Alur Grow a Garden ala Dunia Akiomida:
          klaim ladang -> beli bibit -> tanam -> (siram) -> tumbuh (nyata waktu,
          tetap tumbuh saat pemain menjelajah) -> panen -> jual di pasar.
        Server-authoritative: semua waktu & validasi di server.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Remotes)
local Util = require(ReplicatedStorage.Shared.Util)

local DataService = require(script.Parent.DataService)
local QuestService = require(script.Parent.QuestService)

local FarmService = {}

local PLOT_COUNT = 6
local GRID = 4 -- petak 4x4
local TILE_SIZE = 5
local FENCE_HALF = 13

local cropById: { [string]: any } = {}
for _, crop in ipairs(Config.Crops) do
        cropById[crop.id] = crop
end

local plots: { [number]: any } = {}
local worldFolder: Folder? = nil

local function world(): Folder
        local f = worldFolder
        if not f then
                f = workspace:FindFirstChild("AKM_Dunia") :: Folder?
                if not f then
                        f = Instance.new("Folder")
                        f.Name = "AKM_Dunia"
                        f.Parent = workspace
                end
                worldFolder = f
        end
        return f :: Folder
end

local function part(props): Part
        local p = Instance.new("Part")
        p.Anchored = true
        p.TopSurface = Enum.SurfaceType.Smooth
        p.BottomSurface = Enum.SurfaceType.Smooth
        for k, v in props do
                (p :: any)[k] = v
        end
        p.Parent = world()
        return p
end

--------------------------------------------------------------------
-- VISUAL TANAMAN (3 tahap + siap panen)
--------------------------------------------------------------------

local function destroyPlant(tile)
        if tile.plant then
                tile.plant:Destroy()
                tile.plant = nil
        end
end

--- bucket: 0 = biji, 1 = kecambah, 2 = tumbuh, 3 = siap panen
local function buildPlantVisual(tile, bucket: number)
        destroyPlant(tile)
        local crop = cropById[tile.seed]
        if not crop then
                return
        end
        local base = tile.part.Position
        local ground = base + Vector3.new(0, tile.part.Size.Y / 2, 0)
        local model = Instance.new("Model")
        model.Name = "Tanaman_" .. tile.seed

        local fruitColor = Color3.fromRGB(crop.color[1], crop.color[2], crop.color[3])

        if bucket == 0 then
                part({
                        Name = "Biji",
                        Size = Vector3.new(1.4, 0.5, 1.4),
                        CFrame = CFrame.new(ground + Vector3.new(0, 0.25, 0)),
                        Color = Color3.fromRGB(122, 88, 56),
                        Material = Enum.Material.Ground,
                        CanCollide = false,
                }).Parent = model
        elseif bucket == 1 then
                part({
                        Name = "Kecambah",
                        Size = Vector3.new(0.5, 1.6, 0.5),
                        CFrame = CFrame.new(ground + Vector3.new(0, 0.8, 0)),
                        Color = Color3.fromRGB(120, 200, 90),
                        Material = Enum.Material.Grass,
                        CanCollide = false,
                }).Parent = model
        elseif bucket == 2 then
                part({
                        Name = "Batang",
                        Size = Vector3.new(0.6, 2.6, 0.6),
                        CFrame = CFrame.new(ground + Vector3.new(0, 1.3, 0)),
                        Color = Color3.fromRGB(96, 170, 80),
                        Material = Enum.Material.Grass,
                        CanCollide = false,
                }).Parent = model
                part({
                        Name = "Daun1",
                        Shape = Enum.PartType.Ball,
                        Size = Vector3.new(1.8, 1.1, 1.8),
                        CFrame = CFrame.new(ground + Vector3.new(0.7, 2.0, 0.2)),
                        Color = Color3.fromRGB(110, 195, 90),
                        Material = Enum.Material.Grass,
                        CanCollide = false,
                }).Parent = model
                part({
                        Name = "Daun2",
                        Shape = Enum.PartType.Ball,
                        Size = Vector3.new(1.6, 1.0, 1.6),
                        CFrame = CFrame.new(ground + Vector3.new(-0.7, 1.7, -0.2)),
                        Color = Color3.fromRGB(110, 195, 90),
                        Material = Enum.Material.Grass,
                        CanCollide = false,
                }).Parent = model
        else
                local scale = 1
                if tile.seed == "labu" or tile.seed == "bintang" then
                        scale = 1.5
                end
                part({
                        Name = "Batang",
                        Size = Vector3.new(0.7, 3.2, 0.7),
                        CFrame = CFrame.new(ground + Vector3.new(0, 1.6, 0)),
                        Color = Color3.fromRGB(90, 160, 75),
                        Material = Enum.Material.Grass,
                        CanCollide = false,
                }).Parent = model
                part({
                        Name = "Buah",
                        Shape = Enum.PartType.Ball,
                        Size = Vector3.new(2.4, 2.4, 2.4) * scale,
                        CFrame = CFrame.new(ground + Vector3.new(0, 2.6 + scale * 0.4, 0)),
                        Color = fruitColor,
                        Material = Enum.Material.SmoothPlastic,
                        CanCollide = false,
                }).Parent = model
                local glow = Instance.new("PointLight")
                glow.Color = fruitColor
                glow.Range = 8
                glow.Brightness = 1.2
                glow.Parent = model.Buah
        end

        model.Parent = tile.part
        tile.plant = model
end

--------------------------------------------------------------------
-- PROMPT & STATE PETAK
--------------------------------------------------------------------

local function updateTilePrompt(tile)
        local prompt = tile.prompt
        if not prompt then
                return
        end
        local plot = plots[tile.plotIndex]
        local owner = plot and plot.owner

        if not owner then
                prompt.Enabled = false
                return
        end

        if tile.state == "empty" then
                prompt.ActionText = "Tanam Bibit"
                prompt.ObjectText = "Petak Ladang"
                prompt.HoldDuration = 0
                prompt.Enabled = true
        elseif tile.state == "growing" then
                local data = DataService.get(owner)
                local canWater = data.Tools.can and not tile.watered
                if canWater then
                        prompt.ActionText = "Siram"
                        prompt.ObjectText = tile.seed .. " tumbuh"
                        prompt.HoldDuration = 0.4
                        prompt.Enabled = true
                else
                        prompt.Enabled = false
                end
        elseif tile.state == "ready" then
                prompt.ActionText = "Panen"
                prompt.ObjectText = cropById[tile.seed] and cropById[tile.seed].name or "Hasil"
                prompt.HoldDuration = 0
                prompt.Enabled = true
        end
end

local function onTileTriggered(player: Player, tile)
        local plot = plots[tile.plotIndex]
        if not plot or plot.owner ~= player or not DataService.has(player) then
                return
        end

        if tile.state == "empty" then
                Remotes.get("OpenPlant"):FireClient(player, tile.plotIndex, tile.tileIndex)
        elseif tile.state == "growing" then
                local data = DataService.get(player)
                if not data.Tools.can then
                        Remotes.get("Notify"):FireClient(player, "Butuh Alat", "Kamu butuh Kaleng Siram - beli di Toko Alat.")
                        return
                end
                if tile.watered then
                        return
                end
                tile.watered = true
                tile.plantedAt -= tile.growTime * Config.Economy.WaterBoost
                Remotes.get("Notify"):FireClient(player, "Disiram!", "Tanamanmu tumbuh 25% lebih cepat.")
                DataService.addXP(player, 2)
                DataService.push(player)
        elseif tile.state == "ready" then
                local crop = cropById[tile.seed]
                if not crop then
                        return
                end
                DataService.giveItem(player, "crop", crop.id, 1)
                DataService.addXP(player, 4)
                QuestService.progress(player, "harvest", 1)
                tile.state = "empty"
                tile.seed = nil
                tile.plantedAt = 0
                tile.growTime = 0
                tile.watered = false
                tile.bucket = -1
                destroyPlant(tile)
                updateTilePrompt(tile)
                DataService.push(player)
        end
end

--------------------------------------------------------------------
-- KLAIM LADANG
--------------------------------------------------------------------

local function updateSign(plot)
        local signText = plot.signText
        if not signText then
                return
        end
        if plot.owner then
                signText.Text = "LADANG " .. plot.index .. " - MILIK " .. string.upper(plot.owner.DisplayName)
                plot.claimPrompt.Enabled = false
        else
                signText.Text = "LADANG " .. plot.index .. " - AMBIL ALIH (GRATIS)"
                plot.claimPrompt.Enabled = true
        end
end

local function onClaimTriggered(player: Player, plot)
        if plot.owner then
                if plot.owner == player then
                        Remotes.get("Notify"):FireClient(player, "Ladangmu", "Ini sudah ladang milikmu. Tanami bibit di petak!")
                end
                return
        end
        plot.owner = player
        updateSign(plot)
        for _, tile in plot.tiles do
                updateTilePrompt(tile)
        end
        Remotes.get("Notify"):FireClient(player, "Ladang Baru!",
                "Ladang " .. plot.index .. " jadi milikmu! Beli bibit di Toko Bibit (Pasar Timur), lalu dekati petak tanah untuk menanam.")
        DataService.push(player)
end

--------------------------------------------------------------------
-- BANGUN LADANG (dipanggil MapService)
--------------------------------------------------------------------

function FarmService.buildPlot(index: number, center: Vector3)
        local plot = {
                index = index,
                center = center,
                owner = nil,
                tiles = {},
        }

        part({
                Name = "LadangDasar_" .. index,
                Size = Vector3.new(26, 1, 26),
                CFrame = CFrame.new(center),
                Color = Color3.fromRGB(124, 94, 62),
                Material = Enum.Material.Ground,
        })

        -- pagar: 4 tiang + 4 palang
        local offsets = { Vector3.new(FENCE_HALF, 0, FENCE_HALF), Vector3.new(-FENCE_HALF, 0, FENCE_HALF),
                Vector3.new(FENCE_HALF, 0, -FENCE_HALF), Vector3.new(-FENCE_HALF, 0, -FENCE_HALF) }
        for i, off in offsets do
                part({
                        Name = "PagarTiang_" .. index .. "_" .. i,
                        Size = Vector3.new(1.1, 3.4, 1.1),
                        CFrame = CFrame.new(center + off + Vector3.new(0, 1.7, 0)),
                        Color = Color3.fromRGB(140, 100, 62),
                        Material = Enum.Material.WoodPlanks,
                })
        end
        -- palang utara-selatan & timur-barat sederhana
        for _, cfg in {
                { off = Vector3.new(FENCE_HALF, 0, 0), size = Vector3.new(0.7, 0.7, FENCE_HALF * 2) },
                { off = Vector3.new(-FENCE_HALF, 0, 0), size = Vector3.new(0.7, 0.7, FENCE_HALF * 2) },
                { off = Vector3.new(0, 0, FENCE_HALF), size = Vector3.new(FENCE_HALF * 2, 0.7, 0.7) },
                { off = Vector3.new(0, 0, -FENCE_HALF), size = Vector3.new(FENCE_HALF * 2, 0.7, 0.7) },
        } do
                part({
                        Name = "PagarPalang_" .. index,
                        Size = cfg.size,
                        CFrame = CFrame.new(center + cfg.off + Vector3.new(0, 1.9, 0)),
                        Color = Color3.fromRGB(140, 100, 62),
                        Material = Enum.Material.WoodPlanks,
                })
        end

        -- papan klaim
        local board = part({
                Name = "LadangPapan_" .. index,
                Size = Vector3.new(11, 2.6, 0.5),
                CFrame = CFrame.new(center + Vector3.new(0, 3.4, FENCE_HALF + 1)) * CFrame.Angles(0, math.rad(180), 0),
                Color = Color3.fromRGB(92, 62, 38),
                Material = Enum.Material.WoodPlanks,
        })
        part({
                Name = "LadangPapanTiang_" .. index,
                Size = Vector3.new(0.6, 3.4, 0.6),
                CFrame = CFrame.new(center + Vector3.new(0, 1.7, FENCE_HALF + 1)),
                Color = Color3.fromRGB(92, 62, 38),
                Material = Enum.Material.WoodPlanks,
        })

        local gui = Instance.new("SurfaceGui")
        gui.Face = Enum.NormalId.Front
        gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
        gui.PixelsPerStud = 50
        gui.Parent = board
        local signText = Util.create("TextLabel", {
                Size = UDim2.fromScale(1, 1),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBlack,
                TextScaled = true,
                TextColor3 = Color3.fromRGB(255, 209, 102),
                Text = "LADANG " .. index,
        }, gui)

        local claimPrompt = Instance.new("ProximityPrompt")
        claimPrompt.ActionText = "Ambil Alih Ladang"
        claimPrompt.ObjectText = "Ladang " .. index .. " (gratis)"
        claimPrompt.MaxActivationDistance = 12
        claimPrompt.HoldDuration = 0.3
        claimPrompt.Parent = board
        claimPrompt.Triggered:Connect(function(player)
                onClaimTriggered(player, plot)
        end)

        -- 4x4 petak tanah
        local tiles = {}
        for row = 1, GRID do
                for col = 1, GRID do
                        local tileIndex = (row - 1) * GRID + col
                        local ox = -(GRID - 1) * TILE_SIZE / 2 + (col - 1) * TILE_SIZE
                        local oz = -(GRID - 1) * TILE_SIZE / 2 + (row - 1) * TILE_SIZE
                        local tilePart = part({
                                Name = "Petak_" .. index .. "_" .. tileIndex,
                                Size = Vector3.new(4.4, 0.5, 4.4),
                                CFrame = CFrame.new(center + Vector3.new(ox, 0.75, oz)),
                                Color = Color3.fromRGB(96, 66, 42),
                                Material = Enum.Material.Ground,
                        })

                        local prompt = Instance.new("ProximityPrompt")
                        prompt.ActionText = "Tanam Bibit"
                        prompt.ObjectText = "Petak Ladang"
                        prompt.MaxActivationDistance = 8
                        prompt.HoldDuration = 0
                        prompt.Enabled = false
                        prompt.RequiresLineOfSight = false
                        prompt.Parent = tilePart

                        local tile = {
                                part = tilePart,
                                prompt = prompt,
                                plotIndex = index,
                                tileIndex = tileIndex,
                                state = "empty",
                                seed = nil,
                                plantedAt = 0,
                                growTime = 0,
                                watered = false,
                                bucket = -1,
                                plant = nil,
                        }
                        prompt.Triggered:Connect(function(player)
                                onTileTriggered(player, tile)
                        end)
                        tiles[tileIndex] = tile
                end
        end

        plot.tiles = tiles
        plot.signText = signText
        plot.claimPrompt = claimPrompt
        plots[index] = plot
        updateSign(plot)
        return plot
end

--------------------------------------------------------------------
-- TANAM (RemoteFunction dari panel pilih bibit)
--------------------------------------------------------------------

local function onPlantSeed(player: Player, plotIndex: any, tileIndex: any, seedId: any)
        if not DataService.has(player) then
                return { ok = false, msg = "Data belum siap." }
        end
        if type(plotIndex) ~= "number" or type(tileIndex) ~= "number" or type(seedId) ~= "string" then
                return { ok = false, msg = "Permintaan tidak valid." }
        end
        local plot = plots[math.floor(plotIndex)]
        local tile = plot and plot.tiles[math.floor(tileIndex)]
        if not plot or not tile or plot.owner ~= player then
                return { ok = false, msg = "Petak tidak tersedia." }
        end
        if tile.state ~= "empty" then
                return { ok = false, msg = "Petak sudah ditanami." }
        end
        local crop = cropById[seedId]
        if not crop then
                return { ok = false, msg = "Bibit tidak dikenal." }
        end
        if DataService.levelOf(player) < crop.level then
                return { ok = false, msg = "Butuh level " .. crop.level .. " untuk bibit ini." }
        end
        if not DataService.takeItem(player, "seed", seedId, 1) then
                return { ok = false, msg = "Bibit habis. Beli lagi di Toko Bibit!" }
        end

        tile.state = "growing"
        tile.seed = seedId
        tile.plantedAt = time()
        tile.growTime = crop.grow
        tile.watered = false
        tile.bucket = 0
        buildPlantVisual(tile, 0)
        updateTilePrompt(tile)
        DataService.addXP(player, 2)
        DataService.push(player)
        return { ok = true, msg = crop.name .. " ditanam! Kembali setelah ±" .. crop.grow .. " detik." }
end

--------------------------------------------------------------------
-- LOOP PERTUMBUHAN
--------------------------------------------------------------------

function FarmService.startLoop()
        task.spawn(function()
                while true do
                        task.wait(2)
                        for _, plot in plots do
                                if not plot.owner then
                                        continue
                                end
                                for _, tile in plot.tiles do
                                        if tile.state ~= "growing" then
                                                continue
                                        end
                                        local progress = (time() - tile.plantedAt) / math.max(1, tile.growTime)
                                        if progress >= 1 then
                                                tile.state = "ready"
                                                buildPlantVisual(tile, 3)
                                                updateTilePrompt(tile)
                                        else
                                                local bucket = math.floor(progress * 3) -- 0..2
                                                if bucket ~= tile.bucket then
                                                        tile.bucket = bucket
                                                        buildPlantVisual(tile, bucket)
                                                end
                                                local prompt = tile.prompt
                                                if prompt and not prompt.Enabled then
                                                        updateTilePrompt(tile) -- misal pemain baru saja beli kaleng siram
                                                end
                                        end
                                end
                        end
                end
        end)
end

--------------------------------------------------------------------
-- STATE & PEMBERSIHAN
--------------------------------------------------------------------

function FarmService.getPlotState(player: Player)
        for _, plot in plots do
                if plot.owner == player then
                        local tilesOut = {}
                        for i, tile in plot.tiles do
                                local entry: any = { state = tile.state }
                                if tile.state ~= "empty" then
                                        entry.seed = tile.seed
                                        entry.watered = tile.watered
                                        if tile.state == "growing" then
                                                entry.remain = math.max(0, math.ceil(tile.growTime - (time() - tile.plantedAt)))
                                        end
                                end
                                tilesOut[i] = entry
                        end
                        return { claimed = true, index = plot.index, tiles = tilesOut }
                end
        end
        return { claimed = false, tiles = {} }
end

--- Pemain keluar: hasil siap panen otomatis masuk tas,
--- tanaman yang masih tumbuh hangus (ladang dibebaskan).
function FarmService.releasePlot(player: Player)
        for _, plot in plots do
                if plot.owner == player then
                        local harvested = 0
                        for _, tile in plot.tiles do
                                if tile.state == "ready" and tile.seed then
                                        DataService.giveItem(player, "crop", tile.seed, 1)
                                        harvested += 1
                                end
                                tile.state = "empty"
                                tile.seed = nil
                                tile.plantedAt = 0
                                tile.growTime = 0
                                tile.watered = false
                                tile.bucket = -1
                                destroyPlant(tile)
                                updateTilePrompt(tile)
                        end
                        if harvested > 0 then
                                Remotes.get("Notify"):FireClient(player, "Panen Otomatis",
                                        harvested .. " hasil siap panen otomatis masuk tas sebelum kamu pergi.")
                        end
                        plot.owner = nil
                        updateSign(plot)
                end
        end
end

--------------------------------------------------------------------
-- INIT
--------------------------------------------------------------------

function FarmService.init()
        Remotes.get("PlantSeed").OnServerInvoke = onPlantSeed
        -- daftarkan snapshot ladang ke DataService (tanpa siklus require)
        DataService.registerProvider("plot", function(p)
                return FarmService.getPlotState(p)
        end)
end

return FarmService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">GatherService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
        GatherService.luau - aktivitas mengumpulkan sumber daya:
          Hutan Kayu   : tebang pohon -> Kayu (+Apel keberuntungan)
          Tambang Selatan : tambang Batu (belik lv1), Besi (lv2), Kristal (lv3)
          Danau Tenang : memancing (butuh Pancing Ajaib)
        Semua node respawn otomatis supaya dunia tetap hidup.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Remotes)

local DataService = require(script.Parent.DataService)
local QuestService = require(script.Parent.QuestService)

local GatherService = {}

local RESPAWN_TREE = 90
local RESPAWN_ROCK = 120
local FISH_COOLDOWN = 4

local resourceById: { [string]: any } = {}
for _, res in ipairs(Config.Resources) do
        resourceById[res.id] = res
end
local fishById: { [string]: any } = {}
for _, fish in ipairs(Config.Fish) do
        fishById[fish.id] = fish
end

-- tier bijih: batu=1, besi=2, kristal=3 (butuh belik setingkat itu)
local ROCK_TIER: { [string]: number } = { batu = 1, besi = 2, kristal = 3 }

local fishCooldown: { [Player]: number } = {}

local function world(): Folder
        local f = workspace:FindFirstChild("AKM_Dunia")
        if not f then
                f = Instance.new("Folder")
                f.Name = "AKM_Dunia"
                f.Parent = workspace
        end
        return f :: Folder
end

local function part(props): Part
        local p = Instance.new("Part")
        p.Anchored = true
        p.TopSurface = Enum.SurfaceType.Smooth
        p.BottomSurface = Enum.SurfaceType.Smooth
        for k, v in props do
                (p :: any)[k] = v
        end
        p.Parent = world()
        return p
end

local function notify(player: Player, title: string, text: string)
        Remotes.get("Notify"):FireClient(player, title, text)
end

--------------------------------------------------------------------
-- TEbang POHON
--------------------------------------------------------------------

function GatherService.buildTree(position: Vector3, seed: number?)
        local rng = Random.new(seed or tick() * 1000)
        local trunkH = rng:NextNumber(8, 12)
        local parts = {}

        local trunk = part({
                Name = "PohonBatang",
                Size = Vector3.new(2, trunkH, 2),
                CFrame = CFrame.new(position + Vector3.new(0, trunkH / 2, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0),
                Color = Color3.fromRGB(105, 74, 46),
                Material = Enum.Material.Wood,
        })
        table.insert(parts, trunk)

        for i = 1, 3 do
                local canopy = part({
                        Name = "PohonDaun" .. i,
                        Shape = Enum.PartType.Ball,
                        Size = Vector3.new(1, 1, 1) * rng:NextNumber(6, 9),
                        CFrame = CFrame.new(position + Vector3.new(rng:NextNumber(-1.6, 1.6), trunkH + rng:NextNumber(-1, 2.4), rng:NextNumber(-1.6, 1.6))),
                        Color = Color3.fromRGB(rng:NextInteger(52, 84), rng:NextInteger(140, 175), rng:NextInteger(74, 100)),
                        Material = Enum.Material.Grass,
                })
                table.insert(parts, canopy)
        end

        local prompt = Instance.new("ProximityPrompt")
        prompt.ActionText = "Tebang"
        prompt.ObjectText = "Pohon Kayu"
        prompt.MaxActivationDistance = 10
        prompt.HoldDuration = 1
        prompt.Parent = trunk

        local node = { alive = true, parts = parts, prompt = prompt }

        prompt.Triggered:Connect(function(player)
                if not node.alive or not DataService.has(player) then
                        return
                end
                node.alive = false
                local amount = rng:NextInteger(1, 2)
                DataService.giveItem(player, "bag", "kayu", amount)
                DataService.addXP(player, 3)
                QuestService.progress(player, "chop", 1)
                if rng:NextNumber() < 0.2 then
                        DataService.giveItem(player, "bag", "apel", 1)
                        notify(player, "Keberuntungan!", "Apel jatuh dari pohon! +" .. amount .. " Kayu, +1 Apel")
                else
                        notify(player, "Menebang", "+" .. amount .. " Kayu")
                end
                DataService.push(player)

                for _, p in parts do
                        p.Transparency = 1
                        p.CanCollide = false
                end
                prompt.Enabled = false
                task.delay(RESPAWN_TREE, function()
                        for _, p in parts do
                                p.Transparency = 0
                                p.CanCollide = true
                        end
                        node.alive = true
                        prompt.Enabled = true
                end)
        end)
end

--------------------------------------------------------------------
-- TAMBAANG BIJIH
--------------------------------------------------------------------

local function rockVisual(position: Vector3, tier: number, seed: number)
        local rng = Random.new(seed)
        local parts = {}

        local baseColor
        local material
        if tier == 1 then
                baseColor = Color3.fromRGB(120, 120, 125)
                material = Enum.Material.Slate
        elseif tier == 2 then
                baseColor = Color3.fromRGB(158, 108, 78)
                material = Enum.Material.Rock
        else
                baseColor = Color3.fromRGB(105, 88, 150)
                material = Enum.Material.Slate
        end

        local main = part({
                Name = "BatuUtan",
                Shape = Enum.PartType.Ball,
                Size = Vector3.new(1, 1, 1) * rng:NextNumber(4.5, 6.5),
                CFrame = CFrame.new(position + Vector3.new(0, 1.6, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi), math.rad(rng:NextNumber(-8, 8))),
                Color = baseColor,
                Material = material,
        })
        table.insert(parts, main)

        if tier >= 2 then
                local oreColor = tier == 2 and Color3.fromRGB(230, 160, 90) or Color3.fromRGB(190, 120, 255)
                for i = 1, tier + 1 do
                        local ore = part({
                                Name = "Bijih" .. i,
                                Size = Vector3.new(rng:NextNumber(0.9, 1.6), rng:NextNumber(0.9, 1.6), rng:NextNumber(0.9, 1.6)),
                                CFrame = CFrame.new(position + Vector3.new(rng:NextNumber(-1.8, 1.8), rng:NextNumber(1.4, 3), rng:NextNumber(-1.8, 1.8)))
                                        * CFrame.Angles(rng:NextNumber(0, math.pi), rng:NextNumber(0, math.pi), 0),
                                Color = oreColor,
                                Material = tier == 3 and Enum.Material.Neon or Enum.Material.CorrodedMetal,
                        })
                        table.insert(parts, ore)
                end
        end
        return parts
end

function GatherService.buildRock(position: Vector3, resourceId: string, seed: number?)
        local tier = ROCK_TIER[resourceId] or 1
        local rng = Random.new(seed or tick() * 1000)
        local parts = rockVisual(position, tier, rng:NextInteger(1, 1e6))

        local res = resourceById[resourceId]
        local prompt = Instance.new("ProximityPrompt")
        prompt.ActionText = "Tambang " .. (res and res.name or resourceId)
        prompt.ObjectText = tier == 1 and "Batu Biasa" or (tier == 2 and "Bijih Besi" or "Kristal Langka")
        prompt.MaxActivationDistance = 10
        prompt.HoldDuration = tier == 3 and 2 or 1.2
        prompt.Parent = parts[1]

        local node = { alive = true, parts = parts, prompt = prompt }

        prompt.Triggered:Connect(function(player)
                if not node.alive or not DataService.has(player) then
                        return
                end
                local data = DataService.get(player)
                if data.Tools.pickTier < tier then
                        notify(player, "Belik Kurang Bagus",
                                tier == 2 and "Butuh Belik Batu dari Toko Alat untuk menambang Besi."
                                        or "Butuh Belik Baja dari Toko Alat untuk menambang Kristal.")
                        return
                end
                node.alive = false
                local amount = rng:NextInteger(1, tier == 1 and 2 or 1)
                DataService.giveItem(player, "bag", resourceId, amount)
                DataService.addXP(player, 4)
                QuestService.progress(player, "mine", 1)
                notify(player, "Menambang", "+" .. amount .. " " .. (res and res.name or resourceId))
                DataService.push(player)

                for _, p in parts do
                        p.Transparency = 1
                        p.CanCollide = false
                end
                prompt.Enabled = false
                task.delay(RESPAWN_ROCK, function()
                        for _, p in parts do
                                p.Transparency = 0
                                p.CanCollide = true
                        end
                        node.alive = true
                        prompt.Enabled = true
                end)
        end)
end

--------------------------------------------------------------------
-- MEMANCING
--------------------------------------------------------------------

function GatherService.buildPier(basePosition: Vector3, direction: Vector3)
        -- dermaga: papan jalan ke danau + tiang
        local planks = part({
                Name = "DermagaPapan",
                Size = Vector3.new(14, 0.5, 4),
                CFrame = CFrame.new(basePosition + Vector3.new(0, 1.2, 0)) * CFrame.Angles(0, math.atan2(direction.X, direction.Z) + math.rad(90), 0),
                Color = Color3.fromRGB(146, 106, 66),
                Material = Enum.Material.WoodPlanks,
        })
        for i = -1, 1 do
                part({
                        Name = "DermagaTiang" .. i,
                        Size = Vector3.new(0.8, 3, 0.8),
                        CFrame = CFrame.new(basePosition + Vector3.new(i * 5.5, 0.4, 0) - direction * 0),
                        Color = Color3.fromRGB(110, 80, 50),
                        Material = Enum.Material.Wood,
                })
        end

        local prompt = Instance.new("ProximityPrompt")
        prompt.ActionText = "Pancing Ikan"
        prompt.ObjectText = "Danau Tenang"
        prompt.MaxActivationDistance = 10
        prompt.HoldDuration = 2.5 -- merasakan tarikan pancing...
        prompt.Parent = planks

        prompt.Triggered:Connect(function(player)
                if not DataService.has(player) then
                        return
                end
                local now = time()
                if fishCooldown[player] and now - fishCooldown[player] < FISH_COOLDOWN then
                        return
                end
                fishCooldown[player] = now

                local data = DataService.get(player)
                if not data.Tools.rod then
                        notify(player, "Butuh Pancing", "Beli Pancing Ajaib di Toko Alat (Pasar Timur) untuk memancing.")
                        return
                end

                local roll = math.random()
                local acc = 0
                local caught = Config.Fish[#Config.Fish]
                for _, fish in Config.Fish do
                        acc += fish.chance
                        if roll <= acc then
                                caught = fish
                                break
                        end
                end

                DataService.giveItem(player, "fish", caught.id, 1)
                DataService.addXP(player, 5)
                if caught.id ~= "sepatu" then
                        QuestService.progress(player, "fish", 1)
                end
                if caught.id == "sepatu" then
                        notify(player, "Tidak Nyangka...", "Kamu menarik Sepatu Bot Tua?! Tetap dijual saja.")
                else
                        notify(player, "Dapat Ikan!", "+" .. caught.name .. " - jual di Pasar!")
                end
                DataService.push(player)
        end)
end

function GatherService.init()
        local Players = game:GetService("Players")
        Players.PlayerRemoving:Connect(function(player)
                fishCooldown[player] = nil
        end)
end

return GatherService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
        LeaderboardService.luau - Top XP global (OrderedDataStore) + papan fisik.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Remotes)
local DataService = require(script.Parent.DataService)
local Util = require(ReplicatedStorage.Shared.Util)

local LeaderboardService = {}

local orderedStore = DataStoreService:GetOrderedDataStore(Config.Data.OrderedStoreName)
local latestRows: { { name: string, value: number } } = {}
local boards: { SurfaceGui } = {}

local function buildBoard(position: Vector3, lookAt: Vector3)
        local part = Util.create("Part", {
                Name = "PapanPenjelajah",
                Size = Vector3.new(16, 10, 1),
                Anchored = true,
                Material = Enum.Material.SmoothPlastic,
                Color = Color3.fromRGB(25, 28, 38),
                CFrame = CFrame.lookAt(position, lookAt),
        }, workspace)

        local gui = Util.create("SurfaceGui", {
                Face = Enum.NormalId.Front,
                SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
                PixelsPerStud = 50,
        }, part)

        Util.create("TextLabel", {
                Size = UDim2.fromScale(1, 0.18),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBlack,
                TextScaled = true,
                TextColor3 = Color3.fromRGB(255, 209, 102),
                Text = "PAPAN JUARA DUNIA (XP)",
        }, gui)

        local list = Util.create("Frame", {
                Position = UDim2.fromScale(0.05, 0.22),
                Size = UDim2.fromScale(0.9, 0.74),
                BackgroundTransparency = 1,
        }, gui)
        Util.create("UIListLayout", { Padding = UDim.new(0.02, 0) }, list)

        for i = 1, Config.Leaderboard.Size do
                Util.create("TextLabel", {
                        Name = "Row" .. i,
                        Size = UDim2.fromScale(1, 0.09),
                        BackgroundTransparency = 1,
                        Font = Enum.Font.GothamBold,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        TextScaled = true,
                        TextColor3 = i == 1 and Color3.fromRGB(255, 215, 0) or Color3.fromRGB(230, 230, 240),
                        Text = i .. ". -",
                }, list)
        end
        table.insert(boards, gui)
end

local function renderRows()
        for _, gui in boards do
                local list = gui:FindFirstChildOfClass("Frame")
                if not list then
                        continue
                end
                for i = 1, Config.Leaderboard.Size do
                        local row = list:FindFirstChild("Row" .. i)
                        if not row then
                                continue
                        end
                        local entry = latestRows[i]
                        local rowLabel = row :: TextLabel
                        rowLabel.Text = entry and (i .. ". " .. entry.name .. " - " .. Util.formatNumber(entry.value) .. " XP")
                                or (i .. ". -")
                end
        end
end

local function refresh()
        for _, player in Players:GetPlayers() do
                if DataService.has(player) then
                        local data = DataService.get(player)
                        pcall(function()
                                orderedStore:SetAsync(tostring(player.UserId), math.floor(data.XP))
                        end)
                end
        end

        local ok, pages = pcall(function()
                return orderedStore:GetSortedAsync(false, Config.Leaderboard.Size)
        end)
        if not ok or not pages then
                return
        end
        local rows: { { name: string, value: number } } = {}
        for rank, entry in pages:GetCurrentPage() do
                local name = "Penjelajah " .. entry.key
                local online = Players:GetPlayerByUserId(tonumber(entry.key) or 0)
                if online then
                        name = online.DisplayName
                else
                        local okName, fetched = pcall(Players.GetNameFromUserIdAsync, Players, tonumber(entry.key) or 0)
                        if okName and fetched then
                                name = fetched
                        end
                end
                rows[rank] = { name = name, value = entry.value }
        end
        latestRows = rows
        renderRows()
end

function LeaderboardService.init()
        Remotes.get("GetLeaderboard").OnServerInvoke = function()
                return latestRows
        end

        buildBoard(Vector3.new(-14, 8, -14), Vector3.new(0, 7, 24))
        buildBoard(Vector3.new(14, 8, -14), Vector3.new(0, 7, 24))

        task.spawn(function()
                task.wait(5)
                while true do
                        refresh()
                        task.wait(Config.Leaderboard.RefreshInterval)
                end
        end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">MapService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
        MapService.luau - DUNIA AKIOMIDA v2 (dunia petualangan ekonomi)
        Tata kota pulau 640x640, semuanya original & prosedural:
          Alun-alun pusat : air mancur, gerbang judul, papan juara, Kak Pintar
          Pasar Timur     : Toko Bibit, Pasar Pengepul, Toko Alat, Toko Peliharaan
          Ladang Utara    : 6 ladang pribadi 4x4 petak (klaim gratis)
          Hutan Barat     : pohon bisa ditebang (kayu, apel)
          Tambang Selatan : batu / besi / kristal (butuh belik makin bagus)
          Danau Tenang    : dermaga memancing
        Jalan penghubung, lampu jalan, bangku, bunga, awan, perbukitan.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)

local MapService = {}

local folder = Instance.new("Folder")
folder.Name = "AKM_Dunia"

local function part(props): Part
        local p = Instance.new("Part")
        p.Anchored = true
        p.TopSurface = Enum.SurfaceType.Smooth
        p.BottomSurface = Enum.SurfaceType.Smooth
        for k, v in props do
                (p :: any)[k] = v
        end
        p.Parent = folder
        return p
end

--------------------------------------------------------------------
-- DEKORASI DASAR
--------------------------------------------------------------------

local function buildLamp(position: Vector3)
        part({
                Name = "LampuTiang",
                Size = Vector3.new(0.7, 9, 0.7),
                CFrame = CFrame.new(position + Vector3.new(0, 4.5, 0)),
                Color = Color3.fromRGB(52, 56, 70),
                Material = Enum.Material.Metal,
        })
        local head = part({
                Name = "LampuKepala",
                Shape = Enum.PartType.Ball,
                Size = Vector3.new(1.7, 1.7, 1.7),
                CFrame = CFrame.new(position + Vector3.new(0, 9.4, 0)),
                Color = Color3.fromRGB(255, 226, 160),
                Material = Enum.Material.Neon,
        })
        local light = Instance.new("PointLight")
        light.Color = Color3.fromRGB(255, 214, 150)
        light.Range = 20
        light.Brightness = 1.1
        light.Parent = head
end

local function buildSign(text: string, position: Vector3, yawDeg: number, color: Color3?)
        local c = color or Color3.fromRGB(92, 62, 38)
        part({
                Name = "PapanTiang",
                Size = Vector3.new(0.7, 4.4, 0.7),
                CFrame = CFrame.new(position + Vector3.new(0, 2.2, 0)),
                Color = c,
                Material = Enum.Material.WoodPlanks,
        })
        local board = part({
                Name = "PapanTulisan",
                Size = Vector3.new(10, 2.6, 0.6),
                CFrame = CFrame.new(position + Vector3.new(0, 5.2, 0)) * CFrame.Angles(0, math.rad(yawDeg), 0),
                Color = c,
                Material = Enum.Material.WoodPlanks,
        })
        local gui = Instance.new("SurfaceGui")
        gui.Face = Enum.NormalId.Front
        gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
        gui.PixelsPerStud = 50
        gui.Parent = board
        Util.create("TextLabel", {
                Size = UDim2.fromScale(1, 1),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBlack,
                TextScaled = true,
                TextColor3 = Color3.fromRGB(255, 226, 150),
                Text = text,
        }, board)
        return board
end

local function buildBench(position: Vector3, yawDeg: number)
        local base = CFrame.new(position) * CFrame.Angles(0, math.rad(yawDeg), 0)
        part({
                Name = "BangkuDuduk",
                Size = Vector3.new(4.4, 0.8, 1.8),
                CFrame = base * CFrame.new(0, 1.1, 0),
                Color = Color3.fromRGB(150, 108, 66),
                Material = Enum.Material.WoodPlanks,
        })
        part({
                Name = "BangkuSandaran",
                Size = Vector3.new(4.4, 1.6, 0.5),
                CFrame = base * CFrame.new(0, 2.2, -0.7),
                Color = Color3.fromRGB(150, 108, 66),
                Material = Enum.Material.WoodPlanks,
        })
end

--------------------------------------------------------------------
-- NPC (karya original: tubuh kotak + kepala bulat + topi)
--------------------------------------------------------------------

local function buildNPC(name: string, position: Vector3, color: Color3): ProximityPrompt
        part({
                Name = "NPC_Badan_" .. name,
                Size = Vector3.new(2.4, 3.2, 1.7),
                CFrame = CFrame.new(position + Vector3.new(0, 1.9, 0)),
                Color = color,
                Material = Enum.Material.SmoothPlastic,
        })
        local head = part({
                Name = "NPC_Kepala_" .. name,
                Shape = Enum.PartType.Ball,
                Size = Vector3.new(2, 2, 2),
                CFrame = CFrame.new(position + Vector3.new(0, 4.5, 0)),
                Color = Color3.fromRGB(255, 224, 189),
                Material = Enum.Material.SmoothPlastic,
        })
        part({
                Name = "NPC_Topi_" .. name,
                Size = Vector3.new(2.6, 0.7, 2.6),
                CFrame = CFrame.new(position + Vector3.new(0, 5.7, 0)),
                Color = color:Lerp(Color3.new(0, 0, 0), 0.3),
                Material = Enum.Material.SmoothPlastic,
        })

        local billboard = Instance.new("BillboardGui")
        billboard.Size = UDim2.new(0, 160, 0, 36)
        billboard.StudsOffset = Vector3.new(0, 1.4, 0)
        billboard.AlwaysOnTop = true
        billboard.MaxDistance = 70
        billboard.Parent = head
        Util.create("TextLabel", {
                Size = UDim2.fromScale(1, 1),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBlack,
                TextScaled = true,
                TextColor3 = color,
                TextStrokeTransparency = 0.4,
                Text = name,
        }, billboard)

        local prompt = Instance.new("ProximityPrompt")
        prompt.MaxActivationDistance = 11
        prompt.HoldDuration = 0
        prompt.Parent = head
        return prompt
end

--------------------------------------------------------------------
-- GEDUNG TOKO (pasar timur, menghadap barat ke alun-alun)
--------------------------------------------------------------------

local function buildShop(position: Vector3, wallColor: Color3, roofColor: Color3, title: string)
        local x, y, z = position.X, position.Y, position.Z
        -- bangunan utama
        part({
                Name = "Toko_Badan",
                Size = Vector3.new(14, 9, 13),
                CFrame = CFrame.new(x, y + 4.5, z),
                Color = wallColor,
                Material = Enum.Material.Brick,
        })
        -- atap
        part({
                Name = "Toko_Atap",
                Size = Vector3.new(16.5, 1.3, 15.5),
                CFrame = CFrame.new(x, y + 9.6, z),
                Color = roofColor,
                Material = Enum.Material.Slate,
        })
        -- papan nama (menghadap barat)
        local sign = part({
                Name = "Toko_PapanNama",
                Size = Vector3.new(0.5, 2.6, 11),
                CFrame = CFrame.new(x - 7.3, y + 7.6, z),
                Color = Color3.fromRGB(34, 38, 52),
                Material = Enum.Material.SmoothPlastic,
        })
        local gui = Instance.new("SurfaceGui")
        gui.Face = Enum.NormalId.Left
        gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
        gui.PixelsPerStud = 50
        gui.Parent = sign
        Util.create("TextLabel", {
                Size = UDim2.fromScale(1, 1),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBlack,
                TextScaled = true,
                TextColor3 = wallColor:Lerp(Color3.new(1, 1, 1), 0.55),
                Text = string.upper(title),
        }, sign)
        -- jendela neon
        part({
                Name = "Toko_Jendela",
                Size = Vector3.new(0.4, 2.2, 8),
                CFrame = CFrame.new(x - 7.2, y + 3.4, z),
                Color = Color3.fromRGB(255, 236, 170),
                Material = Enum.Material.Neon,
        })
        -- peti & karung dekorasi
        part({
                Name = "Toko_Peti1",
                Size = Vector3.new(2.4, 2.4, 2.4),
                CFrame = CFrame.new(x - 9.5, y + 1.2, z + 7.5) * CFrame.Angles(0, math.rad(18), 0),
                Color = Color3.fromRGB(150, 108, 66),
                Material = Enum.Material.WoodPlanks,
        })
        part({
                Name = "Toko_Peti2",
                Size = Vector3.new(2, 2, 2),
                CFrame = CFrame.new(x - 9.3, y + 3.4, z + 7.4) * CFrame.Angles(0, math.rad(-24), 0),
                Color = Color3.fromRGB(164, 120, 74),
                Material = Enum.Material.WoodPlanks,
        })
end

--------------------------------------------------------------------
-- ZONA PUSAT
--------------------------------------------------------------------

local function buildPlaza()
        -- air mancur
        part({
                Name = "MancurBak",
                Shape = Enum.PartType.Cylinder,
                Size = Vector3.new(2, 17, 17),
                CFrame = CFrame.new(0, 1, 0) * CFrame.Angles(0, 0, math.rad(90)),
                Color = Color3.fromRGB(208, 200, 186),
                Material = Enum.Material.Marble,
        })
        part({
                Name = "MancurAir",
                Shape = Enum.PartType.Cylinder,
                Size = Vector3.new(1.2, 13.4, 13.4),
                CFrame = CFrame.new(0, 2.1, 0) * CFrame.Angles(0, 0, math.rad(90)),
                Color = Color3.fromRGB(90, 170, 220),
                Material = Enum.Material.Glass,
                Transparency = 0.25,
                CanCollide = false,
        })
        part({
                Name = "MancurTiang",
                Size = Vector3.new(2.6, 5, 2.6),
                CFrame = CFrame.new(0, 4.6, 0),
                Color = Color3.fromRGB(208, 200, 186),
                Material = Enum.Material.Marble,
        })
        local orb = part({
                Name = "MancurBola",
                Shape = Enum.PartType.Ball,
                Size = Vector3.new(2.6, 2.6, 2.6),
                CFrame = CFrame.new(0, 8.2, 0),
                Color = Color3.fromRGB(255, 209, 102),
                Material = Enum.Material.Neon,
        })
        local light = Instance.new("PointLight")
        light.Color = Color3.fromRGB(255, 209, 102)
        light.Range = 28
        light.Brightness = 1.4
        light.Parent = orb

        -- gerbang judul di spawn (z = 34)
        for side = -1, 1, 2 do
                part({
                        Name = "GerbangPilar" .. side,
                        Size = Vector3.new(2.2, 14, 2.2),
                        CFrame = CFrame.new(side * 8, 7, 34),
                        Color = Color3.fromRGB(70, 74, 92),
                        Material = Enum.Material.SmoothPlastic,
                })
        end
        local beam = part({
                Name = "GerbangPalang",
                Size = Vector3.new(20, 3.2, 1.8),
                CFrame = CFrame.new(0, 15.2, 34),
                Color = Color3.fromRGB(34, 38, 52),
                Material = Enum.Material.SmoothPlastic,
        })
        local gui = Instance.new("SurfaceGui")
        gui.Face = Enum.NormalId.Front
        gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
        gui.PixelsPerStud = 50
        gui.Parent = beam
        Util.create("TextLabel", {
                Size = UDim2.fromScale(1, 1),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBlack,
                TextScaled = true,
                TextColor3 = Color3.fromRGB(255, 209, 102),
                Text = "DUNIA AKIOMIDA",
        }, gui)

        -- bangku mengelilingi air mancur
        local benchSpots = {
                { pos = Vector3.new(11.5, 0, 11.5), yaw = 135 },
                { pos = Vector3.new(-11.5, 0, 11.5), yaw = 45 },
                { pos = Vector3.new(11.5, 0, -11.5), yaw = 45 },
                { pos = Vector3.new(-11.5, 0, -11.5), yaw = 135 },
        }
        for _, spot in benchSpots do
                buildBench(spot.pos, spot.yaw)
        end

        -- lampu alun-alun
        for _, pos in {
                Vector3.new(16, 0, 16), Vector3.new(-16, 0, 16), Vector3.new(16, 0, -16), Vector3.new(-16, 0, -16),
        } do
                buildLamp(pos)
        end

        -- bunga warna-warni di alun-alun
        local rng = Random.new(1234)
        local flowerColors = {
                Color3.fromRGB(255, 120, 150), Color3.fromRGB(255, 210, 90),
                Color3.fromRGB(150, 200, 255), Color3.fromRGB(200, 140, 255),
        }
        for i = 1, 14 do
                local angle = rng:NextNumber(0, math.pi * 2)
                local dist = rng:NextNumber(9, 17)
                part({
                        Name = "Bunga" .. i,
                        Shape = Enum.PartType.Ball,
                        Size = Vector3.new(1, 1, 1) * rng:NextNumber(0.8, 1.5),
                        CFrame = CFrame.new(math.cos(angle) * dist, 0.6, math.sin(angle) * dist),
                        Color = flowerColors[rng:NextInteger(1, #flowerColors)],
                        Material = Enum.Material.Grass,
                        CanCollide = false,
                })
        end
end

--------------------------------------------------------------------
-- BUILD ALL
--------------------------------------------------------------------

function MapService.init(svc)
        folder.Parent = workspace

        ---------------------------------------------------------------- pulau & langit
        part({
                Name = "Pulau",
                Size = Vector3.new(640, 8, 640),
                CFrame = CFrame.new(0, -4, 0),
                Color = Color3.fromRGB(105, 168, 90),
                Material = Enum.Material.Grass,
        })
        part({
                Name = "Samudra",
                Size = Vector3.new(2600, 2, 2600),
                CFrame = CFrame.new(0, -3, 0),
                Color = Color3.fromRGB(48, 118, 180),
                Material = Enum.Material.Glass,
                Transparency = 0.2,
        })

        -- atmosfer cerah (bukan kabut kelabu!)
        local atmo = Instance.new("Atmosphere")
        atmo.Density = 0.14
        atmo.Offset = 0.2
        atmo.Color = Color3.fromRGB(205, 215, 235)
        atmo.Glare = 0.15
        atmo.Haze = 0.8
        atmo.Parent = game:GetService("Lighting")

        -- perbukitan cakrawala
        local rngBukit = Random.new(88)
        for i = 1, 10 do
                local angle = (i / 10) * math.pi * 2
                local dist = 285 + rngBukit:NextNumber(-15, 15)
                local h = rngBukit:NextNumber(24, 42)
                part({
                        Name = "Bukit" .. i,
                        Shape = Enum.PartType.Cylinder,
                        Size = Vector3.new(h, rngBukit:NextNumber(90, 130), rngBukit:NextNumber(90, 130)),
                        CFrame = CFrame.new(math.cos(angle) * dist, h / 2 - 8, math.sin(angle) * dist)
                                * CFrame.Angles(0, 0, math.rad(90)),
                        Color = Color3.fromRGB(70, 120, 78):Lerp(Color3.fromRGB(50, 90, 110), rngBukit:NextNumber(0, 0.5)),
                        Material = Enum.Material.Grass,
                })
        end

        -- awan
        local rngAwan = Random.new(77)
        for i = 1, 8 do
                part({
                        Name = "Awan" .. i,
                        Shape = Enum.PartType.Ball,
                        Size = Vector3.new(1, 1, 1) * rngAwan:NextNumber(28, 56),
                        CFrame = CFrame.new(rngAwan:NextNumber(-240, 240), rngAwan:NextNumber(85, 125), rngAwan:NextNumber(-240, 240)),
                        Color = Color3.new(1, 1, 1),
                        Material = Enum.Material.SmoothPlastic,
                        Transparency = 0.35,
                        CanCollide = false,
                })
        end

        ---------------------------------------------------------------- jalan
        part({
                Name = "JalanUtara",
                Size = Vector3.new(10, 0.3, 60),
                CFrame = CFrame.new(0, 0.15, -30),
                Color = Color3.fromRGB(178, 172, 162),
                Material = Enum.Material.Concrete,
        })
        part({
                Name = "JalanSelatan",
                Size = Vector3.new(10, 0.3, 105),
                CFrame = CFrame.new(0, 0.15, 52.5),
                Color = Color3.fromRGB(178, 172, 162),
                Material = Enum.Material.Concrete,
        })
        part({
                Name = "JalanTimurBarat",
                Size = Vector3.new(280, 0.3, 10),
                CFrame = CFrame.new(0, 0.15, 0),
                Color = Color3.fromRGB(178, 172, 162),
                Material = Enum.Material.Concrete,
        })
        part({
                Name = "JalanPasar",
                Size = Vector3.new(10, 0.3, 84),
                CFrame = CFrame.new(90, 0.15, 0),
                Color = Color3.fromRGB(178, 172, 162),
                Material = Enum.Material.Concrete,
        })
        part({
                Name = "PlazaLingkaran",
                Shape = Enum.PartType.Cylinder,
                Size = Vector3.new(0.3, 38, 38),
                CFrame = CFrame.new(0, 0.28, 0) * CFrame.Angles(0, 0, math.rad(90)),
                Color = Color3.fromRGB(196, 188, 176),
                Material = Enum.Material.Granite,
        })

        -- lampu jalan
        for _, z in { -50, -25, 25, 50, 75, 100 } do
                buildLamp(Vector3.new(-6.8, 0, z))
                buildLamp(Vector3.new(6.8, 0, z))
        end
        for _, x in { -125, -100, -75, -50, 50, 75, 100, 125 } do
                buildLamp(Vector3.new(x, 0, -6.8))
                buildLamp(Vector3.new(x, 0, 6.8))
        end

        ---------------------------------------------------------------- alun-alun
        buildPlaza()

        -- Kak Pintar: kuis opsional (tidak pernah memaksa!)
        local quizPrompt = buildNPC("KAK PINTAR", Vector3.new(10, 0, 14), Color3.fromRGB(88, 200, 130))
        svc.Quiz.bindPrompt(quizPrompt)

        -- papan penunjuk arah
        buildSign("PASAR TIMUR >", Vector3.new(48, 0, 8), -90)
        buildSign("KAWASAN LADANG ^", Vector3.new(9, 0, -56), 0)
        buildSign("HUTAN KAYU <", Vector3.new(-52, 0, 8), 90)
        buildSign("TAMBANG SELATAN v", Vector3.new(9, 0, 96), 180)
        buildSign("DANAU TENANG \\", Vector3.new(-62, 0, 52), 90)

        ---------------------------------------------------------------- pasar timur (4 toko)
        local shops = {
                { id = "bibit", pos = Vector3.new(102, 0, -36), wall = Color3.fromRGB(120, 178, 110), roof = Color3.fromRGB(84, 110, 76), title = "Toko Bibit", npc = "KAK TANI", npcColor = Color3.fromRGB(120, 178, 110) },
                { id = "jual", pos = Vector3.new(102, 0, -12), wall = Color3.fromRGB(226, 168, 84), roof = Color3.fromRGB(150, 100, 50), title = "Pasar Pengepul", npc = "BU LARIS", npcColor = Color3.fromRGB(255, 209, 102) },
                { id = "alat", pos = Vector3.new(102, 0, 12), wall = Color3.fromRGB(110, 160, 210), roof = Color3.fromRGB(66, 96, 130), title = "Toko Alat", npc = "PAK BANG", npcColor = Color3.fromRGB(110, 160, 210) },
                { id = "pet", pos = Vector3.new(102, 0, 36), wall = Color3.fromRGB(224, 140, 190), roof = Color3.fromRGB(140, 84, 120), title = "Toko Peliharaan", npc = "MBAH SEKAR", npcColor = Color3.fromRGB(224, 140, 190) },
        }
        for _, shop in shops do
                buildShop(shop.pos, shop.wall, shop.roof, shop.title)
                local npcPos = shop.pos + Vector3.new(-11, 0, 0)
                local prompt = buildNPC(shop.npc, npcPos, shop.npcColor)
                svc.Shop.bindPrompt(prompt, shop.id)
        end

        ---------------------------------------------------------------- ladang utara (6 ladang)
        buildSign("KAWASAN LADANG", Vector3.new(0, 0, -64), 180, Color3.fromRGB(124, 94, 62))
        local plotSpots = {
                Vector3.new(-40, 0.5, -80), Vector3.new(0, 0.5, -80), Vector3.new(40, 0.5, -80),
                Vector3.new(-40, 0.5, -114), Vector3.new(0, 0.5, -114), Vector3.new(40, 0.5, -114),
        }
        for i, spot in plotSpots do
                svc.Farm.buildPlot(i, spot)
        end

        -- kincir angin & orang orangutan ladang (dekorasi)
        local towerX, towerZ = -24, -95
        part({
                Name = "KincirMenara",
                Size = Vector3.new(4, 18, 4),
                CFrame = CFrame.new(towerX, 9, towerZ),
                Color = Color3.fromRGB(214, 206, 192),
                Material = Enum.Material.WoodPlanks,
        })
        for blade = 1, 4 do
                part({
                        Name = "KincirBaling" .. blade,
                        Size = Vector3.new(1, 12, 0.6),
                        CFrame = CFrame.new(towerX, 19, towerZ - 2.4)
                                * CFrame.Angles(0, 0, math.rad(blade * 90)),
                        Color = Color3.fromRGB(240, 236, 226),
                        Material = Enum.Material.WoodPlanks,
                })
        end
        -- orang orangutan: tongkat + kepala + topi jerami
        part({
                Name = "OrorTongkat",
                Size = Vector3.new(0.5, 6, 0.5),
                CFrame = CFrame.new(14, 3, -95),
                Color = Color3.fromRGB(140, 100, 62),
                Material = Enum.Material.Wood,
        })
        part({
                Name = "OrorKepala",
                Shape = Enum.PartType.Ball,
                Size = Vector3.new(2.2, 2.2, 2.2),
                CFrame = CFrame.new(14, 6.6, -95),
                Color = Color3.fromRGB(255, 224, 189),
                Material = Enum.Material.SmoothPlastic,
        })
        part({
                Name = "OrorTopi",
                Shape = Enum.PartType.Cylinder,
                Size = Vector3.new(0.5, 4, 4),
                CFrame = CFrame.new(14, 8.2, -95) * CFrame.Angles(0, 0, math.rad(90)),
                Color = Color3.fromRGB(235, 205, 130),
                Material = Enum.Material.Grass,
        })

        ---------------------------------------------------------------- hutan barat
        buildSign("HUTAN KAYU", Vector3.new(-64, 0, 0), 90, Color3.fromRGB(60, 110, 70))
        local treeSpots = {
                Vector3.new(-105, 0, -55), Vector3.new(-125, 0, -60), Vector3.new(-140, 0, -45),
                Vector3.new(-112, 0, -38), Vector3.new(-132, 0, -22), Vector3.new(-145, 0, -5),
                Vector3.new(-118, 0, -14), Vector3.new(-128, 0, 18), Vector3.new(-108, 0, 25),
                Vector3.new(-142, 0, 30), Vector3.new(-122, 0, 40), Vector3.new(-98, 0, 12),
        }
        for i, spot in treeSpots do
                svc.Gather.buildTree(spot, 100 + i)
        end

        ---------------------------------------------------------------- tambang selatan
        part({
                Name = "TambangLantai",
                Shape = Enum.PartType.Cylinder,
                Size = Vector3.new(0.25, 60, 60),
                CFrame = CFrame.new(0, 0.14, 132) * CFrame.Angles(0, 0, math.rad(90)),
                Color = Color3.fromRGB(112, 112, 118),
                Material = Enum.Material.Slate,
        })
        buildSign("TAMBANG SELATAN", Vector3.new(0, 0, 108), 0, Color3.fromRGB(90, 90, 96))
        -- gerbang tambang + obor
        for side = -1, 1, 2 do
                part({
                        Name = "TambangPilar" .. side,
                        Size = Vector3.new(2.4, 10, 2.4),
                        CFrame = CFrame.new(side * 6, 5, 112),
                        Color = Color3.fromRGB(70, 70, 78),
                        Material = Enum.Material.Rock,
                })
                local torch = part({
                        Name = "TambangObor" .. side,
                        Shape = Enum.PartType.Ball,
                        Size = Vector3.new(1.4, 1.4, 1.4),
                        CFrame = CFrame.new(side * 6, 10.6, 112),
                        Color = Color3.fromRGB(255, 150, 70),
                        Material = Enum.Material.Neon,
                })
                local light = Instance.new("PointLight")
                light.Color = Color3.fromRGB(255, 150, 70)
                light.Range = 18
                light.Brightness = 1.4
                light.Parent = torch
        end
        part({
                Name = "TambangPalang",
                Size = Vector3.new(15, 2, 2),
                CFrame = CFrame.new(0, 11, 112),
                Color = Color3.fromRGB(48, 48, 56),
                Material = Enum.Material.Rock,
        })
        -- gua gelap di belakang gerbang
        part({
                Name = "TambangGua",
                Size = Vector3.new(12, 9, 6),
                CFrame = CFrame.new(0, 4.5, 118),
                Color = Color3.fromRGB(30, 30, 36),
                Material = Enum.Material.Rock,
        })

        local rocks = {
                { id = "batu", pos = Vector3.new(-14, 0, 118) },
                { id = "batu", pos = Vector3.new(12, 0, 122) },
                { id = "batu", pos = Vector3.new(-2, 0, 134) },
                { id = "besi", pos = Vector3.new(-16, 0, 142) },
                { id = "besi", pos = Vector3.new(10, 0, 146) },
                { id = "besi", pos = Vector3.new(-8, 0, 128) },
                { id = "kristal", pos = Vector3.new(8, 0, 154) },
                { id = "kristal", pos = Vector3.new(-12, 0, 152) },
        }
        for i, rock in rocks do
                svc.Gather.buildRock(rock.pos, rock.id, 200 + i)
        end

        ---------------------------------------------------------------- danau tenang
        part({
                Name = "DanauPasir",
                Shape = Enum.PartType.Cylinder,
                Size = Vector3.new(0.3, 64, 64),
                CFrame = CFrame.new(-115, 0.16, 95) * CFrame.Angles(0, 0, math.rad(90)),
                Color = Color3.fromRGB(238, 214, 160),
                Material = Enum.Material.Sand,
        })
        part({
                Name = "DanauAir",
                Shape = Enum.PartType.Cylinder,
                Size = Vector3.new(0.6, 56, 56),
                CFrame = CFrame.new(-115, 0.32, 95) * CFrame.Angles(0, 0, math.rad(90)),
                Color = Color3.fromRGB(70, 150, 200),
                Material = Enum.Material.Glass,
                Transparency = 0.3,
                CanCollide = false,
        })
        svc.Gather.buildPier(Vector3.new(-90, 0, 95), Vector3.new(-1, 0, 0))
        buildSign("DANAU TENANG", Vector3.new(-72, 0, 82), 90, Color3.fromRGB(60, 110, 130))

        ---------------------------------------------------------------- pandai besi (tempa) - timur laut pasar
        local forgeX, forgeZ = 102, -58
        part({
                Name = "TempaBadan",
                Size = Vector3.new(13, 8, 12),
                CFrame = CFrame.new(forgeX, 4, forgeZ),
                Color = Color3.fromRGB(90, 96, 110),
                Material = Enum.Material.Brick,
        })
        part({
                Name = "TempaAtap",
                Size = Vector3.new(15.5, 1.2, 14.5),
                CFrame = CFrame.new(forgeX, 8.6, forgeZ),
                Color = Color3.fromRGB(50, 54, 64),
                Material = Enum.Material.Slate,
        })
        local forgeSign = part({
                Name = "TempaPapanNama",
                Size = Vector3.new(0.5, 2.4, 10),
                CFrame = CFrame.new(forgeX - 6.8, 6.6, forgeZ),
                Color = Color3.fromRGB(34, 38, 52),
                Material = Enum.Material.SmoothPlastic,
        })
        local forgeGui = Instance.new("SurfaceGui")
        forgeGui.Face = Enum.NormalId.Left
        forgeGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
        forgeGui.PixelsPerStud = 50
        forgeGui.Parent = forgeSign
        Util.create("TextLabel", {
                Size = UDim2.fromScale(1, 1),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBlack,
                TextScaled = true,
                TextColor3 = Color3.fromRGB(255, 150, 90),
                Text = "PANDAI BESI",
        }, forgeGui)

        -- perapian (anvil) + tukul + api tempa
        local anvil = part({
                Name = "Perapian",
                Size = Vector3.new(3, 1.6, 1.6),
                CFrame = CFrame.new(forgeX - 10.5, 1.8, forgeZ) * CFrame.Angles(0, math.rad(20), 0),
                Color = Color3.fromRGB(60, 62, 72),
                Material = Enum.Material.Metal,
        })
        part({
                Name = "PerapianKaki",
                Size = Vector3.new(1.4, 1.2, 1.4),
                CFrame = CFrame.new(forgeX - 10.5, 0.6, forgeZ),
                Color = Color3.fromRGB(50, 52, 60),
                Material = Enum.Material.Metal,
        })
        local forgeFire = part({
                Name = "ApiTempa",
                Shape = Enum.PartType.Ball,
                Size = Vector3.new(1.8, 1.8, 1.8),
                CFrame = CFrame.new(forgeX - 14, 1.6, forgeZ + 4),
                Color = Color3.fromRGB(255, 130, 60),
                Material = Enum.Material.Neon,
        })
        do
                local light = Instance.new("PointLight")
                light.Color = Color3.fromRGB(255, 130, 60)
                light.Range = 16
                light.Brightness = 1.5
                light.Parent = forgeFire
        end
        local forgePrompt = buildNPC("PAK TEMPA", Vector3.new(forgeX - 14, 0, forgeZ - 3), Color3.fromRGB(255, 150, 90))
        local anvilPrompt = Instance.new("ProximityPrompt")
        anvilPrompt.Parent = anvil
        svc.Craft.bindStation(anvilPrompt, "tempa")
        -- sambungkan juga prompt NPC (dua cara akses)
        svc.Craft.bindStation(forgePrompt, "tempa")

        ---------------------------------------------------------------- dapur alam (api unggun) - tenggara alun-alun
        part({
                Name = "ApiUnggunBatu",
                Shape = Enum.PartType.Cylinder,
                Size = Vector3.new(0.8, 6, 6),
                CFrame = CFrame.new(26, 0.4, 26) * CFrame.Angles(0, 0, math.rad(90)),
                Color = Color3.fromRGB(120, 118, 124),
                Material = Enum.Material.Slate,
        })
        for i = 1, 4 do
                part({
                        Name = "ApiUnggunKayu" .. i,
                        Size = Vector3.new(0.7, 3.4, 0.7),
                        CFrame = CFrame.new(26, 1.4, 26) * CFrame.Angles(math.rad(24), math.rad(i * 90), 0) * CFrame.new(0, 1.2, 0),
                        Color = Color3.fromRGB(110, 76, 46),
                        Material = Enum.Material.Wood,
                })
        end
        local kitchenFire = part({
                Name = "ApiUnggunApi",
                Shape = Enum.PartType.Ball,
                Size = Vector3.new(2.4, 2.4, 2.4),
                CFrame = CFrame.new(26, 1.8, 26),
                Color = Color3.fromRGB(255, 160, 70),
                Material = Enum.Material.Neon,
        })
        do
                local light = Instance.new("PointLight")
                light.Color = Color3.fromRGB(255, 160, 70)
                light.Range = 18
                light.Brightness = 1.4
                light.Parent = kitchenFire
        end
        -- kuali & rak rempah
        part({
                Name = "Kuali",
                Shape = Enum.PartType.Cylinder,
                Size = Vector3.new(0.9, 3, 3),
                CFrame = CFrame.new(29, 1.1, 28) * CFrame.Angles(0, 0, math.rad(90)),
                Color = Color3.fromRGB(40, 42, 50),
                Material = Enum.Material.Metal,
        })
        buildNPC("BU MASAK", Vector3.new(23, 0, 29), Color3.fromRGB(240, 130, 150))
        local cookPrompt = buildNPC("KUALI AJAIB", Vector3.new(29, 0, 24), Color3.fromRGB(240, 130, 150))
        svc.Craft.bindStation(cookPrompt, "dapur")

        ---------------------------------------------------------------- papan tugas harian - barat laut alun-alun
        part({
                Name = "PapanTugasTiang",
                Size = Vector3.new(0.8, 6, 0.8),
                CFrame = CFrame.new(-16, 3, -18),
                Color = Color3.fromRGB(96, 66, 42),
                Material = Enum.Material.Wood,
        })
        local questBoard = part({
                Name = "PapanTugasPapan",
                Size = Vector3.new(8, 5, 0.7),
                CFrame = CFrame.new(-16, 6.4, -18) * CFrame.Angles(0, math.rad(35), 0),
                Color = Color3.fromRGB(178, 140, 90),
                Material = Enum.Material.WoodPlanks,
        })
        do
                local gui = Instance.new("SurfaceGui")
                gui.Face = Enum.NormalId.Back
                gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
                gui.PixelsPerStud = 40
                gui.Parent = questBoard
                Util.create("TextLabel", {
                        Size = UDim2.fromScale(1, 1),
                        BackgroundTransparency = 1,
                        Font = Enum.Font.GothamBlack,
                        TextScaled = true,
                        TextColor3 = Color3.fromRGB(90, 60, 30),
                        Text = "TUGAS HARIAN",
                }, gui)
        end
        buildNPC("KAK TUGAS", Vector3.new(-14, 0, -15), Color3.fromRGB(255, 209, 102))
        local questPrompt = buildNPC("PAPAN TUGAS", Vector3.new(-18, 0, -21), Color3.fromRGB(255, 209, 102))
        svc.Quest.bindBoard(questPrompt)

        ---------------------------------------------------------------- arena timur (koloseum boss)
        do
                local ax, az = 150, 92
                part({
                        Name = "ArenaLantai",
                        Shape = Enum.PartType.Cylinder,
                        Size = Vector3.new(0.3, 76, 76),
                        CFrame = CFrame.new(ax, 0.16, az) * CFrame.Angles(0, 0, math.rad(90)),
                        Color = Color3.fromRGB(196, 176, 150),
                        Material = Enum.Material.Sand,
                })
                -- dinding cincin (12 segmen)
                for i = 1, 12 do
                        local ang = (i / 12) * math.pi * 2
                        part({
                                Name = "ArenaDinding" .. i,
                                Size = Vector3.new(20, 9, 2.6),
                                CFrame = CFrame.new(ax + math.cos(ang) * 38, 4.5, az + math.sin(ang) * 38)
                                        * CFrame.Angles(0, -math.deg(ang) + 90, 0),
                                Color = Color3.fromRGB(150, 132, 110),
                                Material = Enum.Material.Slate,
                        })
                end
                -- obor arena
                for i = 1, 6 do
                        local ang = (i / 6) * math.pi * 2
                        local torch = part({
                                Name = "ArenaObor" .. i,
                                Shape = Enum.PartType.Ball,
                                Size = Vector3.new(1.6, 1.6, 1.6),
                                CFrame = CFrame.new(ax + math.cos(ang) * 32, 8.6, az + math.sin(ang) * 32),
                                Color = Color3.fromRGB(255, 140, 70),
                                Material = Enum.Material.Neon,
                        })
                        local light = Instance.new("PointLight")
                        light.Color = Color3.fromRGB(255, 140, 70)
                        light.Range = 22
                        light.Brightness = 1.5
                        light.Parent = torch
                end
                buildSign("ARENA TIMUR - PUNCAK GOLEM", Vector3.new(ax - 46, 0, az), 90, Color3.fromRGB(150, 90, 60))
                buildSign("PADANG TIMUR >", Vector3.new(52, 0, 16), -90, Color3.fromRGB(120, 150, 90))
        end

        print("[AKIOMIDA] Dunia siap: alun-alun, pasar, ladang, hutan, tambang, danau, pandai besi, dapur, papan tugas, arena boss.")
end

return MapService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">PetService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
        PetService.luau - peliharaan mengikuti pemain & memberi bonus harga jual.
        Model pet dibuat lewat kode (bola menggembung + nama), digerakkan server
        lewat Heartbeat agar semua pemain melihatnya.
]]

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local DataService = require(script.Parent.DataService)

local PetService = {}

local active: { [Player]: { model: Part, petId: string } } = {}
local folder: Folder? = nil

local function petFolder(): Folder
        local f = folder
        if not f then
                f = Instance.new("Folder")
                f.Name = "AKM_Pets"
                f.Parent = workspace
                folder = f
        end
        return f :: Folder
end

local petById: { [string]: any } = {}
for _, pet in ipairs(Config.Pets) do
        petById[pet.id] = pet
end

function PetService.sellBonus(player: Player): number
        local data = DataService.get(player)
        local pet = petById[data.ActivePet]
        return pet and pet.bonus or 0
end

function PetService.attach(player: Player)
        PetService.cleanup(player)
        if not DataService.has(player) then
                return
        end
        local data = DataService.get(player)
        local def = petById[data.ActivePet]
        if not def then
                return
        end

        local body = Instance.new("Part")
        body.Name = "Pet_" .. player.UserId
        body.Shape = Enum.PartType.Ball
        body.Size = Vector3.new(2, 2, 2)
        body.Color = Color3.fromRGB(def.color[1], def.color[2], def.color[3])
        body.Material = data.Dev and Enum.Material.Neon or Enum.Material.SmoothPlastic
        body.Anchored = true
        body.CanCollide = false
        body.CanQuery = false

        local billboard = Instance.new("BillboardGui")
        billboard.Size = UDim2.new(0, 120, 0, 26)
        billboard.StudsOffset = Vector3.new(0, 1.6, 0)
        billboard.AlwaysOnTop = true
        billboard.MaxDistance = 50
        billboard.Parent = body
        local label = Instance.new("TextLabel")
        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1
        label.Font = Enum.Font.GothamBold
        label.TextScaled = true
        label.TextColor3 = body.Color
        label.TextStrokeTransparency = 0.5
        label.Text = def.name
        label.Parent = billboard

        body.Parent = petFolder()
        active[player] = { model = body, petId = def.id }
end

function PetService.cleanup(player: Player)
        local entry = active[player]
        if entry and entry.model then
                entry.model:Destroy()
        end
        active[player] = nil
end

function PetService.init()
        local Remotes = require(ReplicatedStorage.Remotes)
        Remotes.get("EquipPet").OnServerInvoke = function(player, petId)
                return PetService.equip(player, petId)
        end

        local t = 0
        RunService.Heartbeat:Connect(function(dt)
                t += dt
                for player, entry in active do
                        local character = player.Character
                        local root = character and character:FindFirstChild("HumanoidRootPart")
                        if root then
                                local bob = math.sin(t * 2.2 + player.UserId % 7) * 0.4
                                local target = (root :: BasePart).CFrame
                                        * CFrame.new(2.4, 2.6 + bob, 2.4)
                                entry.model.CFrame = entry.model.CFrame:Lerp(target, math.clamp(dt * 6, 0, 1))
                        end
                end
        end)

        local Players = game:GetService("Players")
        Players.PlayerRemoving:Connect(function(player)
                PetService.cleanup(player)
        end)
end

function PetService.equip(player: Player, petId: any)
        if not DataService.has(player) then
                return { ok = false, msg = "Data belum siap." }
        end
        if type(petId) ~= "string" or petId ~= "" and not petById[petId] then
                return { ok = false, msg = "Peliharaan tidak dikenal." }
        end
        local data = DataService.get(player)
        if petId ~= "" and not data.Pets[petId] then
                return { ok = false, msg = "Kamu belum punya peliharaan itu." }
        end
        data.ActivePet = petId
        DataService.markDirty(player)
        PetService.attach(player)
        DataService.push(player)
        if petId == "" then
                return { ok = true, msg = "Peliharaan diistirahatkan." }
        end
        return { ok = true, msg = petById[petId].name .. " menemanimu!" }
end

return PetService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">QuestService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
        QuestService.luau - v3 "Toram-grade" papan tugas:
          - Rotasi harian 3 tugas dari kolam Balance.Quests (deterministik
            per hari, sama untuk semua server)
          - Terima 1 tugas aktif, progres otomatis dari aktivitas dunia:
            harvest / chop / mine / fish / kill / craft / cook
          - Klaim hadiah koin+XP di papan tugas
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Remotes)
local Balance = require(ReplicatedStorage.Shared.Balance)

local DataService = require(script.Parent.DataService)

local QuestService = {}

local questById: { [string]: any } = {}
for _, q in ipairs(Balance.Quests) do
        questById[q.id] = q
end

--------------------------------------------------------------------
-- ROTASI HARIAN (di Balance - dipakai server & client)
--------------------------------------------------------------------

function QuestService.todayQuestIds(): { string }
	return Balance.todayQuestIds()
end

--------------------------------------------------------------------
-- AKSI TUGAS
--------------------------------------------------------------------

local function snapshot(player: Player)
        local data = DataService.get(player)
        local active = nil
        if data.Quest.id ~= "" then
                local q = questById[data.Quest.id]
                if q then
                        active = {
                                id = q.id,
                                title = q.title,
                                desc = q.desc,
                                prog = math.min(data.Quest.prog, q.goal.count),
                                count = q.goal.count,
                                done = data.Quest.done,
                                coins = q.reward.coins,
                                xp = q.reward.xp,
                        }
                end
        end
        local offers = {}
        for _, id in QuestService.todayQuestIds() do
                local q = questById[id]
                if q and id ~= data.Quest.id then
                        table.insert(offers, { id = q.id, title = q.title, desc = q.desc, coins = q.reward.coins, xp = q.reward.xp })
                end
        end
        return { active = active, offers = offers }
end

local function onQuestAction(player: Player, action: any, questId: any)
        if not DataService.has(player) or type(action) ~= "string" then
                return { ok = false, msg = "Permintaan tidak valid." }
        end
        local data = DataService.get(player)

        if action == "list" then
                return { ok = true, board = snapshot(player) }
        end

        if action == "accept" then
                if type(questId) ~= "string" then
                        return { ok = false, msg = "Tugas tidak dikenal." }
                end
                if data.Quest.id ~= "" and not data.Quest.done then
                        return { ok = false, msg = "Selesaikan tugas yang sedang berjalan dulu!" }
                end
                local offered = false
                for _, id in QuestService.todayQuestIds() do
                        if id == questId then
                                offered = true
                                break
                        end
                end
                local q = questById[questId]
                if not offered or not q then
                        return { ok = false, msg = "Tugas itu tidak ada di papan hari ini." }
                end
                data.Quest = { id = questId, prog = 0, acceptedAt = os.time(), done = false }
                DataService.markDirty(player)
                DataService.push(player)
                return { ok = true, msg = "Tugas diterima: " .. q.title .. " - " .. q.desc, board = snapshot(player) }
        end

        if action == "claim" then
                if data.Quest.id == "" then
                        return { ok = false, msg = "Belum ada tugas aktif." }
                end
                local q = questById[data.Quest.id]
                if not q or not data.Quest.done then
                        return { ok = false, msg = "Tugas belum selesai. Semangat!" }
                end
                DataService.addCoins(player, q.reward.coins, true)
                DataService.addXP(player, q.reward.xp)
                data.Quest = { id = "", prog = 0, acceptedAt = 0, done = false }
                DataService.markDirty(player)
                DataService.push(player)
                return { ok = true, msg = "Tugas selesai! +" .. q.reward.coins .. " koin, +" .. q.reward.xp .. " XP", board = snapshot(player) }
        end

        return { ok = false, msg = "Aksi tidak dikenal." }
end

--------------------------------------------------------------------
-- HOOK PROGRES DARI LAYANAN LAIN
--------------------------------------------------------------------

--- type: "harvest" | "chop" | "mine" | "fish" | "kill" | "craft" | "cook"
function QuestService.progress(player: Player, kind: string, amount: number)
        if not DataService.has(player) then
                return
        end
        local data = DataService.get(player)
        if data.Quest.id == "" or data.Quest.done then
                return
        end
        local q = questById[data.Quest.id]
        if not q or q.goal.type ~= kind then
                return
        end
        data.Quest.prog = math.min(q.goal.count, data.Quest.prog + math.max(1, amount))
        if data.Quest.prog >= q.goal.count then
                data.Quest.done = true
                Remotes.get("Notify"):FireClient(player, "Tugas Selesai!",
                        q.title .. " selesai! Kembali ke Papan Tugas di alun-alun untuk klaim hadiah.")
        else
                Remotes.get("Notify"):FireClient(player, "Progres Tugas",
                        q.title .. ": " .. data.Quest.prog .. "/" .. q.goal.count)
        end
        DataService.markDirty(player)
end

--------------------------------------------------------------------
-- INIT
--------------------------------------------------------------------

function QuestService.bindBoard(prompt: ProximityPrompt)
        prompt.ActionText = "Lihat Tugas"
        prompt.ObjectText = "Papan Tugas Harian"
        prompt.MaxActivationDistance = 11
        prompt.HoldDuration = 0
        prompt.Triggered:Connect(function(player)
                if DataService.has(player) then
                        Remotes.get("OpenQuest"):FireClient(player)
                end
        end)
end

function QuestService.init()
        Remotes.get("QuestAction").OnServerInvoke = onQuestAction
end

return QuestService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">QuizService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	QuizService.luau - KUIS OPSIONAL.
	Kuis BUKAN lagi inti gameplay: tidak ada popup paksa, tidak ada zona
	terkunci. Hanya Kak Pintar di alun-alun yang menawarkan soal bonus -
	penjumlahan buatan sendiri (original) dengan hadiah koin. Pemain yang
	hanya mau bertani/mengelana bisa mengabaikannya sepenuhnya.
	Juga menangani kode penjelajah (server-only via DevCodeVault).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Config = require(ReplicatedStorage.Shared.Config)
local MathGen = require(ReplicatedStorage.Shared.MathGen)
local Remotes = require(ReplicatedStorage.Remotes)

local DataService = require(script.Parent.DataService)
local DevCodeVault = require(script.Parent.DevCodeVault)

local QuizService = {}

local active: { [Player]: { qid: string, benar: number, betul: string, salah: string, born: number } } = {}
local lastRequest: { [Player]: number } = {}

--------------------------------------------------------------------
-- NPC KAK PINTAR -> panel opsional
--------------------------------------------------------------------

function QuizService.bindPrompt(prompt: ProximityPrompt)
	prompt.ActionText = "Ikut Kuis Bonus"
	prompt.ObjectText = "Kak Pintar"
	prompt.MaxActivationDistance = 11
	prompt.HoldDuration = 0
	prompt.Triggered:Connect(function(player)
		if DataService.has(player) then
			Remotes.get("OpenQuiz"):FireClient(player)
		end
	end)
end

--------------------------------------------------------------------
-- MINTA SOAL
--------------------------------------------------------------------

local function onQuizRequest(player: Player)
	if not DataService.has(player) then
		return nil
	end
	local now = time()
	if lastRequest[player] and now - lastRequest[player] < Config.Economy.QuizCooldown then
		return { cooldown = math.ceil(Config.Economy.QuizCooldown - (now - lastRequest[player])) }
	end
	lastRequest[player] = now

	-- tingkat soal mengikuti level pemain (1-6)
	local level = math.clamp(DataService.levelOf(player), 1, 6)
	local q = MathGen.generate(level)
	local qid = tostring(math.random(1, 1e9)) .. "-" .. tostring(os.clock())
	active[player] = {
		qid = qid,
		benar = q.benar,
		betul = q.betul,
		salah = q.salah,
		born = now,
	}
	return {
		qid = qid,
		t = q.t,
		opsi = q.opsi,
		reward = Config.Economy.QuizRewardCoins,
		-- kunci jawaban TIDAK dikirim ke client
	}
end

--------------------------------------------------------------------
-- JAWAB SOAL
--------------------------------------------------------------------

local function onQuizAnswer(player: Player, qid: any, choice: any)
	if not DataService.has(player) or type(choice) ~= "number" then
		return nil
	end
	local current = active[player]
	if not current or type(qid) ~= "string" or qid ~= current.qid then
		return nil
	end
	if time() - current.born > 60 then
		active[player] = nil
		return { correct = false, msg = "Waktu habis - soal kedaluwarsa." }
	end
	active[player] = nil

	local correct = math.floor(choice) == current.benar
	if not correct then
		DataService.markDirty(player)
		return { correct = false, msg = current.salah }
	end

	DataService.addCoins(player, Config.Economy.QuizRewardCoins, true)
	DataService.addXP(player, Config.Economy.QuizRewardXp)
	DataService.push(player)
	return {
		correct = true,
		msg = current.betul,
		reward = Config.Economy.QuizRewardCoins,
	}
end

--------------------------------------------------------------------
-- KODE PENJELAJAH (dev)
--------------------------------------------------------------------

local function onRedeemDevCode(player: Player, code: any)
	if type(code) ~= "string" or not DataService.has(player) then
		return false, "Kode tidak valid."
	end
	if code ~= DevCodeVault.CODE then
		return false, "Kode salah."
	end
	local data = DataService.get(player)
	if data.Dev then
		return true, "Kode sudah aktif sebelumnya."
	end
	data.Dev = true
	DataService.addCoins(player, 5000, false)
	DataService.addXP(player, 500)
	DataService.markDirty(player)
	DataService.push(player)
	Remotes.get("Notify"):FireClient(player, "Penjelajah Dev",
		"Kode diterima! +5.000 koin & +500 XP. Selamat datang kembali, pembuat dunia!")
	return true, "Kode diterima! Hadiah dev masuk."
end

--------------------------------------------------------------------
-- INIT
--------------------------------------------------------------------

function QuizService.init()
	Remotes.get("QuizRequest").OnServerInvoke = onQuizRequest
	Remotes.get("QuizAnswer").OnServerInvoke = onQuizAnswer
	Remotes.get("RedeemDevCode").OnServerInvoke = onRedeemDevCode

	Players.PlayerRemoving:Connect(function(player)
		active[player] = nil
		lastRequest[player] = nil
	end)
end

return QuizService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
        ShopService.luau - roda ekonomi dunia:
          Toko Bibit        : jual bibit (syarat level)
          Pasar Pengepul    : beli hasil panen/sumber daya/ikan (harga pasar dinamis)
          Toko Alat         : kaleng siram, pancing, belik, sepeda
          Toko Peliharaan   : pet memberi bonus harga jual
        Permintaan pasar berubah tiap 10 menit (0.8x - 1.35x) - harga hidup.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Remotes)
local Util = require(ReplicatedStorage.Shared.Util)

local DataService = require(script.Parent.DataService)
local PetService = require(script.Parent.PetService)

local ShopService = {}

local cropById, toolById, petById, resById, fishById = {}, {}, {}, {}, {}
for _, crop in ipairs(Config.Crops) do
        cropById[crop.id] = crop
end
for _, tool in ipairs(Config.Tools) do
        toolById[tool.id] = tool
end
for _, pet in ipairs(Config.Pets) do
        petById[pet.id] = pet
end
for _, res in ipairs(Config.Resources) do
        resById[res.id] = res
end
for _, fish in ipairs(Config.Fish) do
        fishById[fish.id] = fish
end

--------------------------------------------------------------------
-- HARGA PASAR DINAMIS (sama untuk semua server: berbasis os.time)
--------------------------------------------------------------------

local function hashString(s: string): number
        local h = 0
        for i = 1, #s do
                h = (h * 31 + string.byte(s, i)) % 1000000007
        end
        return h
end

--- permintaan pasar 0.80 - 1.35 berganti tiap MarketPeriod detik
function ShopService.demandOf(itemId: string): number
        local period = math.floor(os.time() / Config.Economy.MarketPeriod)
        local rng = Random.new(period * 131 + hashString(itemId))
        return math.floor(rng:NextNumber(0.80, 1.35) * 100) / 100
end

function ShopService.getDemand(): { [string]: number }
        local out = {}
        for id in cropById do
                out[id] = ShopService.demandOf(id)
        end
        return out
end

function ShopService.demandSnapshot()
        return ShopService.getDemand()
end

--- harga jual final = dasar x permintaan x bonus peliharaan
function ShopService.sellPrice(player: Player, baseSell: number, itemId: string): number
        local demand = ShopService.demandOf(itemId)
        local bonus = PetService.sellBonus(player)
        return math.max(1, math.floor(baseSell * demand * (1 + bonus) + 0.5))
end

--------------------------------------------------------------------
-- NPC TOKO -> buka panel
--------------------------------------------------------------------

function ShopService.bindPrompt(prompt: ProximityPrompt, shopId: string)
        local titles = {
                bibit = "Toko Bibit",
                jual = "Pasar Pengepul",
                alat = "Toko Alat",
                pet = "Toko Peliharaan",
        }
        prompt.ActionText = "Belanja"
        prompt.ObjectText = titles[shopId] or "Toko"
        prompt.MaxActivationDistance = 11
        prompt.HoldDuration = 0
        prompt.Triggered:Connect(function(player)
                if DataService.has(player) then
                        Remotes.get("OpenShop"):FireClient(player, shopId)
                end
        end)
end

--------------------------------------------------------------------
-- BELI
--------------------------------------------------------------------

local function applySpeed(player: Player)
        local character = player.Character
        if not character then
                return
        end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
                humanoid.WalkSpeed = DataService.get(player).Tools.bike and 26 or 16
        end
end

local function onBuyItem(player: Player, shopId: any, itemId: any)
        if not DataService.has(player) or type(shopId) ~= "string" or type(itemId) ~= "string" then
                return { ok = false, msg = "Permintaan tidak valid." }
        end

        -------------------------------------------------- TOKO BIBIT
        if shopId == "bibit" then
                local crop = cropById[itemId]
                if not crop then
                        return { ok = false, msg = "Bibit tidak dikenal." }
                end
                local level = DataService.levelOf(player)
                if level < crop.level then
                        return { ok = false, msg = "Butuh level " .. crop.level .. ". Kumpulkan XP dari panen & aktivitas!" }
                end
                if not DataService.spend(player, crop.cost) then
                        return { ok = false, msg = "Koin kurang! Jual hasil panenmu di Pasar Pengepul." }
                end
                DataService.giveItem(player, "seed", itemId, 1)
                DataService.push(player)
                return { ok = true, msg = "Bibit " .. crop.name .. " dibeli!" }

        -------------------------------------------------- TOKO ALAT
        elseif shopId == "alat" then
                local tool = toolById[itemId]
                if not tool then
                        return { ok = false, msg = "Alat tidak dikenal." }
                end
                local data = DataService.get(player)
                if itemId == "pick2" and data.Tools.pickTier >= 2 or itemId == "pick3" and data.Tools.pickTier >= 3 then
                        return { ok = false, msg = "Kamu sudah punya belik yang lebih bagus." }
                end
                if (itemId == "can" and data.Tools.can) or (itemId == "rod" and data.Tools.rod) or (itemId == "bike" and data.Tools.bike) then
                        return { ok = false, msg = "Alat ini sudah kamu miliki." }
                end
                if not DataService.spend(player, tool.cost) then
                        return { ok = false, msg = "Koin kurang! Jual dulu hasil panenmu." }
                end
                if tool.tier then
                        data.Tools.pickTier = tool.tier
                elseif itemId == "can" then
                        data.Tools.can = true
                elseif itemId == "rod" then
                        data.Tools.rod = true
                elseif itemId == "bike" then
                        data.Tools.bike = true
                end
                DataService.markDirty(player)
                applySpeed(player)
                DataService.push(player)
                return { ok = true, msg = tool.name .. " dibeli! " .. tool.desc }

        -------------------------------------------------- TOKO PELIHARAAN
        elseif shopId == "pet" then
                local pet = petById[itemId]
                if not pet then
                        return { ok = false, msg = "Peliharaan tidak dikenal." }
                end
                local data = DataService.get(player)
                if data.Pets[itemId] then
                        DataService.markDirty(player)
                        data.ActivePet = itemId
                        PetService.attach(player)
                        DataService.push(player)
                        return { ok = true, msg = pet.name .. " kembali menemanimu!" }
                end
                if not DataService.spend(player, pet.cost) then
                        return { ok = false, msg = "Koin kurang! Peliharaan ini mahal - kumpulkan hasil panen dulu." }
                end
                data.Pets[itemId] = true
                data.ActivePet = itemId
                DataService.markDirty(player)
                PetService.attach(player)
                DataService.push(player)
                return { ok = true, msg = pet.name .. " ikut bertualang bersamamu! " .. pet.desc }
        end

        return { ok = false, msg = "Toko tidak dikenal." }
end

--------------------------------------------------------------------
-- JUAL
--------------------------------------------------------------------

--- kind: "crop" | "bag" | "fish"
local function baseSellOf(kind: string, id: string): number?
        if kind == "crop" then
                local crop = cropById[id]
                return crop and crop.sell
        elseif kind == "bag" then
                local res = resById[id]
                return res and res.sell
        elseif kind == "fish" then
                local fish = fishById[id]
                return fish and fish.sell
        end
        return nil
end

local function kindLabel(kind: string): string
        if kind == "crop" then
                return "Hasil Panen"
        elseif kind == "bag" then
                return "Sumber Daya"
        elseif kind == "fish" then
                return "Ikan"
        end
        return "Barang"
end

local function onSellItem(player: Player, kind: any, itemId: any, all: any)
        if not DataService.has(player) or type(kind) ~= "string" or type(itemId) ~= "string" then
                return { ok = false, msg = "Permintaan tidak valid." }
        end
        local base = baseSellOf(kind, itemId)
        if not base then
                return { ok = false, msg = "Barang tidak dikenal." }
        end
        local have = DataService.countItem(player, kind, itemId)
        if have <= 0 then
                return { ok = false, msg = "Kamu tidak punya barang itu." }
        end
        local count = (all == true) and have or 1
        local unit = ShopService.sellPrice(player, base, itemId)
        local total = unit * count

        DataService.takeItem(player, kind, itemId, count)
        DataService.addCoins(player, total, true)
        DataService.addXP(player, count)
        DataService.push(player)
        return { ok = true, msg = "Terjual " .. count .. "x - +" .. Util.formatNumber(total) .. " koin!", total = total }
end

--------------------------------------------------------------------
-- JUAL SEMUA SATU KLIK
--------------------------------------------------------------------

local function onSellAll(player: Player)
        if not DataService.has(player) then
                return { ok = false, msg = "Data belum siap." }
        end
        local data = DataService.get(player)
        local total = 0
        local items = 0

        local function flush(kind: string, tableData: { [string]: number }, lookup: { [string]: any })
                for id, count in tableData do
                        if lookup[id] and count > 0 then
                                local unit = ShopService.sellPrice(player, lookup[id].sell, id)
                                DataService.takeItem(player, kind, id, count)
                                total += unit * count
                                items += count
                        end
                end
        end

        flush("crop", data.Crops, cropById)
        flush("bag", data.Bag, resById)
        flush("fish", data.Fish, fishById)

        if items == 0 then
                return { ok = false, msg = "Tas masih kosong. Tanam, tebang, atau mancing dulu!" }
        end
        DataService.addCoins(player, total, true)
        DataService.addXP(player, items)
        DataService.push(player)
        return { ok = true, msg = items .. " barang terjual - +" .. Util.formatNumber(total) .. " koin!", total = total }
end

--------------------------------------------------------------------
-- INIT
--------------------------------------------------------------------

function ShopService.init()
        Remotes.get("BuyItem").OnServerInvoke = onBuyItem
        Remotes.get("SellItem").OnServerInvoke = onSellItem
        Remotes.get("SellAll").OnServerInvoke = onSellAll
        -- daftarkan snapshot permintaan pasar ke DataService (tanpa siklus require)
        DataService.registerProvider("demand", function()
                return ShopService.getDemand()
        end)
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">TradeService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
        TradeService.luau - v3 dagang antar pemain (gaya MMO klasik):
          - Undang pemain terdekat via panel (validasi jarak & data)
          - Dua sisi menawar barang & koin, lalu keduanya "SIAP"
          - Eksekusi atomik & tervalidasi di server (anti-scam dasar)
          - Perubahan tawaran kapan pun mereset status SIAP kedua sisi
          - TradeSync: snapshot langsung ke kedua sisi setiap perubahan
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Remotes)

local DataService = require(script.Parent.DataService)

local TradeService = {}

-- sesi aktif: player -> session (kedua sisi menunjuk tabel sama)
local sessions: { [Player]: any } = {}
-- undangan menunggu: target -> {from, expires}
local invites: { [Player]: any } = {}

--------------------------------------------------------------------
-- SNAPSHOT
--------------------------------------------------------------------

local function offerOf(session: any, player: Player)
        return session[player == session.a and "offerA" or "offerB"]
end

local function pushSync(session: any)
        local snapA = {
                me = { name = session.a.DisplayName, items = session.offerA, coins = session.coinsA, ready = session.readyA },
                partner = { name = session.b.DisplayName, items = session.offerB, coins = session.coinsB, ready = session.readyB },
        }
        local snapB = {
                me = { name = session.b.DisplayName, items = session.offerB, coins = session.coinsB, ready = session.readyB },
                partner = { name = session.a.DisplayName, items = session.offerA, coins = session.coinsA, ready = session.readyA },
        }
        if session.a.Parent then
                Remotes.get("TradeSync"):FireClient(session.a, snapA)
        end
        if session.b.Parent then
                Remotes.get("TradeSync"):FireClient(session.b, snapB)
        end
end

local function closeSession(session: any, reason: string)
        for _, p in { session.a, session.b } do
                if sessions[p] == session then
                        sessions[p] = nil
                end
                if p.Parent and reason ~= "" then
                        Remotes.get("Notify"):FireClient(p, "Dagang", reason)
                end
        end
end

--------------------------------------------------------------------
-- EKSEKUSI (atomik)
--------------------------------------------------------------------

local function canDeliver(player: Player, items: { [string]: any }, coins: number): boolean
        local data = DataService.get(player)
        if data.Coins < coins then
                return false
        end
        for kind, list in items do
                for id, count in list do
                        if DataService.countItem(player, kind, id) < count then
                                return false
                        end
                end
        end
        return true
end

local function deliver(player: Player, items: { [string]: any }, coins: number)
        for kind, list in items do
                for id, count in list do
                        DataService.takeItem(player, kind, id, count)
                end
        end
        DataService.addCoins(player, -coins)
end

local function executeTrade(session: any)
        local a, b = session.a, session.b
        if not DataService.has(a) or not DataService.has(b) then
                closeSession(session, "Dagangan gagal - data pemain tidak siap.")
                return
        end
        if not canDeliver(a, session.offerA, session.coinsA) or not canDeliver(b, session.offerB, session.coinsB) then
                closeSession(session, "Dagangan gagal - barang/koin berubah saat dagang.")
                pushSync(session)
                return
        end
        -- eksekusi: tukar
        deliver(a, session.offerA, session.coinsA)
        deliver(b, session.offerB, session.coinsB)
        for kind, list in session.offerA do
                for id, count in list do
                        DataService.giveItem(b, kind, id, count)
                end
        end
        for kind, list in session.offerB do
                for id, count in list do
                        DataService.giveItem(a, kind, id, count)
                end
        end
        DataService.addCoins(a, session.coinsB, false)
        DataService.addCoins(b, session.coinsA, false)

        Remotes.get("Notify"):FireClient(a, "Dagangan Sukses", "Tukar-menukar dengan " .. b.DisplayName .. " selesai!")
        Remotes.get("Notify"):FireClient(b, "Dagangan Sukses", "Tukar-menukar dengan " .. a.DisplayName .. " selesai!")
        DataService.push(a)
        DataService.push(b)
        closeSession(session, "")
end

--------------------------------------------------------------------
-- AKSI
--------------------------------------------------------------------

local function onTradeAction(player: Player, payload: any)
        if not DataService.has(player) or type(payload) ~= "table" or type(payload.action) ~= "string" then
                return { ok = false, msg = "Permintaan tidak valid." }
        end
        local action = payload.action

        -- sedang dalam sesi? kecuali invite, semua aksi butuh sesi
        local session = sessions[player]

        ---------------------------------------------------------------- undang
        if action == "invite" then
                if session then
                        return { ok = false, msg = "Kamu sedang dagang dengan " .. (player == session.a and session.b.DisplayName or session.a.DisplayName) .. "." }
                end
                local target = typeof(payload.target) == "string" and Players:FindFirstChild(payload.target) or nil
                if not target or target == player then
                        return { ok = false, msg = "Pemain tidak ditemukan di server ini." }
                end
                if not DataService.has(target) or sessions[target] then
                        return { ok = false, msg = "Pemain itu sedang tidak bisa diajak dagang." }
                end
                -- jarak: hanya pemain di dekatmu (biar interaksi tatap muka)
                local myRoot = player.Character and player.Character.PrimaryPart
                local theirRoot = target.Character and target.Character.PrimaryPart
                if not myRoot or not theirRoot or (myRoot.Position - theirRoot.Position).Magnitude > 60 then
                        return { ok = false, msg = "Dekati pemain itu dulu untuk mengundang dagang." }
                end
                invites[target] = { from = player, expires = os.time() + 45 }
                Remotes.get("Notify"):FireClient(target, "Undangan Dagang",
                        player.DisplayName .. " mengundangmu berdagang! Buka panel Dagang untuk menerima.")
                return { ok = true, msg = "Undangan terkirim ke " .. target.DisplayName .. ". Menunggu jawaban..." }

        ---------------------------------------------------------------- terima/tolak
        elseif action == "accept" then
                if session then
                        return { ok = false, msg = "Kamu sudah dalam sesi dagang." }
                end
                local inv = invites[player]
                if not inv or os.time() > inv.expires or not inv.from.Parent then
                        invites[player] = nil
                        return { ok = false, msg = "Undangan sudah kedaluwarsa." }
                end
                local from = inv.from
                if sessions[from] then
                        invites[player] = nil
                        return { ok = false, msg = "Pemain itu sudah dagang dengan orang lain." }
                end
                invites[player] = nil
                local newSession = {
                        a = from, b = player,
                        offerA = {}, offerB = {},
                        coinsA = 0, coinsB = 0,
                        readyA = false, readyB = false,
                }
                sessions[from] = newSession
                sessions[player] = newSession
                Remotes.get("OpenTrade"):FireClient(from)
                Remotes.get("OpenTrade"):FireClient(player)
                pushSync(newSession)
                return { ok = true, msg = "Dagangan dengan " .. from.DisplayName .. " dimulai." }

        elseif action == "decline" then
                local inv = invites[player]
                if inv and inv.from.Parent then
                        Remotes.get("Notify"):FireClient(inv.from, "Dagang", player.DisplayName .. " menolak undanganmu.")
                end
                invites[player] = nil
                return { ok = true, msg = "Undangan ditolak." }

        ---------------------------------------------------------------- isi sesi
        elseif action == "offer" and session then
                if type(payload.kind) ~= "string" or type(payload.id) ~= "string" then
                        return { ok = false, msg = "Tidak valid." }
                end
                local count = math.floor(tonumber(payload.count) or 0)
                local myOffer = offerOf(session, player)
                local have = DataService.countItem(player, payload.kind, payload.id)
                if count <= 0 then
                        myOffer[payload.kind][payload.id] = nil
                else
                        if have < count then
                                return { ok = false, msg = "Stok tidak cukup (" .. have .. ")." }
                        end
                        myOffer[payload.kind] = myOffer[payload.kind] or {}
                        myOffer[payload.kind][payload.id] = count
                end
                session.readyA = false
                session.readyB = false
                pushSync(session)
                return { ok = true }

        elseif action == "coin" and session then
                local amount = math.max(0, math.floor(tonumber(payload.amount) or 0))
                local data = DataService.get(player)
                if amount > data.Coins then
                        amount = data.Coins
                end
                if player == session.a then
                        session.coinsA = amount
                else
                        session.coinsB = amount
                end
                session.readyA = false
                session.readyB = false
                pushSync(session)
                return { ok = true }

        elseif action == "ready" and session then
                local value = payload.value == true
                if player == session.a then
                        session.readyA = value
                else
                        session.readyB = value
                end
                pushSync(session)
                if session.readyA and session.readyB then
                        task.defer(executeTrade, session)
                end
                return { ok = true }

        elseif action == "cancel" and session then
                closeSession(session, "Dagangan dibatalkan.")
                return { ok = true, msg = "Dagangan dibatalkan." }
        end

        return { ok = false, msg = "Kamu tidak sedang berdagang." }
end

--------------------------------------------------------------------
-- INIT
--------------------------------------------------------------------

function TradeService.init()
        Remotes.get("TradeAction").OnServerInvoke = onTradeAction

        Players.PlayerRemoving:Connect(function(player)
                -- undangan
                invites[player] = nil
                for target, inv in invites do
                        if inv.from == player then
                                invites[target] = nil
                        end
                end
                -- sesi dagang
                local session = sessions[player]
                if session then
                        closeSession(session, "Partner dagangmu keluar server - dagangan dibatalkan.")
                end
        end)
end

return TradeService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="25">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="26">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
