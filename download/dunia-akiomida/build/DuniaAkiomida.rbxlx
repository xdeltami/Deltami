      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!nonstrict
--[[
	Config.luau - DUNIA AKIOMIDA (versi Roblox)
	Port original dari game browser "Dunia Akiomida: Petualangan Matematika".
	Fitur sengaja TIDAK dibawa ke Roblox: ads, donasi, share, toggle wawasan.
]]

local Config = {}

Config.Game = {
	Name = "Dunia Akiomida",
	Tagline = "Petualangan Matematika",
	Version = "1.0.0",
}

--------------------------------------------------------------------
-- ZONA (identitas & urutan dari game browser)
-- biome menentukan dekorasi prosedural di MapService.
--------------------------------------------------------------------
Config.Zones = {
	{ id = "kamp",    name = "Kamp Angka",        slogan = "Wilayah permulaan perjalanan",    color = { 99, 200, 255 }, biome = "kamp" },
	{ id = "hutan",   name = "Hutan Simbol",      slogan = "Wilayah bahasa dan tanda",        color = { 79, 227, 200 }, biome = "hutan" },
	{ id = "gunung",  name = "Pegunungan Pola",   slogan = "Wilayah susunan dan bentuk",      color = { 255, 209, 102 }, biome = "gunung" },
	{ id = "kota",    name = "Kota Bukti",        slogan = "Wilayah alasan dan pembuktian",   color = { 255, 157, 157 }, biome = "kota" },
	{ id = "lembah",  name = "Lembah Kedalaman",  slogan = "Wilayah pemahaman yang dalam",    color = { 187, 143, 255 }, biome = "lembah" },
	{ id = "salju",   name = "Puncak Riset",      slogan = "Wilayah para penjelajah terdepan", color = { 165, 216, 255 }, biome = "salju" },
}

--------------------------------------------------------------------
-- PROGRES & KUIS
--------------------------------------------------------------------
Config.Progress = {
	MasteryTarget = 10, -- jawaban benar per zona untuk menguasai
	XpPerCorrect = 10,
	CoinPerCorrect = 5, -- dikali indeks zona (zona makin jauh makin berharga)
	StreakBonusMax = 5, -- bonus XP maksimum dari streak (XP tambahan = streak, dibatasi)
	MasteryBonusXp = 50,
	MasteryBonusCoins = 50,
	UnlockNextOnMastery = true,
	MaxActiveQuestionSeconds = 120, -- soal kedaluwarsa setelah 2 menit
	AnswerCooldown = 0.4, -- anti-spam jawab (detik)
}

--------------------------------------------------------------------
-- KODE PENJELAJAH (fitur dev internal game Akiomida)
--------------------------------------------------------------------
Config.DevCode = "CKZhwbrsRLjms6Da5h"

--------------------------------------------------------------------
-- DATA / LEADERBOARD
--------------------------------------------------------------------
Config.Data = {
	StoreName = "AKM_Progress_v1",
	OrderedStoreName = "AKM_XP_v1",
	AutosaveInterval = 120,
	LoadRetries = 3,
}

Config.Leaderboard = {
	RefreshInterval = 60,
	Size = 10,
}

--------------------------------------------------------------------
-- WORLD LAYOUT: satu pulau panjang, 6 zona berjajar.
--------------------------------------------------------------------
Config.World = {
	ZoneSpacing = 110, -- jarak antar pusat zona (stud, sumbu Z)
	StartZ = 60, -- pusat zona pertama
	IslandWidth = 90,
	IslandHeight = 3,
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">LessonData</string>
          <string name="Source"><![CDATA[--!nonstrict
--[[
	LessonData.luau
	Materi "Bahasan" per zona - teks original yang ditulis ulang untuk versi
	Roblox (gaya edukatif populer, ringkas, bahasa Indonesia).
	Setiap zona punya topik pendek; pemain menandai "sudah dibaca" untuk progres.
]]

local LessonData = {}

-- index zona 1..6, sesuai urutan Config.Zones
local LESSONS = {
	[1] = {
		{ id = "kamp-1", title = "Angka lahir dari kebutuhan", text = "Dulu gembala menghitung domba dengan batu: satu batu satu domba. Batu tersisa artinya domba belum pulang. Angka lahir untuk menjaga agar tidak ada yang hilang." },
		{ id = "kamp-2", title = "Menambah itu menggabungkan", text = "Menambahkan = menggabungkan dua kelompok jadi satu. 3 batu ditambah 4 batu bukan 34 batu - melainkan 7 batu. Coba bayangkan benda, bukan hanya lambang." },
		{ id = "kamp-3", title = "Mengurang itu menyisihkan", text = "Mengurangi = menyingkirkan sebagian dari kelompok. Kalau 9 kue dimakan 4, tersisa 5. Kurang juga bisa dianggap melangkah mundur di garis bilangan." },
		{ id = "kamp-4", title = "Perkalian itu penjumlahan cepat", text = "4 x 3 artinya 4 + 4 + 4. Perkalian adalah jalan pintas untuk penjumlahan berulang. Makin paham maknanya, makin cepat hitungmu." },
		{ id = "kamp-5", title = "Pembagian itu membagi rata", text = "12 dibagi 3 artinya membagi 12 menjadi 3 kelompok sama besar: tiap kelompok 4. Pembagian adalah kebalikan perkalian." },
	},
	[2] = {
		{ id = "hutan-1", title = "Bilangan negatif ada di bawah nol", text = "Suhu 3 derajat lalu turun 5 derajat: hasilnya -2. Negatif bukan 'aneh', hanya langkah ke kiri dari nol di garis bilangan." },
		{ id = "hutan-2", title = "Urutan operasi", text = "Kerjakan kurung dulu, lalu kali/bagi, terakhir tambah/kurang. 2 + 3 x 4 = 14, bukan 20. Aturan ini bikin semua orang paham makna yang sama." },
		{ id = "hutan-3", title = "Simbol bermakna", text = "+, -, x, :, = adalah alat tulis pikiran. Tanda yang salah mengubah makna: 5 - 2 beda jauh dengan 5 + 2. Baca simbol seperti membaca rambu jalan." },
		{ id = "hutan-4", title = "Kurung mengubah segalanya", text = "(2 + 3) x 4 = 20, tapi 2 + 3 x 4 = 14. Kurung menyuruhmu mengerjakan dulu. Letak satu tanda bisa mengubah jawaban." },
	},
	[3] = {
		{ id = "gunung-1", title = "Pola barisan tambah", text = "2, 5, 8, 11, ... tiap kali naik 3. Beda yang tetap menandai barisan aritmetika. Temukan bedanya, kamu bisa menebak langkah ke seribu pun." },
		{ id = "gunung-2", title = "Pola barisan kali", text = "3, 6, 12, 24, ... tiap kali dikali 2. Barisan geometri tumbuh makin cepat - seperti bola salju menggulung." },
		{ id = "gunung-3", title = "Pola segitiga", text = "1, 3, 6, 10, 15 ... ditambah 2, lalu 3, lalu 4. Rumusnya n(n+1)/2. Pola yang sama dipakai menyusun bola pinak di lapangan." },
		{ id = "gunung-4", title = "Pola bentuk", text = "Jumlah sisi segitiga 3, persegi 4, pentagon 5. Bentuk punya pola angka. Matematika membaca dunia lewat pola seperti ini." },
	},
	[4] = {
		{ id = "kota-1", title = "Menyelesaikan persamaan", text = "2x + 3 = 11. Kurangi kedua ruas dengan 3: 2x = 8. Bagi dua: x = 4. Persamaan seperti timbangan - apa yang dilakukan di satu ruas, lakukan juga di ruas lain." },
		{ id = "kota-2", title = "Membuktikan, bukan menebak", text = "Klaim '7 x 8 = 56' harus diuji. Kuadratkan, jumlahkan, periksa. Di Kota Bukti, argumen tanpa perhitungan gak lulus sidang." },
		{ id = "kota-3", title = "Luas dan keliling", text = "Keliling = jalan keliling pagar (persegi: 4 x sisi). Luas = seluruh lantai di dalam (sisi x sisi). Dua hal berbeda yang sering tertukar." },
		{ id = "kota-4", title = "Pertidaksamaan", text = "x > 3 artinya semua bilangan lebih dari 3: 4, 5, 6, ... sampai tak terhingga. Satu simbol membuka wilayah jawaban, bukan hanya satu angka." },
	},
	[5] = {
		{ id = "lembah-1", title = "Fungsi itu mesin", text = "f(x) = 2x + 1. Masukkan 3, keluar 7. Fungsi mengubah input jadi output dengan aturan tetap. Grafiknya menggambar cerita hubungan itu." },
		{ id = "lembah-2", title = "Pangkat & akar", text = "5^2 = 25, akar 25 = 5. Pangkat menaikkan, akar menurunkan kembali. Dua arah jalan yang sama." },
		{ id = "lembah-3", title = "Pecahan & perbandingan", text = "1/2 dari 10 = 5. Pecahan adalah pembagian yang ditulis rapi. Rasio 2:3 artinya tiap 2 bagian A ada 3 bagian B." },
		{ id = "lembah-4", title = "Memahami vs menghafal", text = "Yang dihafal mudah lupa; yang dipahami melekat. Lembah Kedalaman melatih bertanya 'kenapa' sebelum 'berapa'." },
	},
	[6] = {
		{ id = "salju-1", title = "Bilangan prima", text = "2, 3, 5, 7, 11, 13 ... hanya habis dibagi 1 dan dirinya. Prima adalah 'atom' bilangan - semua bilangan tersusun darinya." },
		{ id = "salju-2", title = "Aritmetika modular", text = "7 mod 3 = 1, karena 7 = 2 x 3 + 1. Sisa pembagian berguna untuk jam, kalender, hingga kriptografi." },
		{ id = "salju-3", title = "Penjumlahan Gauss", text = "1 + 2 + ... + 100 = 5050, lewat trik 100(101)/2. Riset sering dimulai dari melihat pola di tempat yang orang lain anggap biasa." },
		{ id = "salju-4", title = "Bertanya seperti peneliti", text = "Coba tebak, uji dengan contoh kecil, cari lawan, lalu buktikan. Puncak Riset bukan soal jawaban cepat, tapi pertanyaan yang tepat." },
	},
}

--- Returns the lesson list for a 1-based zone index.
function LessonData.forZone(zoneIndex: number): { any }
	return LESSONS[zoneIndex] or {}
end

--- Total topic count across all zones (for HUD progress).
function LessonData.totalTopics(): number
	local n = 0
	for _, list in LESSONS do
		n += #list
	end
	return n
end

return LessonData
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">MathGen</string>
          <string name="Source"><![CDATA[--!nonstrict
--[[
        MathGen.luau
        Generator soal matematika prosedural (karya original, gaya edukatif
        peduli umpan balik). Satu generator per zona, tingkat kesulitan naik.

        Output per soal:
        { t = teks soal, opsi = {3 teks}, benar = index (1..3),
          betul = pujian/penguatan, salah = petunjuk lembut }
]]

local MathGen = {}

local function shuffledOptions(correct: number, decoys: { number }): ({ string }, number)
        local opts = { tostring(correct) }
        for _, d in decoys do
                if #opts >= 3 then
                        break
                end
                if d ~= correct then
                        table.insert(opts, tostring(d))
                end
        end
        -- fallback decoys bila kurang
        local filler = correct + 1
        while #opts < 3 do
                if filler ~= correct and table.find(opts, tostring(filler)) == nil then
                        table.insert(opts, tostring(filler))
                end
                filler += 1
        end
        -- shuffle
        for i = #opts, 2, -1 do
                local j = math.random(1, i)
                opts[i], opts[j] = opts[j], opts[i]
        end
        local correctIndex = table.find(opts, tostring(correct)) or 1
        return opts, correctIndex
end

local function question(t: string, correct: number, decoys: { number }, betul: string, salah: string)
        local opsi, benar = shuffledOptions(correct, decoys)
        return { t = t, opsi = opsi, benar = benar, betul = betul, salah = salah }
end

local function near(n: number): { number }
        -- decoys "klik terdekat" yang masuk akal secara pedagogis
        local out = {}
        local candidates = { n + 1, n - 1, n + 2, n - 2, n + 10, n - 10, n * 2 }
        for _, c in candidates do
                if c >= 0 and c ~= n and table.find(out, c) == nil then
                        table.insert(out, c)
                end
        end
        return out
end

--------------------------------------------------------------------
-- ZONA 1: KAMP ANGKA - berhitung dasar
--------------------------------------------------------------------
local function kamp(): any
        local pick = math.random(1, 4)
        if pick == 1 then
                local a, b = math.random(2, 9), math.random(2, 9)
                return question(
                        ("Tenda butuh %d tiang. Sudah berdiri %d. Berapa tiang lagi yang harus dipasang?"):format(a + b, a),
                        b,
                        near(b),
                        ("Tepat! Dari %d menuju %d: %d langkah. Satu tiang berdiri!"):format(a, a + b, b),
                        "Hitung maju pelan-pelan dari " .. a .. " sampai " .. (a + b) .. ". Berapa langkah itu?"
                )
        elseif pick == 2 then
                local a, b = math.random(2, 6), math.random(2, 6)
                return question(
                        ("Kayu unggun disusun %d tumpukan, tiap tumpukan berisi %d kayu. Semuanya berapa kayu?"):format(a, b),
                        a * b,
                        near(a * b),
                        ("Benar! %d x %d = %d. Menjumlah berulang seperti ini adalah bibit perkalian!"):format(a, b, a * b),
                        "Coba hitung tumpuk demi tumpuk, tambahkan terus jumlahnya."
                )
        elseif pick == 3 then
                local total = math.random(5, 12)
                local ambil = math.random(1, total - 2)
                return question(
                        (("%d batu dikumpulkan, lalu %d dipakai bikin tungku. Sisa berapa batu?"):format(total, ambil)),
                        total - ambil,
                        near(total - ambil),
                        "Benar! Mengambil dari jumlah itu artinya berkurang.",
                        "Mulai dari " .. total .. ", lalu hitung mundur sebanyak " .. ambil .. "."
                )
        else
                local domba, kandang = math.random(6, 15), math.random(2, 5)
                return question(
                        (("%d domba dibagi rata ke %d kandang. Tiap kandang berisi berapa domba?"):format(domba, kandang)),
                        math.floor(domba / kandang),
                        near(math.floor(domba / kandang)),
                        "Benar! Membagi rata = membagi sama besar ke tiap kelompok.",
                        ("Bayangkan membagikan domba satu per satu bergiliran ke %d kandang."):format(kandang)
                )
        end
end

--------------------------------------------------------------------
-- ZONA 2: HUTAN SIMBOL - tanda, urutan operasi, bilangan negatif
--------------------------------------------------------------------
local function hutan(): any
        local pick = math.random(1, 4)
        if pick == 1 then
                local a, b, c = math.random(2, 6), math.random(2, 6), math.random(2, 6)
                local correct = a + b * c
                return question(
                        ("Berapa hasil dari %d + %d x %d?"):format(a, b, c),
                        correct,
                        { a * b + c, correct + b, correct - a },
                        "Benar! Kali dulu, baru tambah - urutan operasi menyelamatkanmu.",
                        "Ingat aturan hutan: kali dibahas lebih dulu daripada tambah."
                )
        elseif pick == 2 then
                local a = math.random(3, 12)
                local b = math.random(1, a + 4)
                local correct = a - b
                return question(
                        ("Suhu di hutan %d derajat, malamnya turun %d derajat. Suhu sekarang?"):format(a, b),
                        correct,
                        { a + b, math.abs(correct) + 1, correct + 1 },
                        "Benar! Turun dari angka positif bisa mendarat di wilayah negatif.",
                        "Melangkah mundur dari " .. a .. " sebanyak " .. b .. " kali - bisa lewat nol!"
                )
        elseif pick == 3 then
                local a, b = math.random(-9, 9), math.random(-9, 9)
                if a == b then
                        b = b + 1
                end
                local larger = math.max(a, b)
                return question(
                        ("Mana yang LEBIH BESAR: %d atau %d?"):format(a, b),
                        larger,
                        { math.min(a, b), math.abs(a), math.abs(b) },
                        "Benar! Garis bilangan: makin ke kanan makin besar, minus itu di kiri nol.",
                        "Bayangkan garis bilangan: -5 -4 -3 -2 -1 0 1 2 3 ..."
                )
        else
                local a, b = math.random(2, 9), math.random(2, 9)
                local correct = a * b
                return question(
                        ("Simbol misteri: %d ? %d = %d. Simbol ? seharusnya..."):format(a, b, correct),
                        correct,
                        { a + b, correct + a, math.abs(a - b) },
                        "Benar! Tanda itu tanda kali - simbol punya makna, bukan hiasan.",
                        "Periksa: apakah hasilnya jauh lebih besar dari kedua bilangan? Itu petunjuk perkalian."
                )
        end
end

--------------------------------------------------------------------
-- ZONA 3: PEGUNUNGAN POLA - pola barisan
--------------------------------------------------------------------
local function gunung(): any
        local pick = math.random(1, 3)
        if pick == 1 then
                local start, step = math.random(1, 9), math.random(2, 7)
                local seq = { start, start + step, start + 2 * step, start + 3 * step }
                local nxt = start + 4 * step
                return question(
                        ("Barisan gunung: %d, %d, %d, %d, ... Berapa angka berikutnya?"):format(seq[1], seq[2], seq[3], seq[4]),
                        nxt,
                        { nxt + step, nxt - 1, seq[4] + 1 },
                        ("Benar! Beda tetap +%d. Pola itu tangganya."):format(step),
                        "Cari selisih dua angka yang berdekatan - selisihnya selalu sama."
                )
        elseif pick == 2 then
                local start = math.random(1, 4)
                local seq = { start, start * 2, start * 4, start * 8 }
                local nxt = start * 16
                return question(
                        ("Jejak di gunung: %d, %d, %d, %d, ... angka berikutnya?"):format(seq[1], seq[2], seq[3], seq[4]),
                        nxt,
                        { start * 12, nxt + 2, seq[4] + 8 },
                        "Benar! Tiap langkah dikali 2 - pola perkalian meledak tingginya!",
                        "Bandingkan tiap angka dengan sebelumnya: berapa kali lipat?"
                )
        else
                local rows = math.random(3, 8)
                local correct = rows * (rows + 1) / 2
                return question(
                        ("Susunan kaki gunung: baris 1 ada 1 batu, baris 2 ada 2 batu, sampai baris %d. Total batu?"):format(rows),
                        correct,
                        near(correct),
                        "Benar! 1+2+...+n = n(n+1)/2 - pola segitiga legendaris.",
                        "Jumlahkan bertahap: 1+2=3, 3+3=6, 6+4=10 ... terus sampai baris " .. rows .. "."
                )
        end
end

--------------------------------------------------------------------
-- ZONA 4: KOTA BUKTI - aljabar & pembuktian sederhana
--------------------------------------------------------------------
local function kota(): any
        local pick = math.random(1, 3)
        if pick == 1 then
                local a = math.random(2, 9)
                local x = math.random(2, 9)
                local b = math.random(1, 9)
                return question(
                        ("Selesaikan: %dx + %d = %d. Berapa x?"):format(a, b, a * x + b),
                        x,
                        { x + 1, x - 1, a + x },
                        "Benar! Pindahkan konstanta, lalu bagi - kasus hukum di Kota Bukti selesai.",
                        "Kurangi kedua ruas dengan " .. b .. " dulu, baru bagi dengan " .. a .. "."
                )
        elseif pick == 2 then
                local a, b = math.random(2, 12), math.random(2, 12)
                local correct = a * a + b
                return question(
                        ("Klaim warga: %d x %d + %d = %d. Benar atau tidak? (pilih nilai yang benar)"):format(a, a, b, correct + 2),
                        correct,
                        { correct + 2, a * a - b, a * 2 + b },
                        "Benar! Hitung sendiri = membuktikan. Itu jiwa Kota Bukti.",
                        "Kuadratkan dulu, lalu tambahkan. Jangan percaya klaim tanpa perhitungan!"
                )
        else
                local n = math.random(4, 12)
                local correct = n * n
                return question(
                        ("Luas pelataran kota berbentuk persegi dengan sisi %d. Berapa luasnya?"):format(n),
                        correct,
                        { 4 * n, n * 2, correct + n },
                        "Benar! Luas persegi = sisi x sisi. Bukti geometris selesai.",
                        "Luas bukan keliling - keliling yang 4 x sisi."
                )
        end
end

--------------------------------------------------------------------
-- ZONA 5: LEMBAH KEDALAMAN - pangkat, akar, fungsi
--------------------------------------------------------------------
local function lembah(): any
        local pick = math.random(1, 3)
        if pick == 1 then
                local base = math.random(2, 6)
                local exp = math.random(2, 3)
                local correct = base ^ exp
                return question(
                        ("Teropong riset memperbesar %d kali tiap lapis. Setelah %d lapis: berapa %d^%d?"):format(base, exp, base, exp),
                        correct,
                        { base * exp, correct + base, correct - base },
                        "Benar! Pangkat = perkalian berulang. Semakin dalam, semakin terpahami.",
                        ("%d dipangkatkan %d artinya %d dikalikan dirinya sendiri %d kali."):format(base, exp, base, exp)
                )
        elseif pick == 2 then
                local x = math.random(1, 8)
                local a, b = math.random(2, 5), math.random(1, 6)
                local correct = a * x + b
                return question(
                        ("Fungsi f(x) = %dx + %d. Berapa f(%d)?"):format(a, b, x),
                        correct,
                        near(correct),
                        ("Benar! Masukkan %d ke x: %d(%d) + %d = %d."):format(x, a, x, b, correct),
                        ("Ganti setiap x dengan %d, lalu hitung sesuai urutan operasi."):format(x)
                )
        else
                local root = math.random(2, 12)
                local square = root * root
                return question(
                        ("Akar dari %d?"):format(square),
                        root,
                        { root + 1, root - 1, root * 2 },
                        ("Benar! %d x %d kembali ke %d. Akar adalah kebalikan kuadrat."):format(root, root, square),
                        "Coba kuadratkan pilihan-pilihannya - mana yang kembali ke " .. square .. "?"
                )
        end
end

--------------------------------------------------------------------
-- ZONA 6: PUNCAK RISET - prima, modulo, nalar tingkat lanjut
--------------------------------------------------------------------
local function salju(): any
        local pick = math.random(1, 3)
        if pick == 1 then
                local primes = { 7, 11, 13, 17, 19, 23 }
                local p = primes[math.random(1, #primes)]
                local composites = { 9, 15, 21, 25, 27, 33 }
                local c = composites[math.random(1, #composites)]
                local correct = math.random() < 0.5 and p or c
                local askPrima = correct == p
                return question(
                        ("Manakah bilangan PRIMA: %d atau %d?"):format(p, c),
                        correct,
                        { askPrima and c or p },
                        "Benar! Prima hanya habis dibagi 1 dan dirinya sendiri.",
                        ("Uji bagi: apakah %d bisa dibagi bilangan lain selain 1 dan dirinya?"):format(askPrima and c or p)
                )
        elseif pick == 2 then
                local a = math.random(10, 40)
                local n = math.random(3, 6)
                local correct = a % n
                return question(
                        ("Sisa pembagian %d mod %d?"):format(a, n),
                        correct,
                        near(correct),
                        "Benar! Modulo = sisa setelah dibagi rata. Jam bergulir juga begitu.",
                        ("%d dibagi %d: kali berapa supaya mendekati, sisanya berapa?"):format(a, n)
                )
        else
                local a = math.random(3, 9)
                local correct = a * (a + 1) / 2 * 2
                return question(
                        ("Jumlah 1 + 2 + ... + %d, lalu dikali 2. Hasilnya?"):format(a),
                        correct,
                        near(correct),
                        "Benar! Rumus Gauss n(n+1)/2 lalu dilipatgandakan - riset dimulai dari tools yang tepat.",
                        ("Hitung 1+2+...+%d = %d(%d+1)/2 dulu, baru kali 2."):format(a, a, a)
                )
        end
end

local GENERATORS = { kamp, hutan, gunung, kota, lembah, salju }

--- zoneIndex 1..6
function MathGen.generate(zoneIndex: number): any
        local gen = GENERATORS[math.clamp(zoneIndex, 1, #GENERATORS)]
        return gen()
end

return MathGen
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[--!nonstrict
--[[
	Util.luau - helper bersama (server & client).
]]

local Util = {}

local SUFFIXES = { "", "K", "M", "B", "T" }

function Util.formatNumber(n: number): string
	n = math.floor(n)
	if n < 1000 then
		return tostring(n)
	end
	local idx = math.floor(math.log10(n) / 3)
	if idx >= #SUFFIXES then
		idx = #SUFFIXES - 1
	end
	local m = n / (1000 ^ idx)
	local text
	if m >= 100 then
		text = string.format("%.0f", m)
	elseif m >= 10 then
		text = string.format("%.1f", m)
	else
		text = string.format("%.2f", m)
	end
	text = text:gsub("%.?0+$", "")
	return text .. SUFFIXES[idx + 1]
end

function Util.deepCopy<T>(t: T): T
	if type(t) ~= "table" then
		return t
	end
	local out = {}
	for k, v in pairs(t :: any) do
		out[k] = Util.deepCopy(v)
	end
	return out :: any
end

function Util.retry<T>(attempts: number, fn: () -> ...any): (boolean, ...any)
	local ok, a, b, c = false, nil, nil, nil
	for i = 1, attempts do
		ok, a, b, c = pcall(fn)
		if ok then
			return true, a, b, c
		end
		task.wait(i * 2)
	end
	return false, a
end

function Util.create(className: string, props: { [string]: any }?, parent: Instance?): Instance
	local inst = Instance.new(className)
	if props then
		for k, v in pairs(props) do
			(inst :: any)[k] = v
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

--- Warna zona dari Config.Zones (array {r,g,b} 0-255) -> Color3.
function Util.zoneColor(rgb): Color3
	return Color3.fromRGB(rgb[1], rgb[2], rgb[3])
end

return Util
]]></string>
        </Properties>
      </Item>
