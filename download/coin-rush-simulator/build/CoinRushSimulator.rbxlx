    <Item class="Script" referent="7">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!nonstrict
--[[
	init.server.luau
	Server bootstrap. Init order matters:
	  Remotes -> Map -> Data loops -> Economy loops -> Monetization ->
	  Pets -> Shop -> Leaderboard -> per-player: data load -> setup.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Remotes)

Remotes.init()

local Modules = script.Modules
local MapService = require(Modules.MapService)
local DataService = require(Modules.DataService)
local EconomyService = require(Modules.EconomyService)
local MonetizationService = require(Modules.MonetizationService)
local PetService = require(Modules.PetService)
local ShopService = require(Modules.ShopService)
local LeaderboardService = require(Modules.LeaderboardService)

MapService.init()
DataService.startLoops()
EconomyService.startLoops()
MonetizationService.init()
PetService.init()
ShopService.init()
LeaderboardService.init()

local function onPlayerAdded(player: Player)
	local ok = DataService.load(player)
	if not ok then
		player:Kick("Data failed to load - please rejoin in a minute.")
		return
	end
	EconomyService.setupPlayer(player)
	PetService.validateEquipped(player)
	EconomyService.requestSync(player)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

print("[CoinRush] Server booted: map + services ready.")
]]></string>
      </Properties>
      <Item class="Folder" referent="8">
        <Properties>
          <string name="Name">Modules</string>
        </Properties>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
        DataService.luau
        Loads/saves per-player data with retries, autosave and graceful shutdown.
        Also validates loaded data against the template so old/corrupt saves
        never crash the server.
]]

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Util = require(ReplicatedStorage.Shared.Util)

local DataService = {}

local store = DataStoreService:GetDataStore(Config.Data.StoreName)

-- Sessions[player] = { data = table, dirty = boolean }
local sessions: { [Player]: { data: { [string]: any }, dirty: boolean } } = {}

local DEFAULT_DATA = {
        Coins = 0,
        TotalEarned = 0,
        Rebirths = 0,
        Upgrades = { MultiClick = 0, CoinBoost = 0, AutoClick = 0 },
        Pets = {}, -- owned pet ids
        Equipped = {}, -- equipped pet ids (max = equip cap)
        Gamepasses = { DoubleCoins = false, VIP = false, TurboHands = false },
        LastSeen = 0,
}

local function sanitize(data: any): { [string]: any }
        local out = Util.deepCopy(DEFAULT_DATA)
        if type(data) ~= "table" then
                return out
        end
        out.Coins = tonumber(data.Coins) or 0
        out.TotalEarned = tonumber(data.TotalEarned) or 0
        out.Rebirths = tonumber(data.Rebirths) or 0
        if type(data.Upgrades) == "table" then
                for _, upg in Config.Upgrades do
                        out.Upgrades[upg.id] = math.min(tonumber(data.Upgrades[upg.id]) or 0, upg.max)
                end
        end
        if type(data.Pets) == "table" then
                for _, pet in Config.Pets do
                        if table.find(data.Pets, pet.id) then
                                table.insert(out.Pets, pet.id)
                        end
                end
        end
        if type(data.Equipped) == "table" then
                for _, id in data.Equipped do
                        local owned = table.find(out.Pets, id)
                        if owned and #out.Equipped < Config.VipEquipCap then
                                table.insert(out.Equipped, id)
                        end
                end
        end
        if type(data.Gamepasses) == "table" then
                for key in out.Gamepasses do
                        out.Gamepasses[key] = data.Gamepasses[key] == true
                end
        end
        out.LastSeen = tonumber(data.LastSeen) or 0
        return out
end

function DataService.get(player: Player): { [string]: any }
        local session = sessions[player]
        return session and session.data or DEFAULT_DATA
end

--- True if the player has a real (loaded) session.
function DataService.has(player: Player): boolean
        return sessions[player] ~= nil
end

function DataService.markDirty(player: Player)
        local session = sessions[player]
        if session then
                session.dirty = true
        end
end

--- Loads (or creates) data for a joining player. Kicks after repeated failure.
--- Returns true on success.
function DataService.load(player: Player): boolean
        local key = "p_" .. player.UserId
        local ok, raw = Util.retry(Config.Data.LoadRetries, function()
                return store:GetAsync(key)
        end)
        if not ok then
                return false
        end
        sessions[player] = { data = sanitize(raw), dirty = false }
        return true
end

function DataService.save(player: Player): boolean
        local session = sessions[player]
        if not session then
                return false
        end
        session.data.LastSeen = os.time()
        local key = "p_" .. player.UserId
        local ok = Util.retry(Config.Data.LoadRetries, function()
                store:SetAsync(key, session.data)
        end)
        if ok then
                session.dirty = false
        end
        return ok
end

function DataService.startLoops()
        -- Autosave loop
        task.spawn(function()
                while true do
                        task.wait(Config.Data.AutosaveInterval)
                        for player in sessions do
                                local session = sessions[player]
                                if session and session.dirty then
                                        task.spawn(DataService.save, player)
                                end
                        end
                end
        end)

        Players.PlayerRemoving:Connect(function(player)
                DataService.save(player)
                sessions[player] = nil
        end)

        game:BindToClose(function()
                for player in sessions do
                        DataService.save(player)
                end
        end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
	EconomyService.luau
	All coin math lives here and ONLY here (server-authoritative):
	  - click value & passive income formulas
	  - click rate limiting (anti-exploit)
	  - debounced StateSync to clients + leaderstats
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Remotes)
local DataService = require(script.Parent.DataService)

local EconomyService = {}

local stateSync = Remotes.get("StateSync")
local notifyRemote = Remotes.get("Notify")

local SYNC_DEBOUNCE = 0.2

-- player -> { windowStart, count } for the click rate limiter
local clickLimiter: { [Player]: { windowStart: number, count: number } } = {}
-- player -> pending sync flag (debounce)
local syncPending: { [Player]: boolean } = {}
-- player -> leaderstats IntValue handles
local statsHandles: { [Player]: { Coins: IntValue, Rebirths: IntValue } } = {}

--------------------------------------------------------------------
-- FORMULAS
--------------------------------------------------------------------

--- Permanent multiplier from rebirths (1 + 0.5 per rebirth).
function EconomyService.rebirthMult(data): number
	return 1 + data.Rebirths * Config.Rebirth.BonusPer
end

--- Total percentage bonus from CoinBoost upgrade levels.
--- Config.Upgrades[2] is CoinBoost by design (see Config.luau order).
function EconomyService.boostMult(data): number
	local upgrade = nil
	for _, u in Config.Upgrades do
		if u.id == "CoinBoost" then
			upgrade = u
			break
		end
	end
	local percent = (upgrade and upgrade.percent) or 10
	return 1 + (data.Upgrades.CoinBoost * percent) / 100
end

--- Combined multiplier: rebirth x boost x gamepasses.
function EconomyService.totalMult(data): number
	local mult = EconomyService.rebirthMult(data) * EconomyService.boostMult(data)
	if data.Gamepasses.DoubleCoins then
		mult = mult * 2
	end
	if data.Gamepasses.VIP then
		mult = mult * 1.25
	end
	return mult
end

--- Coins per click.
function EconomyService.clickValue(data): number
	local perLevel = nil
	for _, u in Config.Upgrades do
		if u.id == "MultiClick" then
			perLevel = u.perLevel
			break
		end
	end
	local base = Config.Economy.BaseClickValue + data.Upgrades.MultiClick * (perLevel or 1)
	return base * EconomyService.totalMult(data)
end

--- Coins per second (Auto Click upgrade + equipped pets + Turbo Hands).
function EconomyService.perSecond(data): number
	local inc = 0
	for _, u in Config.Upgrades do
		if u.id == "AutoClick" then
			inc = data.Upgrades.AutoClick * (u.perLevel or 2)
			break
		end
	end
	for _, petId in data.Equipped do
		for _, pet in Config.Pets do
			if pet.id == petId then
				inc += pet.income
				break
			end
		end
	end
	if data.Gamepasses.TurboHands then
		inc += 20
	end
	return inc * EconomyService.totalMult(data)
end

--- Cost of the next level of an upgrade (nil when maxed).
function EconomyService.upgradeCost(upgradeDef, currentLevel: number): number?
	if currentLevel >= upgradeDef.max then
		return nil
	end
	return math.floor(upgradeDef.base * upgradeDef.growth ^ currentLevel + 0.5)
end

function EconomyService.rebirthCost(data): number
	return math.floor(Config.Rebirth.BaseCost * Config.Rebirth.Growth ^ data.Rebirths + 0.5)
end

--------------------------------------------------------------------
-- GRANTING COINS (single entry point so TotalEarned stays consistent)
--------------------------------------------------------------------

--- Adds coins (fractional amounts allowed, dust below 1 coin is dropped).
function EconomyService.addCoins(player: Player, amount: number)
	local data = DataService.get(player)
	if amount <= 0 then
		return
	end
	data.Coins = math.floor(data.Coins + amount)
	data.TotalEarned = math.floor(data.TotalEarned + amount)
	DataService.markDirty(player)
end

function EconomyService.spendCoins(player: Player, amount: number): boolean
	local data = DataService.get(player)
	if data.Coins < amount then
		return false
	end
	data.Coins -= amount
	DataService.markDirty(player)
	return true
end

--------------------------------------------------------------------
-- CLICKS (rate limited)
--------------------------------------------------------------------

function EconomyService.registerClick(player: Player)
	if not DataService.has(player) then
		return
	end
	local limiter = clickLimiter[player]
	if not limiter then
		limiter = { windowStart = time(), count = 0 }
		clickLimiter[player] = limiter
	end
	local now = time()
	if now - limiter.windowStart >= 1 then
		limiter.windowStart = now
		limiter.count = 0
	end
	limiter.count += 1
	if limiter.count > Config.Economy.MaxClicksPerSecond then
		return -- silently drop; exploiters gain nothing
	end
	local value = EconomyService.clickValue(DataService.get(player))
	EconomyService.addCoins(player, value)
	EconomyService.requestSync(player)
end

--------------------------------------------------------------------
-- SYNC + LEADERSTATS
--------------------------------------------------------------------

--- Debounced full-state push to one client. Also refreshes leaderstats.
function EconomyService.requestSync(player: Player)
	if syncPending[player] then
		return
	end
	syncPending[player] = true
	task.delay(SYNC_DEBOUNCE, function()
		syncPending[player] = nil
		if not player.Parent or not DataService.has(player) then
			return
		end
		local data = DataService.get(player)
		stateSync:FireClient(player, {
			Coins = data.Coins,
			TotalEarned = data.TotalEarned,
			Rebirths = data.Rebirths,
			Upgrades = data.Upgrades,
			Pets = data.Pets,
			Equipped = data.Equipped,
			Gamepasses = data.Gamepasses,
			PerSecond = EconomyService.perSecond(data),
			ClickValue = EconomyService.clickValue(data),
			RebirthCost = EconomyService.rebirthCost(data),
			EquipCap = data.Gamepasses.VIP and Config.VipEquipCap or Config.PetEquipCap,
		})
		local handles = statsHandles[player]
		if handles then
			handles.Coins.Value = data.Coins
			handles.Rebirths.Value = data.Rebirths
		end
	end)
end

--------------------------------------------------------------------
-- LOOPS
--------------------------------------------------------------------

function EconomyService.startLoops()
	-- Passive income tick (1s)
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in Players:GetPlayers() do
				if DataService.has(player) then
					local inc = EconomyService.perSecond(DataService.get(player))
					if inc > 0 then
						EconomyService.addCoins(player, inc)
						EconomyService.requestSync(player)
					end
				end
			end
		end
	end)

	-- Cleanup on leave
	Players.PlayerRemoving:Connect(function(player)
		clickLimiter[player] = nil
		syncPending[player] = nil
		statsHandles[player] = nil
	end)
end

--- Call once per player after data load: create leaderstats + first sync.
function EconomyService.setupPlayer(player: Player)
	local data = DataService.get(player)

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"

	local coinsStat = Instance.new("IntValue")
	coinsStat.Name = "Coins"
	coinsStat.Value = data.Coins
	coinsStat.Parent = leaderstats

	local rebirthStat = Instance.new("IntValue")
	rebirthStat.Name = "Rebirths"
	rebirthStat.Value = data.Rebirths
	rebirthStat.Parent = leaderstats

	leaderstats.Parent = player
	statsHandles[player] = { Coins = coinsStat, Rebirths = rebirthStat }

	EconomyService.requestSync(player)
	notifyRemote:FireClient(player, "Welcome", "Tap the giant coin or the button below to earn coins!")
end

return EconomyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
        LeaderboardService.luau
        Global top-10 board by TotalEarned (OrderedDataStore):
          - uploads every online player's TotalEarned each refresh
          - reads the top 10 and renders them on physical boards (SurfaceGui)
          - serves the same rows to clients on request (RemoteFunction)
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Remotes)
local DataService = require(script.Parent.DataService)
local Util = require(ReplicatedStorage.Shared.Util)

local LeaderboardService = {}

local orderedStore = DataStoreService:GetOrderedDataStore(Config.Data.OrderedStoreName)
local lbRemote = Remotes.get("GetLeaderboard")

local latestRows: { { name: string, value: number } } = {}
local boards: { SurfaceGui } = {}

--------------------------------------------------------------------
-- BOARD CONSTRUCTION (procedural)
--------------------------------------------------------------------

local function buildBoard(position: Vector3, lookAt: Vector3): SurfaceGui
        local part = Instance.new("Part")
        part.Name = "GlobalLeaderboard"
        part.Size = Vector3.new(18, 11, 1)
        part.Anchored = true
        part.Material = Enum.Material.SmoothPlastic
        part.Color = Color3.fromRGB(25, 28, 38)
        part.CFrame = CFrame.lookAt(position, lookAt)
        part.Parent = workspace

        local gui = Instance.new("SurfaceGui")
        gui.Face = Enum.NormalId.Front
        gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
        gui.PixelsPerStud = 50
        gui.Parent = part

        local title = Instance.new("TextLabel")
        title.Size = UDim2.fromScale(1, 0.16)
        title.BackgroundTransparency = 1
        title.Font = Enum.Font.GothamBlack
        title.TextScaled = true
        title.TextColor3 = Color3.fromRGB(255, 196, 37)
        title.Text = "TOP COIN EARNERS"
        title.Parent = gui

        local list = Instance.new("Frame")
        list.Position = UDim2.fromScale(0.05, 0.2)
        list.Size = UDim2.fromScale(0.9, 0.76)
        list.BackgroundTransparency = 1
        list.Parent = gui

        local layout = Instance.new("UIListLayout")
        layout.Padding = UDim.new(0.02, 0)
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Parent = list

        for i = 1, Config.Leaderboard.Size do
                local row = Instance.new("TextLabel")
                row.Name = "Row" .. i
                row.Size = UDim2.fromScale(1, 0.09)
                row.BackgroundTransparency = 1
                row.Font = Enum.Font.GothamBold
                row.TextXAlignment = Enum.TextXAlignment.Left
                row.TextScaled = true
                row.TextColor3 = Color3.fromRGB(230, 230, 240)
                row.Text = i .. ". -"
                row.Parent = list
                if i == 1 then
                        row.TextColor3 = Color3.fromRGB(255, 215, 0)
                elseif i == 2 then
                        row.TextColor3 = Color3.fromRGB(200, 200, 210)
                elseif i == 3 then
                        row.TextColor3 = Color3.fromRGB(205, 127, 50)
                end
        end

        table.insert(boards, gui)
        return gui
end

local function renderRows()
        for _, gui in boards do
                local list = gui:FindFirstChildOfClass("Frame")
                if not list then
                        continue
                end
                for i = 1, Config.Leaderboard.Size do
                        local row = list:FindFirstChild("Row" .. i)
                        if not row then
                                continue
                        end
                        local entry = latestRows[i]
                        if entry then
                                (row :: TextLabel).Text = i .. ". " .. entry.name .. " - " .. Util.formatNumber(entry.value)
                        else
                                (row :: TextLabel).Text = i .. ". -"
                        end
                end
        end
end

--------------------------------------------------------------------
-- REFRESH LOOP
--------------------------------------------------------------------

local function refresh()
        -- 1) Upload all online players
        for _, player in Players:GetPlayers() do
                if DataService.has(player) then
                        local data = DataService.get(player)
                        pcall(function()
                                orderedStore:SetAsync(tostring(player.UserId), math.floor(data.TotalEarned))
                        end)
                end
        end

        -- 2) Read top 10
        local ok, pages = pcall(function()
                return orderedStore:GetSortedAsync(false, Config.Leaderboard.Size)
        end)
        if not ok or not pages then
                return
        end
        local page = pages:GetCurrentPage()
        local rows: { { name: string, value: number } } = {}
        for rank, entry in page do
                local name = "Player " .. entry.key
                local lookup = Players:GetPlayerByUserId(tonumber(entry.key) or 0)
                if lookup then
                        name = lookup.DisplayName
                else
                        local okName, fetched = pcall(Players.GetNameFromUserIdAsync, Players, tonumber(entry.key) or 0)
                        if okName and fetched then
                                name = fetched
                        end
                end
                rows[rank] = { name = name, value = entry.value }
        end
        latestRows = rows
        renderRows()
end

--------------------------------------------------------------------
-- INIT
--------------------------------------------------------------------

function LeaderboardService.init()
        lbRemote.OnServerInvoke = function()
                return latestRows
        end

        -- Two physical boards flanking the spawn area
        buildBoard(Vector3.new(-26, 10, 22), Vector3.new(0, 8, -10))
        buildBoard(Vector3.new(26, 10, 22), Vector3.new(0, 8, -10))

        task.spawn(function()
                -- first refresh soon, then periodically
                task.wait(5)
                while true do
                        refresh()
                        task.wait(Config.Leaderboard.RefreshInterval)
                end
        end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">MapService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
        MapService.luau
        Builds the entire map procedurally at server boot - zero uploaded assets:
          - floating grass island
          - giant clickable coin (idle spin + ClickDetector)
          - spawn arch signage, decorative trees & crystals
        SpawnLocation comes from default.project.json.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local EconomyService = require(script.Parent.EconomyService)

local MapService = {}

local folder = Instance.new("Folder")
folder.Name = "Map"

local function part(props): Part
        local p = Instance.new("Part")
        p.Anchored = true
        p.TopSurface = Enum.SurfaceType.Smooth
        p.BottomSurface = Enum.SurfaceType.Smooth
        for k, v in props do
                (p :: any)[k] = v
        end
        p.Parent = folder
        return p
end

local function buildIsland()
        local radius = Config.World.IslandRadius
        local island = part({
                Name = "Island",
                Shape = Enum.PartType.Cylinder,
                Size = Vector3.new(4, radius * 2, radius * 2),
                CFrame = CFrame.new(0, 0, 0) * CFrame.Angles(0, 0, math.rad(90)),
                Color = Color3.fromRGB(90, 160, 70),
                Material = Enum.Material.Grass,
        })
        _ = island
        -- underside rock wedge for depth
        part({
                Name = "IslandBase",
                Size = Vector3.new(radius * 1.2, radius * 0.9, radius * 1.2),
                CFrame = CFrame.new(0, -radius * 0.45, 0) * CFrame.Angles(math.rad(45), 0, math.rad(45)),
                Color = Color3.fromRGB(90, 85, 80),
                Material = Enum.Material.Slate,
        })
end

local function buildCoin()
        local pos = Config.World.CoinPosition
        local d = Config.World.CoinSize
        local coin = part({
                Name = "GiantCoin",
                Shape = Enum.PartType.Cylinder,
                Size = Vector3.new(1.6, d, d),
                CFrame = CFrame.new(pos[1], pos[2], pos[3]) * CFrame.Angles(0, math.rad(90), 0),
                Color = Color3.fromRGB(255, 196, 37),
                Material = Enum.Material.Neon,
        })

        -- idle spin (server-side tween, cheap: single anchored part)
        local spin = TweenService:Create(
                coin,
                TweenInfo.new(8, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1),
                { CFrame = coin.CFrame * CFrame.Angles(0, math.rad(360), 0) }
        )
        spin:Play()

        -- click detection: players can click the coin directly
        local click = Instance.new("ClickDetector")
        click.MaxActivationDistance = 40
        click.Parent = coin
        click.MouseClick:Connect(function(player)
                EconomyService.registerClick(player)
        end)

        -- pedestal
        part({
                Name = "CoinPedestal",
                Size = Vector3.new(10, 2, 10),
                CFrame = CFrame.new(pos[1], 3, pos[3]),
                Color = Color3.fromRGB(60, 64, 80),
                Material = Enum.Material.SmoothPlastic,
        })
end

local function buildSignage()
        -- arch over spawn: two pillars + beam with game title
        local pillarMat = { Color = Color3.fromRGB(60, 64, 80), Material = Enum.Material.SmoothPlastic }
        part({
                Name = "SignPillarL",
                Size = Vector3.new(2, 16, 2),
                CFrame = CFrame.new(-8, 10, 40),
                Color = pillarMat.Color,
                Material = pillarMat.Material,
        })
        part({
                Name = "SignPillarR",
                Size = Vector3.new(2, 16, 2),
                CFrame = CFrame.new(8, 10, 40),
                Color = pillarMat.Color,
                Material = pillarMat.Material,
        })
        local beam = part({
                Name = "SignBeam",
                Size = Vector3.new(20, 3.5, 1.5),
                CFrame = CFrame.new(0, 18, 40),
                Color = Color3.fromRGB(25, 28, 38),
                Material = Enum.Material.SmoothPlastic,
        })
        local gui = Instance.new("SurfaceGui")
        gui.Face = Enum.NormalId.Front
        gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
        gui.PixelsPerStud = 50
        gui.Parent = beam
        local label = Instance.new("TextLabel")
        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1
        label.Font = Enum.Font.GothamBlack
        label.TextScaled = true
        label.TextColor3 = Color3.fromRGB(255, 196, 37)
        label.Text = "COIN RUSH SIMULATOR"
        label.Parent = gui
end

local function buildTrees()
        local rng = Random.new(42)
        for i = 1, 8 do
                local angle = (i / 8) * math.pi * 2 + rng:NextNumber(-0.15, 0.15)
                local dist = 62 + rng:NextNumber(-6, 6)
                local x = math.cos(angle) * dist
                local z = math.sin(angle) * dist
                part({
                        Name = "TreeTrunk" .. i,
                        Size = Vector3.new(2, 9, 2),
                        CFrame = CFrame.new(x, 6.5, z),
                        Color = Color3.fromRGB(120, 82, 45),
                        Material = Enum.Material.Wood,
                })
                part({
                        Name = "TreeTop" .. i,
                        Shape = Enum.PartType.Ball,
                        Size = Vector3.new(11, 11, 11),
                        CFrame = CFrame.new(x, 13, z),
                        Color = Color3.fromRGB(60, 140, 60),
                        Material = Enum.Material.Grass,
                })
        end
end

local function buildCrystals()
        local rng = Random.new(7)
        for i = 1, 6 do
                local angle = rng:NextNumber(0, math.pi * 2)
                local dist = rng:NextNumber(24, 46)
                part({
                        Name = "Crystal" .. i,
                        Size = Vector3.new(2.5, rng:NextNumber(4, 7), 2.5),
                        CFrame = CFrame.new(math.cos(angle) * dist, 4, math.sin(angle) * dist)
                                * CFrame.Angles(0, rng:NextNumber(0, math.pi), math.rad(18)),
                        Color = Color3.fromRGB(140, 110, 255),
                        Material = Enum.Material.Neon,
                        Transparency = 0.15,
                })
        end
end

function MapService.init()
        folder.Parent = workspace
        buildIsland()
        buildCoin()
        buildSignage()
        buildTrees()
        buildCrystals()
end

return MapService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">MonetizationService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
        MonetizationService.luau
        - Grants gamepass perks on join (re-checks ownership with Roblox)
        - Grants perks instantly when a purchase finishes mid-session
        - Processes developer product receipts (coin packs)

        All IDs live in Config.Gamepasses / Config.Products. id = 0 means
        "not configured yet": the feature is skipped safely.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Remotes)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)

local MonetizationService = {}

local notifyRemote = Remotes.get("Notify")
-- Receipt ledger: PurchaseId -> true. Guarantees a purchase is granted
-- exactly once even if the server crashes mid-receipt.
local receiptStore = DataStoreService:GetDataStore("CRS_Receipts_v1")

local passIdToKey: { [number]: string } = {}
local productIdToKey: { [number]: string } = {}

local function grantPass(player: Player, key: string, announce: boolean)
        local data = DataService.get(player)
        if data.Gamepasses[key] then
                return
        end
        data.Gamepasses[key] = true
        DataService.markDirty(player)
        if announce then
                notifyRemote:FireClient(player, "Thanks!", Config.Gamepasses[key].name .. " is now active!")
        end
        EconomyService.requestSync(player)
end

function MonetizationService.init()
        for key, def in Config.Gamepasses do
                if def.id and def.id > 0 then
                        passIdToKey[def.id] = key
                end
        end
        for key, def in Config.Products do
                if def.id and def.id > 0 then
                        productIdToKey[def.id] = key
                end
        end

        -- Re-verify ownership on join (covers restores & cross-device)
        Players.PlayerAdded:Connect(function(player)
                for key, def in Config.Gamepasses do
                        if def.id and def.id > 0 then
                                task.spawn(function()
                                        local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, def.id)
                                        if ok and owns then
                                                grantPass(player, key, false)
                                        end
                                end)
                        end
                end
        end)

        -- Instant grant when bought mid-session
        MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId: number, purchased: boolean)
                if purchased then
                        local key = passIdToKey[passId]
                        if key then
                                grantPass(player, key, true)
                        end
                end
        end)

        -- Developer products (coin packs). Official pattern:
        -- record receipt first, then grant, then acknowledge.
        MarketplaceService.ProcessReceipt = function(receipt)
                local key = productIdToKey[receipt.ProductId]
                if not key then
                        return Enum.ProductPurchaseDecision.NotProcessedYet
                end
                local player = Players:GetPlayerByUserId(receipt.PlayerId)
                if not player or not DataService.has(player) then
                        return Enum.ProductPurchaseDecision.NotProcessedYet
                end

                -- 1) Dedupe: skip if we already granted this exact receipt
                local already, granted = pcall(function()
                        return receiptStore:GetAsync("r_" .. receipt.PurchaseId)
                end)
                if already and granted == true then
                        return Enum.ProductPurchaseDecision.PurchaseGranted
                end

                -- 2) Record BEFORE granting (crash-safe: retry grants again)
                local recorded = pcall(function()
                        receiptStore:SetAsync("r_" .. receipt.PurchaseId, true)
                end)
                if not recorded then
                        return Enum.ProductPurchaseDecision.NotProcessedYet
                end

                -- 3) Grant + acknowledge
                local def = Config.Products[key]
                EconomyService.addCoins(player, def.coins)
                EconomyService.requestSync(player)
                notifyRemote:FireClient(player, "Purchase", "+" .. def.coins .. " coins delivered!")
                return Enum.ProductPurchaseDecision.PurchaseGranted
        end
end

return MonetizationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">PetService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
        PetService.luau
        Pet ownership & equipped slots are stored in player data (DataService).
        Pet INCOME is computed server-side in EconomyService - exploit-proof.
        Pet MODELS are purely cosmetic and rendered client-side (PetVisuals.luau),
        so there is zero replication traffic for pet movement.

        This service keeps equipped slots consistent with ownership and caps
        (e.g. a player who lost VIP gets trimmed back to the normal cap).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local PetService = {}

--- Rebuilds data.Equipped in place: owned-only, no duplicates, within cap.
function PetService.validateEquipped(player: Player): { string }
        local DataService = require(script.Parent.DataService)
        local data = DataService.get(player)
        local cap = data.Gamepasses.VIP and Config.VipEquipCap or Config.PetEquipCap

        local valid: { string } = {}
        for _, petId in data.Equipped do
                if #valid >= cap then
                        break
                end
                if table.find(data.Pets, petId) and not table.find(valid, petId) then
                        table.insert(valid, petId)
                end
        end
        data.Equipped = valid
        DataService.markDirty(player)
        return valid
end

function PetService.init()
        Players.PlayerAdded:Connect(function(player)
                PetService.validateEquipped(player)
        end)
        -- Also run once for anyone already present (robust against init order)
        for _, player in Players:GetPlayers() do
                PetService.validateEquipped(player)
        end
end

return PetService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
        ShopService.luau
        Handles the Purchase RemoteFunction: upgrades, pets, rebirth.
        Every purchase is validated server-side against Config prices.
        Client can never dictate a price.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Remotes)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local PetService = require(script.Parent.PetService)

local ShopService = {}

local purchaseRemote = Remotes.get("Purchase")
local notifyRemote = Remotes.get("Notify")

local function upgradeById(id: string)
        for _, u in Config.Upgrades do
                if u.id == id then
                        return u
                end
        end
        return nil
end

local function petById(id: string)
        for _, p in Config.Pets do
                if p.id == id then
                        return p
                end
        end
        return nil
end

--------------------------------------------------------------------
-- HANDLERS
--------------------------------------------------------------------

local function buyUpgrade(player: Player, upgradeId: string): (boolean, string)
        local def = upgradeById(upgradeId)
        if not def then
                return false, "Unknown upgrade."
        end
        local data = DataService.get(player)
        local level = data.Upgrades[def.id] or 0
        local cost = EconomyService.upgradeCost(def, level)
        if not cost then
                return false, def.name .. " is already maxed!"
        end
        if not EconomyService.spendCoins(player, cost) then
                return false, "Not enough coins! Need " .. string.format("%d", cost) .. "."
        end
        data.Upgrades[def.id] = level + 1
        DataService.markDirty(player)
        return true, def.name .. " -> Lv " .. (level + 1) .. "!"
end

local function buyPet(player: Player, petId: string): (boolean, string)
        local def = petById(petId)
        if not def then
                return false, "Unknown pet."
        end
        local data = DataService.get(player)
        if table.find(data.Pets, def.id) then
                return false, "You already own " .. def.name .. "."
        end
        if not EconomyService.spendCoins(player, def.price) then
                return false, "Not enough coins! " .. def.name .. " costs " .. def.price .. "."
        end
        table.insert(data.Pets, def.id)
        DataService.markDirty(player)
        return true, def.name .. " hatched! Equip it in the Pets tab."
end

local function equipPet(player: Player, petId: string, equip: boolean): (boolean, string)
        local def = petById(petId)
        if not def then
                return false, "Unknown pet."
        end
        local data = DataService.get(player)
        if equip then
                if not table.find(data.Pets, def.id) then
                        return false, "You don't own " .. def.name .. "."
                end
                if table.find(data.Equipped, def.id) then
                        return true, def.name .. " is already equipped."
                end
                local cap = data.Gamepasses.VIP and Config.VipEquipCap or Config.PetEquipCap
                if #data.Equipped >= cap then
                        return false, "Pet slots full (" .. cap .. "). Unequip one first."
                end
                table.insert(data.Equipped, def.id)
                DataService.markDirty(player)
                return true, def.name .. " equipped! +" .. def.income .. "/s"
        else
                local idx = table.find(data.Equipped, def.id)
                if not idx then
                        return true, def.name .. " is not equipped."
                end
                table.remove(data.Equipped, idx)
                DataService.markDirty(player)
                return true, def.name .. " unequipped."
        end
end

local function doRebirth(player: Player): (boolean, string)
        local data = DataService.get(player)
        local cost = EconomyService.rebirthCost(data)
        if data.Coins < cost then
                return false, "Rebirth needs " .. cost .. " coins!"
        end
        data.Coins = 0
        for _, u in Config.Upgrades do
                data.Upgrades[u.id] = 0
        end
        data.Rebirths += 1
        DataService.markDirty(player)
        EconomyService.requestSync(player)
        return true, "REBIRTH #" .. data.Rebirths .. "! Permanent x" .. (1 + data.Rebirths * Config.Rebirth.BonusPer) .. " coins!"
end

--------------------------------------------------------------------
-- WIRING
--------------------------------------------------------------------

function ShopService.init()
        PetService.init()

        purchaseRemote.OnServerInvoke = function(player, kind: string, arg: any)
                -- reject everything until the player's data finished loading
                if not DataService.has(player) then
                        notifyRemote:FireClient(player, "Shop", "Still loading - try again in a second.")
                        return false, "Data not loaded yet."
                end
                local ok, msg = false, "Invalid request."
                if kind == "upgrade" and type(arg) == "string" then
                        ok, msg = buyUpgrade(player, arg)
                elseif kind == "pet_buy" and type(arg) == "string" then
                        ok, msg = buyPet(player, arg)
                elseif kind == "pet_equip" and type(arg) == "string" then
                        ok, msg = equipPet(player, arg, true)
                elseif kind == "pet_unequip" and type(arg) == "string" then
                        ok, msg = equipPet(player, arg, false)
                elseif kind == "rebirth" then
                        ok, msg = doRebirth(player)
                end
                if ok then
                        EconomyService.requestSync(player)
                end
                notifyRemote:FireClient(player, ok and "Success" or "Shop", msg)
                return ok, msg
        end
end

return ShopService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="16">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="17">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="18">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!nonstrict
--[[
        init.client.luau
        Client bootstrap: build UI + pet visuals. Both modules subscribe
        to StateSync themselves.
]]

local UIController = require(script.UIController)
local PetVisuals = require(script.PetVisuals)

UIController.new()
PetVisuals.new()

print("[CoinRush] Client ready.")
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">PetVisuals</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
        PetVisuals.luau
        Purely cosmetic client-side pets: floating models that orbit the player.
        Created from Config (color/shape/size) - no uploaded assets.
        The server computes income; this is decoration only.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Remotes)

local PetVisuals = {}
PetVisuals.__index = PetVisuals

local player = Players.LocalPlayer

local function petDef(id: string)
        for _, def in Config.Pets do
                if def.id == id then
                        return def
                end
        end
        return nil
end

local function buildModel(def)
        local color = Color3.fromRGB(def.color[1], def.color[2], def.color[3])
        local size = def.size

        local model = Instance.new("Model")
        model.Name = "PetLocal_" .. def.id

        local body = Instance.new("Part")
        body.Name = "Body"
        body.Shape = def.shape == "Ball" and Enum.PartType.Ball or Enum.PartType.Block
        body.Size = Vector3.new(size, size, size)
        body.Color = color
        body.Material = Enum.Material.Neon
        body.Anchored = true
        body.CanCollide = false
        body.CanQuery = false
        body.CanTouch = false
        body.CastShadow = false
        body.Parent = model
        model.PrimaryPart = body

        local billboard = Instance.new("BillboardGui")
        billboard.Size = UDim2.new(0, 90, 0, 24)
        billboard.StudsOffset = Vector3.new(0, size + 0.6, 0)
        billboard.AlwaysOnTop = true
        billboard.MaxDistance = 80
        billboard.Parent = body

        local name = Instance.new("TextLabel")
        name.Size = UDim2.fromScale(1, 1)
        name.BackgroundTransparency = 1
        name.Font = Enum.Font.GothamBold
        name.TextScaled = true
        name.TextColor3 = color
        name.TextStrokeTransparency = 0.4
        name.Text = def.name
        name.Parent = billboard

        return model
end

function PetVisuals.new()
        local self = setmetatable({}, PetVisuals)
        self.equipped = {}
        self.models = {}
        self.folder = Instance.new("Folder")
        self.folder.Name = "PetVisuals_" .. player.Name

        Remotes.get("StateSync").OnClientEvent:Connect(function(state)
                self:setEquipped(state.Equipped)
        end)

        RunService.RenderStepped:Connect(function(dt)
                self:step(dt)
        end)

        return self
end

function PetVisuals:setEquipped(list: { string })
        if type(list) ~= "table" then
                return
        end
        self.equipped = list
        -- create missing models
        for _, id in list do
                if not self.models[id] then
                        local def = petDef(id)
                        if def then
                                local model = buildModel(def)
                                model.Parent = self.folder
                                self.models[id] = model
                        end
                end
        end
        -- remove models no longer equipped
        for id, model in self.models do
                if not table.find(list, id) then
                        model:Destroy()
                        self.models[id] = nil
                end
        end
end

function PetVisuals:step(dt: number)
        local character = player.Character
        local head = character and character:FindFirstChild("Head")
        if not head then
                self.folder.Parent = nil
                return
        end
        if self.folder.Parent ~= workspace then
                self.folder.Parent = workspace
        end

        local count = #self.equipped
        if count == 0 then
                return
        end

        local now = time()
        for i, id in self.equipped do
                local model = self.models[id]
                local root = model and model.PrimaryPart
                if root then
                        local angle = now * 1.6 + (i / count) * math.pi * 2
                        local bob = math.sin(now * 2.2 + i) * 0.35
                        local offset = Vector3.new(math.cos(angle) * 4.5, 2.4 + bob, math.sin(angle) * 4.5)
                        local target = head.Position + offset
                        local alpha = 1 - math.exp(-dt * 8)
                        root.CFrame = root.CFrame:Lerp(CFrame.new(target) * CFrame.Angles(0, angle, 0), alpha)
                end
        end
end

return PetVisuals
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">UIController</string>
            <string name="Source"><![CDATA[--!nonstrict
--[[
        UIController.luau
        Builds the whole game UI in code (no uploaded assets):
          - top coin counter (+ per second)
          - big circular click button with floating "+N" popups
          - shop with 3 tabs: Upgrades / Pets / Robux
          - rebirth button, global leaderboard panel, toast notifications
        All purchases go through the Purchase RemoteFunction; the server
        validates everything.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local MarketplaceService = game:GetService("MarketplaceService")

local Config = require(ReplicatedStorage.Shared.Config)
local Remotes = require(ReplicatedStorage.Remotes)
local Util = require(ReplicatedStorage.Shared.Util)

local UIController = {}
UIController.__index = UIController

--------------------------------------------------------------------
-- THEME
--------------------------------------------------------------------
local T = {
        Bg = Color3.fromRGB(18, 20, 28),
        Panel = Color3.fromRGB(30, 33, 45),
        PanelLight = Color3.fromRGB(42, 46, 62),
        Gold = Color3.fromRGB(255, 196, 37),
        Green = Color3.fromRGB(80, 200, 120),
        Red = Color3.fromRGB(235, 90, 90),
        Blue = Color3.fromRGB(90, 140, 255),
        Text = Color3.fromRGB(235, 235, 245),
        TextDim = Color3.fromRGB(160, 165, 180),
        Disabled = Color3.fromRGB(70, 74, 88),
}

local player = Players.LocalPlayer

--------------------------------------------------------------------
-- HELPERS
--------------------------------------------------------------------

local function corner(parent, radius)
        return Util.create("UICorner", { CornerRadius = UDim.new(0, radius or 10) }, parent)
end

local function makeSound()
        local s = Util.create("Sound", {
                SoundId = "rbxasset://sounds/electronicpingshort.wav",
                Volume = 0.4,
        }, SoundService)
        return s
end

--------------------------------------------------------------------
-- CONSTRUCTION
--------------------------------------------------------------------

function UIController.new()
        local self = setmetatable({}, UIController)

        self.state = nil
        self.sound = makeSound()

        self:buildRoot()
        self:buildCoinCounter()
        self:buildClickButton()
        self:buildSideButtons()
        self:buildShop()
        self:buildLeaderboardPanel()
        self:buildNotifyContainer()
        self:wireRemotes()

        return self
end

function UIController:buildRoot()
        self.gui = Util.create("ScreenGui", {
                Name = "CoinRushUI",
                ResetOnSpawn = false,
                IgnoreGuiInset = true,
                ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        }, player:WaitForChild("PlayerGui"))
end

function UIController:buildCoinCounter()
        local panel = Util.create("Frame", {
                Name = "CoinPanel",
                Position = UDim2.new(0.5, -140, 0, 12),
                Size = UDim2.new(0, 280, 0, 64),
                BackgroundColor3 = T.Panel,
                Parent = self.gui,
        })
        corner(panel, 16)

        local coin = Util.create("Frame", {
                Position = UDim2.new(0, 12, 0.5, -19),
                Size = UDim2.new(0, 38, 0, 38),
                BackgroundColor3 = T.Gold,
                Parent = panel,
        })
        corner(coin, 19)
        Util.create("TextLabel", {
                Size = UDim2.fromScale(1, 1),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBlack,
                Text = "C",
                TextScaled = true,
                TextColor3 = T.Bg,
                Parent = coin,
        })

        self.coinsLabel = Util.create("TextLabel", {
                Position = UDim2.new(0, 60, 0, 8),
                Size = UDim2.new(1, -70, 0, 30),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBlack,
                Text = "0",
                TextXAlignment = Enum.TextXAlignment.Left,
                TextScaled = true,
                TextColor3 = T.Text,
                Parent = panel,
        })

        self.perSecLabel = Util.create("TextLabel", {
                Position = UDim2.new(0, 60, 0, 38),
                Size = UDim2.new(1, -70, 0, 18),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBold,
                Text = "+0 /s",
                TextXAlignment = Enum.TextXAlignment.Left,
                TextScaled = true,
                TextColor3 = T.TextDim,
                Parent = panel,
        })
end

function UIController:buildClickButton()
        local btn = Util.create("TextButton", {
                Name = "ClickButton",
                AnchorPoint = Vector2.new(0.5, 1),
                Position = UDim2.new(0.5, 0, 1, -24),
                Size = UDim2.new(0, 120, 0, 120),
                BackgroundColor3 = T.Gold,
                Font = Enum.Font.GothamBlack,
                Text = "CLICK!\n+1",
                TextScaled = false,
                TextSize = 22,
                TextColor3 = T.Bg,
                AutoButtonColor = true,
                Parent = self.gui,
        })
        corner(btn, 60)
        Util.create("UIStroke", { Color = Color3.fromRGB(255, 230, 150), Thickness = 3 }, btn)
        self.clickButton = btn

        self.floatLayer = Util.create("Frame", {
                Name = "FloatLayer",
                BackgroundTransparency = 1,
                Size = UDim2.fromScale(1, 1),
                Parent = self.gui,
        })

        btn.Activated:Connect(function()
                self:onClicked()
        end)
end

function UIController:buildSideButtons()
        self.shopBtn = Util.create("TextButton", {
                AnchorPoint = Vector2.new(0, 1),
                Position = UDim2.new(0, 20, 1, -40),
                Size = UDim2.new(0, 120, 0, 48),
                BackgroundColor3 = T.Blue,
                Font = Enum.Font.GothamBlack,
                Text = "SHOP",
                TextSize = 22,
                TextColor3 = T.Text,
                Parent = self.gui,
        })
        corner(self.shopBtn, 12)
        self.shopBtn.Activated:Connect(function()
                self:setShopOpen(not self.shopOpen)
        end)

        self.rebirthBtn = Util.create("TextButton", {
                AnchorPoint = Vector2.new(0, 1),
                Position = UDim2.new(0, 20, 1, -100),
                Size = UDim2.new(0, 120, 0, 48),
                BackgroundColor3 = T.PanelLight,
                Font = Enum.Font.GothamBlack,
                Text = "REBIRTH",
                TextSize = 18,
                TextColor3 = T.Text,
                Parent = self.gui,
        })
        corner(self.rebirthBtn, 12)
        self.rebirthBtn.Activated:Connect(function()
                if self.state then
                        Remotes.get("Purchase"):InvokeServer("rebirth")
                end
        end)

        self.lbBtn = Util.create("TextButton", {
                Position = UDim2.new(1, -140, 0, 12),
                Size = UDim2.new(0, 120, 0, 40),
                BackgroundColor3 = T.Panel,
                Font = Enum.Font.GothamBlack,
                Text = "TOP 10",
                TextSize = 18,
                TextColor3 = T.Text,
                Parent = self.gui,
        })
        corner(self.lbBtn, 12)
        self.lbBtn.Activated:Connect(function()
                self:setLeaderboardOpen(not self.lbOpen)
        end)
end

--------------------------------------------------------------------
-- SHOP
--------------------------------------------------------------------

function UIController:buildShop()
        local frame = Util.create("Frame", {
                Name = "Shop",
                Visible = false,
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.fromScale(0.5, 0.5),
                Size = UDim2.new(0, 460, 0, 420),
                BackgroundColor3 = T.Bg,
                BackgroundTransparency = 0.06,
                Parent = self.gui,
        })
        corner(frame, 18)
        Util.create("UIStroke", { Color = T.PanelLight, Thickness = 2 }, frame)
        self.shopFrame = frame

        Util.create("TextLabel", {
                Position = UDim2.new(0, 16, 0, 10),
                Size = UDim2.new(1, -60, 0, 30),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBlack,
                Text = "SHOP",
                TextXAlignment = Enum.TextXAlignment.Left,
                TextSize = 22,
                TextColor3 = T.Gold,
                Parent = frame,
        })

        local close = Util.create("TextButton", {
                AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, -12, 0, 10),
                Size = UDim2.new(0, 30, 0, 30),
                BackgroundColor3 = T.Red,
                Font = Enum.Font.GothamBlack,
                Text = "X",
                TextSize = 16,
                TextColor3 = T.Text,
                Parent = frame,
        })
        corner(close, 8)
        close.Activated:Connect(function()
                self:setShopOpen(false)
        end)

        -- Tabs
        self.tabs = {}
        local tabNames = { "Upgrades", "Pets", "Robux" }
        for i, name in tabNames do
                local tab = Util.create("TextButton", {
                        Position = UDim2.new((i - 1) / 3, 4, 0, 46),
                        Size = UDim2.new(1 / 3, -8, 0, 34),
                        BackgroundColor3 = T.PanelLight,
                        Font = Enum.Font.GothamBold,
                        Text = name,
                        TextSize = 16,
                        TextColor3 = T.Text,
                        Parent = frame,
                })
                corner(tab, 8)
                self.tabs[name] = tab
                tab.Activated:Connect(function()
                        self:setTab(name)
                end)
        end

        -- Tab content: scrolling frames
        self.tabFrames = {}
        for _, name in tabNames do
                local scroll = Util.create("ScrollingFrame", {
                        Visible = false,
                        Position = UDim2.new(0, 12, 0, 90),
                        Size = UDim2.new(1, -24, 1, -104),
                        BackgroundTransparency = 1,
                        ScrollBarThickness = 4,
                        ScrollBarImageColor3 = T.PanelLight,
                        CanvasSize = UDim2.new(0, 0, 0, 0),
                        AutomaticCanvasSize = Enum.AutomaticSize.Y,
                        Parent = frame,
                })
                Util.create("UIListLayout", {
                        Padding = UDim.new(0, 8),
                        SortOrder = Enum.SortOrder.LayoutOrder,
                }, scroll)
                self.tabFrames[name] = scroll
        end

        self:populateUpgrades()
        self:populatePets()
        self:populateRobux()
        self:setTab("Upgrades")
end

local function newRow(parent): (Frame, TextLabel, TextLabel, TextButton)
        local row = Util.create("Frame", {
                Size = UDim2.new(1, -8, 0, 58),
                BackgroundColor3 = T.Panel,
                Parent = parent,
        })
        corner(row, 10)

        local nameLabel = Util.create("TextLabel", {
                Position = UDim2.new(0, 12, 0, 8),
                Size = UDim2.new(1, -140, 0, 22),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBold,
                Text = "Item",
                TextXAlignment = Enum.TextXAlignment.Left,
                TextSize = 17,
                TextColor3 = T.Text,
                Parent = row,
        })

        local subLabel = Util.create("TextLabel", {
                Position = UDim2.new(0, 12, 0, 32),
                Size = UDim2.new(1, -140, 0, 18),
                BackgroundTransparency = 1,
                Font = Enum.Font.Gotham,
                Text = "",
                TextXAlignment = Enum.TextXAlignment.Left,
                TextSize = 14,
                TextColor3 = T.TextDim,
                Parent = row,
        })

        local buy = Util.create("TextButton", {
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -10, 0.5, 0),
                Size = UDim2.new(0, 110, 0, 38),
                BackgroundColor3 = T.Green,
                Font = Enum.Font.GothamBlack,
                Text = "BUY",
                TextSize = 15,
                TextColor3 = T.Text,
                Parent = row,
        })
        corner(buy, 8)
        return row, nameLabel, subLabel, buy
end

function UIController:populateUpgrades()
        local scroll = self.tabFrames.Upgrades
        self.upgradeRows = {}
        for index, def in Config.Upgrades do
                local row, nameLabel, subLabel, buy = newRow(scroll)
                nameLabel.Text = def.name
                self.upgradeRows[def.id] = { sub = subLabel, button = buy, def = def }
                buy.Activated:Connect(function()
                        Remotes.get("Purchase"):InvokeServer("upgrade", def.id)
                end)
                row.LayoutOrder = index
        end
end

function UIController:populatePets()
        local scroll = self.tabFrames.Pets
        self.petRows = {}
        for index, def in Config.Pets do
                local row, nameLabel, subLabel, buy = newRow(scroll)
                nameLabel.Text = def.name .. "  (+" .. def.income .. "/s)"
                self.petRows[def.id] = { sub = subLabel, button = buy, def = def }
                buy.Activated:Connect(function()
                        local st = self.state
                        if st and table.find(st.Pets, def.id) then
                                if table.find(st.Equipped, def.id) then
                                        Remotes.get("Purchase"):InvokeServer("pet_unequip", def.id)
                                else
                                        Remotes.get("Purchase"):InvokeServer("pet_equip", def.id)
                                end
                        else
                                Remotes.get("Purchase"):InvokeServer("pet_buy", def.id)
                        end
                end)
                row.LayoutOrder = index
        end

        self.petCapLabel = Util.create("TextLabel", {
                Size = UDim2.new(1, -8, 0, 24),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBold,
                Text = "Equipped: 0/3",
                TextSize = 14,
                TextColor3 = T.TextDim,
                Parent = scroll,
        })
        self.petCapLabel.LayoutOrder = 999
end

function UIController:populateRobux()
        local scroll = self.tabFrames.Robux

        local function card(order, titleText, subText, priceText, onClick, active: boolean)
                local row = Util.create("Frame", {
                        Size = UDim2.new(1, -8, 0, 62),
                        BackgroundColor3 = T.Panel,
                        Parent = scroll,
                })
                corner(row, 10)
                row.LayoutOrder = order

                Util.create("TextLabel", {
                        Position = UDim2.new(0, 12, 0, 9),
                        Size = UDim2.new(1, -150, 0, 22),
                        BackgroundTransparency = 1,
                        Font = Enum.Font.GothamBold,
                        Text = titleText,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        TextSize = 17,
                        TextColor3 = T.Text,
                        Parent = row,
                })
                Util.create("TextLabel", {
                        Position = UDim2.new(0, 12, 0, 33),
                        Size = UDim2.new(1, -150, 0, 18),
                        BackgroundTransparency = 1,
                        Font = Enum.Font.Gotham,
                        Text = subText,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        TextSize = 13,
                        TextColor3 = T.TextDim,
                        Parent = row,
                })

                local buy = Util.create("TextButton", {
                        AnchorPoint = Vector2.new(1, 0.5),
                        Position = UDim2.new(1, -10, 0.5, 0),
                        Size = UDim2.new(0, 110, 0, 40),
                        BackgroundColor3 = active and T.Gold or T.Disabled,
                        Font = Enum.Font.GothamBlack,
                        Text = active and ("R$ " .. priceText) or "SOON",
                        TextSize = 14,
                        TextColor3 = active and T.Bg or T.TextDim,
                        Parent = row,
                })
                corner(buy, 8)
                if active then
                        buy.Activated:Connect(onClick)
                end
        end

        for key, def in Config.Gamepasses do
                local active = def.id and def.id > 0
                card(
                        1,
                        def.name,
                        def.desc,
                        tostring(def.price),
                        function()
                                MarketplaceService:PromptGamePassPurchase(player, def.id)
                        end,
                        active
                )
        end

        for key, def in Config.Products do
                local active = def.id and def.id > 0
                card(
                        2,
                        def.name,
                        "Instant coin pack",
                        tostring(def.price),
                        function()
                                MarketplaceService:PromptProductPurchase(player, def.id)
                        end,
                        active
                )
        end
end

--------------------------------------------------------------------
-- LEADERBOARD PANEL + NOTIFY
--------------------------------------------------------------------

function UIController:buildLeaderboardPanel()
        local frame = Util.create("Frame", {
                Name = "Leaderboard",
                Visible = false,
                AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, -14, 0, 60),
                Size = UDim2.new(0, 260, 0, 320),
                BackgroundColor3 = T.Bg,
                BackgroundTransparency = 0.06,
                Parent = self.gui,
        })
        corner(frame, 14)
        Util.create("UIStroke", { Color = T.PanelLight, Thickness = 2 }, frame)
        self.lbFrame = frame

        Util.create("TextLabel", {
                Position = UDim2.new(0, 12, 0, 8),
                Size = UDim2.new(1, -24, 0, 26),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBlack,
                Text = "TOP COIN EARNERS",
                TextXAlignment = Enum.TextXAlignment.Left,
                TextSize = 16,
                TextColor3 = T.Gold,
                Parent = frame,
        })

        self.lbList = Util.create("Frame", {
                Position = UDim2.new(0, 12, 0, 40),
                Size = UDim2.new(1, -24, 1, -52),
                BackgroundTransparency = 1,
                Parent = frame,
        })
        Util.create("UIListLayout", {
                Padding = UDim.new(0, 4),
                SortOrder = Enum.SortOrder.LayoutOrder,
        }, self.lbList)
end

function UIController:buildNotifyContainer()
        self.notifyFrame = Util.create("Frame", {
                Name = "Notify",
                AnchorPoint = Vector2.new(1, 1),
                Position = UDim2.new(1, -16, 1, -160),
                Size = UDim2.new(0, 260, 0, 140),
                BackgroundTransparency = 1,
                Parent = self.gui,
        })
        Util.create("UIListLayout", {
                Padding = UDim.new(0, 6),
                SortOrder = Enum.SortOrder.LayoutOrder,
                VerticalAlignment = Enum.VerticalAlignment.Bottom,
        }, self.notifyFrame)
end

--------------------------------------------------------------------
-- BEHAVIOUR
--------------------------------------------------------------------

function UIController:onClickSound()
        self.sound.PlaybackSpeed = 0.9 + math.random() * 0.3
        self.sound:Play()
end

function UIController:spawnFloat(text: string)
        local btn = self.clickButton
        local pos = btn.AbsolutePosition + btn.AbsoluteSize / 2
        local label = Util.create("TextLabel", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(0, pos.X + math.random(-30, 30), 0, pos.Y - 20),
                Size = UDim2.new(0, 120, 0, 26),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBlack,
                Text = text,
                TextSize = 20,
                TextColor3 = T.Gold,
                Parent = self.floatLayer,
        })
        local goal = {
                Position = label.Position - UDim2.fromOffset(0, 60),
                TextTransparency = 1,
        }
        local tween = TweenService:Create(label, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal)
        tween:Play()
        tween.Completed:Connect(function()
                label:Destroy()
        end)
end

function UIController:onClicked()
        self:onClickSound()
        Remotes.get("Click"):FireServer()
        if self.state then
                self:spawnFloat("+" .. Util.formatNumber(self.state.ClickValue))
        end
end

function UIController:setShopOpen(open: boolean)
        self.shopOpen = open
        self.shopFrame.Visible = open
end

function UIController:setLeaderboardOpen(open: boolean)
        self.lbOpen = open
        self.lbFrame.Visible = open
        if open then
                self:refreshLeaderboard()
        end
end

function UIController:setTab(name: string)
        for tabName, frame in self.tabFrames do
                frame.Visible = tabName == name
        end
        for tabName, tab in self.tabs do
                tab.BackgroundColor3 = tabName == name and T.Blue or T.PanelLight
        end
end

function UIController:refreshLeaderboard()
        task.spawn(function()
                local ok, rows = pcall(function()
                        return Remotes.get("GetLeaderboard"):InvokeServer()
                end)
                if not ok or not rows then
                        return
                end
                for _, child in self.lbList:GetChildren() do
                        if child:IsA("TextLabel") then
                                child:Destroy()
                        end
                end
                if #rows == 0 then
                        Util.create("TextLabel", {
                                Size = UDim2.new(1, 0, 0, 24),
                                BackgroundTransparency = 1,
                                Font = Enum.Font.Gotham,
                                Text = "No entries yet - be the first!",
                                TextSize = 14,
                                TextColor3 = T.TextDim,
                                Parent = self.lbList,
                        })
                        return
                end
                for i, entry in rows do
                        Util.create("TextLabel", {
                                Size = UDim2.new(1, 0, 0, 24),
                                BackgroundTransparency = 1,
                                Font = Enum.Font.GothamBold,
                                Text = i .. ". " .. entry.name .. "  -  " .. Util.formatNumber(entry.value),
                                TextXAlignment = Enum.TextXAlignment.Left,
                                TextSize = 15,
                                TextColor3 = i <= 3 and T.Gold or T.Text,
                                Parent = self.lbList,
                        })
                end
        end)
end

--------------------------------------------------------------------
-- STATE -> UI
--------------------------------------------------------------------

function UIController:applyState(state)
        self.state = state

        self.coinsLabel.Text = Util.formatNumber(state.Coins)
        self.perSecLabel.Text = "+" .. Util.formatNumber(state.PerSecond) .. " /s"
        self.clickButton.Text = "CLICK!\n+" .. Util.formatNumber(state.ClickValue)

        local canRebirth = state.Coins >= state.RebirthCost
        self.rebirthBtn.Text = "REBIRTH\n" .. Util.formatNumber(state.RebirthCost)
        self.rebirthBtn.BackgroundColor3 = canRebirth and T.Green or T.PanelLight

        for id, row in self.upgradeRows do
                local level = state.Upgrades[id] or 0
                local maxed = level >= row.def.max
                local cost = maxed and 0 or math.floor(row.def.base * row.def.growth ^ level + 0.5)
                row.sub.Text = maxed and ("Lv " .. level .. "/" .. row.def.max .. "  -  MAXED")
                        or ("Lv " .. level .. "/" .. row.def.max .. "  -  " .. Util.formatNumber(cost) .. " coins")
                local afford = not maxed and state.Coins >= cost
                row.button.Text = maxed and "MAX" or "BUY"
                row.button.BackgroundColor3 = maxed and T.Disabled or (afford and T.Green or T.PanelLight)
        end

        local equippedCount = #state.Equipped
        for id, row in self.petRows do
                local owned = table.find(state.Pets, id) ~= nil
                local equipped = table.find(state.Equipped, id) ~= nil
                if equipped then
                        row.sub.Text = "EQUIPPED  -  +" .. row.def.income .. "/s"
                        row.button.Text = "UNEQUIP"
                        row.button.BackgroundColor3 = T.Red
                elseif owned then
                        row.sub.Text = "Owned  -  +" .. row.def.income .. "/s"
                        row.button.Text = "EQUIP"
                        row.button.BackgroundColor3 = T.Blue
                else
                        row.sub.Text = row.def.price .. " coins  -  +" .. row.def.income .. "/s"
                        row.button.Text = "BUY"
                        row.button.BackgroundColor3 = state.Coins >= row.def.price and T.Green or T.PanelLight
                end
        end
        self.petCapLabel.Text = "Equipped: " .. equippedCount .. "/" .. state.EquipCap
end

--------------------------------------------------------------------
-- REMOTES
--------------------------------------------------------------------

function UIController:wireRemotes()
        local stateSync = Remotes.get("StateSync")
        stateSync.OnClientEvent:Connect(function(state)
                self:applyState(state)
        end)

        local notify = Remotes.get("Notify")
        notify.OnClientEvent:Connect(function(title: string, message: string)
                self:toast(title, message)
        end)

        -- periodic leaderboard refresh while open
        task.spawn(function()
                while true do
                        task.wait(20)
                        if self.lbOpen then
                                self:refreshLeaderboard()
                        end
                end
        end)
end

function UIController:toast(title: string, message: string)
        local card = Util.create("Frame", {
                Size = UDim2.new(1, 0, 0, 52),
                BackgroundColor3 = T.Panel,
                BackgroundTransparency = 0.1,
                Parent = self.notifyFrame,
        })
        corner(card, 10)

        Util.create("TextLabel", {
                Position = UDim2.new(0, 10, 0, 6),
                Size = UDim2.new(1, -20, 0, 18),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBlack,
                Text = title,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextSize = 14,
                TextColor3 = T.Gold,
                Parent = card,
        })
        Util.create("TextLabel", {
                Position = UDim2.new(0, 10, 0, 26),
                Size = UDim2.new(1, -20, 0, 20),
                BackgroundTransparency = 1,
                Font = Enum.Font.Gotham,
                Text = message,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextScaled = true,
                TextColor3 = T.Text,
                Parent = card,
        })

        task.delay(3.2, function()
                local tween = TweenService:Create(
                        card,
                        TweenInfo.new(0.4),
                        { BackgroundTransparency = 1 }
                )
                tween:Play()
                tween.Completed:Wait()
                card:Destroy()
        end)
end

return UIController
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
